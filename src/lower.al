      ## field `f` is typed `fn(…) -> R` (a code pointer), route it to an indirect call through that field
      ## rather than a (nonexistent) fn named `f`: lower the REAL call args (source indices 1.., the
      ## receiver `o` erased via `skip = 0`) into the SysV registers, load the code pointer from `o`'s
      ## field slot into %rax, `call *%rax`. Checked BEFORE the local-slot fn-value path below so that a
      ## member call `o.f(…)` reaches the FIELD even when a same-named local `f` shadows it (member access
      ## wins). `fn_field_call_slot` gates it to a Var receiver naming an inline struct with a genuine
      ## fn-typed field, so an ordinary UFCS method call / a non-struct arg 0 both fall through unchanged →
      ## `src/`+`lib/` declare no fn-typed field, so this never fires there → the TOOL-1 fixpoint holds.
      if nargs >= 1 {
        ffcs := fn_field_call_slot(arg_expr_at(args_head, 0, a), cs, cl, cx)
        if ffcs >= 0 {
          cx.call_cidx = -1
          ## FLOAT ARGUMENT CLASS (FN-6 / SysV) — the field's own fn type says which arguments ride
          ## %xmm. The receiver is erased (`skip = 0`), so VALUE argument k is fn-type parameter k.
          cx.ind_fn_fmask = fn_field_param_fmask(arg_expr_at(args_head, 0, a), cs, cl, cx)
          emit_call_args(args_head, 0, -1, -1, nargs - 1, sb, cx, nl)
          push_str(sb, "  movq -")
          push_int(sb, (ffcs + 1) * 8)
          push_str(sb, "(%rbp), %rax\n  call *%rax\n")
          emit_call_cleanup(sb, nargs - 1)
          ## FLOAT RETURN CLASS (FN-6 / SysV): an `f64`/`f32`-returning fn value delivers its result in
          ## %xmm0, not %rax — move it across before it rides the word-sized value stack, exactly as a
          ## named direct float-returning call does. Non-float fields keep the byte-identical push.
          if fn_field_call_ret_float(arg_expr_at(args_head, 0, a), cs, cl, cx) {
            push_str(sb, "  movq %xmm0, %rax\n")
          }
          push_str(sb, "  pushq %rax\n")
          return
        }
      }
      ## FN-11: INDIRECT CALL through a `dyn` FAT-PAIR local (`d : dyn fn(…)->R`, ek 11): load `env`
      ## (word 1) into %rdi (the leading environment pointer), lower the user args into %rsi.. (the sret
      ## shift `sc_shift=1` frees %rdi), load `code` (word 0) into %rax, `call *%rax`. Checked BEFORE the
      ## bare fn-value-slot path so a dyn local is NOT mistaken for a one-word code pointer.
      dynslot := slot_of(cx.slots, cx.src, cs, cl)
      if dynslot >= 0 and deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, cs, cl))).ek == 11 {
        cx.call_cidx = -1
        cx.sret_call = 0
        ## FLOAT ARGUMENT CLASS (FN-6 / SysV): the `dyn` type's own signature says which user arguments
        ## are `f64`/`f32` and so must ride %xmm rather than a GPR.
        cx.ind_fn_fmask = fnval_param_fmask(cs, cl, cx)
        emit_call_args(args_head, -1, -1, -1, nargs, sb, cx, nl)
        push_str(sb, "  movq -")
        push_int(sb, dynslot * 8)
        push_str(sb, "(%rbp), %rdi\n  movq -")
        push_int(sb, (dynslot + 1) * 8)
        push_str(sb, "(%rbp), %rax\n  call *%rax\n")
        emit_call_cleanup_shift(sb, nargs, 1)
        ## FLOAT RETURN CLASS (FN-6 / SysV) — see the fn-value-field site above: a `dyn fn(…) -> f64`
        ## delivers in %xmm0. `fnval_ty_pos` skips the `dyn` head of the local's declared type.
        if fnval_call_ret_float(cs, cl, cx) { push_str(sb, "  movq %xmm0, %rax\n") }
        push_str(sb, "  pushq %rax\n")
        return
      }
      ## INDIRECT CALL through a fn-VALUE local/param (`f : fn(…) -> R`, bound as a scalar code
      ## pointer): `f(args)` where `f` names a LOCAL/PARAM SLOT — lower the args into the SysV
      ## registers, load the code pointer from f's slot into %rax (not an arg register), `call *%rax`,
      ## reclaim any stack args, push the result. Enables higher-order stdlib fns (map/filter/reduce/
      ## sort_by over a fn-value predicate). Only a real slot triggers this; a same-name FN is a
      ## direct call (`src/` has no fn-value call → the direct path stays byte-identical → fixpoint).
      fvslot := slot_of(cx.slots, cx.src, cs, cl)
      if fvslot >= 0 {
        cx.call_cidx = -1
        ## FLOAT ARGUMENT CLASS (FN-6 / SysV): an `f64`/`f32` parameter of the fn VALUE takes an SSE
        ## register. Without the mask every argument rode a GPR while the callee (a real fn with real
        ## float params) read %xmm — right only by accident, when %xmm0 still held the value from the
        ## argument's own load. The mask is 0 for an all-integer / unresolvable fn value → unchanged.
        cx.ind_fn_fmask = fnval_param_fmask(cs, cl, cx)
        emit_call_args(args_head, -1, -1, -1, nargs, sb, cx, nl)
        push_str(sb, "  movq -")
        push_int(sb, (fvslot + 1) * 8)
        push_str(sb, "(%rbp), %rax\n  call *%rax\n")
        emit_call_cleanup(sb, nargs)
        ## FLOAT RETURN CLASS (FN-6 / SysV) — the fn-value local/param dual of the two sites above: an
        ## `f64`/`f32`-returning fn value leaves its result in %xmm0. Without this the value stack
        ## captured %rax (a silent 0 for every consumer that was not itself a float operation).
        if fnval_call_ret_float(cs, cl, cx) { push_str(sb, "  movq %xmm0, %rax\n") }
        push_str(sb, "  pushq %rax\n")
        return
      }
      ## GENERICS tier: if the callee is a generic fn, arg 0 is the COMPTIME TYPE argument
      ## (an ident naming the concrete type) — it is ERASED (no register). Lower only args
      ## 1.. into registers (shifted DOWN by one: value arg `k` → `argreg(k-1)`), and call the
      ## mangled instance `<module>__<fn>__<typetag>`.
      mut gi := generic_decl_of(cx.decls, cx.src, cs, cl, cx.mod_s, cx.mod_l, nargs, args_head, a)
      ## RECEIVER-KEYED SELECTION (spec FN-7): a bare/UFCS call to a name shared by generics in
      ## different modules (`unwrap`/`is_ok`/… in both `base/result` and `base/option`) must pick the
      ## candidate whose `self` type matches arg 0's type — not the last-declared. Neutral for every
      ## call whose resolved decl already matches the receiver (`recv_redirect_generic` is a no-op then).
      if gi >= 0 and nargs >= 1 {
        r_ty := expr_type_span(arg_expr_at(args_head, 0, a), cx)
        if r_ty.n != 0 {
          r_bt := base_type_name(cx.src, r_ty.s, r_ty.n)
          gi = recv_redirect_generic(cx.decls, cx.src, gi, nargs, r_bt.s, r_bt.n, a)
        }
      }
      ## A CONCRETE overload matching the args by arity+first-arg type WINS over a same-name generic
      ## (`eq(u64,u64)` → `cmp::eq`, not `derive::eq(T,a,b)`) — route it to the non-generic path below.
      if gi >= 0 {
        gat := arg_type_name(args_head, cx, a)
        if nongen_type_match(cx.decls, cx.src, cs, cl, nargs, gat.s, gat.n, a) { gi = 0 - 1 }
      }
      if gi >= 0 {
        ## the comptime type parameter may sit at ANY source arg index (`allocate`'s `T` is arg 1);
        ## `tpi` locates it, `type_arg_at` reads the concrete type there, and `emit_call_args` erases
        ## exactly that arg. For the common leading `T : type` (tpi 0) this is byte-identical.
        tpi := tparam_idx(cx.decls, gi, cx.src, a)
        mut ta := type_arg_at(args_head, tpi, a)
        if is_fn_name(cx.decls, cx.src, ta.s, ta.n) { ta = CSpan(s = 0, n = 0) }
        ## a TUPLE type-arg `(T0, T1, …)` — recover its `(…)` source span (mono keys on it).
        if ta.n == 0 {
          tt := tuple_typearg_span(arg_expr_at(args_head, tpi, a), cx.src, a)
          if tt.n != 0 { ta = tt }
        }
        if ta.n == 0 and cx.cf_var_l != 0 {
          ct_a0 := arg_expr_at(args_head, tpi, a)
          ct_fp := field_var_parts(ct_a0)
          if ct_fp.ok and streq(cx.src, ct_fp.os, ct_fp.on, cx.cf_var_s, cx.cf_var_l) and str_at((cx.src + ct_fp.fs), ct_fp.fl) == "type" {
            ta = CSpan(s = cx.cf_ty_s, n = cx.cf_ty_l)
          }
        }
        ## NESTED GENERIC substitution: inside a generic INSTANCE (this fn was emitted for the
        ## concrete type `cx.it_s`/`it_l`), a nested generic call whose type-argument IS the
        ## enclosing type-parameter (`cx.gp_s`/`gp_l`, e.g. `buf_ptr(T, …)` / `get(T, …)` inside
        ## `allocate` mono'd for `u8`) must route to the callee's CONCRETE instance — so substitute
        ## the type-arg lexeme `T` → the instance type. Without this the call targeted an
        ## unsubstituted `<mod>__buf_ptr__T` (a bogus label; the real `__u8` instance went uncalled).
        ## The mono pre-pass performs the matching transitive collection so the `__<concrete>`
        ## instance is defined. (Fires only inside an instance with a type-param arg — src/ has no
        ## such nested call, so it never fires there → fixpoint-neutral.)
        if cx.gp_l != 0 and cx.it_l != 0 and streq(cx.src, ta.s, ta.n, cx.gp_s, cx.gp_l) {
          ta = CSpan(s = cx.it_s, n = cx.it_l)
        } else if cx.gp2_l != 0 and cx.it2_l != 0 and streq(cx.src, ta.s, ta.n, cx.gp2_s, cx.gp2_l) {
          ta = CSpan(s = cx.it2_s, n = cx.it2_l)
        } else if cx.gp3_l != 0 and cx.it3_l != 0 and streq(cx.src, ta.s, ta.n, cx.gp3_s, cx.gp3_l) {
          ta = CSpan(s = cx.it3_s, n = cx.it3_l)
        }
        ## SECOND type-param (`map(T, U, …)`): read its type-arg + skip position; erase BOTH args.
        ## `skip2 = -1` for a single-type-param callee → byte-identical single-tag path.
        ntpc := tparam_count(cx.decls, gi, cx.src, a)
        mut ta2 := CSpan(s = 0, n = 0)
        mut tpi2 := -1
        if ntpc >= 2 {
          tpi2 = i64(tparam_idx2(cx.decls, gi, cx.src, a))
          ta2 = type_arg_at(args_head, usize(tpi2), a)
          if is_fn_name(cx.decls, cx.src, ta2.s, ta2.n) { ta2 = CSpan(s = 0, n = 0) }
          if cx.gp_l != 0 and cx.it_l != 0 and streq(cx.src, ta2.s, ta2.n, cx.gp_s, cx.gp_l) { ta2 = CSpan(s = cx.it_s, n = cx.it_l) }
          else if cx.gp2_l != 0 and cx.it2_l != 0 and streq(cx.src, ta2.s, ta2.n, cx.gp2_s, cx.gp2_l) { ta2 = CSpan(s = cx.it2_s, n = cx.it2_l) }
          else if cx.gp3_l != 0 and cx.it3_l != 0 and streq(cx.src, ta2.s, ta2.n, cx.gp3_s, cx.gp3_l) { ta2 = CSpan(s = cx.it3_s, n = cx.it3_l) }
        }
        ## THIRD type-param (`Result::map(T, E, U, …)`): its type-arg + skip; erase all three leading args.
        mut ta3 := CSpan(s = 0, n = 0)
        mut tpi3 := -1
        if ntpc >= 3 {
          tpi3 = i64(tparam_idx3(cx.decls, gi, cx.src, a))
          ta3 = type_arg_at(args_head, usize(tpi3), a)
          if is_fn_name(cx.decls, cx.src, ta3.s, ta3.n) { ta3 = CSpan(s = 0, n = 0) }
          if cx.gp_l != 0 and cx.it_l != 0 and streq(cx.src, ta3.s, ta3.n, cx.gp_s, cx.gp_l) { ta3 = CSpan(s = cx.it_s, n = cx.it_l) }
          else if cx.gp2_l != 0 and cx.it2_l != 0 and streq(cx.src, ta3.s, ta3.n, cx.gp2_s, cx.gp2_l) { ta3 = CSpan(s = cx.it2_s, n = cx.it2_l) }
          else if cx.gp3_l != 0 and cx.it3_l != 0 and streq(cx.src, ta3.s, ta3.n, cx.gp3_s, cx.gp3_l) { ta3 = CSpan(s = cx.it3_s, n = cx.it3_l) }
        }
        ## IMPLICIT payload type-arg (derive's enum `hash(p)`): a single-type-param generic called with
        ## the current arm's payload binding as its ONLY arg — the type-arg is IMPLICIT (the payload's
        ## own type `cf_pay_ty`), and the payload is the VALUE arg (nothing erased). Detected by arg 0
        ## being a `Var` == `cf_pay`.
        mut impl_pay := false
        if cx.cf_pay_l != 0 and ntpc == 1 {
          ip_a0 := arg_expr_at(args_head, 0, a)
          ip_vn := var_name_span(ip_a0)
          if ip_vn.n != 0 and streq(cx.src, ip_vn.s, ip_vn.n, cx.cf_pay_s, cx.cf_pay_l) {
            impl_pay = true
            ta = CSpan(s = cx.cf_pay_ty_s, n = cx.cf_pay_ty_l)
          }
        }
        ## GENERAL implicit type-arg (`hash(key)`, T omitted, non-derive): the call passes only value
        ## args (`nargs == arity - ntpc`). Infer T from the value arg's type; nothing is erased.
        gdi := deref(decl_at(Decl, rt::vec_get(deref(cx.decls), usize(gi))))
        if impl_pay == false and ntpc == 1 and gdi.arity != 0 and nargs == gdi.arity - ntpc {
          iti := infer_implicit_targ(gi, args_head, cx, a)
          if iti.n != 0 { impl_pay = true; ta = iti }
        }
        ## IMPLICIT UFCS receiver on a MULTI-type-param method (`r.unwrap()`/`r.is_ok()`/`r.unwrap_or(d)`
        ## on `Result(T, E)` — arity `ntpc + <value params>`): the leading `T…` are ALL omitted and the
        ## receiver is the `self` value arg. Infer the CONCRETE type-args from the receiver's DECLARED type
        ## (`recv_full_emit` reads the source annotation, since the slot keeps only the base name) so the
        ## instance label is the proven `base__result__unwrap__u64__u64`; erase nothing. WITHOUT this,
        ## `nvals = nargs - ntpc` UNDERFLOWS (usize) → the arg loop runs unbounded → SIGILL at COMPILE time.
        ## Gated to `nargs == arity - ntpc` so an explicit `map(u64,u64,u64,r,f)` (arity match) is untouched.
        ## `src/` spells its type-args → never fires here → fixpoint-neutral.
        if impl_pay == false and ntpc == 2 and gdi.arity != 0 and nargs == gdi.arity - ntpc {
          rcv_ty := recv_full_emit(arg_expr_at(args_head, 0, a), cx.decls, cx.src, a)
          if rcv_ty.n != 0 {
            c0 := implicit_targ_from_recv(cx.decls, cx.src, gi, rcv_ty.s, rcv_ty.n, 0, a)
            c1 := implicit_targ_from_recv(cx.decls, cx.src, gi, rcv_ty.s, rcv_ty.n, 1, a)
            if c0.n != 0 and c1.n != 0 {
              impl_pay = true
              ta = c0
              ta2 = c1
              ## nothing is erased (both type-args came from the receiver) → clear the erase positions
              ## for the 2nd type-param too, else `emit_call_args` skips a nonexistent source arg → OOB.
              tpi2 = 0 - 1
              tpi3 = 0 - 1
            }
          }
        }
        ## A 3-type-param method via implicit UFCS (`r.map(f)`/…) whose 3rd type-param comes from the
        ## mapper's return is unsupported (parser discards the fn-value param's return; seed mis-lowers
        ## the conditional struct-return inference) — fail loud with the explicit-type-arg workaround.
        ## I11 / Comptime §3.3 — the leading comptime type argument was OMITTED (`nargs == arity -
        ## ntpc`) and NO rule above could infer it. Comptime §3.3: "a parameter that cannot be
        ## inferred MUST be supplied explicitly". Without this reject the call fell through with
        ## `impl_pay == false`, so `nvals = nargs - ntpc` silently DROPPED one value argument and
        ## `type_arg_at` tagged the instance with that argument's own source TEXT. Measured:
        ## `println(s)` for a `str` local emitted `call std__fmt__println__s` with NO arguments at all
        ## and printed `0`; `id(s)` through a user `fn(T : type, v : T) -> T` SIGSEGV'd. Both silent —
        ## the forbidden outcome. `src/`+`lib/` spell every type argument they cannot infer, so this
        ## never fires on the self-host build.
        if impl_pay == false and ntpc == 1 and nargs != 0 and gdi.arity != 0 and nargs == gdi.arity - ntpc {
          panic("selfhost: this generic call omits its comptime type argument and it cannot be inferred here (Comptime 3.3) - pass it explicitly (`f(str, v)`) or annotate the argument's binding with its type (`v : str = ...`)")
        }
        if impl_pay == false and nargs < ntpc {
          panic("selfhost: an implicit-UFCS call to a multi-type-parameter Result/Option method can't infer all its type arguments here (e.g. map/and_then/map_err — the mapper return type; or a receiver bound from a generic call whose type is not tracked) — call it with explicit type args, e.g. `map(T, E, U, r, f)` / `unwrap(T, E, r)`")
        }
        ## value args = args past the erased comptime type args; `nvals = nargs - ntpc`. For an
        ## implicit-payload call nothing is erased (the type came from context) → all args are values.
        ## The `nargs - ntpc` is computed ONLY on the non-implicit branch: an implicit-UFCS call has
        ## `nargs < ntpc` (all type-args omitted), so the CHECKED subtraction would underflow → `ud2`
        ## (the original SIGILL) before the reassignment could rescue it.
        mut nvals := if impl_pay { nargs } else { nargs - ntpc }
        mut eff_tpi := if impl_pay { 0 - 1 } else { i64(tpi) }
        cx.call_cidx = gi
        emit_call_args(args_head, eff_tpi, tpi2, tpi3, nvals, sb, cx, nl)
        push_str(sb, "  call ")
        ## the instance label `<defining-module>__<fn>__<typetag>`: take the module + bare name
        ## from the RESOLVED generic decl (`gd` at `gi`), NOT the caller. The per-module helpers
        ## `node_ptr`/`decl_at` are duplicated in every module and `generic_decl_of` resolves a
        ## bare call to the LAST matching copy — and the mono pre-pass emits the INSTANCE from the
        ## SAME `gd`, so emitting the call label from `gd` makes the two always agree (whereas the
        ## caller-module mangling of `emit_mangled_call` produced `<caller>__node_ptr__T`, for which
        ## no instance is defined). A qualified `mod::f` resolves to `mod`'s decl → same label.
        gd := deref(decl_at(Decl, rt::vec_get(deref(cx.decls), usize(gi))))
        emit_generic_label(sb, cx.src, gd.mod_start, gd.mod_len, gd.name_start, gd.name_len, ta.s, ta.n, ta2.s, ta2.n, ta3.s, ta3.n)
        push_str(sb, "\n")
        emit_call_cleanup(sb, nvals)
        if callee_returns_float(cx.decls, cx.src, gi) {
          push_str(sb, "  movq %xmm0, %rax\n  pushq %rax\n")
        } else {
          push_str(sb, "  pushq %rax\n")
        }
        return
      }
      ## `@inline` CALL — EXPAND the callee's body at the call site (§3.1/§3.5) instead of a `call`
      ## (`emit_inline_call`, shared with the operator-routing path). Tail-expression + statement bodies.
      inl_ci := inline_callee_idx(cx.decls, cx.src, cs, cl, cx.mod_s, cx.mod_l)
      if inl_ci >= 0 and cx.inl_tmp >= 0 {
        emit_inline_call(inl_ci, args_head, sb, cx, a, nl)
        return
      }
      ## §7.2 SLICE-VARIADIC CALL — a callee whose last param is a `...T` rest (`pmode == 3`). Unlike
      ## the comptime variadic below, the callee is a REAL runtime fn; the call site GATHERS the trailing
      ## args into a contiguous block + passes a `{ptr, len}` slice (`emit_slice_variadic_call`).
      sv_ci := slice_variadic_callee_idx(cx.decls, cx.src, cs, cl, cx.mod_s, cx.mod_l)
      if sv_ci >= 0 {
        emit_slice_variadic_call(sv_ci, cs, cl, args_head, nargs, sb, cx, a, nl)
        return
      }
      ## comptime-VARIADIC CALL (Functions §7.1) — a callee whose last param is a `...` rest is
      ## monomorphized/EXPANDED at the call site: fixed args bind, trailing args form the pack the body's
      ## `comptime for` unrolls over. Like `@inline`, there is no runtime call.
      var_ci := variadic_callee_idx(cx.decls, cx.src, cs, cl, cx.mod_s, cx.mod_l, a)
      if var_ci >= 0 and cx.inl_tmp >= 0 {
        emit_variadic_call(var_ci, args_head, sb, cx, a, nl)
        return
      }
      ## Lower the arguments into the System V locations (args 1-6 in %rdi..%r9, args 7+ pushed
      ## on the stack per `emit_call_args`), `call`, reclaim any stack args, then push the result
      ## (%rax) like any other expression value. An AGGREGATE argument is passed BY REFERENCE via
      ## `emit_arg` (its word-0 address), not a value.
      cidx2 := resolve_callee_idx(cx.decls, cx.src, cs, cl, cx.mod_s, cx.mod_l)
      cx.call_cidx = cidx2
      ## C-ABI FOREIGN CALL (spec 150 §FN-9) in value position — `@abi(c)` callee: lay the args by the
      ## SysV C register-classing (scalars + aggregates ≤ 16 bytes in int / xmm regs) instead of the
      ## internal by-reference pass, `call` the extern symbol, then push the result like any value. A
      ## float-returning callee delivers its result in %xmm0 (the SSE return register) — move it to %rax
      ## for the ordinary word-sized value stack (mirroring the non-`@abi(c)` float-return path below).
      ## Register-only (no stack cleanup / sret). Gated on `callee_decl_is_abi_c` → no self-host call
      ## reaches here → fixpoint byte-identical. (An `@abi(c)` fn is never overloaded → no suffix.)
      if callee_decl_is_abi_c(cx.decls, cx.src, cidx2) {
        c_area := emit_abi_c_call_args(args_head, nargs, cidx2, sb, cx, nl)
        push_str(sb, "  call ")
        emit_mangled_call(sb, cx.src, cs, cl, cx.mod_s, cx.mod_l, cx.decls)
        push_str(sb, "\n")
        if c_area != 0 {
          push_str(sb, "  addq $")
          push_int(sb, i64(c_area * 8))
          push_str(sb, ", %rsp\n")
        }
        if callee_returns_float(cx.decls, cx.src, cidx2) {
          push_str(sb, "  movq %xmm0, %rax\n  pushq %rax\n")
        } else {
          push_str(sb, "  pushq %rax\n")
        }
        return
      }
      emit_call_args(args_head, -1, -1, -1, nargs, sb, cx, nl)
      push_str(sb, "  call ")
      emit_mangled_call(sb, cx.src, cs, cl, cx.mod_s, cx.mod_l, cx.decls)
      emit_overload_suffix(sb, cs, cl, args_head, cx, a)
      push_str(sb, "\n")
      emit_call_cleanup(sb, nargs)
      ## a float-returning callee delivers its result in %xmm0 — move it to %rax for the value stack.
      if callee_returns_float(cx.decls, cx.src, cidx2) {
        push_str(sb, "  movq %xmm0, %rax\n  pushq %rax\n")
      } else {
        push_str(sb, "  pushq %rax\n")
      }
    }
    ## `base.f` — a field read. The base is a struct `Var`; resolve its slot entry (base
    ## offset + struct TYPE span), map the field name to its declaration-order index, and
    ## load the word at `-(base_off + field_index + 1) * 8(%rbp)`, pushing it. (Only a `Var`
    ## base is supported — the structs the self-host compiler reads are named locals; a
    ## nested/temporary struct base is deferred.)
    Expr::Field(base, fs, fl) => {
      if cf_unknown_member(e, cx) { panic("selfhost: unknown typeinfo Field member; allowed members are name, type, offset, mutable") }
      ## `f.mutable` — a comptime FIELD descriptor read. It has no runtime storage; emit the source-level
      ## mutability bit as an immediate before ordinary field machinery sees `f` as a runtime variable.
      cfm := cf_mutable_value(e, cx)
      if cfm >= 0 {
        push_str(sb, "  movq $")
        push_int(sb, cfm)
        push_str(sb, ", %rax\n  pushq %rax\n")
        return
      }
      ## `f.offset` — a comptime FIELD descriptor read. It must be folded before the ordinary field
      ## machinery sees `f` as a runtime variable; the descriptor has no runtime storage.
      cfo := cf_offset_value(e, cx, deref(cx.mar))
      if cfo >= 0 {
        push_str(sb, "  movq $")
        push_int(sb, cfo)
        push_str(sb, ", %rax\n  pushq %rax\n")
        return
      }
      ## `build.<flag>` (Tooling §2.7) used as a bare comptime VALUE — fold to its selected value as an
      ## immediate. Checked FIRST: `build` is a reserved comptime handle (like `verify`/`target`), never a
      ## runtime slot, so an undeclared flag must fail LOUD here rather than fall to the generic slot read.
      ## No `src/`/`lib/` expression names `build` → this never fires for the self-host build (neutral).
      bfb := var_name_span(base)
      if bfb.n != 0 and str_at((cx.src + bfb.s), bfb.n) == "build" {
        emit_build_flag_value(str_at((cx.src + fs), fl), sb)
        return
      }
      ## `a.len` (FIELD form, no parens) on a FIXED array `[T; N]` = the comptime `N`, folded to an
      ## immediate (spec Types §6.4 / Control-Flow §5.4 — a `[T; N]` array's own length is `N`).
      ## WITHOUT this, an `ek == 5` fixed-array base fell to the SLICE `.len` path below (a runtime
      ## word read) and returned a garbage element (`[10,20,30].len` → 20 = `a[1]`) — a SILENT WRONG
      ## VALUE (I11). Gated to a fixed array (`ek == 5`, `!is_ref`) via `fixed_arr_len`, so a slice's
      ## `.len` (`is_ref`, a real {ptr,len}) is BYTE-IDENTICAL. Checked FIRST so no later Field path
      ## can mis-read a fixed-array base.
      if str_at((cx.src + fs), fl) == "len" {
        falf := fixed_arr_len(base, cx.slots, cx.src)
        if falf >= 0 {
          push_str(sb, "  movq $")
          push_int(sb, falf)
          push_str(sb, ", %rax\n  pushq %rax\n")
          return
        }
      }
      ## `f(…).len` / `f(…).ptr` — a DIRECT `.len`/`.ptr` on a `Slice(T)`-returning CALL result (not
      ## bound to a local). The call delivers {ptr/%rax, len/%rdx} (the slice-return convention); read
      ## the requested word. Without this a direct `.len` fell to a bogus slot/fold and read 0 (silent).
      ## Gated to `slice_ret_call` — a non-slice call base is untouched → fixpoint-neutral.
      dslf := str_at((cx.src + fs), fl)
      if (dslf == "len" or dslf == "ptr") and slice_ret_call(base, cx.decls, cx.src, a) {
        emit_struct_value(base, sb, cx, a, nl)      ## ptr → %rax, len → %rdx
        if dslf == "len" { push_str(sb, "  pushq %rdx\n") } else { push_str(sb, "  pushq %rax\n") }
        return
      }
      ## `f(…).len` / `f(…).ptr` — the `str` DUAL of the `Slice(T)`-returning-call case just above
      ## (Types §9.4: a `str` IS the same 2-word {ptr, len} pair, delivered in ptr/%rax + len/%rdx by
      ## `emit_struct_value`'s Call arm — exactly what `emit_str_pair`'s `str_ret_call` arm pushes).
      ## WITHOUT this a DIRECT `rd().len` (the result not bound to a local) matched no Field arm and
      ## fell to the slot default, reading a garbage frame word — in practice 0, a SILENT MISCOMPILE
      ## (`s := rd(); s.len` — the bound form — already worked, so the two spellings disagreed).
      ## Gated to `str_ret_call`, checked AFTER `slice_ret_call` so a Slice-returning call keeps its
      ## existing lowering byte-for-byte; a non-str call base is untouched → fixpoint-neutral.
      if (dslf == "len" or dslf == "ptr") and str_ret_call(base, cx.decls, cx.src, deref(cx.mar)) {
        emit_struct_value(base, sb, cx, a, nl)      ## ptr → %rax, len → %rdx
        if dslf == "len" { push_str(sb, "  pushq %rdx\n") } else { push_str(sb, "  pushq %rax\n") }
        return
      }
      ## Types §7 — `.len`/`.ptr` read off a two-word VIEW VALUE with NO frame home: a str LITERAL
      ## (`"hi\n".ptr`), a `sub(…)` / `str_at(…)` / `bytes(…)` view, or a range sub-view
      ## (`s[lo..hi]`, `xs[lo..hi]`). Every one of them matched no arm and fell through to the slot
      ## default, which read a garbage frame word — in practice 0. MEASURED silent wrong values:
      ## `"hi\n".len == 3` was FALSE, `"hi\n".ptr` handed a write syscall a null buffer so it wrote
      ## NOTHING (the shipped workaround was to bind the literal to a local first), `sub(s,0,5).len`,
      ## `s[0..5].len`, `bytes(s).len` and `xs[2..6].len` all answered 0. The dropped fact is the same
      ## one `emit_arg`'s view-materialization arm recovers — the BASE is a view, and `emit_str_pair`
      ## is the one choke point that can build its pair — so read the requested word straight off that
      ## pair. Gated to the homeless view VALUES: a `Var` / FIELD / INDEX base is a PLACE with its own
      ## working arm below and is untouched, so `src/`+`lib/` (which spell `s.len` on locals, fields
      ## and globals) are byte-identical → fixpoint-neutral.
      if (dslf == "len" or dslf == "ptr") and view_pair_base(base, cx) {
        emit_str_pair(base, sb, cx, a, nl)          ## stack: [ptr (deeper), len (top)]
        if dslf == "len" {
          push_str(sb, "  popq %rax\n  popq %rbx\n  pushq %rax\n")
        } else {
          push_str(sb, "  popq %rbx\n")             ## drop the len; the ptr is already the top word
        }
        return
      }
      ## §8 `@packed` — `p.f` where `p` is a `@packed` struct LOCAL (an INLINE struct slot, ek 2): the
      ## field is at its cumulative BYTE offset (no padding), read with a correctly-SIZED load, NOT the
      ## word-sized `field_slot` path below. Gated on `is_packed(p's struct type)`, so an un-attributed
      ## struct never enters here → the whole word-sized read path is byte-identical (fixpoint-neutral).
      ## Checked FIRST (before the const/global/tryable paths): a packed local is a plain `Var` base and
      ## the byte-precise read must win over the generic slot read.
      pkv := var_name_span(base)
      if pkv.n != 0 {
        pke := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, pkv.s, pkv.n)))
        if streq(cx.src, pke.ns, pke.nl, pkv.s, pkv.n) and pke.ek == 2 and not pke.is_ref and is_packed(cx.decls, cx.src, pke.sns, pke.snl) {
          bo := packed_field_byte_offset(cx.decls, cx.src, pke.sns, pke.snl, fs, fl, deref(cx.mar))
          fty := field_type_span(cx.decls, cx.src, pke.sns, pke.snl, fs, fl, deref(cx.mar))
          if bo >= 0 {
            psz := scalar_byte_size(cx.src, fty.s, fty.n)
            psigned := fty.n != 0 and str_at((cx.src + fty.s), 1) == "i"
            peb := packed_field_endian(cx.decls, cx.src, pke.sns, pke.snl, fs, fl)   ## §8 @endian(big)=1
            emit_packed_load(sb, psz, psigned, i64((pke.off + 1) * 8) - bo, peb == 1)
            return
          }
        }
      }
      ## STANDARD BYTE LAYOUT — a direct byte-array field makes the containing ordinary struct
      ## byte-addressed. Scalar neighbours still use their exact standard offset; an aggregate field
      ## value is rejected here because a bare Field expression has no multi-byte value home.
      stdv := var_name_span(base)
      if stdv.n != 0 {
        stde := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, stdv.s, stdv.n)))
        if streq(cx.src, stde.ns, stde.nl, stdv.s, stdv.n) and stde.ek == 2 and not stde.is_ref and std_struct_has_direct_byte_layout(cx.decls, cx.src, stde.sns, stde.snl, deref(cx.mar)) {
          sbo := standard_field_byte_offset(cx.decls, cx.src, stde.sns, stde.snl, fs, fl, deref(cx.mar))
          sfty := field_type_span(cx.decls, cx.src, stde.sns, stde.snl, fs, fl, deref(cx.mar))
          saes := array_elem_span(cx.src, sfty.s, sfty.n)
          smulti := saes.n != 0 or (sfty.n != 0 and (str_at((cx.src + sfty.s), sfty.n) == "str" or struct_decl_of(cx.decls, cx.src, sfty.s, sfty.n) >= 0 or enum_decl_of(cx.decls, cx.src, sfty.s, sfty.n) >= 0))
          if sbo >= 0 {
            if smulti { panic("selfhost: a standard-layout aggregate field read needs a byte-aware aggregate value path; use indexing for byte arrays or bind a supported scalar field") }
            emit_packed_load(sb, scalar_byte_size(cx.src, sfty.s, sfty.n), sfty.n != 0 and str_at((cx.src + sfty.s), 1) == "i", i64((stde.off + 1) * 8) - sbo, false)
            return
          }
        }
      }
      ## STANDARD BYTE LAYOUT — a scalar leaf of a NESTED field path (`o.inner.tail`). The
      ## single-hop arm above is enough for `o.tail`, but its fallback `field_slot` counts the
      ## outer byte array as four words and therefore points at the wrong word for the nested
      ## field. Accumulate the shared byte offsets from the root and use the exact leaf width.
      s3path := standard_field_path(e, cx.slots, cx.decls, cx.src, a)
      if s3path.ok {
        s3arr := array_elem_span(cx.src, s3path.ts, s3path.tl)
        mut s3agg := s3arr.n != 0
        if s3path.tl != 0 and (str_at((cx.src + s3path.ts), s3path.tl) == "str" or struct_decl_of(cx.decls, cx.src, s3path.ts, s3path.tl) >= 0 or enum_decl_of(cx.decls, cx.src, s3path.ts, s3path.tl) >= 0) { s3agg = true }
        if s3agg { panic("selfhost: a standard-layout nested aggregate field value needs its aggregate copy consumer; use a scalar projection or bind the inner value first") }
        emit_packed_load(sb, scalar_byte_size(cx.src, s3path.ts, s3path.tl), s3path.tl != 0 and str_at((cx.src + s3path.ts), 1) == "i", i64((s3path.root + 1) * 8) - s3path.bo, false)
        return
      }
      ## P0-NESTED-DEREF-BITCAST — the same standard byte-layout walk for a pointer root. The existing
      ## `standard_field_path` intentionally starts at an INLINE `Var`, while `resolve_nested_ptr_field`
      ## intentionally composes only word offsets. This bounded path covers `deref(p).inner.b` and the
      ## exact `deref(bitcast(ptr(S), ptr(o))).inner.b`; it is byte-tier-only, so word-tier roots retain
      ## the established resolver and packed roots trap in `bitcast_deref_path`.
      bdpz := unchecked bitcast(ptr(Expr), 0)
      mut bdp := ByteDerefPath(ok = false, p = bdpz, bo = 0, ts = 0, tl = 0)
      ## Keep the existing depth-1 packed pointer readers ahead of this resolver. The new path is
      ## for a NESTED chain only (`deref(...).inner.leaf`), where the old word resolver was the gap.
      bdpbase := field_place_parts(base)
      if unchecked bitcast(usize, bdpbase.base) != 0 { bdp = bitcast_deref_path(e, cx) }
      if bdp.ok {
        if std_idx_leaf_is_agg(cx.decls, cx.src, bdp.ts, bdp.tl) {
          panic("selfhost: a standard-layout nested pointer field aggregate value needs its aggregate copy consumer; use a scalar projection or bind the inner value first")
        }
        emit_gas(bdp.p, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n")
        emit_packed_load_rax(sb, scalar_byte_size(cx.src, bdp.ts, bdp.tl), bdp.tl != 0 and str_at((cx.src + bdp.ts), 1) == "i", bdp.bo, false)
        return
      }
      ## §8 `@packed` AGGREGATE-field READ — `r.agg.sub` (a scalar sub-field of a nested-STRUCT field) or
      ## `r.name.len` / `r.name.ptr` (a `str` field) where `r` is a `@packed` struct LOCAL. The aggregate
      ## was STORED by `emit_packed_assign` at an 8-aligned byte→slot position (word slot `pke.off - bo/8`)
      ## via the word-model emitters, so it is READ the same way: the nested struct's sub-field sits at its
      ## word-model slot within the aggregate; the `str`'s ptr/len at that slot / slot-1. Mirrors the WRITE
      ## side exactly. Gated on the INTERMEDIATE field's struct being `@packed` → an un-attributed nested
      ## read is byte-identical (fixpoint-neutral). An UNALIGNED aggregate offset is not handled here (the
      ## write side already fails loud), so it falls through. Only a SCALAR sub-field / `.len` / `.ptr` is
      ## read; a further-nested aggregate sub-field is deferred.
      pfp := field_place_parts(base)
      if unchecked bitcast(usize, pfp.base) != 0 {
        pbv := field_base_var(pfp.base)
        if pbv.ok {
          pae := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, pbv.s, pbv.n)))
          if streq(cx.src, pae.ns, pae.nl, pbv.s, pbv.n) and pae.ek == 2 and not pae.is_ref and is_packed(cx.decls, cx.src, pae.sns, pae.snl) {
            abo := packed_field_byte_offset(cx.decls, cx.src, pae.sns, pae.snl, pfp.fs, pfp.fl, deref(cx.mar))
            afty := field_type_span(cx.decls, cx.src, pae.sns, pae.snl, pfp.fs, pfp.fl, deref(cx.mar))
            if abo >= 0 and (abo / 8) * 8 == abo {
              aslot := i64(pae.off) - abo / 8
              fnm := str_at((cx.src + fs), fl)
              is_str_agg := afty.n != 0 and str_at((cx.src + afty.s), afty.n) == "str"
              if is_str_agg and fnm == "ptr" {
                push_str(sb, "  movq -")
                push_int(sb, (aslot + 1) * 8)
                push_str(sb, "(%rbp), %rax\n  pushq %rax\n")
                return
              }
              if is_str_agg and fnm == "len" {
                push_str(sb, "  movq -")
                push_int(sb, aslot * 8)
                push_str(sb, "(%rbp), %rax\n  pushq %rax\n")
                return
              }
              ## CLAYOUT packed-nested seam: the intermediate child can itself be @packed. The
              ## word-model fallback below is correct for a plain nested struct because that child
              ## was stored one word per field, but it is SILENTLY WRONG for a packed child: `a : u8`
              ## and `b : u16` live at child byte offsets 0 and 1, not word offsets 0 and 1. Compose
              ## the two packed byte-cursor offsets and use the sized load. Keep this deliberately
              ## scalar-only; packed aggregate children remain a located fence rather than widening
              ## the packed-in-plain or aggregate ABI surfaces.
              if is_packed(cx.decls, cx.src, afty.s, afty.n) {
                pbo := packed_field_byte_offset(cx.decls, cx.src, afty.s, afty.n, fs, fl, deref(cx.mar))
                pfty := field_type_span(cx.decls, cx.src, afty.s, afty.n, fs, fl, deref(cx.mar))
                parr := array_elem_span(cx.src, pfty.s, pfty.n)
                pstr := pfty.n != 0 and str_at((cx.src + pfty.s), pfty.n) == "str"
                if pbo >= 0 and pfty.n != 0 and parr.n == 0 and not pstr and struct_decl_of(cx.decls, cx.src, pfty.s, pfty.n) < 0 and enum_decl_of(cx.decls, cx.src, pfty.s, pfty.n) < 0 {
                  ptotal := abo + pbo
                  psz := scalar_byte_size(cx.src, pfty.s, pfty.n)
                  psigned := str_at((cx.src + pfty.s), 1) == "i"
                  peb := packed_field_endian(cx.decls, cx.src, afty.s, afty.n, fs, fl)
                  emit_packed_load(sb, psz, psigned, i64((pae.off + 1) * 8) - ptotal, peb == 1)
                  return
                }
                panic("selfhost: a scalar projection through a @packed nested child is not lowerable for this field shape; aggregate packed-child reads remain deferred")
              }
              astr_di := struct_decl_of(cx.decls, cx.src, afty.s, afty.n)
              if astr_di >= 0 {
                swoff := field_word_offset(cx.decls, cx.src, afty.s, afty.n, fs, fl, deref(cx.mar))
                if swoff >= 0 {
                  rslot := aslot - swoff
                  push_str(sb, "  movq -")
                  push_int(sb, (rslot + 1) * 8)
                  push_str(sb, "(%rbp), %rax\n  pushq %rax\n")
                  return
                }
              }
            }
          }
        }
      }
      ## §8 a `@packed` struct used as a FIELD of a NON-packed struct — DEFERRED, fail LOUD (spec Types
      ## §8). The outer struct's own layout is the word model (`field_word_offset`), so the packed field
      ## occupies WORD slots; but the nested literal `Big(z = 1, p = Pk(…))` routes through
      ## `emit_struct_assign` → `is_packed` → `emit_packed_assign`, which writes the packed struct
      ## BYTE-precise into the first of those words. Write and read then disagree: `g.p.b` read word
      ## `index(p) + index(b)` while `b` lives at BYTE 1 of word `index(p)` — a SILENT WRONG VALUE (0).
      ## Correct-or-trap: reject rather than emit the word read. (The mirror direction — a plain
      ## struct nested INSIDE a `@packed` struct — is supported by the byte→slot arm just above and is
      ## unaffected.) Gated on the INTERMEDIATE field's type being packed while the base is not →
      ## `src/`+`lib/` declare no packed struct, so this is unreachable there (fixpoint-neutral).
      if unchecked bitcast(usize, pfp.base) != 0 {
        pnb := field_base_var(pfp.base)
        if pnb.ok {
          pne := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, pnb.s, pnb.n)))
          if streq(cx.src, pne.ns, pne.nl, pnb.s, pnb.n) and pne.ek == 2 and not is_packed(cx.decls, cx.src, pne.sns, pne.snl) {
            pnft := field_type_span(cx.decls, cx.src, pne.sns, pne.snl, pfp.fs, pfp.fl, deref(cx.mar))
            if pnft.n != 0 and is_packed(cx.decls, cx.src, pnft.s, pnft.n) { panic("selfhost: a @packed/@offset/@align/@endian struct used as a FIELD of a NON-packed struct is not yet supported (spec Types §8) — the outer struct lays its fields out word-wise while the packed field is stored byte-precise; declare the outer struct @packed too, or hold a ptr to the packed struct") }
          }
        }
      }
      ## `CONST.field` — a field read on a module-level const struct (`ORIGIN.x`): emit the field's
      ## compile-time value inline (there is no runtime storage). Checked first: the base names a
      ## const, not a local slot / tryable receiver.
      csf := const_struct_field(base, fs, fl, cx.decls, cx.src, a)
      if unchecked bitcast(usize, csf) != 0 {
        emit_gas(csf, sb, cx, a, nl)
        return
      }
      ## `GLOBAL.field` — a field read on a MUTABLE struct global (`STATE.x`): load the word at
      ## `LABEL + field_index*8` (ascending `.data` layout). Mirrors `const_struct_field`'s shape —
      ## get the value POINTER via `mut_global_value`, read `struct_lit_info` HERE (outer frame). The
      ## base is a module global, not a local slot, so this precedes the slot / tryable paths.
      gbv := var_name_span(base)
      mut mgv : ptr(Expr) = if gbv.n != 0 { mut_global_value(cx.decls, cx.src, gbv.s, gbv.n) } else { unchecked bitcast(ptr(Expr), 0) }
      if unchecked bitcast(usize, mgv) == 0 and gbv.n != 0 { mgv = const_array_value(cx.decls, cx.src, gbv.s, gbv.n) }
      if unchecked bitcast(usize, mgv) != 0 {
        ## CORRECT-OR-TRAP: a FIELD read of a `mut` global whose initializer is a runtime CALL
        ## returning an AGGREGATE. Nothing runs before `_start`, so the call never happened and the
        ## global's `.data` is ZEROED — every field read below silently returned 0 (or an adjacent
        ## `.data` word) instead of the initializer's value. The global itself stays legal (its zeroed
        ## storage is the shipped global-`Mutex` idiom, which only takes its ADDRESS); it is READING it
        ## as if the initializer had run that is the lie. `mgv` is already resolved here (memoized), and
        ## the predicate short-circuits on any non-`Call` value → no cost on the existing paths.
        if global_init_agg_call(mgv, cx.decls, cx.src, deref(cx.mar)) {
          panic("selfhost: reading a FIELD of a module-level global initialized by a runtime CALL returning an aggregate — the initializer never runs (the global's storage is zeroed), so the field would silently read 0; build the value inside a function instead")
        }
        ## An explicitly typed byte-array global may have a StrLit initializer (`embed(...)`). It is
        ## still an array value, so `.len` is the declared N rather than the str-pair's second word.
        if global_array_byte_eek(cx.decls, cx.src, gbv.s, gbv.n) != 0 and str_at((cx.src + fs), fl) == "len" {
          push_str(sb, "  movq $")
          push_int(sb, i64(global_array_len(cx.decls, cx.src, gbv.s, gbv.n, mgv)))
          push_str(sb, ", %rax\n  pushq %rax\n")
          return
        }
        gefi := enum_lit_full(mgv)
        if gefi.is_e and is_union_decl(cx.decls, cx.src, gefi.es, gefi.el) {
          ## A raw-union global is emitted as payload words at offset zero, not as an enum's
          ## discriminant-plus-payload layout. `field_word_offset` already validates the member and
          ## returns zero for every union arm, so read the overlapping payload directly from `.data`.
          gufi := field_word_offset(cx.decls, cx.src, gefi.es, gefi.el, fs, fl, a)
          if gufi >= 0 {
            push_str(sb, "  movq ")
            emit_global_label(sb, cx.decls, cx.src, gbv.s, gbv.n)
            push_str(sb, "+")
            push_int(sb, gufi * 8)
            push_str(sb, "(%rip), %rax\n  pushq %rax\n")
            return
          }
        }
        gsli := struct_lit_info(mgv)
        if gsli.is_s {
          ## WORD offset (not declaration index): a multi-word field (str = 2, nested struct = its
          ## word count) shifts every later field's `.data` cell, so a scalar field after one must
          ## read its true word offset. Identical to the declaration index for an all-scalar struct.
          gfi := field_word_offset(cx.decls, cx.src, gsli.ss, gsli.sl, fs, fl, a)
          if gfi >= 0 {
            push_str(sb, "  movq ")
            emit_global_label(sb, cx.decls, cx.src, gbv.s, gbv.n)
            push_str(sb, "+")
            push_int(sb, gfi * 8)
            push_str(sb, "(%rip), %rax\n  pushq %rax\n")
            return
          }
        }
      }
      ## `S.len` / `S.ptr` — the len/ptr word of a BARE str MUTABLE GLOBAL (`mut S := "hi"`; the base
      ## `S` is itself a str, NOT a struct field). Its {ptr, len} live in `.data` at `LABEL+0` (word 0 =
      ## ptr) / `LABEL+8` (word 1 = len). Was ABSENT → `S.len` fell through the struct/nested-global
      ## paths (S is not a struct) to the slot default and read a garbage frame word (`-16(%rbp)` → 0).
      if unchecked bitcast(usize, mgv) != 0 and str_lit_info(mgv).is_s {
        sfnm := str_at((cx.src + fs), fl)
        if sfnm == "len" or sfnm == "ptr" {
          mut ssub := 0
          if sfnm == "len" { ssub = 1 }
          push_str(sb, "  movq ")
          emit_global_label(sb, cx.decls, cx.src, gbv.s, gbv.n)
          push_str(sb, "+")
          push_int(sb, i64(ssub) * 8)
          push_str(sb, "(%rip), %rax\n  pushq %rax\n")
          return
        }
      }
      ## `GLOBAL.f1.f2…` — a SCALAR field of a nested struct field of a mutable-global struct, at ANY
      ## depth (`STATE.a.b.c`): `global_place` resolves the cumulative `.data` word offset through the
      ## whole chain; a scalar final field is a single-word read at `LABEL + off*8`. (1-level `STATE.f`
      ## returned above; an aggregate final field needs multi-word delivery — deferred — so it falls
      ## through unhandled rather than mis-reading one word.)
      ngp := global_place(e, cx, a)
      if ngp.found and global_place_scalar(ngp.ts, ngp.tl, cx) {
        push_str(sb, "  movq ")
        emit_global_label(sb, cx.decls, cx.src, ngp.gs, ngp.gn)
        push_str(sb, "+")
        push_int(sb, ngp.off * 8)
        push_str(sb, "(%rip), %rax\n  pushq %rax\n")
        return
      }
      ## `GLOBAL.….name.ptr` / `.len` — `.ptr`/`.len` on a str FIELD of a (possibly nested) struct field
      ## of a mutable-global struct, at ANY depth. `global_place(base)` resolves the str field's `.data`
      ## place; its {ptr, len} live at `LABEL + off*8` and the next word (sub 0 = ptr, 1 = len).
      gfnm := str_at((cx.src + fs), fl)
      if gfnm == "ptr" or gfnm == "len" {
        sgp := global_place(base, cx, a)
        if sgp.found and sgp.tl != 0 and str_at((cx.src + sgp.ts), sgp.tl) == "str" {
          mut gsub := 0
          if gfnm == "len" { gsub = 1 }
          push_str(sb, "  movq ")
          emit_global_label(sb, cx.decls, cx.src, sgp.gs, sgp.gn)
          push_str(sb, "+")
          push_int(sb, (sgp.off + i64(gsub)) * 8)
          push_str(sb, "(%rip), %rax\n  pushq %rax\n")
          return
        }
      }
      ## `ARR[i].field` — a field read on an element of a MUTABLE STRUCT-array global. Element i's fields
      ## sit ASCENDING in `.data` at `LABEL + i*stride*8 + fieldidx*8`; compute that address and load.
      ## (`Field(Index(...))`; the base is an `Index`, not a `Var`, so it precedes the tryable/slot paths.)
      fbi := field_base_index(base)
      if fbi.is_ix {
        ivn := var_name_span(fbi.arr)
        igmv := if ivn.n != 0 { mut_global_value(cx.decls, cx.src, ivn.s, ivn.n) } else { unchecked bitcast(ptr(Expr), 0) }
        if unchecked bitcast(usize, igmv) != 0 and array_lit_info(igmv).is_a {
          iesli := struct_lit_info(arg_expr_at(array_lit_info(igmv).ehead, 0, a))
          if iesli.is_s {
            istride := struct_words(cx.decls, cx.src, iesli.ss, iesli.sl, a)
            ifi := struct_field_index(cx.decls, cx.src, iesli.ss, iesli.sl, fs, fl, a)
            if ifi >= 0 {
              emit_gas(fbi.idx, sb, cx, a, nl)              ## element index → stack
              push_str(sb, "  leaq ")
              emit_global_label(sb, cx.decls, cx.src, ivn.s, ivn.n)
              push_str(sb, "(%rip), %rax\n  popq %rcx\n")
              ## CHECKED BOUNDS (I11 §358): a mutable-global STRUCT array has a static element count too
              ## (`array_lit_info(...).nel`) — trap an out-of-range index before scaling, like the scalar
              ## global path. Was missing → `TAB[i].field` read out of bounds silently. `jb` skips on
              ## `idx < N`. Dropped under `unchecked` (cx.vchk false).
              if cx.vchk { push_str(sb, "  cmpq $"); push_int(sb, i64(array_lit_info(igmv).nel)); push_str(sb, ", %rcx\n  jb 1f\n  ud2\n1:\n") }
              push_str(sb, "  imulq $")
              push_int(sb, i64(istride * 8))
              push_str(sb, ", %rcx\n  addq %rcx, %rax\n  movq ")
              push_int(sb, ifi * 8)
              push_str(sb, "(%rax), %rax\n  pushq %rax\n")
              return
            }
          }
        }
      }
      ## `<tryable>.field` — `recv?.f` (Try) or `recv.expect(msg).f`, where `recv` is a call returning
      ## `Result(Payload, E)` / `Option(Payload)` and `f` is a field of the Ok-Payload STRUCT at WORD
      ## OFFSET 0 (`allocate(…)?.idx` / `allocate(…).expect(m).idx` — Payload = `Handle{idx}`). The
      ## generic-`T`-returning `expect`/`?` couldn't be typed to resolve `.idx` (blocker B); here we
      ## unwrap inline like `Try`: `emit_enum_value(recv)` leaves disc/%rax + payload[0]/%rdx, then a
      ## disc check (Ok = 0) — on failure `?` returns the whole enum from the enclosing fn, `expect`
      ## writes `msg` + `exit(1)` (the `panic` sequence); on success the field IS payload[0] (%rdx)
      ## since it is at offset 0. (Offset > 0 needs payload words past %rdx — not delivered here — so
      ## this fires ONLY for an offset-0 field; anything else falls through.)
      tbf := tryable_field_recv(base, cx.src, a)
      if tbf.kind != 0 {
        rty := call_ret_ty_span(tbf.recv, cx.decls, cx.src, deref(cx.mar))
        if rty.n != 0 {
          rhead := base_type_name(cx.src, rty.s, rty.n)         ## "Result" / "Option"
          pl := typearg_at(cx.src, rhead.s, rhead.n, 0)          ## the Ok-payload type span
          pbase := base_type_name(cx.src, pl.s, pl.n)            ## payload struct base name (strip generic args)
          foff := field_word_offset(cx.decls, cx.src, pbase.s, pbase.n, fs, fl, a)
          if foff == 0 {
            emit_enum_value(tbf.recv, sb, cx, a, nl)             ## disc → %rax, payload[0] → %rdx
            lok := nl
            nl += 1
            push_str(sb, "  cmpq $0, %rax\n  je ")
            emit_label(sb, lok)
            push_str(sb, "\n")
            if tbf.kind == 1 {
              push_str(sb, "  jmp ")
              emit_label(sb, cx.epi)
              push_str(sb, "\n")
            } else {
              emit_str_pair(tbf.msg, sb, cx, a, nl)              ## msg {ptr,len} → stack
              push_str(sb, "  popq %rdx\n  popq %rsi\n  movq $2, %rdi\n  movq $1, %rax\n  syscall\n")
              push_str(sb, "  movq $1, %rdi\n  movq $60, %rax\n  syscall\n")
            }
            emit_label(sb, lok)
            push_str(sb, ":\n  pushq %rdx\n")
            return
          }
        }
      }
      ## `<str>.len` / `<str>.ptr` — the str's `{ptr, len}` fields (str is `{ptr,len}`, Type
      ## System §7; the spec accessor `byte_len` returns `s.len`). A str LOCAL (ek 4) keeps ptr at
      ## slot `off`, len at slot `off+1`; a by-ref str PARAM keeps a pointer in its slot (ptr at
      ## `(%rax)`, len at `-8(%rax)`). `var_name_span` isolates the deref-match (no nested match).
      sfv := var_name_span(base)
      mut sf := 0                       ## 0 not a str field, 1 .ptr, 2 .len
      mut sfoff := 0
      mut sfref := false
      if sfv.n != 0 {
        se := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, sfv.s, sfv.n)))
        ## `.ptr`/`.len` on a str LOCAL/PARAM (ek 4) OR a SLICE param (`buf : [u8]`, ek 5 by-ref):
        ## the lean parser binds a slice `[T]` and an array `[T; N]` identically (ek 5), but a
        ## `.ptr`/`.len` field access is legal ONLY on a slice ({ptr, len}) — an array is indexed —
        ## so an ek-5 base reaching this arm is a slice, read via the same by-ref {ptr, len} layout
        ## as a str (ptr at `(%rax)`, len at `-8(%rax)`). Fixes `write_fd(buf : [u8])`'s
        ## `buf.ptr`/`buf.len` (was the generic-field path → offset -1 → a malformed `--8(%rax)`).
        if se.ek == 4 or se.ek == 5 {
          fnm := str_at((cx.src + fs), fl)
          if fnm == "ptr" { sf = 1 } else if fnm == "len" { sf = 2 }
          sfoff = se.off
          sfref = se.is_ref
          ## a TYPED ARRAY-SLICE local (§4, snl == 1, `sns == 0`) stores its {data ptr, len} DIRECTLY in
          ## its two words — read them directly. A slice PARAM (`sns == 1`) instead holds a POINTER to the
          ## caller's {ptr,len} block, so it KEEPS `sfref` (the double-deref below) — without the `sns == 0`
          ## guard, `s.len` (field) on a slice param read the raw slot word (a garbage local), the field
          ## dual of the working `s.len()` method. (A struct/enum-element slice has `snl` = a type span.)
          ## A POINTER-element slice VIEW (`eek == 7`, a `[ptr(mut b0), …]` slice) ALSO stores {data ptr,
          ## len} directly in its two words (`emit_array_slice_assign` is eek-agnostic), but carries the
          ## POINTEE struct span in `sns`/`snl` (not the `snl == 1` marker) so `deref(s[i]).field` resolves
          ## — so its `.len`/`.ptr` must ALSO take the direct two-word read, else the by-ref double-deref
          ## below read `8(data_ptr)` (a frame word past the data) = garbage (a constant 48).
          if se.ek == 5 and se.is_ref and ((se.snl == 1 and se.sns == 0) or se.eek == 7) { sfref = false }
          ## A STRUCT/ENUM-element slice LOCAL (`s := arr[lo..hi]` over `[Pt; N]`, eek 2/3) ALSO stores
          ## {data ptr, len} DIRECTLY in its two words — but it carries the element TYPE span in
          ## `sns`/`snl` (so `s[i].field` resolves), so it matches neither marker above and fell to the
          ## by-ref double-deref: `s.len` read `8(data_ptr)` = the first element's SECOND word (a silent
          ## WRONG length — 2 for a `[Pt; 3]` slice of 3). A slice/array PARAM keeps the double-deref, and
          ## is told apart by its `name : T` ANNOTATION (the slot entry alone cannot distinguish them).
          if se.ek == 5 and se.is_ref and (se.eek == 2 or se.eek == 3) and slot_name_is_annotated(cx.src, se.ns, se.nl) == false { sfref = false }
        }
      }
      ## `g.name.ptr` / `g.name.len` — `.ptr`/`.len` on a str FIELD of a struct (base is `g.name`, a
      ## Field, not a Var, so `sfv` above was empty). An INLINE struct local reuses the non-ref str slot
      ## math (ptr at `off+1`, len at `off+2`). A BY-REFERENCE struct param needs a pointer-relative read
      ## (below), so it is emitted directly here and skips the shared `sf != 0` block.
      if sf == 0 {
        sfp := str_field_place(base, cx, a)
        if sfp.found {
          fnm2 := str_at((cx.src + fs), fl)
          if sfp.is_ref {
            ## load the caller's word-0 pointer, then the str field's ptr/len at the down-growing
            ## pointee offset (`-(fldoff*8)`/`-((fldoff+1)*8)(%rax)`, matching the by-ref field read).
            push_str(sb, "  movq -")
            push_int(sb, i64((sfp.off + 1) * 8))
            push_str(sb, "(%rbp), %rax\n")
            mut rsub := sfp.fldoff
            if fnm2 == "len" { rsub = sfp.fldoff + 1 }
            push_str(sb, "  movq ")
            push_int(sb, i64(rsub * 8))
            push_str(sb, "(%rax), %rax\n  pushq %rax\n")
            return
          }
          if fnm2 == "ptr" { sf = 1 } else if fnm2 == "len" { sf = 2 }
          sfoff = sfp.off
          sfref = false
        }
      }
      ## `xs[i].ptr` / `xs[i].len` — `.ptr`/`.len` on an indexed str-ELEMENT array element (base is
      ## `Index(xs, i)`, xs eek 4 / estride 2). `emit_index_addr` gives element i's word-0 (ptr) address
      ## stride-aware; the len is one word past it (`-8(%rax)`, the down-growing element layout).
      if sf == 0 {
        sfibx := field_base_index(base)
        if sfibx.is_ix {
          sfient := deref(svec_at(SlotEntry, cx.slots, index_base_entry(sfibx.arr, cx.slots, cx.src)))
          if sfient.eek == 4 {
            fnm3 := str_at((cx.src + fs), fl)
            if fnm3 == "ptr" or fnm3 == "len" {
              emit_index_addr(sfibx.arr, sfibx.idx, sb, cx, a, nl)   ## element ptr addr → %rax
              if fnm3 == "ptr" { push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n") }
              else { push_str(sb, "  movq 8(%rax), %rax\n  pushq %rax\n") }
              return
            }
          }
        }
      }
      ## `xs[i].key.ptr` / `xs[i].key.len` — `.ptr`/`.len` on a str FIELD of an ARRAY-of-STRUCT element
      ## (base is `xs[i].key`). The str's {ptr, len} sit at the element field address and the next word
      ## down (`-8(%rax)`), matching the value read (`str_field_arr_elem` in `emit_str_pair`).
      if sf == 0 {
        sae2 := str_field_arr_elem(base, cx, deref(cx.mar))
        if sae2.found {
          fnm4 := str_at((cx.src + fs), fl)
          if fnm4 == "ptr" or fnm4 == "len" {
            emit_idx_field_addr(sae2.arr, sae2.idx, sae2.woff * 8, sb, cx, nl)   ## str field addr → %rax
            if fnm4 == "ptr" { push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n") }
            else { push_str(sb, "  movq 8(%rax), %rax\n  pushq %rax\n") }
            return
          }
        }
      }
      if sf != 0 {
        if sfref {
          push_str(sb, "  movq -")
          push_int(sb, i64((sfoff + 1) * 8))
          push_str(sb, "(%rbp), %rax\n")
          if sf == 1 { push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n") } else { push_str(sb, "  movq 8(%rax), %rax\n  pushq %rax\n") }
        } else {
          mut w := sfoff + 1              ## §4 UP: ptr word 0 at slot sfoff (byte (sfoff+1)*8)
          if sf == 2 { w = sfoff }         ## len word 1 at slot sfoff-1 (byte sfoff*8)
          push_str(sb, "  movq -")
          push_int(sb, i64(w * 8))
          push_str(sb, "(%rbp), %rax\n  pushq %rax\n")
        }
        return
      }
      ## CLAYOUT S3(d) — a SCALAR leaf of a BYTE-TIER ARRAY ELEMENT (`xs[i].f`, `xs[i].inner.b`, any
      ## depth). Claimed FIRST, and it has to be first for a mechanical reason as well as a semantic
      ## one: `ddif` below is bound EAGERLY, and `resolve_idx_field_place`'s byte-tier fence would fire
      ## before any later arm could look. The element address comes from `emit_index_addr` (Types §6.4's
      ## byte stride via `slot_elem_stride_bytes`) and the leaf offset from `std_idx_path` (§6.1 bytes
      ## per hop, `layout_field_offset_bytes` — the same query `standard_field_path` uses for a `Var`
      ## root), so the place read here is exactly the place the ONE byte-precise writer wrote. The load
      ## is SIZED to the leaf's own width and sign-extended for an `iN`: reading a `u16` leaf with a
      ## `movq` would drag in its three neighbours.
      s3dr := std_idx_path(e, cx.slots, cx.decls, cx.src, a)
      if s3dr.ok {
        if std_idx_leaf_is_agg(cx.decls, cx.src, s3dr.ts, s3dr.tl) {
          panic("selfhost: reading a whole AGGREGATE field of a byte-layout array element as a value (`xs[i].inner` / `xs[i].data` where the field is a struct, str, enum or array) has no value home in this slice — index a byte array element (`xs[i].data[j]`), read a scalar leaf, or bind the whole element to a local first (`e := xs[i]`)")
        }
        emit_index_addr(s3dr.arr, s3dr.idx, sb, cx, a, nl)
        emit_packed_load_rax(sb, scalar_byte_size(cx.src, s3dr.ts, s3dr.tl), s3dr.tl != 0 and str_at((cx.src + s3dr.ts), 1) == "i", s3dr.bo, false)
        return
      }
      dsb := deref_struct_span(base, cx.slots, cx.src)
      fbi := field_base_index(base)
      ## `arr[i].agg.leaf` — element → struct field → scalar leaf (Types §9.4). Resolved EAGERLY: the
      ## resolver returns found=false for any base that is not `Field(Index(...), agg)` (no spurious panic),
      ## and a deep shape never matches the deref-span arms below (base is a `Field`, not a `Deref`).
      ddif := resolve_deep_idx_field(base, fs, fl, cx)
      dcf := deref_call_struct_span(base, cx.decls, cx.src, a)
      dfps := deref_field_ptrstruct_span(base, cx.slots, cx.decls, cx.src, deref(cx.mar))
      dix := deref_index_ptrstruct_span(base, cx.slots, cx.src)
      dddx := deref_deref_struct_span(base, cx.slots, cx.src)
      ## GENERIC `deref(s[i]).f` over a `Slice(ptr(mut T))` PARAM — the pointee `T` is erased in the
      ## param's source text (no per-instance mono binding here), so fail LOUD rather than emit a wrong
      ## `pushq $0` (never a silent miscompile). The concrete `[ptr(mut b0), …]` case (eek 7 → `dix`) is
      ## handled below and never reaches this guard.
      if dix.n == 0 and deref_index_ptr_param_unresolved(base, cx.slots, cx.src) { panic("selfhost: inline `deref(s[i]).field` over a generic `Slice(ptr(mut T))` PARAM is not yet supported (the pointee type is erased in the param — pass the element pointer across a call and deref in the callee, or use a concrete-typed slice)") }
      if dddx.n != 0 {
        ## `deref(deref(pp)).f` — a field read through a POINTER-TO-POINTER-to-struct (depth-2 nested
        ## deref). `deref_inner_expr(base)` = the inner `deref(pp)`, whose ordinary nested-Deref VALUE
        ## emit yields the `&Struct` pointer; pop it, load the field at `fi*8(%rax)` (ascending pointee
        ## layout, the same as the ek-7 `deref(p).f` read). Was previously unhandled → `field_slot`
        ## returned -1 → a `pushq $0` SILENT MISCOMPILE.
        dddinner := deref_inner_expr(base)
        fi := field_word_offset(cx.decls, cx.src, dddx.s, dddx.n, fs, fl, deref(cx.mar))
        emit_gas(dddinner, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movq ")
        push_int(sb, fi * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else if dsb.n != 0 {
        ## `deref(p).f` — a field THROUGH a pointer-to-struct (ek 7): load p's value (the pointee
        ## word-0 address), then load the field at `fi*8(%rax)` (ascending pointee layout).
        pv := deref_var_span(base)
        pent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, pv.s, pv.n)))
        ## §8 pointer-to-@packed (ek 7 MMIO map): if the pointee struct is `@packed`, read the field at
        ## its PACKED byte offset with a correctly-SIZED load (movzbl/movzwl/movl), NOT the word offset —
        ## the MMIO / register-map pattern. Gated on `is_packed(pointee)` + a SCALAR field (not str/struct/
        ## enum), so a non-packed pointee (the whole existing corpus) keeps the word `movq` → byte-identical.
        ppk := is_packed(cx.decls, cx.src, dsb.s, dsb.n)
        mut pdbo := i64(-1)
        mut pdfty := CSpan(s = 0, n = 0)
        if ppk {
          pdbo = packed_field_byte_offset(cx.decls, cx.src, dsb.s, dsb.n, fs, fl, deref(cx.mar))
          pdfty = field_type_span(cx.decls, cx.src, dsb.s, dsb.n, fs, fl, deref(cx.mar))
        }
        pstd := std_struct_has_direct_byte_layout(cx.decls, cx.src, dsb.s, dsb.n, deref(cx.mar))
        if pstd {
          pdbo = standard_field_byte_offset(cx.decls, cx.src, dsb.s, dsb.n, fs, fl, deref(cx.mar))
          pdfty = field_type_span(cx.decls, cx.src, dsb.s, dsb.n, fs, fl, deref(cx.mar))
        }
        pdaes := array_elem_span(cx.src, pdfty.s, pdfty.n)
        pd_agg := pdaes.n != 0 or (pdfty.n != 0 and (str_at((cx.src + pdfty.s), pdfty.n) == "str" or struct_decl_of(cx.decls, cx.src, pdfty.s, pdfty.n) >= 0 or enum_decl_of(cx.decls, cx.src, pdfty.s, pdfty.n) >= 0))
        if ppk and pdbo >= 0 and not pd_agg {
          push_str(sb, "  movq -")
          push_int(sb, i64((pent.off + 1) * 8))
          push_str(sb, "(%rbp), %rax\n")
          emit_packed_load_rax(sb, scalar_byte_size(cx.src, pdfty.s, pdfty.n), pdfty.n != 0 and str_at((cx.src + pdfty.s), 1) == "i", pdbo, packed_field_endian(cx.decls, cx.src, dsb.s, dsb.n, fs, fl) == 1)
          return
        }
        if pstd and pdbo >= 0 and not pd_agg {
          push_str(sb, "  movq -")
          push_int(sb, i64((pent.off + 1) * 8))
          push_str(sb, "(%rbp), %rax\n")
          emit_packed_load_rax(sb, scalar_byte_size(cx.src, pdfty.s, pdfty.n), pdfty.n != 0 and str_at((cx.src + pdfty.s), 1) == "i", pdbo, false)
          return
        }
        if pstd { panic("selfhost: a standard-layout aggregate field read through deref needs a byte-aware aggregate value path; use indexing for byte arrays or bind a supported scalar field") }
        fi := field_word_offset(cx.decls, cx.src, dsb.s, dsb.n, fs, fl, deref(cx.mar))
        push_str(sb, "  movq -")
        push_int(sb, i64((pent.off + 1) * 8))
        push_str(sb, "(%rbp), %rax\n  movq ")
        push_int(sb, fi * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else if dcf.n != 0 {
        ## `deref(<call: node_ptr/decl_at/get(S, …)>).f` — a field read INLINE off a deref of a
        ## CALL that returns a pointer-to-struct, with no intermediate `x := deref(…)` binding.
        ## Lower the call (its result is the pointee word-0 address), pop it into %rax, then load the
        ## field at `-(fi*8)(%rax)` (the down-growing pointee layout, the same as the ek-7 `deref(p).f`
        ## read and the deref-COPY in `collect_slots`). Removes the "bind the deref to a local first"
        ## discipline for the node_ptr/decl_at accessors (the per-module typed AST readers).
        dcall := deref_inner_expr(base)
        fi := field_word_offset(cx.decls, cx.src, dcf.s, dcf.n, fs, fl, deref(cx.mar))
        emit_gas(dcall, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movq ")
        push_int(sb, fi * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else if dfps.n != 0 {
        ## `deref(o.p).f` — a field read INLINE off a deref of a POINTER-TYPED struct FIELD (`o.p` a
        ## `ptr(Struct)` field), with no intermediate `n := o.p` binding. Evaluate `o.p` (the field's
        ## pointer value) → %rax, then load the pointee's field at `fi*8(%rax)` (the same ascending
        ## pointee layout as the ek-7 `deref(p).f` and `deref(<call>).f` reads). Removes the
        ## "bind the field to a local first" discipline for the idiomatic linked-list / tree walk
        ## spelled inline (`deref(node.next).val`).
        dfinner := deref_inner_expr(base)
        fi := field_word_offset(cx.decls, cx.src, dfps.s, dfps.n, fs, fl, deref(cx.mar))
        emit_gas(dfinner, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movq ")
        push_int(sb, fi * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else if dix.n != 0 {
        ## `deref(s[i]).f` — a field read INLINE through a POINTER element of a slice/array (`eek == 7`,
        ## bound from a `[ptr(mut b0), …]` literal). Emit the scalar `s[i]` read (the element POINTER
        ## value → stack), pop it into %rax, then load the pointee's field at `fi*8(%rax)` (the same
        ## ascending pointee layout as the ek-7 `deref(p).f` / `deref(o.p).f` reads — matching the
        ## proven across-a-call path). The pointee type comes from the slice slot's eek-7 span
        ## (`deref_index_ptrstruct_span`). Was previously unhandled → `field_slot` returned -1 → a
        ## `pushq $0` SILENT MISCOMPILE (the field read 0 / segfaulted when that 0 was dereffed).
        dixinner := deref_inner_expr(base)                 ## the Index `s[i]`
        fi := field_word_offset(cx.decls, cx.src, dix.s, dix.n, fs, fl, deref(cx.mar))
        emit_gas(dixinner, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movq ")
        push_int(sb, fi * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else if fbi.is_ix {
        ## `a[i].f` — array-of-struct element field read: compute the field address, load it.
        ffoff := idx_field_index(fbi.arr, fbi.idx, fs, fl, cx) * 8
        emit_idx_field_addr(fbi.arr, fbi.idx, ffoff, sb, cx, nl)
        push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n")
      } else if ddif.found {
        ## `arr[i].agg.leaf` — array element → struct field → scalar leaf: element base + COMBINED field
        ## offset → %rax, load the leaf word. The deeper read dual of the one-level `a[i].f` above (Types
        ## §9.4). Was previously unhandled → the `pushq $0` default, a SILENT 0 (the read of a written leaf
        ## returned 0). A non-scalar/unresolvable deep path already failed loud in `resolve_deep_idx_field`.
        emit_idx_field_addr(ddif.arr, ddif.idx, ddif.woff * 8, sb, cx, nl)
        push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n")
      } else if call_ptrstruct_field_span(base, cx.decls, cx.src, deref(cx.mar)).n != 0 {
        ## `<call>.field` — a field read DIRECTLY off a POINTER-returning call's result (the call
        ## returns `ptr(<opt mut> Struct)`, e.g. `get(S, ar, h).b` / a `node_ptr(T, …).f`), with no
        ## intermediate `p := f(…); deref(p).f` binding. WITHOUT this the base (a Call whose result is a
        ## POINTER, not a struct by value) fell through every place/deref arm to the `field_slot`
        ## default `pushq $0` — a SILENT MISCOMPILE (the field read 0/stale; it silently zeroed the DA
        ## header words `da_fvec_value(x).len`, worked around in sema by capturing the pointer first).
        ## Lower the call — its result IS the pointee word-0 address — pop it into %rax, then load the
        ## field at `fi*8(%rax)` (ASCENDING pointee layout, identical to the `deref(p).f` `dsb` read and
        ## the `deref(<call>).f` `dcf` read, so the direct form matches the proven two-step form). A
        ## MULTI-WORD field (str / struct / enum) has no single-register home here → fail LOUD (bind the
        ## pointer to a local first), never emit a truncating one-word read.
        pcsp := call_ptrstruct_field_span(base, cx.decls, cx.src, deref(cx.mar))
        pcfty := field_type_span(cx.decls, cx.src, pcsp.s, pcsp.n, fs, fl, deref(cx.mar))
        if pcfty.n != 0 and (str_at((cx.src + pcfty.s), pcfty.n) == "str" or struct_decl_of(cx.decls, cx.src, pcfty.s, pcfty.n) >= 0 or enum_decl_of(cx.decls, cx.src, pcfty.s, pcfty.n) >= 0) { panic("selfhost: a MULTI-WORD field read directly off a pointer-returning call is not lowered (bind the pointer to a local first: `p := f(...); deref(p).field`)") }
        fi := field_word_offset(cx.decls, cx.src, pcsp.s, pcsp.n, fs, fl, deref(cx.mar))
        if fi < 0 { panic("selfhost: field read off a pointer-returning call names a field the pointee struct does not declare") }
        emit_gas(base, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movq ")
        push_int(sb, fi * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else if struct_ret_call(base, cx.decls, cx.src, deref(cx.mar)) {
        ## `<call>.field` — a field read DIRECTLY off a struct-returning call's result (e.g.
        ## `cur(pc).kind`, with no intermediate `t := cur(pc)` binding). Emit the call —
        ## `emit_struct_value`'s Call arm leaves the returned struct's words in %rax (word 0) /
        ## %rdx (word 1) / %rcx (word 2) — then select the field's word into %rax and push it.
        ## Without this the base (a Call, not a Var/place) fell through to the `pushq $0` default,
        ## so `cur(pc).kind` read 0 and the parser's top-level `while cur(pc).kind != 0` loop never
        ## ran (Stage2 parsed zero decls — the self-host fixpoint "emits only the wrapper" bug).
        csp := call_ret_struct_span(base, cx.decls, cx.src, deref(cx.mar))
        fi := field_word_offset(cx.decls, cx.src, csp.s, csp.n, fs, fl, deref(cx.mar))
        emit_struct_value(base, sb, cx, a, nl)
        ## the returned struct's field k is in emit_retreg(k); move the selected field's reg → %rax
        if fi > 0 {
          push_str(sb, "  movq ")
          emit_retreg(sb, usize(fi))
          push_str(sb, ", %rax\n")
        }
        push_str(sb, "  pushq %rax\n")
      } else if call_chain_place(base, cx.decls, cx.src, deref(cx.mar)).found {
        ## `<call>.f1…leaf` — a SCALAR-leaf field PROJECTION off a struct-returning call's result, either
        ## a CHAINED field off a concrete by-value struct call (`mk().b.c`, base a `Field` so the
        ## single-`<call>.field` arm above doesn't match) or a field off a GENERIC `id(T,v)->T` call
        ## (`id(P,…).b`, which `struct_ret_call` reports false for → the arm above is skipped). Both fell
        ## to the `field_slot` default `pushq $0` — a SILENT 0 (the read of a real value returned 0 /
        ## segfaulted). `call_chain_place` walks the `Field` chain to the root call, resolves its returned
        ## struct span (concrete or the generic type-arg shape, the SAME resolver the working binding path
        ## `r := id(P,…); r.b` uses), and accumulates the intermediate word offsets. Here we add the LEAF
        ## field's offset, materialize the call's struct into the %rax:%rdx:… return registers via
        ## `emit_struct_value`, and select the leaf word into %rax. A MULTI-WORD (str/struct/enum) leaf has
        ## no single-register home → fail LOUD (bind the call result to a local first), never a truncating
        ## one-word read.
        ccp := call_chain_place(base, cx.decls, cx.src, deref(cx.mar))
        clft := field_type_span(cx.decls, cx.src, ccp.tys, ccp.tyn, fs, fl, deref(cx.mar))
        if clft.n == 0 { panic("selfhost: field read off a struct-returning call names a field the returned struct does not declare") }
        if str_at((cx.src + clft.s), clft.n) == "str" or struct_decl_of(cx.decls, cx.src, clft.s, clft.n) >= 0 or enum_decl_of(cx.decls, cx.src, clft.s, clft.n) >= 0 { panic("selfhost: a MULTI-WORD (str/struct/enum) field read off a struct-returning call is not lowered (bind the call result to a local first, then read the field)") }
        clwleaf := field_word_offset(cx.decls, cx.src, ccp.tys, ccp.tyn, fs, fl, deref(cx.mar))
        if clwleaf < 0 { panic("selfhost: field read off a struct-returning call — leaf field not resolvable in the returned struct type") }
        clwoff := ccp.woff + i64(clwleaf)
        if clwoff > 6 { panic("selfhost: field read off a struct-returning call selects a word past the register-return window (>7-word struct); bind the call result to a local first") }
        emit_struct_value(ccp.root, sb, cx, a, nl)
        if clwoff > 0 {
          push_str(sb, "  movq ")
          emit_retreg(sb, usize(clwoff))
          push_str(sb, ", %rax\n")
        }
        push_str(sb, "  pushq %rax\n")
      } else if struct_lit_info(base).is_s {
        ## `S(…).field` — a field read DIRECTLY off a struct LITERAL (no `t := S(…)` binding). A SCALAR
        ## field emits the literal's initializer value for that field; a MULTI-WORD field (str / enum /
        ## nested struct) has no bare-expression home → fail loud (bind the literal to a local first).
        ## Was unhandled → the `field_slot` default `pushq $0` (a silent 0). Also the per-branch target
        ## of the `(if …).field` rewrite below when a branch is a struct literal.
        slli := struct_lit_info(base)
        slfx := struct_field_index(cx.decls, cx.src, slli.ss, slli.sl, fs, fl, deref(cx.mar))
        if slfx < 0 { panic("selfhost: field read off a struct literal names a field the struct does not declare") }
        slft := field_type_span(cx.decls, cx.src, slli.ss, slli.sl, fs, fl, deref(cx.mar))
        mut sl_multi := false
        if slft.n != 0 {
          if str_at((cx.src + slft.s), slft.n) == "str" { sl_multi = true }
          if struct_decl_of(cx.decls, cx.src, slft.s, slft.n) >= 0 { sl_multi = true }
          if enum_decl_of(cx.decls, cx.src, slft.s, slft.n) >= 0 { sl_multi = true }
        }
        if sl_multi { panic("selfhost: a MULTI-WORD field read directly off a struct LITERAL is not lowered (bind the literal to a local first, then read the field)") }
        emit_gas(arg_expr_at(struct_lit_fields(base), usize(slfx), a), sb, cx, a, nl)
      } else if if_info(base).is_if and match_if_agg_kind(base, cx.decls, cx.src, deref(cx.mar)).kind == 2 {
        ## `(if c { … } else { … }).field` — a field read DIRECTLY off a struct-valued if-EXPRESSION,
        ## with no intermediate `x := if … ; x.field` binding. REWRITE to `if c { <t>.field } else
        ## { <e>.field }` (push the field access INTO each branch) and emit that now-SCALAR if: each
        ## branch's field read rides the working `<call>.field` / struct-literal-field path above, and
        ## the scalar Expr::If arm converges the selected word. Was unhandled → the `field_slot` default
        ## `pushq $0` — a §Priority-1 silent 0 for `return (if …).v`.
        bif := if_info(base)
        btf := node_ptr(Expr, deref(cx.mar), mk_expr(deref(cx.mar), Expr.Field(bif.then_e, fs, fl)))
        bef := node_ptr(Expr, deref(cx.mar), mk_expr(deref(cx.mar), Expr.Field(bif.else_e, fs, fl)))
        bnif := node_ptr(Expr, deref(cx.mar), mk_expr(deref(cx.mar), Expr.If(bif.cond, btf, bef)))
        emit_gas(bnif, sb, cx, a, nl)
      } else if match_info(base).is_m and match_if_agg_kind(base, cx.decls, cx.src, deref(cx.mar)).kind == 2 {
        ## `(match scrut { … => { <agg> } }).field` — a field read DIRECTLY off a struct-valued
        ## MATCH-EXPRESSION, with no intermediate `x := match … ; x.field` binding. REWRITE to
        ## `match scrut { … => { <arm>.field } }` (push the field access INTO each arm body) and emit
        ## that now-SCALAR match: each arm's field read rides the working `<call>.field` /
        ## struct-literal-field path above, and the scalar/enum match path (`emit_gas(am.body)`)
        ## converges the selected word. Was unhandled → the `field_slot` default `pushq $0` — a
        ## §Priority-1 silent 0 for `return (match …).v`. The If-EXPRESSION dual is just above.
        bmi := match_info(base)
        mut mnh := 0
        mut mnt := 0
        mut marm := bmi.head
        while marm != 0 {
          mam := deref(arm_p(marm))
          ## a value-match EXPRESSION carries each arm's value in `body`; a null `body` is a STATEMENT-list
          ## arm (`body_stmts`), which has no bare-expression field home → fail loud (never a silent 0).
          if unchecked bitcast(usize, mam.body) == 0 { panic("selfhost: field read off a match-EXPRESSION whose arm has a STATEMENT-list body (not a single value expression) is not lowered — bind the match to a local first, then read the field") }
          mfb := node_ptr(Expr, deref(cx.mar), mk_expr(deref(cx.mar), Expr.Field(mam.body, fs, fl)))
          mai := mk_arm(deref(cx.mar), Arm(wild = mam.wild, lit = mam.lit, body = mfb, next = 0, vs = mam.vs, vl = mam.vl, binds_head = mam.binds_head, body_stmts = mam.body_stmts, hi = mam.hi))
          if mnh == 0 { mnh = mai } else { set_arm_next(cx.mar, mnt, mai) }
          mnt = mai
          marm = mam.next
        }
        bnm := node_ptr(Expr, deref(cx.mar), mk_expr(deref(cx.mar), Expr.Match(bmi.scrut, unchecked bitcast(ptr(mut Arm), mnh))))
        emit_gas(bnm, sb, cx, a, nl)
      } else if resolve_nested_ptr_field(base, fs, fl, cx).found {
        ## `<ptr-root>.f1…leaf` (depth>=2) — a nested SCALAR field read THROUGH a pointer: a BY-REF struct
        ## param (`a.b.pb`) or `deref(p).b.pb`. The depth-1 forms are handled above (`bref` / `dsb`); the
        ## deeper chain fell to `field_slot` → -1 → a `pushq $0` SILENT MISCOMPILE (the by-ref `Var` arm
        ## of `field_slot` computed `ent.off - fi` off a slot holding a POINTER, not the inline struct).
        ## Load the pointer (`movq -(off+1)*8(%rbp)`), then the leaf at its ASCENDING word offset.
        npf := resolve_nested_ptr_field(base, fs, fl, cx)
        nent := deref(svec_at(SlotEntry, cx.slots, npf.ent_idx))
        push_str(sb, "  movq -")
        push_int(sb, i64((nent.off + 1) * 8))
        push_str(sb, "(%rbp), %rax\n  movq ")
        push_int(sb, npf.woff * 8)
        push_str(sb, "(%rax), %rax\n  pushq %rax\n")
      } else {
        bref := field_base_ref(base, fs, fl, cx)
        if bref.is_ref {
          ## BY-REFERENCE struct param: load word-0 address (the slot's pointer), then the
          ## field is at -(field_index*8)(%rax) (the down-growing aggregate layout). Bind the entry
          ## to a LOCAL first so emit_agg_base_addr's by-ref SlotEntry param gets the entry's
          ## ADDRESS (passing `deref(svec_at(…))` inline passes its word-0/ns instead — the entry
          ## must be a Var for emit_arg to take its address).
          bent2 := deref(svec_at(SlotEntry, cx.slots, bref.ent_idx))
          ## §8 `@packed` BY-REFERENCE PARAM (spec Types §8) — an aggregate parameter is passed by
          ## REFERENCE (the caller's word-0 ADDRESS), so a `@packed` struct param's slot is `is_ref`
          ## and failed the `ek == 2 and not is_ref` gate of the packed-LOCAL read above: the field
          ## fell to `field_word_offset` + a word `movq`, reading byte `8*index` of a byte-precise
          ## block — a SILENT WRONG VALUE (`take(p : Pk) { p.b }` read 0 while `p.b` on the caller's
          ## LOCAL read 20). The caller's storage IS the packed byte layout, so the field is at its
          ## cumulative packed BYTE offset from the pointer, with a correctly-SIZED load — exactly the
          ## `ptr(Pk)` (ek 7) pointer-to-packed path, whose emitter is reused verbatim. Gated on
          ## `is_packed(param's struct type)` + a SCALAR field + a resolved byte offset, so every
          ## un-attributed by-ref param keeps the word `movq` byte-identically (fixpoint-neutral).
          bpk := is_packed(cx.decls, cx.src, bent2.sns, bent2.snl)
          mut bbo := i64(-1)
          mut bfty := CSpan(s = 0, n = 0)
          if bpk {
            bbo = packed_field_byte_offset(cx.decls, cx.src, bent2.sns, bent2.snl, fs, fl, deref(cx.mar))
            bfty = field_type_span(cx.decls, cx.src, bent2.sns, bent2.snl, fs, fl, deref(cx.mar))
          }
          bstd := std_struct_has_direct_byte_layout(cx.decls, cx.src, bent2.sns, bent2.snl, deref(cx.mar))
          if bstd {
            bbo = standard_field_byte_offset(cx.decls, cx.src, bent2.sns, bent2.snl, fs, fl, deref(cx.mar))
            bfty = field_type_span(cx.decls, cx.src, bent2.sns, bent2.snl, fs, fl, deref(cx.mar))
          }
          baes := array_elem_span(cx.src, bfty.s, bfty.n)
          b_agg := baes.n != 0 or (bfty.n != 0 and (str_at((cx.src + bfty.s), bfty.n) == "str" or struct_decl_of(cx.decls, cx.src, bfty.s, bfty.n) >= 0 or enum_decl_of(cx.decls, cx.src, bfty.s, bfty.n) >= 0))
          emit_agg_base_addr(bent2, sb)
          if bpk and bbo >= 0 and not b_agg {
            emit_packed_load_rax(sb, scalar_byte_size(cx.src, bfty.s, bfty.n), bfty.n != 0 and str_at((cx.src + bfty.s), 1) == "i", bbo, packed_field_endian(cx.decls, cx.src, bent2.sns, bent2.snl, fs, fl) == 1)
          } else if bstd and bbo >= 0 and not b_agg {
            emit_packed_load_rax(sb, scalar_byte_size(cx.src, bfty.s, bfty.n), bfty.n != 0 and str_at((cx.src + bfty.s), 1) == "i", bbo, false)
          } else if bstd {
            panic("selfhost: a standard-layout aggregate field read through a by-reference parameter needs a byte-aware aggregate value path; use indexing for byte arrays or bind a supported scalar field")
          } else {
          push_str(sb, "  movq ")
          push_int(sb, bref.fi * 8)
          push_str(sb, "(%rax), %rax\n  pushq %rax\n")
          }
        } else {
          ## POINTER-TO-STRUCT base `p.f` (p : ptr(S), ek 7 — the bare `p.f` spelling, vs the
          ## explicit `deref(p).f` handled by the `dsb.n != 0` path above): load p's pointer value,
          ## then the field at `-(fi*8)(%rax)`. Without this, `field_slot` returned `off + fi` as a
          ## FRAME slot (cx holds a POINTER, not the struct inline) — so `cx.brk`/`cx.tail` read garbage.
          pv7 := var_name_span(base)
          mut p7 := false
          if pv7.n != 0 {
            p7e := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, pv7.s, pv7.n)))
            if p7e.ek == 7 {
              ## §8 pointer-to-@packed (ek 7 MMIO map) — the bare `p.f` spelling: a packed pointee reads
              ## the field at its PACKED byte offset with a sized load (parallel to the `deref(p).f` path).
              p7pk := is_packed(cx.decls, cx.src, p7e.sns, p7e.snl)
              mut p7bo := i64(-1)
              mut p7fty := CSpan(s = 0, n = 0)
              if p7pk {
                p7bo = packed_field_byte_offset(cx.decls, cx.src, p7e.sns, p7e.snl, fs, fl, deref(cx.mar))
                p7fty = field_type_span(cx.decls, cx.src, p7e.sns, p7e.snl, fs, fl, deref(cx.mar))
              }
              p7std := std_struct_has_direct_byte_layout(cx.decls, cx.src, p7e.sns, p7e.snl, deref(cx.mar))
              if p7std {
                p7bo = standard_field_byte_offset(cx.decls, cx.src, p7e.sns, p7e.snl, fs, fl, deref(cx.mar))
                p7fty = field_type_span(cx.decls, cx.src, p7e.sns, p7e.snl, fs, fl, deref(cx.mar))
              }
              p7aes := array_elem_span(cx.src, p7fty.s, p7fty.n)
              p7_agg := p7aes.n != 0 or (p7fty.n != 0 and (str_at((cx.src + p7fty.s), p7fty.n) == "str" or struct_decl_of(cx.decls, cx.src, p7fty.s, p7fty.n) >= 0 or enum_decl_of(cx.decls, cx.src, p7fty.s, p7fty.n) >= 0))
              if p7pk and p7bo >= 0 and not p7_agg {
                push_str(sb, "  movq -")
                push_int(sb, i64((p7e.off + 1) * 8))
                push_str(sb, "(%rbp), %rax\n")
                emit_packed_load_rax(sb, scalar_byte_size(cx.src, p7fty.s, p7fty.n), p7fty.n != 0 and str_at((cx.src + p7fty.s), 1) == "i", p7bo, packed_field_endian(cx.decls, cx.src, p7e.sns, p7e.snl, fs, fl) == 1)
              } else if p7std and p7bo >= 0 and not p7_agg {
                push_str(sb, "  movq -")
                push_int(sb, i64((p7e.off + 1) * 8))
                push_str(sb, "(%rbp), %rax\n")
                emit_packed_load_rax(sb, scalar_byte_size(cx.src, p7fty.s, p7fty.n), p7fty.n != 0 and str_at((cx.src + p7fty.s), 1) == "i", p7bo, false)
              } else if p7std {
                panic("selfhost: a standard-layout aggregate field read through a pointer needs a byte-aware aggregate value path; use indexing for byte arrays or bind a supported scalar field")
              } else {
                fi7 := field_word_offset(cx.decls, cx.src, p7e.sns, p7e.snl, fs, fl, deref(cx.mar))
                push_str(sb, "  movq -")
                push_int(sb, i64((p7e.off + 1) * 8))
                push_str(sb, "(%rbp), %rax\n  movq ")
                push_int(sb, fi7 * 8)
                push_str(sb, "(%rax), %rax\n  pushq %rax\n")
              }
              p7 = true
            }
          }
          if not p7 {
            slot := field_slot(base, fs, fl, cx)
            if slot >= 0 {
              push_str(sb, "  movq -")
              push_int(sb, (slot + 1) * 8)
              push_str(sb, "(%rbp), %rax\n  pushq %rax\n")
            } else {
              push_str(sb, "  pushq $0\n")
            }
          }
        }
      }
    }
    ## A struct construction in pure expression position has no frame home, so it is only
    ## supported as the value of an `Assign` (handled in `emit_stmts`, which stores each
    ## field into the local's reserved slots). Reaching here means a bare `S(…)` expression
    ## with no binding — push a placeholder 0 (not exercised by the supported grammar).
    Expr::StructLit(cs, cl, nf, fhead) => {
      push_str(sb, "  pushq $0\n")
    }
    ## `base.name(args)` parses as an `EnumLit` whether it is an enum-variant construction
    ## (`E.V(…)`, base is an enum TYPE) or a UFCS method call (`recv.method(…)`, base is a VALUE).
    ## If `base` is NOT an enum type (`enum_decl_of < 0`), it is UFCS: desugar to `name(recv, args)`
    ## — build a receiver `Var(es,el)`, PREPEND it as argument 0 of a fresh `Call(name, np+1, …)`,
    ## and emit that call through the ordinary Call path (`node_alloc` builds the nodes, the proven
    ## parser shape). A genuine enum-ctor in pure expression position has no frame home → placeholder 0.
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      ## `x86_64.<mnem>(dest, src)` — an arch instruction INTRINSIC (num.al's `@inline` operators).
      ## `base.name(args)` with a bare-Var base parses as an `EnumLit`; when the base is the arch
      ## name `x86_64` and `name` is a known mnemonic, lower the real instruction instead of the
      ## UFCS-call fallback (which would emit an undefined `call <mnem>`).
      if el != 0 and str_at((cx.src + es), el) == "x86_64" and is_arch_mnemonic(str_at((cx.src + vs), vl)) {
        emit_arch_intr(vs, vl, phead, sb, cx, a, nl)
      } else if enum_decl_of(cx.decls, cx.src, es, el) < 0 {
        vidx := mk_expr(deref(cx.mar), Expr.Var(es, el))
        vptr := node_ptr(Expr, deref(cx.mar), vidx)
        aidx := mk_arg(deref(cx.mar), Arg(e = vptr, next = phead))
        cidx := mk_expr(deref(cx.mar), Expr.Call(vs, vl, np + 1, aidx))
        cptr := node_ptr(Expr, deref(cx.mar), cidx)
        emit_gas(cptr, sb, cx, a)
      } else if np == 0 {
        ## A nullary enum variant is a scalar discriminant when it appears in a comparison or as a
        ## nested one-word payload. The old placeholder erased E.A/E.B/E.C to zero, making every
        ## variant compare equal and making Result/Option carry the wrong nested enum value.
        push_str(sb, "  movq $")
        push_int(sb, variant_index(cx.decls, cx.src, es, el, vs, vl, deref(cx.mar)))
        push_str(sb, ", %rax\n  pushq %rax\n")
      } else {
        ## A payloaded enum literal in a scalar-only context has no defined scalar projection. Keep the
        ## historical zero placeholder for the compiler's own internal Result construction paths; the
        ## aggregate value paths above are the authoritative ones for user-visible enum payloads.
        push_str(sb, "  pushq $0\n")
      }
    }
    ## `ptr(<place>)` — take the address of a local-var place: `leaq -(off+1)*8(%rbp),
    ## %rax` (the var's frame slot address) and push it. Only a local `Var` place is supported
    ## `ptr(<place>)` — push the place's ADDRESS. A local `Var` → `leaq` its frame slot;
    ## an array element `a[i]` → `emit_index_addr` (the runtime element address, the arena `get`
    ## shape); any other place → placeholder 0. Routed through `emit_addr_of`.
    Expr::AddrOf(p) => {
      emit_addr_of(p, sb, cx, a, nl)
    }
    ## `deref(<ptr>)` — a load through a pointer value: lower the pointer expression (its
    ## value on the stack), pop it into %rax, load the word it points at (`movq (%rax), %rax`),
    ## and push the loaded value.
    Expr::Deref(p) => {
      emit_gas(p, sb, cx, a, nl)
      ## Narrow the load to the pointee width when it is a KNOWN sub-word scalar (`ptr(u8)` etc.,
      ## seen through the parser-preserved `Bitcast`); word-sized / unknown keeps the full `movq`.
      push_str(sb, "  popq %rax\n")
      emit_deref_load(sb, deref_pointee_bytes(p, cx), deref_pointee_signed(p, cx))
      push_str(sb, "  pushq %rax\n")
    }
    ## `bitcast(ptr(<sub-word>), v)` PRESERVED (parser) — bit-identity, so emit exactly the inner
    ## VALUE; the node exists only to carry the pointee width to a `deref` load/store (above).
    Expr::Bitcast(inner, bps, bpl) => {
      emit_gas(inner, sb, cx, a, nl)
    }
    ## A string literal in bare expression position pushes its data POINTER (a single word —
    ## `leaq .Lstr<idx>(%rip)`). A `str` is a 2-word {ptr, len} value, but the stack machine
    ## pushes one word; str values are consumed only by the `len`/`str_eq` builtins (which read
    ## the pair directly via `emit_str_pair`) and by a `name := "…"` binding (which stores both
    ## words via `emit_str_assign`), so the bare arm only needs the pointer.
    Expr::StrLit(ss, sl, lbl) => {
      push_str(sb, "  leaq ")
      push_lstr(sb, lbl)
      push_str(sb, "(%rip), %rax\n  pushq %rax\n")
    }
    ## An array construction in pure expression position has no frame home, so it is only
    ## supported as the value of an `Assign` (handled in `emit_stmts` via `emit_array_assign`,
    ## which stores each element into the local's reserved slots). A bare `[…]` expression
    ## pushes a placeholder 0 (not exercised by the supported grammar).
    Expr::ArrayLit(nel, ehead) => {
      push_str(sb, "  pushq $0\n")
    }
    ## `a[i]` — an element READ: compute the element address (`emit_index_addr`: base +
    ## index*8 in %rax via SIB), load the word it points at (`movq (%rax), %rax`), and push it.
    Expr::Index(base, idx) => {
      ## STANDARD BYTE TUPLE COMPONENT READ — claim `t.N[i]` before the historical array-of-tuples
      ## recognizer below. The component address is byte-granular and the load width follows the
      ## declared direct byte-array element kind.
      tbread0 := tuple_byte_component_base(base, cx)
      if tbread0.ok {
        emit_index_addr(base, idx, sb, cx, a, nl)
        teek0 := tuple_byte_component_base_eek(base, cx)
        if teek0 == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
        push_str(sb, "  pushq %rax\n")
        return
      }
      ## BYTES bounded DIRECT READ — a supported `[u8; N]` call result is returned as one packed
      ## word in %rax. Keep the index on the value stack while lowering the call, then extract byte
      ## `k` from the returned little-endian word. This is intentionally a READ-only composition;
      ## `emit_index_addr` retains the old located reject for unsupported direct aggregate places and
      ## for writes, so no address/temporary ABI is invented here.
      dret_n := fixed_array_byte_return_len(base, cx.decls, cx.src, a)
      if dret_n >= 1 {
        emit_gas(idx, sb, cx, a, nl)
        emit_gas(base, sb, cx, a, nl)
        push_str(sb, "  popq %rbx\n  popq %rcx\n")
        if cx.vchk {
          push_str(sb, "  cmpq $")
          push_int(sb, dret_n)
          push_str(sb, ", %rcx\n  jb 1f\n  ud2\n1:\n")
        }
        push_str(sb, "  movq %rcx, %r8\n  shlq $3, %r8\n  movq %r8, %rcx\n  shrq %cl, %rbx\n  andq $255, %rbx\n  movq %rbx, %rax\n  pushq %rax\n")
        return
      }
      ## `xs[i].N` — a TUPLE component of an ARRAY-of-tuples element (parsed `Index(Index(xs, i), N)`,
      ## since `t.N` lowers to `Index(t, N)`). The inner `Index(xs, i)` bases on an eek-5 array (tuple
      ## element, stride = component count); `emit_index_addr` computes element i's word-0 address
      ## stride-aware, then component N sits at `-(N*8)(%rax)` (the down-growing tuple-component layout,
      ## the same as a tuple LOCAL's `Index`). N is a constant (a tuple index is always a literal).
      nbx := field_base_index(base)
      if nbx.is_ix {
        nie := deref(svec_at(SlotEntry, cx.slots, index_base_entry(nbx.arr, cx.slots, cx.src)))
        ## NAME: `tbcn`, not `tbc` — this function already binds a `usize` `tbc` (the match scratch
        ## level, in the `Stmt`-scrutinee path above). Alatyr locals are function-scoped and the slot
        ## map reuses a name's FIRST reservation, so reusing `tbc` here bound this 3-word struct to
        ## that 1-word scalar slot: the return's 3 words overwrote the two neighbouring locals and
        ## `tbc.ok` read a slot nothing wrote (see `require_reservation`, which now rejects it).
        tbcn := tuple_byte_component_base(base, cx)
        if tbcn.ok {
          emit_index_addr(base, idx, sb, cx, a, nl)
          eek := tuple_component_byte_eek(nbx.arr, usize(num_lit_value(nbx.idx)), cx)
          if eek == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
          push_str(sb, "  pushq %rax\n")
          return
        }
        if nie.eek == 5 {
          emit_index_addr(nbx.arr, nbx.idx, sb, cx, a, nl)   ## element i's word-0 address → %rax
          ncomp := num_lit_value(idx)
          push_str(sb, "  movq ")
          push_int(sb, ncomp * 8)
          push_str(sb, "(%rax), %rax\n  pushq %rax\n")
          return
        }
        ## NESTED mixed-kind tuple element access `t.N.M` (parsed `Index(Index(t, N), M)`), where the
        ## inner base `t` is a MIXED tuple LOCAL whose per-component layout is recorded in `tcomps` and
        ## component N is itself a FLAT single-word-position tuple (`tc.ek == 6` — set by `tuple_layout_
        ## collect` via `tuple_flat_single_word`). `emit_index_addr` (its `tcomp` branch) computes component
        ## N's word-0 ADDRESS (element-0 frame address + `tc.off*8`, is_ref-aware); component M is then word
        ## M within it, `+M*8(%rax)` (word M == position M BECAUSE every position is one word) — a single
        ## pushed word (the SAME up-growing sub-layout as the eek-5 array-of-tuples path). Distinct from the
        ## eek-5 branch above (a UNIFORM array-of-tuples, `nie.eek == 5`); here `t`'s first component is a
        ## scalar (`nie.eek == 0`), so N's own offset comes from `tcomps`.
        ## SOUNDNESS (cardinal rule — never a silent miscompile): the branch fires ONLY for `tc.ek == 6`.
        ## If component N has ANY multi-word position (a further nested tuple/struct/array, e.g.
        ## `(1, (100, 200))` or `((1, 2), 3)`), `ek` stays 5 → we FALL THROUGH to `emit_index_addr`'s
        ## fail-loud panic (word M would truncate the multi-word position and, with an earlier wide position,
        ## mis-offset — position offset != index). A struct/enum component (`t.N.field`) uses the Field path.
        nbvn := var_name_span(nbx.arr)
        if nbvn.n != 0 {
          tc := tcomp_find(cx, nie.off, usize(num_lit_value(nbx.idx)))
          if tc.estride != 0 and tc.ek == 6 {
            emit_index_addr(nbx.arr, nbx.idx, sb, cx, a, nl)   ## component N word-0 address → %rax
            mcomp := num_lit_value(idx)
            push_str(sb, "  movq ")
            push_int(sb, mcomp * 8)
            push_str(sb, "(%rax), %rax\n  pushq %rax\n")
            return
          }
        }
      }
      ## `xs[i].arr[j]` — an inner index into an ARRAY FIELD of an array-of-struct ELEMENT (base is
      ## `Field(Index(xs,i), arr)`). Compose: the array-field's word-0 ADDRESS (`emit_idx_field_addr`
      ## = element base + field word offset, the ASCENDING element layout) + element j at `+j*8` (the
      ## field's words sit contiguously ascending within the element). Was unhandled → `emit_index_addr`
      ## read slot 0 (base is a `Field`, not a `Var`) → a `pushq $0`-equivalent SILENT MISCOMPILE.
      afe := arr_field_elem(base, cx)
      if afe.found {
        ## A whole aggregate element has no scalar value representation in this expression position.
        ## It is valid only through the explicit bind/copy path (`p := xs[i].arr[j]`); keeping this
        ## guard here preserves I11's fail-loud behavior for `u64(xs[i].arr[j])` and other bare reads.
        if arr_field_agg_type(e, cx.slots, cx.src, cx.decls, a).n != 0 {
          panic("selfhost: whole aggregate `xs[i].arr[j]` is only supported as a binding or aggregate assignment (bind it to a local first)")
        }
        emit_gas(idx, sb, cx, a, nl)                                       ## inner index j → stack FIRST (its lowering may clobber regs)
        emit_idx_field_addr(afe.arr, afe.idx, afe.woff * 8, sb, cx, nl)    ## array-field word-0 addr → %rax
        push_str(sb, "  popq %rcx\n")                                      ## j → %rcx
        ## CHECKED BOUNDS (I11 §358): trap an out-of-range inner index against the array field's static
        ## length N before scaling. `jb` skips on `idx < N`; a negative (huge-unsigned) index also traps.
        if cx.vchk and afe.elen > 0 {
          push_str(sb, "  cmpq $")
          push_int(sb, afe.elen)
          push_str(sb, ", %rcx\n  jb 1f\n  ud2\n1:\n")
        }
        push_str(sb, "  imulq $8, %rcx\n  addq %rcx, %rax\n  movq (%rax), %rax\n  pushq %rax\n")
        return
      }
      ## `st.v[i]` — an element READ through a 2-word `{ptr, len}` VIEW FIELD (`v : Slice(T)` / `str`).
      ## `emit_pair_field_index_addr` gives the element ADDRESS (data pointer + i*stride, bounds-checked
      ## against the runtime len); the load WIDTH is chosen here — one BYTE for a `str` / `Slice(u8)`
      ## view (`str` IS `[u8]`, appendix 160 §3.5), a word otherwise. Handled BEFORE the slice-LOCAL
      ## (`slr`) and array-field paths, neither of which matches a `Field` base — it previously fell to
      ## `emit_index_addr`'s inline-`[T; N]`-FIELD branch, which read the {ptr, len} words THEMSELVES as
      ## elements (`st.v[1]` / `st.name[1]` returned the LENGTH) — a SILENT MISCOMPILE.
      pfe := pair_field_elem_stride(base, cx, a)
      if pfe != 0 {
        emit_pair_field_index_addr(base, idx, sb, cx, a, nl)   ## element address → %rax
        if pfe == 1 {
          push_str(sb, "  movzbq (%rax), %rax\n  pushq %rax\n")
        } else {
          push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n")
        }
        return
      }
      ## A str element has no scalar word representation. Its valid consumers are the pair-valued
      ## `emit_str_pair` path and the whole-element binding copier; reaching this scalar emitter means
      ## an unsupported call/operand edge (including a `Slice(str)` PARAM), so stop at the source shape
      ## instead of silently passing only the element's pointer word.
      if call_arg_is_str_elem(e, cx) {
        panic("selfhost: a str element index is a two-word `{ptr,len}` value and cannot enter scalar lowering; bind it or use it in a str context")
      }
      ## `s[i]` on a `Slice(T)` VALUE — deref its `ptr` field (word 0) and load element `i` at
      ## the arena's UPWARD element address. A Slice is a `{ptr, len}` STRUCT, not a frame-local
      ## array, so indexing must NOT read the struct's own frame words (that returned `s.len` for
      ## `s[1]`, garbage for `s[0]`). A LOCAL keeps `ptr` at slot `off`; a by-ref PARAM keeps a
      ## pointer to the struct, whose word 0 is `ptr`. `Slice(str)` is a two-word value and is
      ## intentionally rejected here: its pair-valued consumers go through `emit_str_pair`, while
      ## silently loading only word 0 would turn a valid element read into a wrong scalar.
      slr := slice_var_ref(base, cx)
      if slr.ok {
        if slr.is_ref {
          push_str(sb, "  movq -")
          push_int(sb, i64((slr.off + 1) * 8))
          push_str(sb, "(%rbp), %rax\n  movq (%rax), %rax\n")
        } else {
          push_str(sb, "  movq -")
          push_int(sb, i64((slr.off + 1) * 8))
          push_str(sb, "(%rbp), %rax\n")
        }
        push_str(sb, "  pushq %rax\n")
        emit_gas(idx, sb, cx, a, nl)
        push_str(sb, "  popq %r8\n")
        ## CHECKED BOUNDS (I11 / CG-7) for a `Slice(T)`/str-view LOCAL: word 1 is the runtime len (the
        ## {ptr, len} value lives at frame slots `off`/`off+1`), so compare the index (%r8) against the
        ## len word `-(off+2)*8(%rbp)`; `jb` skips on `idx < len`, a negative (huge-unsigned) index also
        ## traps. Only the non-ref (local) case here — a by-ref `Slice(T)` PARAM keeps its len behind the
        ## struct pointer (`8(ptr)`) and is a follow-up. Dropped in an `unchecked` scope.
        if cx.vchk and slr.is_ref == false {
          push_str(sb, "  cmpq -")
          push_int(sb, i64(slr.off * 8))
          push_str(sb, "(%rbp), %r8\n  jb 1f\n  ud2\n1:\n")
        }
        if slr.is_byte {
          ## BYTE element (`Slice(u8)` — e.g. `strmap`/`hash_bytes` byte keys): load one byte at
          ## `ptr + i` (stride 1), zero-extended — NOT a word at `ptr + i*8` (which read 8 bytes per
          ## element, past the buffer, garbaging the hash + running off the end).
          push_str(sb, "  popq %rax\n  movzbq (%rax,%r8), %rax\n  pushq %rax\n")
        } else {
          push_str(sb, "  popq %rax\n  movq (%rax,%r8,8), %rax\n  pushq %rax\n")
        }
        return
      }
      ## `bytes(s)[i]` — the SPEC-canonical str byte access (`str` is `[u8]`, appendix 160 §3.5):
      ## a BYTE read, not a word read. Detect a `bytes(<s>)` base and emit the byte load
      ## (`movzbq`, reusing the `byte_at` machinery — push the str's {ptr,len} pair, lower the
      ## index, then `movzbq (%rax,%r8)`); otherwise the ordinary array-element word read. This
      ## is the byte primitive both Stage-0 and the self-host lower accept (no `byte_at` builtin).
      mut bv := bytes_view_arg(base, cx.src, a)
      ## `GLOBAL[i]` on a MUTABLE array global (`TABLE[i]`): load element `i` from `.data` at
      ## `LABEL + i*8`. `leaq LABEL(%rip)` (PIE-safe base), then an indexed word load. The base is a
      ## module global, not a frame array, so this precedes `emit_index_addr` (which reads a slot).
      gav := var_name_span(base)
      ## `VIEW := bytes("...")` is an immutable module initializer. It has no `.data` array label;
      ## resolve the binding to its initializer and feed the inner str to the same byte-index path
      ## used by immediate `bytes("...")[i]`. This is deliberately limited to `bytes(...)` rather
      ## than treating an arbitrary module constant as an array place.
      if unchecked bitcast(usize, bv) == 0 and gav.n != 0 {
        gcv := module_const_value(cx.decls, cx.src, gav.s, gav.n)
        if unchecked bitcast(usize, gcv) != 0 and is_bytes_call(gcv, cx.src) {
          bv = bytes_view_arg(gcv, cx.src, a)
        }
      }
      mut gamgv : ptr(Expr) = if gav.n != 0 { mut_global_value(cx.decls, cx.src, gav.s, gav.n) } else { unchecked bitcast(ptr(Expr), 0) }
      ## CORRECT-OR-TRAP (BYTES): both a mutable global and a const global whose
      ## initializer is a direct bounded `[u8; N]` return call have no valid array image here.
      ## The mutable path otherwise emits a zero/short `.data` cell; the const path has no
      ## materialized array value. In either case an indexed read would silently lose the call's
      ## result, so reject before the ordinary global-array address path. Only the already-supported
      ## one-word `[u8; N]` ABI is claimed; wider/non-u8 array returns stay on their existing fences.
      mut ginit := gamgv
      if unchecked bitcast(usize, ginit) == 0 and gav.n != 0 { ginit = module_const_value(cx.decls, cx.src, gav.s, gav.n) }
      if unchecked bitcast(usize, ginit) != 0 and fixed_array_byte_return_len(ginit, cx.decls, cx.src, a) >= 1 {
        panic("selfhost: indexed read of a module-level [u8;N] global initialized by a runtime CALL is not supported — the initializer never runs before _start and its array storage would silently read zero; build the value inside a function instead")
      }
      ## a CONST (non-mut) global ARRAY (`TAB := […]`, then `TAB[i]`) also has `.data` storage — fall
      ## back to its value so the indexed read addresses `LABEL + i*8` like a mut array (read-only).
      if unchecked bitcast(usize, gamgv) == 0 and gav.n != 0 { gamgv = const_array_value(cx.decls, cx.src, gav.s, gav.n) }
      mut ga_done := false
      if unchecked bitcast(usize, gamgv) != 0 {
        ## an ENUM-element array global element in a VALUE position — the indexed word load below
        ## would take ONE word at `LABEL + i*8` (the middle of a `1 + max-payload`-word element) and
        ## pass it off as the enum: a silent wrong-discriminant/garbage-payload read. The supported
        ## shapes (`e := GE[i]`, `match GE[i]`) are claimed BEFORE `emit_gas` ever sees the Index.
        if global_arr_enum(cx.decls, cx.src, gamgv, a).is_e {
          panic("selfhost: an ENUM-element ARRAY GLOBAL element `GE[i]` in a VALUE position (a call argument, a return, an operand) is not lowered — the element is `1 + max-payload` words, not one. Bind it first (`e := GE[i]`) or `match GE[i]` directly. [fail-loud guard: never a silent one-word read]")
        }
        if array_lit_info(gamgv).is_a or global_array_byte_eek(cx.decls, cx.src, gav.s, gav.n) != 0 {
          gnel := global_array_len(cx.decls, cx.src, gav.s, gav.n, gamgv)
          emit_gas(idx, sb, cx, a, nl)                 ## index on the stack
          push_str(sb, "  leaq ")
          emit_global_label(sb, cx.decls, cx.src, gav.s, gav.n)
          push_str(sb, "(%rip), %rax\n  popq %rcx\n")
          ## CHECKED BOUNDS (I11 §358) — a mutable-global array has a static element count too.
          if cx.vchk { push_str(sb, "  cmpq $"); push_int(sb, i64(gnel)); push_str(sb, ", %rcx\n  jb 1f\n  ud2\n1:\n") }
          ## An explicitly typed byte global is laid out as one byte per element. The address and
          ## bounds path is otherwise identical to the historical word-global path; only the scale
          ## and load width differ. i8 sign-extends, while u8/bits8 zero-extend.
          gbyte := global_array_byte_eek(cx.decls, cx.src, gav.s, gav.n)
          if gbyte != 0 {
            push_str(sb, "  movq %rax, %r8\n  addq %rcx, %r8\n")
            if gbyte == 10 { push_str(sb, "  movsbq (%r8), %rax\n") } else { push_str(sb, "  movzbq (%r8), %rax\n") }
            push_str(sb, "  pushq %rax\n")
          } else {
            push_str(sb, "  movq (%rax,%rcx,8), %rax\n  pushq %rax\n")
          }
          ga_done = true
        }
      }
      ## `g.xs[i]` — an ARRAY FIELD of a MUTABLE-GLOBAL struct (base is `g.xs`, a Field, so the direct-
      ## global path above missed it). The field's words start at `LABEL + off*8`; element `i` (word-
      ## sized) is at `LABEL + (off + i)*8(%rip)`. `leaq LABEL(%rip)` (PIE-safe), add `off*8`, indexed load.
      if not ga_done {
        gfo := global_field_off(base, cx, a)
        if gfo.found {
          emit_gas(idx, sb, cx, a, nl)                 ## index on the stack
          push_str(sb, "  leaq ")
          emit_global_label(sb, cx.decls, cx.src, gfo.gs, gfo.gn)
          push_str(sb, "+")
          push_int(sb, gfo.off * 8)
          push_str(sb, "(%rip), %rax\n  popq %rcx\n  movq (%rax,%rcx,8), %rax\n  pushq %rax\n")
          ga_done = true
        }
      }
      if ga_done {
      } else if unchecked bitcast(usize, bv) != 0 {
        ## An immutable module-level str is a compile-time value, not a frame slot. Resolve it only
        ## in this bytes-index path; the general str-pair path retains its established behavior for
        ## other contexts until their separate global-str contract is addressed.
        mut bsrc := bv
        bvn := var_name_span(bv)
        if bvn.n != 0 {
          bconst := module_const_value(cx.decls, cx.src, bvn.s, bvn.n)
          if unchecked bitcast(usize, bconst) != 0 and str_lit_info(bconst).is_s { bsrc = bconst }
        }
        emit_str_pair(bsrc, sb, cx, a, nl)
        emit_gas(idx, sb, cx, a, nl)
        push_str(sb, "  popq %r8\n  popq %rbx\n  popq %rax\n  movzbq (%rax,%r8), %rax\n  pushq %rax\n")
      } else {
        emit_index_addr(base, idx, sb, cx, a, nl)
        tbread := tuple_byte_component_base(base, cx)
        if tbread.ok {
          teek := tuple_byte_component_base_eek(base, cx)
          if teek == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
          push_str(sb, "  pushq %rax\n")
          return
        }
        pbfe := packed_byte_field_eek(base, cx)
        sbfe := standard_byte_field_eek(base, cx)
        ## CLAYOUT S3(d) — `xs[i].data[j]`: the address above is already the exact BYTE, so the load
        ## must be one byte wide. Without this the chain fell to the `movq` default and read the byte
        ## plus its seven neighbours.
        sdbe := std_idx_byte_field_eek(base, cx.slots, cx.decls, cx.src, a)
        pbe := packed_byte_base_entry(base, cx)
        if pbfe != 0 {
          if pbfe == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
          push_str(sb, "  pushq %rax\n")
        } else if sdbe != 0 {
          if sdbe == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
          push_str(sb, "  pushq %rax\n")
        } else if sbfe != 0 {
          if sbfe == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
          push_str(sb, "  pushq %rax\n")
        } else if pbe >= 0 {
          pent := deref(svec_at(SlotEntry, cx.slots, usize(pbe)))
          if pent.eek == 10 { push_str(sb, "  movsbq (%rax), %rax\n") } else { push_str(sb, "  movzbq (%rax), %rax\n") }
          push_str(sb, "  pushq %rax\n")
        } else {
          push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n")
        }
      }
    }
    ## `base[lo..hi]` — a RANGE SLICE. In a bare expression position it leaves the str view's
    ## {ptr, len} pair on the stack (the str-expression value shape), like a bare `sub(…)`.
    Expr::Slice(base, lo, hi) => {
      emit_slice_pair(e, sb, cx, a, nl)
    }
    ## `base.(f)` — COMPTIME field access, resolved during a `comptime for` unroll: `f` is the loop
    ## var (`cf_var`), currently bound to a member `cf_fld`, so emit `base.<cf_fld>` (a plain Field).
    Expr::CompField(base, idx) => {
      vn := var_name_span(idx)
      if cx.cf_var_l != 0 and vn.n != 0 and streq(cx.src, vn.s, vn.n, cx.cf_var_s, cx.cf_var_l) {
        if not comp_field_scalar_value(cx) { panic("selfhost: comptime field projection of an aggregate is unsupported in value position; pass the field to an aggregate-aware callee") }
        if str_at((cx.src + cx.it_s), 1) == "(" or str_at((cx.src + cx.it_s), 1) == "[" {
          ## TUPLE component / ARRAY element projection `v.(c)` — index in `cf_fld_s` (`cf_fld_l
          ## == 0`). A tuple is passed to a generic like a small struct: BY REFERENCE, so `v`'s slot
          ## holds the tuple's word-0 ADDRESS and component `c` sits at `-(c*8)(ptr)` (down-growing
          ## aggregate layout). A by-VALUE tuple in the frame (ek 5) is read via the Index machinery.
          bvn := var_name_span(base)
          if bvn.n != 0 {
            bent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, bvn.s, bvn.n)))
            if bent.ek == 5 {
              nidx := mk_expr(deref(cx.mar), Expr.Num(i64(cx.cf_fld_s), 0, 0))
              nptr := node_ptr(Expr, deref(cx.mar), nidx)
              iidx := mk_expr(deref(cx.mar), Expr.Index(base, nptr))
              iptr := node_ptr(Expr, deref(cx.mar), iidx)
              emit_gas(iptr, sb, cx, a, nl)
            } else {
              ## by-ref container param: `v` holds the word-0 address; the member sits at its
              ## CUMULATIVE word offset (`cf_member_woff` — handles a scalar after a wide component).
              cwo := cf_member_woff(cx, a)
              push_str(sb, "  movq -")
              push_int(sb, i64((bent.off + 1) * 8))
              push_str(sb, "(%rbp), %rax\n")
              if cwo != 0 {
                push_str(sb, "  movq ")
                push_int(sb, i64(cwo * 8))
                push_str(sb, "(%rax), %rax\n  pushq %rax\n")
              } else {
                push_str(sb, "  movq (%rax), %rax\n  pushq %rax\n")
              }
            }
          } else {
            push_str(sb, "  pushq $0\n")
          }
        } else {
          fidx := mk_expr(deref(cx.mar), Expr.Field(base, cx.cf_fld_s, cx.cf_fld_l))
          fptr := node_ptr(Expr, deref(cx.mar), fidx)
          emit_gas(fptr, sb, cx, a, nl)
        }
      } else {
        push_str(sb, "  pushq $0\n")
      }
    }
    ## `inner?` — the tryable `?` operator. Materialize the inner enum into the two-register
    ## return convention (discriminant in %rax, payload word in %rdx) via `emit_enum_value`,
    ## then test the discriminant: a non-zero discriminant is a FAILURE — the whole enum is
    ## already in %rax/%rdx, the enclosing fn's enum-return convention, so `jmp` the function
    ## epilogue (`cx.epi`) to return it; a zero discriminant is SUCCESS — the `?` expression's
    ## value is the success payload (word 0, in %rdx), so push %rdx. (CONVENTION: success =
    ## variant 0; the enclosing fn returns the same enum type — see ast.al's `Try` note.)
    Expr::Try(inner) => {
      emit_enum_value(inner, sb, cx, a, nl)   ## disc → %rax, payload[0] → %rdx
      ## SUCCESS = the operand enum's Some/Ok variant, NOT positionally variant 0 (a stdlib Option is
      ## `{None, Some}` → Some = 1). Resolve it from the operand's type; unresolved folds to 0.
      tsp := try_operand_ty_span(inner, cx, a)
      sdisc := try_success_disc(cx.decls, cx.src, tsp.s, tsp.n, a)
      lok := nl
      nl += 1
      push_str(sb, "  cmpq $")
      push_int(sb, sdisc)
      push_str(sb, ", %rax\n  je ")
      emit_label(sb, lok)
      push_str(sb, "\n")
      ## failure: %rax/%rdx already hold the whole enum — return it from the enclosing fn.
      ## DEFER (§9.3): the `?` early-exit runs the NESTED-frame defers (boundary `FRAME[0]`) before
      ## jumping — SAVE & RESTORE the ledger (an alternate runtime path). Gated on a nested defer frame
      ## so a defer-free fn (all of `src/`+`lib/`) emits nothing here.
      if cx.defer_sp > 0 {
        sv := cx.defer_n
        emit_defer_chain(sb, cx, a, nl, cx.defer_frame[0])
        cx.defer_n = sv
      }
      push_str(sb, "  jmp ")
      emit_label(sb, cx.epi)
      push_str(sb, "\n")
      ## success: the `?` value is the payload word (in %rdx).
      emit_label(sb, lok)
      push_str(sb, ":\n  pushq %rdx\n")
    }
    ## `unchecked <inner>` — a scoped verification mode (Types §4.2, CT-11). Emit the inner with
    ## `cx.vchk` FALSE so a routed library operator's `comptime if verify.checked` guard folds
    ## comptime-absent (raw wrapping instruction); save/restore the mode so a checked context
    ## surrounding the `unchecked` expression is unaffected. The emitted VALUE is the inner's value.
    Expr::Unchecked(inner) => {
      ov := cx.vchk
      cx.vchk = false
      emit_gas(inner, sb, cx, a, nl)
      cx.vchk = ov
    }
  }
}

## Emit the element stores for an array construction `name := [e0, e1, …, eN]` — store each
## element into the local's reserved slots. Element `i` lives at slot `base + i*stride` (stride
## = the element's size in words: 1 for a word-sized element, nfields for a struct element,
## 1+max_arity for an enum element). A word-sized element is one word store (byte-identical to
## the old path, stride 1). An AGGREGATE element reuses `emit_struct_assign`/`emit_enum_assign`
## TARGETED AT THE ELEMENT'S BASE SLOT (a whole-aggregate store into the array element). Elements
## appear in source order. The deref-match on the value pointer `v` stays here (a pointer PARAM).
## The word width of a tuple/array element EXPR — MUST match `emit_array_assign`'s per-element advance.
elem_expr_width := fn(e : ptr(Expr), slots : ptr(SVec), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> i64 {
  esl := struct_lit_info(e)
  if esl.is_s { return i64(struct_words(decls, src, esl.ss, esl.sl, a)) }
  va := var_agg_info(e, slots, src)
  if va.ek == 2 { return i64(struct_words(decls, src, va.s, va.n, a)) }
  eil := enum_lit_info(e)
  if eil.is_e { return 1 + i64(enum_inst_words(decls, src, eil.es, eil.el, a)) }
  if va.ek == 3 { return 1 + i64(enum_inst_words(decls, src, va.s, va.n, a)) }
  if str_lit_info(e).is_s { return 2 }
  nai := array_lit_info(e)
  if nai.is_a { return i64(nai.nel) }
  1
}
## Whether component expr `e` is a FLAT tuple whose EVERY position is a single 8-byte word (a native
## scalar `u64`/`i64`/`usize`/`bool`/`ptr` OR an `f64`/`f32` — `elem_expr_width == 1` each). ONLY such a
## component supports the nested value-read `t.N.M` (word M == position M, one pushed word). A component
## with ANY multi-word position (a nested tuple / struct / enum / array, or a >8-byte type) is NOT flat →
## the read would truncate the multi-word position AND mis-offset every later position (position offset !=
## index when an earlier position spans >1 word), so it must FALL THROUGH to the `emit_index_addr` fail-loud
## (a loud panic, the safe old behavior — never a wrong value). A non-`ArrayLit` (scalar/struct/enum
## component) or an EMPTY tuple is NOT a flat readable tuple → false. Marks the tcomp entry's `ek` = 6.
tuple_flat_single_word := fn(e : ptr(Expr), slots : ptr(SVec), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> bool {
  ali := array_lit_info(e)
  if ali.is_a == false { return false }
  if ali.nel == 0 { return false }
  mut g := ali.ehead
  mut flat := true
  while g != 0 {
    ga := deref(arg_p(g))
    if elem_expr_width(ga.e, slots, decls, src, a) != 1 { flat = false }
    g = ga.next
  }
  flat
}
## Record the per-component layout of a MIXED-kind tuple LOCAL into `tcomps` (see LCtx.tcomps). For each
## `name := (e0, e1, …)` binding whose components are NOT uniform (differing kind/width), push one
## `SlotEntry` per component: `ns` = the tuple's base slot, `nl` = the component index, `sns`/`snl` = the
## component's struct/enum type span (0/0 scalar), `off` = its cumulative word offset, `eek` = kind. A
## UNIFORM tuple/array is skipped (the uniform-stride read is already correct → fixpoint-neutral). Mirrors
## the statement arms of `collect_slots`/`scan_str_arg_stmts` (every arm advances `s`, so no spin).
##
## TUPLE BYTE COMPONENT TIER — typed tuple locals are represented by the parser as an ArrayLit, but their
## declared local type retains the complete `(T0, T1, …)` source span. Keep this small descriptor source-
## driven: no new AST/SlotEntry shape is needed. Component `off` is the normative standard-layout byte
## offset; the enclosing slot uses eek 12 as a private byte-tuple marker and reserves the rounded total
## byte size. Params, returns, globals, nested aggregates and comparisons remain outside this tier.
tuple_local_type := fn(src : ptr(u8), ns : usize, nl : usize) -> CSpan {
  lt := local_type_span(src, ns, nl)
  if lt.n == 0 or str_at((src + lt.s), 1) != "(" { return CSpan(s = 0, n = 0) }
  CSpan(s = lt.s, n = lt.n)
}

tuple_type_has_byte_component := fn(src : ptr(u8), ns : usize, nl : usize) -> bool {
  tt := tuple_local_type(src, ns, nl)
  if tt.n == 0 { return false }
  tuple_span_has_byte_component(src, tt.s, tt.n)
}

tuple_span_has_byte_component := fn(src : ptr(u8), ts : usize, tl : usize) -> bool {
  if tl == 0 or str_at((src + ts), 1) != "(" { return false }
  mut i := 0
  mut found := false
  mut scanning := true
  while scanning {
    cs := typearg_at(src, ts, 0, usize(i))
    if cs.n == 0 { scanning = false } else {
      ae := array_elem_span(src, cs.s, cs.n)
      if ae.n != 0 and byte_type_eek(src, ae.s, ae.n) != 0 { found = true }
      i += 1
    }
  }
  found
}

## The size/align fold also covers a direct narrow scalar component such as `(u64, u8)`. Keep this
## detector separate from `tuple_span_has_byte_component`: the latter is the older ABI-boundary guard
## for byte-array tuples, and widening it would reject existing word-ABI functions like `(u8, bool)`.
tuple_span_has_narrow_component := fn(src : ptr(u8), ts : usize, tl : usize) -> bool {
  if tl == 0 or str_at((src + ts), 1) != "(" { return false }
  mut i := 0
  mut found := false
  mut scanning := true
  while scanning {
    cs := typearg_at(src, ts, 0, usize(i))
    if cs.n == 0 { scanning = false } else {
      if byte_type_eek(src, cs.s, cs.n) != 0 { found = true }
      else {
        ae := array_elem_span(src, cs.s, cs.n)
        if ae.n != 0 and byte_type_eek(src, ae.s, ae.n) != 0 { found = true }
      }
      i += 1
    }
  }
  found
}

tuple_standard_byte_words := fn(decls : ptr(rt::Vec), src : ptr(u8), ns : usize, nl : usize, a : rt::Arena) -> usize {
  tt := tuple_local_type(src, ns, nl)
  if tt.n == 0 { return 0 }
  (tuple_standard_byte_bytes(decls, src, tt.s, tt.n, a) + 7) / 8
}

tuple_standard_byte_bytes := fn(decls : ptr(rt::Vec), src : ptr(u8), ts : usize, tl : usize, a : rt::Arena) -> usize {
  if tl == 0 or str_at((src + ts), 1) != "(" { return 0 }
  mut off := 0
  mut al := 1
  mut i := 0
  mut scanning := true
  while scanning {
    cs := typearg_at(src, ts, 0, usize(i))
    if cs.n == 0 { scanning = false } else {
      ca := standard_type_byte_align(decls, src, cs.s, cs.n, 1, a)
      if ca > al { al = ca }
      off = round_up_to(off, ca)
      off += standard_type_byte_size(decls, src, cs.s, cs.n, 1, a)
      i += 1
    }
  }
  round_up_to(off, al)
}

tuple_standard_byte_align_value := fn(decls : ptr(rt::Vec), src : ptr(u8), ts : usize, tl : usize, a : rt::Arena) -> usize {
  if tl == 0 or str_at((src + ts), 1) != "(" { return 0 }
  mut al := 1
  mut i := 0
  mut scanning := true
  while scanning {
    cs := typearg_at(src, ts, 0, usize(i))
    if cs.n == 0 { scanning = false } else {
      ca := standard_type_byte_align(decls, src, cs.s, cs.n, 1, a)
      if ca > al { al = ca }
      i += 1
    }
  }
  al
}

tuple_component_offset := fn(base : ptr(Expr), idx : usize, cx : ptr(LCtx)) -> i64 {
  vn := var_name_span(base)
  if vn.n == 0 { return -1 }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, vn.s, vn.n)))
  if ent.ek != 5 or ent.is_ref or ent.eek != 12 { return -1 }
  tt := tuple_local_type(cx.src, ent.ns, ent.nl)
  if tt.n == 0 { return -1 }
  mut off := 0
  mut al := 1
  mut i := 0
  mut res : i64 = -1
  mut scanning := true
  while scanning {
    cs := typearg_at(cx.src, tt.s, 0, usize(i))
    if cs.n == 0 { scanning = false } else {
      ca := standard_type_byte_align(cx.decls, cx.src, cs.s, cs.n, 1, deref(cx.mar))
      if ca > al { al = ca }
      off = round_up_to(off, ca)
      if i == idx { res = i64(off) }
      off += standard_type_byte_size(cx.decls, cx.src, cs.s, cs.n, 1, deref(cx.mar))
      i += 1
    }
  }
  res
}

tuple_component_byte_eek := fn(base : ptr(Expr), idx : usize, cx : ptr(LCtx)) -> u8 {
  vn := var_name_span(base)
  if vn.n == 0 { return 0 }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, vn.s, vn.n)))
  if tuple_component_offset(base, idx, cx) < 0 { return 0 }
  tt := tuple_local_type(cx.src, ent.ns, ent.nl)
  if tt.n == 0 { return 0 }
  cs := typearg_at(cx.src, tt.s, 0, idx)
  if cs.n == 0 { return 0 }
  ae := array_elem_span(cx.src, cs.s, cs.n)
  if ae.n == 0 { return 0 }
  byte_type_eek(cx.src, ae.s, ae.n)
}

tuple_component_byte_len := fn(base : ptr(Expr), idx : usize, cx : ptr(LCtx)) -> i64 {
  vn := var_name_span(base)
  if vn.n == 0 { return 0 }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, vn.s, vn.n)))
  if tuple_component_byte_eek(base, idx, cx) == 0 { return 0 }
  tt := tuple_local_type(cx.src, ent.ns, ent.nl)
  cs := typearg_at(cx.src, tt.s, 0, idx)
  i64(parse_arr_len(cx.src, cs.s, cs.n))
}

TupleByteComponent := struct { ok : bool, off : i64, len : i64 }
tuple_byte_component_base := fn(base : ptr(Expr), cx : ptr(LCtx)) -> TupleByteComponent {
  z := TupleByteComponent(ok = false, off = 0, len = 0)
  match deref(base) {
    Expr::Index(ib, ii) => {
      idx := num_lit_value(ii)
      eek := tuple_component_byte_eek(ib, usize(idx), cx)
      if eek != 0 {
        return TupleByteComponent(ok = true, off = tuple_component_offset(ib, usize(idx), cx), len = tuple_component_byte_len(ib, usize(idx), cx))
      }
    }
    _ => {}
  }
  z
}

tuple_byte_component_base_eek := fn(base : ptr(Expr), cx : ptr(LCtx)) -> u8 {
  match deref(base) {
    Expr::Index(ib, ii) => { return tuple_component_byte_eek(ib, usize(num_lit_value(ii)), cx) }
    _ => {}
  }
  0
}

tuple_byte_slot_for_off := fn(base : i64, cx : ptr(LCtx)) -> i64 {
  if base < 0 { return -1 }
  mut i := 0
  cnt := svec_len(cx.slots)
  while i < cnt {
    ent := deref(svec_at(SlotEntry, cx.slots, i))
    if i64(ent.off) == base and ent.ek == 5 and ent.eek == 12 and ent.is_ref == false { return i64(i) }
    i += 1
  }
  -1
}

tuple_layout_collect := fn(head : ptr(mut Stmt), slots : ptr(SVec), in out tcomps : SVec, src : ptr(u8), decls : ptr(rt::Vec), a : rt::Arena, mar : ptr(mut rt::Arena)) {
  mut s := head
  while s != 0 {
    st := deref(stmt_p(Stmt, s))
    match st {
      Stmt::Assign(ns, nl, v, nx) => {
        ali := array_lit_info(v)
        if ali.is_a {
          slot := slot_of(slots, src, ns, nl)
          if slot >= 0 {
            ## first pass: uniform? (all components same eek+width). second pass: if mixed, record each.
            mut g0 := ali.ehead
            mut w0 := i64(-1)
            mut ek0 := u8(255)
            mut mixed := false
            while g0 != 0 {
              g0a := deref(arg_p(g0))
              cw := elem_expr_width(g0a.e, slots, decls, src, a)
              ce := comp_eek(g0a.e, slots, src, decls, a)
              if w0 < 0 { w0 = cw; ek0 = ce } else if cw != w0 or ce != ek0 { mixed = true }
              g0 = g0a.next
            }
            if mixed {
              mut g := ali.ehead
              mut idx := 0
              mut cum := i64(0)
              while g != 0 {
                ga := deref(arg_p(g))
                cts := comp_type_span(ga.e, slots, src)
                ## `ek` = 6 marks a component that is a FLAT single-word-position tuple — the ONLY shape the
                ## nested `t.N.M` value-read supports (see `tuple_flat_single_word` + the `emit_gas` Index arm);
                ## every other component keeps `ek` = 5 (the value used elsewhere is `estride`/`eek`, not `ek`).
                mut cmek : u8 = 5
                if tuple_flat_single_word(ga.e, slots, decls, src, a) { cmek = 6 }
                svec_push(tcomps, SlotEntry(ns = usize(slot), nl = usize(idx), off = usize(cum), sns = cts.s, snl = cts.n, ek = cmek, estride = 1, eek = comp_eek(ga.e, slots, src, decls, a), is_ref = false, tmod_s = 0, tmod_l = 0))
                cum += elem_expr_width(ga.e, slots, decls, src, a)
                idx += 1
                g = ga.next
              }
            }
          }
        }
        s = nx
      }
      Stmt::While(c, b, nx) => { tuple_layout_collect(b, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::Loop(b, nx) => { tuple_layout_collect(b, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::Unchecked(b, nx) => { tuple_layout_collect(b, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::AllocWith(ae, b, nx) => { tuple_layout_collect(b, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::Break(_bv, _bd, nx) => { s = nx }
      Stmt::Continue(_cd, nx) => { s = nx }
      Stmt::ExprStmt(e, nx) => { s = nx }
      Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { s = nx }
      Stmt::FieldPathAssign(pl, fpv, nx) => { s = nx }
      Stmt::Return(rv, nx) => { s = nx }
      Stmt::DerefAssign(p, val, nx) => { s = nx }
      Stmt::IndexAssign(ib, ii, iv, nx) => { s = nx }
      Stmt::IndexFieldAssign(fia, fii, ifs, ifl, fiv, nx) => { s = nx }
      Stmt::If(c, th, el, nx) => { tuple_layout_collect(th, slots, tcomps, src, decls, a, mar); tuple_layout_collect(el, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::Match(sc, ah, nx) => { mut arm := ah; while arm != 0 { am := deref(arm_p(arm)); tuple_layout_collect(am.body_stmts, slots, tcomps, src, decls, a, mar); arm = am.next } ; s = nx }
      Stmt::For(fns, fnl, flo, fhi, fb, nx) => { tuple_layout_collect(fb, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::CompIf(cc, ct, ce, nx) => { tuple_layout_collect(ct, slots, tcomps, src, decls, a, mar); tuple_layout_collect(ce, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::CompFor(cvs, cvl, civ, cb, nx) => { tuple_layout_collect(cb, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::CompForRange(rvs, rvl, rlo, rhi, rb, nx) => { tuple_layout_collect(rb, slots, tcomps, src, decls, a, mar); s = nx }
      Stmt::CompMatch(cmsc, cmah, nx) => { mut car : usize = cmah; while car != 0 { cam := deref(arm_p(car)); tuple_layout_collect(cam.body_stmts, slots, tcomps, src, decls, a, mar); car = cam.next } ; s = nx }
    }
  }
}

## Position of the `(` opening a TUPLE parameter type `name : (…)`, or -1 if the param type is not a
## tuple. The parser keeps only a tuple param's FIRST component span, so the full tuple is recovered by
## source-scanning after the param name (the same source-scan discipline as `local_is_mut`). `in`/`out`
## modes sit BEFORE the name, so the scan starts right at the `:`.
param_tuple_open := fn(src : ptr(u8), ns : usize, nl : usize) -> i64 {
  mut i := ns + nl
  mut go := true
  while go { if str_at((src + i), 1) == " " { i = i + 1 } else { go = false } }
  if str_at((src + i), 1) != ":" { return 0 - 1 }
  i = i + 1
  go = true
  while go { if str_at((src + i), 1) == " " { i = i + 1 } else { go = false } }
  if str_at((src + i), 1) == "(" { return i64(i) }
  0 - 1
}
## A tuple COMPONENT type's word width (struct → struct_words, enum → 1 + payload, else scalar 1) and
## KIND (2 struct / 3 enum / 0 scalar) — the type-driven duals of `elem_expr_width` / `comp_eek`, used
## for the tuple-PARAM layout (whose components come from the type text, not initializer expressions).
tuple_comp_width := fn(decls : ptr(rt::Vec), src : ptr(u8), ts : usize, tl : usize, a : rt::Arena) -> usize {
  bn := base_type_name(src, ts, tl)
  if struct_decl_of(decls, src, bn.s, bn.n) >= 0 { return struct_words(decls, src, bn.s, bn.n, a) }
  if enum_decl_of(decls, src, bn.s, bn.n) >= 0 { return 1 + enum_inst_words(decls, src, bn.s, bn.n, a) }
  1
}
tuple_comp_eek := fn(decls : ptr(rt::Vec), src : ptr(u8), ts : usize, tl : usize) -> u8 {
  bn := base_type_name(src, ts, tl)
  if struct_decl_of(decls, src, bn.s, bn.n) >= 0 { return 2 }
  if enum_decl_of(decls, src, bn.s, bn.n) >= 0 { return 3 }
  ## A FLOAT component (`t : (u64, f64)`) is scalar-width but reads on the xmm path — `eek = 9` so a
  ## mixed-tuple PARAM's `t.N` (the float component) uses `addsd`, not the integer `addq`. Uniform
  ## float tuples take the array-param branch above; this covers the MIXED (per-component) layout.
  if type_is_float(decls, src, bn.s, bn.n) { return 9 }
  0
}
## Record per-component layout for a MIXED-kind tuple PARAM (`t : (u64, Pt)`) — the by-ref dual of
## `tuple_layout_collect`. A tuple param is bound by-reference (ek 5) with only the FIRST component as
## its element span, so `t.N.field` for N with a wider/differently-typed component could not resolve
## (a fail-loud reject in `idx_field_index`). Here the full tuple type is recovered by source-scan and
## split with `typearg_at`; if the components are NOT uniform, one `tcomps` entry per component is
## pushed, keyed by the param slot's `off` (matching `tcomp_find`) exactly like the LOCAL case — the
## emit side (`emit_index_addr`'s `is_ref` branch + `idx_field_index`) already consumes these. A UNIFORM
## tuple param keeps the uniform-stride path (no entry) → byte-identical, fixpoint-neutral.
param_tuple_layout_collect := fn(params_head : ptr(mut Param), slots : ptr(SVec), in out tcomps : SVec, src : ptr(u8), decls : ptr(rt::Vec), a : rt::Arena, mar : ptr(mut rt::Arena)) {
  mut p := params_head
  while p != 0 {
    pm := deref(param_p(p))
    open := param_tuple_open(src, pm.ns, pm.nl)
    if open >= 0 {
      slot := slot_of(slots, src, pm.ns, pm.nl)
      if slot >= 0 {
        ## first pass — uniform? (every component the same width AND kind)
        mut w0 := i64(0 - 1)
        mut ek0 : u8 = 255
        mut mixed := false
        mut j := 0
        mut going := true
        while going {
          cs := typearg_at(src, usize(open), 0, usize(j))
          if cs.n == 0 { going = false } else {
            cw := i64(tuple_comp_width(decls, src, cs.s, cs.n, a))
            ce := tuple_comp_eek(decls, src, cs.s, cs.n)
            if w0 < 0 { w0 = cw ; ek0 = ce } else { if cw != w0 { mixed = true } ; if ce != ek0 { mixed = true } }
            j += 1
          }
        }
        ## second pass — record each component (type span for struct/enum, 0/0 for scalar) + cumulative offset
        if mixed {
          mut k := 0
          mut cum := i64(0)
          mut go2 := true
          while go2 {
            cs := typearg_at(src, usize(open), 0, usize(k))
            if cs.n == 0 { go2 = false } else {
              cek := tuple_comp_eek(decls, src, cs.s, cs.n)
              mut tsn := 0
              mut tnl := 0
              if cek != 0 { tsn = cs.s ; tnl = cs.n }
              svec_push(tcomps, SlotEntry(ns = usize(slot), nl = usize(k), off = usize(cum), sns = tsn, snl = tnl, ek = 5, estride = 1, eek = cek, is_ref = false))
              cum += i64(tuple_comp_width(decls, src, cs.s, cs.n, a))
              k += 1
            }
          }
        }
      }
    }
    p = pm.next
  }
}
## STANDARD BYTE TUPLE BOUNDARIES — the supported tier is deliberately local-only. A tuple containing a
## direct byte array has a byte-product layout, while the existing parameter/return/global ABI paths are
## word-based. Reject those consumers before emission rather than letting them silently reinterpret bytes.
validate_standard_byte_tuple_boundaries := fn(decls : ptr(rt::Vec), src : ptr(u8)) {
  cnt := rt::vec_len(deref(decls))
  for i in 0..cnt {
    d := deref(decl_get(decls, i))
    if d.kind == 1 {
      if d.ret_tl != 0 and tuple_span_has_byte_component(src, d.ret_ts, d.ret_tl) {
        panic("selfhost: a standard-layout byte tuple return is not supported yet (return ABI is word-based)")
      }
      mut p := d.params_head
      while p != 0 {
        pm := deref(param_p(p))
        po := param_tuple_open(src, pm.ns, pm.nl)
        if po >= 0 and tuple_span_has_byte_component(src, usize(po), 1) {
          panic("selfhost: a standard-layout byte tuple parameter is not supported yet (parameter ABI is word-based)")
        }
        p = pm.next
      }
    } else if d.kind == 0 and d.is_fn == false and d.ret_tl == 0 and d.arity == 0 {
      if tuple_type_has_byte_component(src, d.name_start, d.name_len) {
        panic("selfhost: a standard-layout byte tuple global is not supported yet (global storage is word-based)")
      }
    }
  }
}
## A tuple component's KIND (2 struct / 3 enum / 0 scalar-or-other) for the mixed-tuple layout table.
comp_eek := fn(e : ptr(Expr), slots : ptr(SVec), src : ptr(u8), decls : ptr(rt::Vec), a : rt::Arena) -> u8 {
  if struct_lit_info(e).is_s { return 2 }
  va := var_agg_info(e, slots, src)
  if va.ek == 2 { return 2 }
  if enum_lit_info(e).is_e { return 3 }
  if va.ek == 3 { return 3 }
  0
}
## A tuple component's struct/enum TYPE span (0/0 if scalar/str/other) for the mixed-tuple layout table.
comp_type_span := fn(e : ptr(Expr), slots : ptr(SVec), src : ptr(u8)) -> CSpan {
  esl := struct_lit_info(e)
  if esl.is_s { return CSpan(s = esl.ss, n = esl.sl) }
  va := var_agg_info(e, slots, src)
  if va.ek == 2 or va.ek == 3 { return CSpan(s = va.s, n = va.n) }
  eil := enum_lit_info(e)
  if eil.is_e { return CSpan(s = eil.es, n = eil.el) }
  CSpan(s = 0, n = 0)
}
## Look up the mixed-tuple component entry for base slot `slot`, component index `idx` (a null-`snl`
## sentinel if absent — the tuple is uniform / not recorded, so callers fall back to the uniform path).
tcomp_find := fn(cx : ptr(LCtx), slot : usize, idx : usize) -> SlotEntry {
  mut i := 0
  cnt := svec_len(cx.tcomps)
  while i < cnt {
    e := deref(svec_at(SlotEntry, cx.tcomps, i))
    if e.ns == slot and e.nl == idx { return e }
    i += 1
  }
  SlotEntry(ns = 0, nl = 0, off = 0, sns = 0, snl = 0, ek = 0, estride = 0, eek = 0, is_ref = false)
}

## Store an `embed(...)` StrLit into an explicitly typed byte-array local. The baked bytes live at the
## absolute arena address in `StrLit.ss`; unlike a normal string literal, `src + ss` is not the payload.
## The destination is the packed array's byte region at `-(base*8)(%rbp)`, the same address convention
## used by `emit_array_assign` for `[u8|i8|bits8; N]`. `n` comes from the declared `[T; N]` type.
emit_embed_byte_assign := fn(v : ptr(Expr), base : i64, n : usize, in out sb : strbuf::StrBuf) {
  si := str_lit_info(v)
  if not si.is_s { panic("selfhost: an embedded byte-array initializer is not a StrLit") }
  if si.sl != n { panic("selfhost: embed byte count does not match the declared fixed-array length") }
  push_str(sb, "  leaq -")
  push_int(sb, base * 8)
  push_str(sb, "(%rbp), %r13\n")
  mut i := 0
  while i < si.sl {
    eb := bytes(str_at(unchecked bitcast(ptr(u8), si.ss + i), 1))[0]
    push_str(sb, "  movb $")
    push_int(sb, i64(usize(eb)))
    push_str(sb, ", ")
    push_int(sb, i)
    push_str(sb, "(%r13)\n")
    i += 1
  }
}

emit_tuple_byte_assign := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  ai := array_lit_info(v)
  if ai.is_a == false { panic("selfhost: a standard-layout byte tuple initializer must be an array/tuple literal") }
  si := tuple_byte_slot_for_off(base, cx)
  if si < 0 { panic("selfhost: standard-layout byte tuple has no slot descriptor") }
  ent := deref(svec_at(SlotEntry, cx.slots, usize(si)))
  tt := tuple_local_type(cx.src, ent.ns, ent.nl)
  if tt.n == 0 { panic("selfhost: standard-layout byte tuple has no declared tuple type") }
  tv := mk_expr(deref(cx.mar), Expr.Var(ent.ns, ent.nl))
  tp := node_ptr(Expr, deref(cx.mar), tv)
  mut g := ai.ehead
  mut i := 0
  while g != 0 {
    cs := typearg_at(cx.src, tt.s, 0, usize(i))
    if cs.n == 0 { panic("selfhost: standard-layout byte tuple initializer has more components than its type") }
    ga := deref(arg_p(g))
    bo := tuple_component_offset(tp, usize(i), cx)
    if bo < 0 { panic("selfhost: standard-layout byte tuple component has no byte offset") }
    aes := array_elem_span(cx.src, cs.s, cs.n)
    mut beek := u8(0)
    if aes.n != 0 { beek = byte_type_eek(cx.src, aes.s, aes.n) }
    if beek != 0 {
      ali := array_lit_info(ga.e)
      if ali.is_a == false { panic("selfhost: a standard-layout byte tuple component must be an array literal") }
      mut ae := ali.ehead
      mut k := 0
      while ae != 0 {
        av := deref(arg_p(ae))
        if struct_lit_info(av.e).is_s or enum_lit_info(av.e).is_e or str_lit_info(av.e).is_s or array_lit_info(av.e).is_a { panic("selfhost: a standard-layout byte tuple array must contain scalar elements") }
        emit_gas(av.e, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movb %al, -")
        push_int(sb, (base + 1) * 8 - bo - i64(k))
        push_str(sb, "(%rbp)\n")
        k += 1
        ae = av.next
      }
    } else if str_at((cx.src + cs.s), cs.n) == "str" or struct_decl_of(cx.decls, cx.src, cs.s, cs.n) >= 0 or enum_decl_of(cx.decls, cx.src, cs.s, cs.n) >= 0 or array_elem_span(cx.src, cs.s, cs.n).n != 0 {
      panic("selfhost: standard-layout byte tuple supports only direct byte-array and scalar components")
    } else {
      emit_gas(ga.e, sb, cx, a, nl)
      push_str(sb, "  popq %rax\n")
      sz := scalar_byte_size(cx.src, cs.s, cs.n)
      if sz == 1 { push_str(sb, "  movb %al, -") }
      else if sz == 2 { push_str(sb, "  movw %ax, -") }
      else if sz == 4 { push_str(sb, "  movl %eax, -") }
      else { push_str(sb, "  movq %rax, -") }
      push_int(sb, (base + 1) * 8 - bo)
      push_str(sb, "(%rbp)\n")
    }
    i += 1
    g = ga.next
  }
}

emit_array_assign := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), in out nl : usize) {
  a := arena_of(cx)
  if tuple_byte_slot_for_off(base, cx) >= 0 {
    emit_tuple_byte_assign(v, base, sb, cx, a, nl)
    return
  }
  ## BYTE-PACKED LOCAL ARRAY INIT. The historical array emitter writes one full word per element;
  ## using it for `[u8|i8|bits8; N]` would both waste 7 bytes per element and make the next local
  ## overlap the live byte region once storage is packed. The base slot is metadata; the reserved
  ## filler immediately below it starts at `-(base*8)(%rbp)` and holds ceil(N/8) words contiguously.
  pslot := packed_byte_slot_for_off(base, cx)
  if pslot >= 0 {
    match deref(v) {
      Expr::ArrayLit(nel, ehead) => {
        push_str(sb, "  leaq -")
        push_int(sb, base * 8)
        push_str(sb, "(%rbp), %r13\n")
        mut g := ehead
        mut k := 0
        while g != 0 {
          ga := deref(arg_p(g))
          if struct_lit_info(ga.e).is_s or enum_lit_info(ga.e).is_e or str_lit_info(ga.e).is_s or array_lit_info(ga.e).is_a {
            panic("selfhost: a byte-packed array literal must contain scalar elements")
          }
          emit_gas(ga.e, sb, cx, a, nl)
          push_str(sb, "  popq %rax\n  movb %al, ")
          push_int(sb, k)
          push_str(sb, "(%r13)\n")
          k += 1
          g = ga.next
        }
      }
      _ => { panic("selfhost: byte-packed array assignment requires an array literal") }
    }
    return
  }
  match deref(v) {
    Expr::ArrayLit(nel, ehead) => {
      ## Emit each element by ITS OWN type at a CUMULATIVE word offset (`cumw`), not the first
      ## element's type at a uniform stride. For a HOMOGENEOUS array (all elements the same size)
      ## this is byte-identical to the old `i*stride` layout; for a HETEROGENEOUS TUPLE literal
      ## `(Pt(…), 9)` it places each component correctly (the old code emitted the scalar `9` via the
      ## struct path — dropping it — so `t.1` read uninitialised). Handles struct / enum / str / scalar
      ## element EXPRs, whether literals (struct_lit_info/…) or aggregate VARs (var_agg_info).
      mut g := ehead
      mut cumw := 0
      while g != 0 {
        ga := deref(arg_p(g))
        ebase := base - cumw          ## §4 UP-GROWING: element at word `cumw` lives at slot `base - cumw`
        esl := struct_lit_info(ga.e)
        eil := enum_lit_info(ga.e)
        esr := str_lit_info(ga.e)
        va := var_agg_info(ga.e, cx.slots, cx.src)
        if esl.is_s {
          emit_struct_assign(ga.e, ebase, sb, cx, a, nl)
          cumw += i64(struct_words(cx.decls, cx.src, esl.ss, esl.sl, a))
        } else if va.ek == 2 {
          emit_struct_assign(ga.e, ebase, sb, cx, a, nl)
          cumw += i64(struct_words(cx.decls, cx.src, va.s, va.n, a))
        } else if eil.is_e {
          emit_enum_assign(ga.e, ebase, sb, cx, a, nl)
          cumw += 1 + i64(enum_inst_words(cx.decls, cx.src, eil.es, eil.el, a))
        } else if va.ek == 3 {
          emit_enum_assign(ga.e, ebase, sb, cx, a, nl)
          cumw += 1 + i64(enum_inst_words(cx.decls, cx.src, va.s, va.n, a))
        } else if esr.is_s {
          ## a str element: store the {ptr, len} pair into the element's two slots (ptr at
          ## `ebase`, len at `ebase+1`) — the same 2-word layout a str-local binding uses.
          emit_str_assign(ga.e, ebase, sb)
          cumw += 2
        } else if array_lit_info(ga.e).is_a {
          ## a TUPLE / nested-ARRAY element (`[(a, b), …]`) — store its components at the element base
          ## via a recursive `emit_array_assign` (ascending within the element), then advance by the
          ## element's component count. Was `emit_gas` → `$0` (a bare ArrayLit has no frame home), so
          ## every tuple element stored one zero word and `xs[i].N` read 0.
          nai := array_lit_info(ga.e)
          emit_array_assign(ga.e, ebase, sb, cx, nl)
          cumw += i64(nai.nel)
        } else {
          emit_gas(ga.e, sb, cx, a, nl)
          push_str(sb, "  popq %rax\n  movq %rax, -")
          push_int(sb, (ebase + 1) * 8)
          push_str(sb, "(%rbp)\n")
          cumw += 1
        }
        g = ga.next
      }
    }
    _ => {}
  }
}

## The base array LOCAL's base slot offset for an `Index(base, idx)` whose base is a `Var`
## array local (`-1` if the base is not a `Var`). The deref-match on the base pointer PARAM
## stays here — the lowerable shape (like `addr_var_slot`/`field_slot`). Used to compute the
## runtime element ADDRESS `-(off+1)*8(%rbp) + idx*8`.
index_base_slot := fn(base : ptr(Expr), cx : ptr(LCtx)) -> i64 {
  match deref(base) {
    Expr::Var(s, n) => { slot_of(cx.slots, cx.src, s, n) }
    _ => { -1 }
  }
}

## The full base array LOCAL's SlotEntry for an `Index(base, idx)` whose base is a `Var` array
## local — carries the element STRIDE (`estride`) and element TYPE span (`sns`/`snl`) needed for
## a multi-word element. The deref-match on the base pointer PARAM stays here (the lowerable
## shape, like `index_base_slot`). A non-`Var` base yields a default entry (stride 1, off 0).
## The slot INDEX of an `Index(base, idx)`'s base array `Var` local (0 if the base is not a `Var`
## — a defensive default never hit by the tree's `a[i]` forms, which always index a Var array
## local). Returns the index — NOT the `SlotEntry` by value (9-word return truncates; see
## `svec_at`/`entry_of`). Callers recover the entry with `deref(svec_at(SlotEntry, slots, …))`.
index_base_entry := fn(base : ptr(Expr), slots : ptr(SVec), src : ptr(u8)) -> usize {
  mut res := 0
  match deref(base) {
    Expr::Var(s, n) => { res = entry_of(slots, src, s, n) }
    _ => {}
  }
  res
}

## Return the slot index of a byte-packed array/slice base, or -1 for every other indexable value.
## The byte tier is intentionally kept behind this narrow predicate: all old word arrays, globals,
## and fields continue through their established paths. Concrete fixed-array parameters reuse the
## same byte element descriptor and pointer ABI as packed locals.
packed_byte_base_entry := fn(base : ptr(Expr), cx : ptr(LCtx)) -> i64 {
  vn := var_name_span(base)
  if vn.n == 0 { return -1 }
  si := entry_of(cx.slots, cx.src, vn.s, vn.n)
  ent := deref(svec_at(SlotEntry, cx.slots, si))
  if streq(cx.src, ent.ns, ent.nl, vn.s, vn.n) and ent.ek == 5 and is_byte_array_eek(ent.eek) { return i64(si) }
  -1
}

packed_byte_slot_for_off := fn(base : i64, cx : ptr(LCtx)) -> i64 {
  if base < 0 { return -1 }
  mut i := 0
  cnt := svec_len(cx.slots)
  while i < cnt {
    ent := deref(svec_at(SlotEntry, cx.slots, i))
    if i64(ent.off) == base and ent.ek == 5 and ent.is_ref == false and is_byte_array_eek(ent.eek) { return i64(i) }
    i += 1
  }
  -1
}

## The concrete STRUCT element type of `xs[i].arr[j]`, when the inner array is a fixed-array FIELD
## directly on a plain-struct array element. This is the binding-side dual of `arr_field_elem`: it
## deliberately returns only the type span, so the existing IVLayout can keep using `arr = Field(…)`
## and `idx = j` to carry the place into `emit_elem_copy_in`. A non-struct element is left to the
## ordinary scalar/read router, where `arr_field_elem` preserves the fail-loud guard for str/enum and
## other multi-word leaves. Packed element structs are rejected because the word-model address
## composition below cannot represent their byte layout.
arr_field_agg_type := fn(v : ptr(Expr), slots : ptr(SVec), src : ptr(u8), decls : ptr(rt::Vec), a : rt::Arena) -> CSpan {
  mut res := CSpan(s = 0, n = 0)
  match deref(v) {
    Expr::Index(base, inner) => {
      fp := field_place_parts(base)
      if unchecked bitcast(usize, fp.base) != 0 {
        ibx := field_base_index(fp.base)
        if ibx.is_ix {
          mut ess := 0
          mut esl := 0
          gmv := global_arr_value(slots, decls, src, var_name_span(ibx.arr).s, var_name_span(ibx.arr).n)
          if unchecked bitcast(usize, gmv) != 0 {
            ali := array_lit_info(gmv)
            if ali.is_a and ali.nel > 0 {
              ge := struct_lit_info(arg_expr_at(ali.ehead, 0, a))
              if ge.is_s { ess = ge.ss; esl = ge.sl }
            }
          } else {
            ent := deref(svec_at(SlotEntry, slots, index_base_entry(ibx.arr, slots, src)))
            if ent.eek == 2 and ent.snl != 0 { ess = ent.sns; esl = ent.snl }
          }
          if esl != 0 {
            fts := field_type_span(decls, src, ess, esl, fp.fs, fp.fl, a)
            ae := array_elem_span(src, fts.s, fts.n)
            if ae.n != 0 and struct_decl_of(decls, src, ae.s, ae.n) >= 0 {
              if is_packed(decls, src, ae.s, ae.n) {
                panic("selfhost: `xs[i].arr[j]` over a @packed aggregate array-field element is not yet supported")
              }
              res = ae
            }
          }
        }
      }
    }
    _ => {}
  }
  res
}

## A WHOLE-ELEMENT read `n := arr[i]` analysis — whether the value expr is an `Index` into an
## AGGREGATE-element array (`eek` 2 struct / 3 enum), and if so the array base + index Expr
## pointers + the element layout (stride, eek, element type span). Used by the `Assign` arm to
## copy an aggregate element into an aggregate LOCAL (the whole-element READ). A word-sized
## element array (`eek == 0`) is NOT an aggregate copy — `is_agg` false, handled by the scalar
## `a[i]` read. The two nested deref-matches stay in pointer-PARAM helpers (the lowerable shape).
## The ELEMENT struct type span of a `Slice(<Struct>)` VALUE local (`ek == 2`, base name "Slice"),
## when that element is a MULTI-WORD struct (`> 1` word); 0/0 otherwise. Recovered from the slice
## struct's mono type-name span (`sns`/`snl` → "Slice(Rec)" → type-arg 0 → "Rec"). Drives the
## whole-element copy `v := sl[i]` for a slice built over arbitrary (arena/mmap) memory — the
## `omap_values` / constructed-`Slice(T)` shape whose backing is laid out UPWARD (element i at
## `ptr + i*stride*8`, field k at `+k*8`), reached through the slice's word-0 data pointer. Gated to
## `> 1` word so a scalar/word/byte element (`Slice(u64)`, `Slice(u8)`) keeps its existing scalar
## `sl[i]` read byte-identical; a 1-word struct also stays on the scalar path (unchanged).
slice_val_struct_espan := fn(src : ptr(u8), sns : usize, snl : usize, decls : ptr(rt::Vec), a : rt::Arena) -> CSpan {
  bn := base_type_name(src, sns, snl)
  if str_at((src + bn.s), bn.n) != "Slice" { return CSpan(s = 0, n = 0) }
  eta := typearg_at(src, sns, snl, 0)
  if eta.n == 0 { return CSpan(s = 0, n = 0) }
  if struct_decl_of(decls, src, eta.s, eta.n) < 0 { return CSpan(s = 0, n = 0) }
  if struct_words(decls, src, eta.s, eta.n, a) <= 1 { return CSpan(s = 0, n = 0) }
  CSpan(s = eta.s, n = eta.n)
}

## The `str` element type of a `Slice(str)` VALUE local. Unlike a named struct element, `str` is
## already a two-word view and has no declaration/word-count lookup to perform. Keep this fact
## separate from `slice_val_struct_espan`: both callers need the concrete element span, but the
## aggregate copier needs only the fixed two-word stride while the slot binder needs eek 4.
slice_val_str_espan := fn(src : ptr(u8), sns : usize, snl : usize) -> CSpan {
  bn := base_type_name(src, sns, snl)
  if str_at((src + bn.s), bn.n) != "Slice" { return CSpan(s = 0, n = 0) }
  eta := typearg_at(src, sns, snl, 0)
  if eta.n == 0 or str_at((src + eta.s), eta.n) != "str" { return CSpan(s = 0, n = 0) }
  CSpan(s = eta.s, n = eta.n)
}

## Word stride for a multiword element of a `Slice(T)` VALUE. The `str` case is deliberately
## explicit: it is a two-word `{ptr,len}` element even though `str` is not a named struct declaration.
slice_val_elem_stride := fn(src : ptr(u8), sns : usize, snl : usize, decls : ptr(rt::Vec), a : rt::Arena) -> usize {
  sse := slice_val_str_espan(src, sns, snl)
  if sse.n != 0 { return 2 }
  sse2 := slice_val_struct_espan(src, sns, snl, decls, a)
  if sse2.n != 0 { return struct_words(decls, src, sse2.s, sse2.n, a) }
  0
}

IVLayout := struct { is_agg : bool, arr : ptr(Expr), idx : ptr(Expr), stride : usize, eek : u8, ess : usize, esl : usize }
index_value_layout := fn(v : ptr(Expr), slots : ptr(SVec), src : ptr(u8), decls : ptr(rt::Vec), a : rt::Arena) -> IVLayout {
  z := unchecked bitcast(ptr(Expr), 0)
  mut res := IVLayout(is_agg = false, arr = z, idx = z, stride = 1, eek = 0, ess = 0, esl = 0)
  match deref(v) {
    Expr::Index(b, i) => {
      ## `p := xs[i].arr[j]` — the INDEX base is a Field, so index_base_entry(b) cannot see the
      ## enclosing array's SlotEntry. Keep the Field base + inner index in the same IVLayout shape;
      ## emit_elem_copy_in composes the outer element address, array-field offset, and inner stride.
      afe := arr_field_agg_type(v, slots, src, decls, a)
      if afe.n != 0 {
        res = IVLayout(is_agg = true, arr = b, idx = i, stride = struct_words(decls, src, afe.s, afe.n, a), eek = 2, ess = afe.s, esl = afe.n)
      } else {
      ent := deref(svec_at(SlotEntry, slots, index_base_entry(b, slots, src)))
      if ent.ek == 5 and (ent.eek == 2 or ent.eek == 3 or ent.eek == 4) {
        res = IVLayout(is_agg = true, arr = b, idx = i, stride = ent.estride, eek = ent.eek, ess = ent.sns, esl = ent.snl)
      } else if ent.ek == 2 and var_name_span(b).n != 0 and slice_val_str_espan(src, ent.sns, ent.snl).n != 0 {
        ## `v := sl[i]` where `sl` is a `Slice(str)` VALUE (arena/mmap-backed, e.g. `oset_as_slice`)
        ## — a whole-element STR copy. `str` is a two-word `{ptr,len}` value, so preserve eek 4 and
        ## stride 2 instead of letting the ordinary Slice VALUE path read one word at `ptr + i*8`.
        se := slice_val_str_espan(src, ent.sns, ent.snl)
        res = IVLayout(is_agg = true, arr = b, idx = i, stride = 2, eek = 4, ess = se.s, esl = se.n)
      } else if ent.ek == 2 and var_name_span(b).n != 0 and slice_val_struct_espan(src, ent.sns, ent.snl, decls, a).n != 0 {
        ## `v := sl[i]` where `sl` is a `Slice(<Struct>)` VALUE (arena/mmap-backed, e.g. `omap_values`)
        ## — a whole-element STRUCT copy. Stride = the element struct's word count; element type span
        ## carried so `v` binds as that struct. `emit_elem_copy_in` reads it UPWARD through the slice's
        ## data pointer (distinct from the frame-array / global-array element sources).
        se := slice_val_struct_espan(src, ent.sns, ent.snl, decls, a)
        res = IVLayout(is_agg = true, arr = b, idx = i, stride = struct_words(decls, src, se.s, se.n, a), eek = 2, ess = se.s, esl = se.n)
      } else {
        ## a STRUCT-element mutable ARRAY GLOBAL indexed (`e := ARR[i]`, ARR a `mut [Pt; N]` global —
        ## no frame slot). Resolve the element struct type + stride from the global's ArrayLit first
        ## element, so `e` binds as that struct (the emit copies it from the global's `.data`).
        bvn := var_name_span(b)
        if bvn.n != 0 {
          gmv := mut_global_value(decls, src, bvn.s, bvn.n)
          if unchecked bitcast(usize, gmv) != 0 and array_lit_info(gmv).is_a {
            gesli := struct_lit_info(arg_expr_at(array_lit_info(gmv).ehead, 0, a))
            if gesli.is_s {
              gw := struct_words(decls, src, gesli.ss, gesli.sl, a)
              res = IVLayout(is_agg = true, arr = b, idx = i, stride = gw, eek = 2, ess = gesli.ss, esl = gesli.sl)
            }
          }
          ## an ENUM-element ARRAY GLOBAL indexed (`e := GE[i]`, `mut` or const) — bind `e` as that enum
          ## (`1 + enum_inst_words` words: disc + widest payload) so a following `match e` / payload read
          ## works; `emit_elem_copy_in` copies element i's words out of the global's `.data`.
          if res.is_agg == false {
            gaen := global_arr_enum(decls, src, global_arr_value(slots, decls, src, bvn.s, bvn.n), a)
            if gaen.is_e {
              res = IVLayout(is_agg = true, arr = b, idx = i, stride = gaen.stride, eek = 3, ess = gaen.es, esl = gaen.el)
            }
          }
        }
      }
      }
    }
    _ => {}
  }
  res
}


## NESTED PLACE `v.buf[i]` — analysis of an `Index`'s base when that base is a `Field(v, f)`
## (a struct field that is itself an array). `is_fld` true means the index target is an array
## FIELD: `ent` is the base struct slot entry and `foff` is the field's CUMULATIVE word offset.
## A plain `Var` root keeps the existing local/by-ref aggregate path. A `deref(Var)` root is
## admitted only for a scalar array element: its pointer slot is loaded by the place emitter,
## while aggregate elements stay on the deliberate non-local reject path below. A deeper nesting
## `a.b.c[i]` is still deferred.
## Carries the base-struct slot INDEX (`ent_idx`), NOT an embedded `SlotEntry` (a 9-word field →
## an 11-word value the ≤3-register struct-return truncates). Recover via `deref(svec_at(…))`.
FldIxBase := struct { is_fld : bool, ent_idx : usize, foff : i64, flen : i64 }
## The base var name span of a `Field`'s base when that base is a `Var` (the struct holding the
## array field). Isolated into its own pointer-PARAM helper so the deref-match on `fb` stays a
## function-body match over a direct param (a nested `match deref(<enum-pattern-bound ptr>)`
## is NOT lowered — the documented gotcha). `ok` false means the base is not a plain `Var`.
FldBaseVar := struct { ok : bool, s : usize, n : usize }
field_base_var := fn(fb : ptr(Expr)) -> FldBaseVar {
  match deref(fb) {
    Expr::Var(s, n) => { FldBaseVar(ok = true, s = s, n = n) }
    _ => { FldBaseVar(ok = false, s = 0, n = 0) }
  }
}
field_index_base := fn(base : ptr(Expr), cx : ptr(LCtx)) -> FldIxBase {
  mut res := FldIxBase(is_fld = false, ent_idx = 0, foff = 0, flen = 0)
  match deref(base) {
    Expr::Field(fb, fs, fl) => {
      bv := field_base_vp(fb)
      if bv.ok {
        ix := entry_of(cx.slots, cx.src, bv.s, bv.n)
        ent := deref(svec_at(SlotEntry, cx.slots, ix))
        fts := field_type_span(cx.decls, cx.src, ent.sns, ent.snl, fs, fl, deref(cx.mar))
        ## POINTER-DERIVED ROOT — `deref(p).field[i]` is safe here only when the array element is
        ## one scalar word. The generic address path has no aggregate copy consumer; admitting a
        ## `[Struct; N]`/`[str; N]` element would reopen the silent wrong-address path guarded below.
        mut root_ok := true
        if bv.via_ptr {
          if ent.ek != 7 { root_ok = false }
          paes := array_elem_span(cx.src, fts.s, fts.n)
          if paes.n == 0 { root_ok = false }
          if paes.n != 0 {
            if array_elem_span(cx.src, paes.s, paes.n).n != 0 { root_ok = false }
            if str_at((cx.src + paes.s), paes.n) == "str" { root_ok = false }
            if struct_decl_of(cx.decls, cx.src, paes.s, paes.n) >= 0 { root_ok = false }
            if enum_decl_of(cx.decls, cx.src, paes.s, paes.n) >= 0 { root_ok = false }
          }
        }
        if root_ok {
          fo := field_word_offset(cx.decls, cx.src, ent.sns, ent.snl, fs, fl, deref(cx.mar))
          ## the array FIELD's static length `[T; N]` → N, for the I11 bounds check (0 = not an array
          ## field / unknown → no check). Recovered from the field's declared type span.
          ## COMPTIME-VALUE-GENERIC: a computed length `[T; <expr>]` folds against the instance's
          ## comptime-value bindings (`uint(192)` → 3), so the bounds check covers it too.
          mut fln := i64(parse_arr_len(cx.src, fts.s, fts.n))
          if fln == 0 { fln = i64(ct_arr_len(cx.decls, cx.src, ent.sns, ent.snl, fts.s, fts.n, deref(cx.mar))) }
          if fo >= 0 { res = FldIxBase(is_fld = true, ent_idx = ix, foff = fo, flen = fln) }
        }
      }
    }
    _ => {}
  }
  res
}

## `v.bytes[i]` where `bytes : [u8|i8|bits8; N]` is an explicit field of a `@packed` struct.
## This is deliberately separate from `FldIxBase`: its 3-word return stays within the self-host
## aggregate-return limit, while callers recover the containing struct entry through field_index_base.
PackedByteField := struct { ok : bool, off : i64, len : i64 }
packed_byte_field := fn(base : ptr(Expr), cx : ptr(LCtx)) -> PackedByteField {
  mut res := PackedByteField(ok = false, off = 0, len = 0)
  fp := field_place_parts(base)
  if unchecked bitcast(usize, fp.base) == 0 { return res }
  bv := field_base_var(fp.base)
  if not bv.ok { return res }
  ix := entry_of(cx.slots, cx.src, bv.s, bv.n)
  ent := deref(svec_at(SlotEntry, cx.slots, ix))
  if ent.ek != 2 or ent.snl == 0 { return res }
  if not is_packed(cx.decls, cx.src, ent.sns, ent.snl) { return res }
  fts := field_type_span(cx.decls, cx.src, ent.sns, ent.snl, fp.fs, fp.fl, deref(cx.mar))
  aes := array_elem_span(cx.src, fts.s, fts.n)
  if aes.n == 0 or byte_type_eek(cx.src, aes.s, aes.n) == 0 { return res }
  mut n := parse_arr_len(cx.src, fts.s, fts.n)
  if n == 0 { n = ct_arr_len(cx.decls, cx.src, ent.sns, ent.snl, fts.s, fts.n, deref(cx.mar)) }
  bo := packed_field_byte_offset(cx.decls, cx.src, ent.sns, ent.snl, fp.fs, fp.fl, deref(cx.mar))
  if bo >= 0 and n > 0 { res = PackedByteField(ok = true, off = bo, len = i64(n)) }
  res
}

## The byte element kind for the same packed byte-array field. Kept as a scalar query so the address
## helper does not return a fourth word (which would be truncated by the self-host ABI).
packed_byte_field_eek := fn(base : ptr(Expr), cx : ptr(LCtx)) -> u8 {
  fp := field_place_parts(base)
  if unchecked bitcast(usize, fp.base) == 0 { return 0 }
  bv := field_base_var(fp.base)
  if not bv.ok { return 0 }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, bv.s, bv.n)))
  if ent.ek != 2 or ent.snl == 0 or not is_packed(cx.decls, cx.src, ent.sns, ent.snl) { return 0 }
  fts := field_type_span(cx.decls, cx.src, ent.sns, ent.snl, fp.fs, fp.fl, deref(cx.mar))
  aes := array_elem_span(cx.src, fts.s, fts.n)
  if aes.n == 0 { return 0 }
  byte_type_eek(cx.src, aes.s, aes.n)
}

## The ordinary-struct dual of `packed_byte_field`: an explicitly byte-typed fixed-array FIELD whose
## containing struct uses the shared standard layout tier. The returned offset is ASCENDING from the
## aggregate word-0 address, so the same address consumer works for an inline local, a by-ref param,
## and the pointee of `deref(p)` when `p` is a pointer-to-struct slot.
StandardByteField := struct { ok : bool, off : i64, len : i64 }
standard_byte_field := fn(base : ptr(Expr), cx : ptr(LCtx)) -> StandardByteField {
  mut res := StandardByteField(ok = false, off = 0, len = 0)
  fp := field_place_parts(base)
  if unchecked bitcast(usize, fp.base) == 0 { return res }
  bv := field_base_vp(fp.base)
  if not bv.ok { return res }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, bv.s, bv.n)))
  ## A pointer-derived root stores the pointee address in an ek-7 scalar slot. Its `sns`/`snl`
  ## still name the containing struct, so the byte-layout oracle is valid; all other non-struct
  ## roots remain outside this helper's domain.
  if ent.snl == 0 or (ent.ek != 2 and (ent.ek != 7 or not bv.via_ptr)) or is_packed(cx.decls, cx.src, ent.sns, ent.snl) { return res }
  if not std_struct_has_direct_byte_layout(cx.decls, cx.src, ent.sns, ent.snl, deref(cx.mar)) { return res }
  fts := field_type_span(cx.decls, cx.src, ent.sns, ent.snl, fp.fs, fp.fl, deref(cx.mar))
  aes := array_elem_span(cx.src, fts.s, fts.n)
  if aes.n == 0 or byte_type_eek(cx.src, aes.s, aes.n) == 0 { return res }
  mut n := parse_arr_len(cx.src, fts.s, fts.n)
  if n == 0 { n = ct_arr_len(cx.decls, cx.src, ent.sns, ent.snl, fts.s, fts.n, deref(cx.mar)) }
  bo := standard_field_byte_offset(cx.decls, cx.src, ent.sns, ent.snl, fp.fs, fp.fl, deref(cx.mar))
  if bo >= 0 and n > 0 { res = StandardByteField(ok = true, off = bo, len = i64(n)) }
  res
}

standard_byte_field_eek := fn(base : ptr(Expr), cx : ptr(LCtx)) -> u8 {
  fp := field_place_parts(base)
  if unchecked bitcast(usize, fp.base) == 0 { return 0 }
  bv := field_base_vp(fp.base)
  if not bv.ok { return 0 }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, bv.s, bv.n)))
  if ent.snl == 0 or (ent.ek != 2 and (ent.ek != 7 or not bv.via_ptr)) or is_packed(cx.decls, cx.src, ent.sns, ent.snl) { return 0 }
  if not std_struct_has_direct_byte_layout(cx.decls, cx.src, ent.sns, ent.snl, deref(cx.mar)) { return 0 }
  fts := field_type_span(cx.decls, cx.src, ent.sns, ent.snl, fp.fs, fp.fl, deref(cx.mar))
  aes := array_elem_span(cx.src, fts.s, fts.n)
  if aes.n == 0 { return 0 }
  byte_type_eek(cx.src, aes.s, aes.n)
}

## Emit code computing an array element's ADDRESS into %rax for `a[i]`. The frame GROWS DOWN
## (element 0 at -(base_off+1)*8(%rbp), element `i` at element-0's address MINUS `i*stride*8`),
## so the element address is `base_element0_addr - index*stride*8` — a SUBTRACTION, NOT the SIB
## `+index*…` which ADDS. Steps: lower the index (value on the stack), pop it into %rax, scale
## `imulq $(stride*8), %rax` (= index*stride*8), load element 0's frame ADDRESS into %rbx
## (`leaq`, does not touch %rax), then `subq %rax, %rbx` and move the result into %rax. The
## RUNTIME-index address computation, now stride-aware (stride = the element's size in words: 1
## for a word-sized element — byte-identical to the old path — nfields for a struct element,
## 1+max_arity for an enum element). Only a `Var` array-local base is supported.
## Is `base` a `Slice(T)` VALUE var (a `{ptr, len}` struct — `ek == 2`, struct base name "Slice")?
## Indexing one derefs its `ptr` field (element `k` at `ptr + k*8`, the arena's UPWARD element
## layout that `push` writes) — NOT the struct's own frame words. `ok`/`off`/`is_ref` drive the
## `Expr::Index` slice arm; a non-Slice base yields `ok = false` (falls to the array-index path).
SlRef := struct { ok : bool, off : usize, is_ref : bool, is_byte : bool }
slice_var_ref := fn(base : ptr(Expr), cx : ptr(LCtx)) -> SlRef {
  mut res := SlRef(ok = false, off = 0, is_ref = false, is_byte = false)
  vn := var_name_span(base)
  if vn.n != 0 {
    ei := entry_of(cx.slots, cx.src, vn.s, vn.n)
    ent := deref(svec_at(SlotEntry, cx.slots, ei))
    if streq(cx.src, ent.ns, ent.nl, vn.s, vn.n) and ent.ek == 2 {
      bn := base_type_name(cx.src, ent.sns, ent.snl)
      if str_at((cx.src + bn.s), bn.n) == "Slice" {
        ## the element type is the slice's first type-arg (`Slice(u8)` → `u8`); a BYTE element
        ## (`u8`/`i8`/`bits8`) indexes at stride 1 with a byte load, not the word (stride-8) default.
        ## SlotEntry.sns/snl may carry the FULL concrete application span (for example
        ## `Slice(u8)`) when the binding came from a generic enum payload. `typearg_at`
        ## deliberately accepts the HEAD span and scans the following `(…)`; passing the
        ## full span made it look like a scalar-element Slice and silently selected the
        ## word-stride path. Keep the full span in the slot for layout, but strip only for
        ## type-argument recovery here.
        eta := typearg_at(cx.src, bn.s, bn.n, 0)
        mut isb := false
        if eta.n != 0 {
          etx := str_at((cx.src + eta.s), eta.n)
          if etx == "u8" or etx == "i8" or etx == "bits8" { isb = true }
        }
        res = SlRef(ok = true, off = ent.off, is_ref = ent.is_ref, is_byte = isb)
      }
    }
    ## A `str` / str-VIEW local (`ek == 4` — a `{ptr, len}` binding from a literal, `bytes(x)`,
    ## `sub(…)`, `str_at(…)`, or a str-returning call): `s[i]` is a BYTE read (`str` IS `[u8]`,
    ## appendix 160 §3.5) — the byte at `ptr + i` (ptr = word 0). Reuses the Slice arm's non-ref
    ## load (`movq slot0 → ptr`) + the `is_byte` `movzbq` path. Without this a `bs := bytes(t);
    ## bs[i]` (as in `alloc::strbuf::push_str`'s copy loop) fell to the frame-array word read, which
    ## read the {ptr,len} slots themselves as "bytes" → garbage text. `src/` indexes only the DIRECT
    ## `bytes(x)[i]` form (handled by the `Index` arm's `bytes_view_arg` case), never a str LOCAL, so
    ## this is fixpoint-neutral.
    else if streq(cx.src, ent.ns, ent.nl, vn.s, vn.n) and ent.ek == 4 {
      res = SlRef(ok = true, off = ent.off, is_ref = ent.is_ref, is_byte = true)
    }
  }
  res
}

## Is the indexed element of this `Slice(T)` VALUE a `str` pair? Keep it as a scalar query rather
## than widening `SlRef`: that return already sits on a tight self-host ABI boundary. `Slice(str)` is
## represented by the same two-word slice struct as every other `Slice(T)`, but its element stride is
## 2 words and its value cannot be loaded by the one-word `emit_gas` path.
slice_var_is_str_elem := fn(base : ptr(Expr), cx : ptr(LCtx)) -> bool {
  vn := var_name_span(base)
  if vn.n == 0 { return false }
  ei := entry_of(cx.slots, cx.src, vn.s, vn.n)
  ent := deref(svec_at(SlotEntry, cx.slots, ei))
  if ent.ek != 2 or streq(cx.src, ent.ns, ent.nl, vn.s, vn.n) == false { return false }
  slice_val_str_espan(cx.src, ent.sns, ent.snl).n != 0
}

## Emit the address of an element of a `Slice(T)` local or payload binding. A Slice is an UP-growing
## `{ptr,len}` view: byte elements live at `ptr + i`, ordinary word elements at `ptr + i*8`, and
## `str` elements at `ptr + i*16` because each element is a `{ptr,len}` pair. The caller chooses the
## store width from `slice_base_is_byte`, so a byte address can never be paired with the generic
## clobbering `movq` store.
emit_slice_index_addr := fn(base : ptr(Expr), idx : ptr(Expr), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) -> bool {
  slr := slice_var_ref(base, cx)
  if slr.ok == false { return false }
  if slr.is_ref {
    push_str(sb, "  movq -")
    push_int(sb, i64((slr.off + 1) * 8))
    push_str(sb, "(%rbp), %rax\n  movq (%rax), %rax\n")
  } else {
    push_str(sb, "  movq -")
    push_int(sb, i64((slr.off + 1) * 8))
    push_str(sb, "(%rbp), %rax\n")
  }
  push_str(sb, "  pushq %rax\n")
  emit_gas(idx, sb, cx, a, nl)
  push_str(sb, "  popq %r8\n")
  if cx.vchk and slr.is_ref == false {
    push_str(sb, "  cmpq -")
    push_int(sb, i64(slr.off * 8))
    push_str(sb, "(%rbp), %r8\n  jb 1f\n  ud2\n1:\n")
  }
  push_str(sb, "  popq %rax\n")
  if slr.is_byte {
    push_str(sb, "  addq %r8, %rax\n")
  } else if slice_var_is_str_elem(base, cx) {
    push_str(sb, "  imulq $16, %r8\n  addq %r8, %rax\n")
  } else {
    push_str(sb, "  imulq $8, %r8\n  addq %r8, %rax\n")
  }
  true
}

slice_base_is_byte := fn(base : ptr(Expr), cx : ptr(LCtx)) -> bool {
  slr := slice_var_ref(base, cx)
  slr.ok and slr.is_byte
}

## Does the local/param variable `[s,n)` carry a mixed-kind tuple `tcomps` layout (i.e. it is a
## non-uniform tuple)? Used to detect a nested `t.N.M` access whose uniform stride math would be wrong.
var_has_tcomps := fn(cx : ptr(LCtx), s : usize, n : usize) -> bool {
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, s, n)))
  mut i := 0
  mut r := false
  cnt := svec_len(cx.tcomps)
  while i < cnt {
    e := deref(svec_at(SlotEntry, cx.tcomps, i))
    if e.ns == ent.off { r = true }
    i += 1
  }
  r
}

## Types §9.4 — is `base` a 2-word `{ptr, len}` VIEW FIELD (`g.v` with `v : Slice(T)` / `v : str`) used
## as an INDEX base? Returns that field's element BYTE stride (0 = not a pair field). This is the
## discriminator the inline-array-FIELD path needs: `field_index_base` reports `is_fld` for EVERY
## resolvable struct field, and the `[T; N]` element math it emits (`field word 0 + i*elem_words*8`)
## is right ONLY when the field's words ARE the elements. A `Slice(T)`/`str` field instead holds a
## POINTER to elements living elsewhere, so the element address must be `load(field word 0) +
## i*stride` — the same read the slice-LOCAL path (`slice_var_ref`) does. Without this split
## `st.v[0]`/`st.v[1]` read the {ptr, len} words themselves (`st.name[1]` returned the LEN) — SILENT.
## Stride: 1 for a BYTE element (`str`, `Slice(u8)`/`i8`/`bits8` — `str` IS `[u8]`, appendix 160
## §3.5), else `field_words(T) * 8` (8 for a word element, the full width for a struct element).
## An INLINE `[T; N]` field has no `Slice(`/`str` type → 0 → the untouched array-field path.
pair_field_elem_stride := fn(base : ptr(Expr), cx : ptr(LCtx), a : rt::Arena) -> i64 {
  if str_field_place(base, cx, a).found == false { return 0 }
  fp := field_place_parts(base)
  bv := field_base_var(fp.base)
  se := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, bv.s, bv.n)))
  fts := field_type_span(cx.decls, cx.src, se.sns, se.snl, fp.fs, fp.fl, a)
  if str_at((cx.src + fts.s), fts.n) == "str" { return 1 }
  eta := typearg_at(cx.src, fts.s, fts.n, 0)
  if eta.n == 0 { return 8 }
  etx := str_at((cx.src + eta.s), eta.n)
  if etx == "u8" or etx == "i8" or etx == "bits8" { return 1 }
  i64(field_words(cx.decls, cx.src, eta.s, eta.n, 1, a)) * 8
}

## Emit the ELEMENT ADDRESS of `base[idx]` where `base` is a 2-word `{ptr, len}` VIEW FIELD
## (`pair_field_elem_stride != 0`) into %rax. The index is lowered FIRST (its lowering may clobber
## %rbx/%rcx), then the field's DATA pointer → %rbx and its runtime LEN → %rcx — read straight from
## the two frame words for an INLINE struct local, or through the caller's word-0 pointer at the
## field's ASCENDING pointee offsets for a BY-REFERENCE struct param. I11 §358: the index is trapped
## against the runtime len (`jb`, so a negative i64 index — huge unsigned — also traps); dropped in an
## `unchecked` scope (CG-7). Then element address = data pointer + index*stride.
emit_pair_field_index_addr := fn(base : ptr(Expr), idx : ptr(Expr), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  pfp := str_field_place(base, cx, a)
  emit_gas(idx, sb, cx, a, nl)                    ## index → stack (lowered first)
  if pfp.is_ref {
    push_str(sb, "  movq -")
    push_int(sb, i64((pfp.off + 1) * 8))
    push_str(sb, "(%rbp), %rax\n  movq ")
    push_int(sb, i64(pfp.fldoff * 8))
    push_str(sb, "(%rax), %rbx\n  movq ")
    push_int(sb, i64((pfp.fldoff + 1) * 8))
    push_str(sb, "(%rax), %rcx\n")
  } else {
    push_str(sb, "  movq -")
    push_int(sb, i64((pfp.off + 1) * 8))
    push_str(sb, "(%rbp), %rbx\n  movq -")
    push_int(sb, i64(pfp.off * 8))
    push_str(sb, "(%rbp), %rcx\n")
  }
  push_str(sb, "  popq %rax\n")
  if cx.vchk { push_str(sb, "  cmpq %rcx, %rax\n  jb 1f\n  ud2\n1:\n") }
  push_str(sb, "  imulq $")
  push_int(sb, pair_field_elem_stride(base, cx, a))
  push_str(sb, ", %rax\n  addq %rax, %rbx\n  movq %rbx, %rax\n")
}

## Emit the two-word store for a str-literal binding `name := "…"` — the {ptr, len} pair
## stored into the str local's reserved slots: ptr (`leaq .Lstr<idx>(%rip)`) at slot `base`,
## len (the immediate byte count) at slot `base+1`. The deref-match on the value pointer `v`
## stays here (a pointer PARAM) — the lowerable shape (like `emit_struct_assign`).
emit_str_assign := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf) {
  match deref(v) {
    Expr::StrLit(ss, sl, lbl) => {
      ## ptr word at slot `base`
      push_str(sb, "  leaq ")
      push_lstr(sb, lbl)
      push_str(sb, "(%rip), %rax\n  movq %rax, -")
      push_int(sb, (base + 1) * 8)
      push_str(sb, "(%rbp)\n")
      ## len word at slot `base+1`
      push_str(sb, "  movq $")
      push_int(sb, i64(sl))
      push_str(sb, ", %rax\n  movq %rax, -")
      push_int(sb, base * 8)
      push_str(sb, "(%rbp)\n")
    }
    _ => {}
  }
}

## Types §9.4 — store a 2-word `{ptr, len}` VIEW value (`str` / `Slice(T)`) into the two contiguous
## frame slots whose word 0 (the pointer) is `base`: ptr at `-(base+1)*8`, len at `-base*8` — the same
## layout `emit_str_assign` writes for a literal and `emit_str_pair` reads back. A str LITERAL keeps
## the byte-identical `emit_str_assign` path; ANY OTHER str/slice-valued expression (a str `Var`, a
## `sub`/`str_at`/`bytes` view, a range slice `xs[lo..hi]`, a str-returning call) materializes its pair
## on the stack via `emit_str_pair` and pops it in — exactly the `emit_sub_assign` shape, generalized
## from `sub(…)` to every str-expression kind. Fixes the struct-LITERAL field store, where a
## non-literal `str` field value hit `emit_str_assign`'s `_ => {}` (NOTHING stored, `f.len` read 0)
## and a `Slice(T)` field value hit `emit_array_assign`'s `_ => {}` (likewise nothing) — both SILENT.
emit_pair_field_store := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  if str_lit_info(v).is_s { emit_str_assign(v, base, sb) ; return }
  emit_str_pair(v, sb, cx, a, nl)   ## stack: [ptr (deep), len (top)]
  push_str(sb, "  popq %rax\n  movq %rax, -")
  push_int(sb, base * 8)
  push_str(sb, "(%rbp)\n  popq %rax\n  movq %rax, -")
  push_int(sb, (base + 1) * 8)
  push_str(sb, "(%rbp)\n")
}

## Types §9.4 — is `e` a `{ptr, len}` VIEW value `emit_str_pair` materializes as a 2-word pair? A str
## literal, a range slice `xs[lo..hi]`, a `sub`/`str_at`/`bytes` view, or a `Var` bound as a str local
## (ek 4) / an array-slice view or slice param (ek 5 + `is_ref`). Gates the 2-word field store above,
## so ONLY a field that today stores NOTHING (the `emit_array_assign` `_ => {}` fall-through) is
## rerouted — every other struct-literal field path is untouched.
pair_value_expr := fn(e : ptr(Expr), cx : ptr(LCtx)) -> bool {
  if str_lit_info(e).is_s { return true }
  if is_slice_expr(e) { return true }
  if is_sub_call(e, cx.src) { return true }
  if is_strat_call(e, cx.src) { return true }
  if is_bytes_call(e, cx.src) { return true }
  vn := var_name_span(e)
  if vn.n == 0 { return false }
  ent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, vn.s, vn.n)))
  if streq(cx.src, ent.ns, ent.nl, vn.s, vn.n) == false { return false }
  if ent.ek == 4 { return true }
  if ent.ek == 5 and ent.is_ref { return true }
  false
}

## §8 `@niche` — construct a NICHE-FOLDED `Option(ptr(T))` value (Types §6.2/§8, Memory §4.2) into
## its ONE-word slot: no discriminant, the single word at `-(base+1)*8` (the slot's word 0, where
## `emit_repr_tag_load` reads it in a `match`). `Option.None` → store `0` (the null niche); a payload
## variant `Option.Some(p)` → lower the pointer expression `p` and store it (a non-null `ptr` is
## nonzero, so it can never collide with the `None` sentinel — Memory §4.2). The dedicated dual of
## `emit_enum_assign` for the folded case; called only when the destination slot is niche-folded, so
## every ordinary `[disc, payload]` enum construction is untouched (byte-identical).
emit_folded_option_assign := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  match deref(v) {
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      if phead != 0 {
        ga := deref(arg_p(phead))
        emit_gas(ga.e, sb, cx, a, nl)               ## Some(p): the pointer value → stack top
        push_str(sb, "  popq %rax\n  movq %rax, -")
        push_int(sb, (base + 1) * 8)
        push_str(sb, "(%rbp)\n")
      } else {
        push_str(sb, "  movq $0, -")                ## None: the null niche (0)
        push_int(sb, (base + 1) * 8)
        push_str(sb, "(%rbp)\n")
      }
    }
    _ => {}
  }
}

## §8 `@niche`: emit a folded `Option(ptr(T))` VALUE as ONE word in %rax (the RETURN dual of
## `emit_folded_option_assign`). `Some(p)` → the pointer `p`; `None` → 0 (the null niche); any other
## form (a folded Var/local — a 1-word slot) → its scalar `emit_gas` load, which yields the folded word.
## Called only when the fn's return type is niche-folded (gated by `is_niche_folded`).
emit_folded_option_value := fn(v : ptr(Expr), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  match deref(v) {
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      if phead != 0 {
        ga := deref(arg_p(phead))
        emit_gas(ga.e, sb, cx, a, nl)               ## Some(p): the pointer value → stack top
        push_str(sb, "  popq %rax\n")
      } else {
        push_str(sb, "  movq $0, %rax\n")           ## None: the null niche (0)
      }
    }
    _ => { emit_gas(v, sb, cx, a, nl) ; push_str(sb, "  popq %rax\n") }
  }
}

## Emit the discriminant + payload stores for an enum construction `name := E.V(p0, p1)`:
## store the variant's declaration index (the discriminant) at word 0 (slot `base`), then
## lower each payload value and store it at words 1, 2 (slots `base+1`, `base+2`). The
## variant name is resolved to its discriminant index via the enum's `FieldDecl` list. The
## deref-match on the value pointer `v` stays here (a pointer PARAM) — the lowerable shape.
## RAW UNION construction store `u := U.m(value)` (spec Types §6.3). The write parses as the same
## variant-ctor `EnumLit` as an enum, but a union is UNTAGGED: the payload is stored at OFFSET 0 (word 0
## = slot `base`, byte `-(base+1)*8`) with NO discriminant word (contrast `emit_enum_assign`, which
## writes a disc at word 0 and the payload at word 1+). A union member is single-payload in v1
## (multi-payload is additive), so exactly one payload arg is stored. A SCALAR payload is a single word;
## a STRUCT-literal payload lays its words from word 0 via `emit_struct_assign` (base slot = `base`).
emit_union_assign := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  match deref(v) {
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      if phead != 0 {
        ga := deref(arg_p(phead))
        psi := struct_lit_info(ga.e)
        if psi.is_s {
          emit_struct_assign(ga.e, base, sb, cx, a, nl)
        } else {
          emit_gas(ga.e, sb, cx, a, nl)
          push_str(sb, "  popq %rax\n  movq %rax, -")
          push_int(sb, (base + 1) * 8)
          push_str(sb, "(%rbp)\n")
        }
      }
    }
    _ => {}
  }
}

emit_enum_assign := fn(v : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  match deref(v) {
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      disc := variant_index(cx.decls, cx.src, es, el, vs, vl, deref(cx.mar))
      ## discriminant at the base slot — at the enum's `@repr(T)` tag WIDTH if it pins one (spec §8),
      ## else the word-sized `movq` (code 0 → byte-identical for the no-`@repr` corpus). Mirrors
      ## `emit_repr_tag_load`: a narrow store (`movb`/`movw`/`movl`) writes ONLY the tag's low bytes,
      ## leaving the rest of the tag word intact (no over-wide clobber at the C-ABI boundary).
      ersp := enum_repr_ty(cx.decls, cx.src, es, el)
      emit_repr_tag_store(sb, base, disc, repr_tag_code(cx.src, ersp.s, ersp.n))
      ## walk the arena-linked `Arg` payload-value list; payload `i` is stored at word `i+1`,
      ## i.e. slot `base + 1 + i` (byte offset -(base + i + 2) * 8(%rbp)).
      mut g := phead
      mut i := 0
      while g != 0 {
        ga := deref(arg_p(g))
        reject_unsupported_enum_call_payload(es, el, vs, vl, ga.e, cx, a)
        ## A fixed-array payload is an inline aggregate, not one scalar payload word. Store its
        ## complete literal into the enum's payload block so a subsequent match binding aliases the
        ## real array elements. The array element itself may be a plain struct (the claimed slice);
        ## aggregate array leaves remain rejected by the match place resolver.
        apw := enum_lit_array_payload_words(v, cx.decls, cx.src, a)
        if apw != 0 and i == 0 {
          if array_lit_info(ga.e).is_a {
            emit_array_assign(ga.e, base - 1 - i, sb, cx, nl)
            i += i64(apw)
          } else {
            panic("selfhost: an enum array payload must be constructed from an array literal; bind the array to a local first")
          }
          g = ga.next
          continue
        }
        psi := struct_lit_info(ga.e)
        pstr := str_lit_info(ga.e)
        if psi.is_s {
          ## a STRUCT-literal payload (`V(P(a=…, …))`) — store ALL its words at the payload slots
          ## `base+1+i …` via `emit_struct_assign` (its base slot is `base+1+i`), then advance `i`
          ## by the struct's word count. Was `emit_gas` → a placeholder `$0` (a struct is not a
          ## scalar value), truncating the payload to one zero word (the aggregate-enum-payload bug).
          emit_struct_assign(ga.e, base - 1 - i, sb, cx, a, nl)
          i += i64(struct_words(cx.decls, cx.src, psi.ss, psi.sl, deref(cx.mar)))
        } else if pstr.is_s {
          ## a str-literal payload (`V("…")`) — store its {ptr, len} as TWO words at `base+1+i` (ptr)
          ## and `base+2+i` (len), like a str local, then advance `i` by 2. Was `emit_gas` → one word
          ## (the ptr), dropping the len so a payload `match { V(s) => s.len }` read 0.
          emit_str_assign(ga.e, base - 1 - i, sb)
          i += 2
        } else if pair_value_expr(ga.e, cx) {
          ## A Slice(T)/str VIEW expression (`d[lo..hi]`, `bytes(s)`, a view local, or a
          ## view-returning call) is a two-word payload even when it is not a literal. The scalar
          ## fallback below would pop only the length/top word and leave the pointer uninitialized,
          ## making a local `Option(Slice(T)).Some(view)` disagree with the return-register path.
          ## Reuse the struct-field pair store so pointer/length direction stays identical to the
          ## existing str-literal constructor path.
          emit_pair_field_store(ga.e, base - 1 - i, sb, cx, a, nl)
          i += 2
        } else if enum_lit_info(ga.e).is_e {
          ## a NESTED ENUM payload (`Outer.X(Inner.A(…))`) — store the inner enum's `[disc, payload…]`
          ## words at `base+1+i …` via `emit_enum_assign` (its base slot is `base+1+i`), then advance
          ## `i` by the inner enum's instance width. Was `emit_gas` → one word, truncating the nested
          ## enum so `match X(i) { … match i { A(v) => … } }` read a garbage disc/payload.
          pei := enum_lit_info(ga.e)
          emit_enum_assign(ga.e, base - 1 - i, sb, cx, a, nl)
          i += i64(enum_inst_words(cx.decls, cx.src, pei.es, pei.el, deref(cx.mar)))
        } else if enum_ret_call_d(ga.e, cx.decls, cx.src, a) {
          ## An enum-returning CALL payload (`Some(inner())` / `Err(make_e())`) already leaves the
          ## complete inner enum in the return registers. Store every word into the outer enum's
          ## inline payload block, the local-storage dual of `emit_enum_value`'s register shift.
          ## The hidden-pointer (>7-word) return is a separate SRET destination path; keep this narrow
          ## slice fail-loud rather than storing a partial register result.
          ces := call_ret_enum_span_d(ga.e, cx.decls, cx.src, a)
          if ces.n == 0 { panic("selfhost: an enum CALL payload has no resolvable return type") }
          cew := 1 + enum_inst_words(cx.decls, cx.src, ces.s, ces.n, a)
          if cew > 7 { panic("selfhost: an enum CALL payload wider than 7 words needs the nested SRET path") }
          emit_enum_value(ga.e, sb, cx, a, nl)
          for j in 0..cew {
            push_str(sb, "  movq ")
            emit_retreg(sb, j)
            push_str(sb, ", -")
            push_int(sb, (base - i - i64(j)) * 8)
            push_str(sb, "(%rbp)\n")
          }
          i += i64(cew)
        } else if var_agg_info(ga.e, cx.slots, cx.src).ek == 2 and struct_words(cx.decls, cx.src, var_agg_info(ga.e, cx.slots, cx.src).s, var_agg_info(ga.e, cx.slots, cx.src).n, deref(cx.mar)) > 1 {
          ## a MULTI-WORD struct VAR payload (`Some(q)` with q a struct LOCAL / by-ref param) — store ALL
          ## its words at the payload slots `base-i, base-i-1, …`, then advance `i` by the struct's word
          ## count. Was `emit_gas` → a single word (word 0), truncating fields past the first (the
          ## aggregate-enum-payload local-BIND bug, the store dual of the return-register truncation).
          ## Gated `> 1` so a 1-word struct var keeps the byte-identical scalar emission below (neutral).
          vai := var_agg_info(ga.e, cx.slots, cx.src)
          pwv := struct_words(cx.decls, cx.src, vai.s, vai.n, deref(cx.mar))
          vn := var_name_span(ga.e)
          vent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, vn.s, vn.n)))
          if vent.is_ref {
            ## a by-ref struct PARAM: the slot holds a POINTER; load it into %r11 and read pointee word j.
            push_str(sb, "  movq -")
            push_int(sb, i64((vent.off + 1) * 8))
            push_str(sb, "(%rbp), %r11\n")
            for j in 0..pwv {
              push_str(sb, "  movq ")
              push_int(sb, i64(j * 8))
              push_str(sb, "(%r11), %rax\n  movq %rax, -")
              push_int(sb, (base - i - i64(j)) * 8)
              push_str(sb, "(%rbp)\n")
            }
          } else {
            for j in 0..pwv {
              push_str(sb, "  movq -")
              push_frame_word(sb, vent.off, j)
              push_str(sb, "(%rbp), %rax\n  movq %rax, -")
              push_int(sb, (base - i - i64(j)) * 8)
              push_str(sb, "(%rbp)\n")
            }
          }
          i += i64(pwv)
        } else if var_agg_info(ga.e, cx.slots, cx.src).ek == 3 and (1 + enum_inst_words(cx.decls, cx.src, var_agg_info(ga.e, cx.slots, cx.src).s, var_agg_info(ga.e, cx.slots, cx.src).n, deref(cx.mar))) > 1 {
          ## A MULTI-WORD ENUM VAR payload (`Some(r)` with r an enum LOCAL/PARAM) — copy the complete
          ## inner `[disc, payload…]` block into the outer payload. This is the storage dual of the
          ## enum-returning-call path and the enum-literal recursion above.
          vai := var_agg_info(ga.e, cx.slots, cx.src)
          pwv := 1 + enum_inst_words(cx.decls, cx.src, vai.s, vai.n, deref(cx.mar))
          vn := var_name_span(ga.e)
          vent := deref(svec_at(SlotEntry, cx.slots, entry_of(cx.slots, cx.src, vn.s, vn.n)))
          if vent.is_ref {
            ## A by-reference enum PARAM slot holds the pointer to word 0; load each pointee word
            ## before writing the destination, matching the enum return and struct payload paths.
            push_str(sb, "  movq -")
            push_int(sb, i64((vent.off + 1) * 8))
            push_str(sb, "(%rbp), %r11\n")
            for j in 0..pwv {
              push_str(sb, "  movq ")
              push_int(sb, i64(j * 8))
              push_str(sb, "(%r11), %rax\n  movq %rax, -")
              push_int(sb, (base - i - i64(j)) * 8)
              push_str(sb, "(%rbp)\n")
            }
          } else {
            for j in 0..pwv {
              push_str(sb, "  movq -")
              push_frame_word(sb, vent.off, j)
              push_str(sb, "(%rbp), %rax\n  movq %rax, -")
              push_int(sb, (base - i - i64(j)) * 8)
              push_str(sb, "(%rbp)\n")
            }
          }
          i += i64(pwv)
        } else {
          emit_gas(ga.e, sb, cx, a, nl)
          push_str(sb, "  popq %rax\n  movq %rax, -")
          push_int(sb, (base - i) * 8)
          push_str(sb, "(%rbp)\n")
          i += 1
        }
        g = ga.next
      }
    }
    _ => {}
  }
}

## Is `e` the internal `Num(-1)` sentinel — the parser's "no trailing return expression" placeholder
## (`emit_fn`'s `d.value` when the body ends in a statement, not a tail expr)? Gates TAIL-VALUE mode.
expr_is_no_tail := fn(e : ptr(Expr)) -> bool {
  match deref(e) {
    Expr::Num(v, s, n) => { return v == 0 - 1 and n == 0 }
    _ => { return false }
  }
}

## A `Match`-detection result: whether the expression is a `match`, and (if so) its scrutinee
## pointer + arm-list head. Carried out of `match_info` so the deref-`match` stays a function-body
## match over a pointer PARAM (the lowerable shape, like `struct_lit_info`).
MInfo := struct { is_m : bool, scrut : ptr(Expr), head : ptr(mut Stmt) }
match_info := fn(e : ptr(Expr)) -> MInfo {
  match deref(e) {
    Expr::Match(scrut, head) => { MInfo(is_m = true, scrut = scrut, head = head) }
    _ => { MInfo(is_m = false, scrut = e, head = 0) }
  }
}

## Whether `e` is an `if cond { then } else { else }` EXPRESSION + its three parts — the If dual of
## `match_info`, used by `emit_return_value` to deliver an if-EXPRESSION's branch value via the
## return convention (an aggregate/str/enum branch value, which `emit_struct_value`/… can't deliver
## from a bare `If`). Isolated pointer-PARAM deref-match (the lowerable shape).
IfInfo := struct { is_if : bool, cond : ptr(Expr), then_e : ptr(Expr), else_e : ptr(Expr) }
if_info := fn(e : ptr(Expr)) -> IfInfo {
  match deref(e) {
    Expr::If(c, t, f) => { IfInfo(is_if = true, cond = c, then_e = t, else_e = f) }
    _ => { IfInfo(is_if = false, cond = e, then_e = e, else_e = e) }
  }
}

## Does a match arm list contain a STR-LITERAL pattern arm (`wild == 4`, a `"lit" => …` arm whose
## pattern `StrLit` node handle is stored in `lit`)? Such a match dispatches by BYTE-COMPARE
## (`emit_str_eq_core` against the str scrutinee), not an integer value compare (§5.4). `src/`'s
## matches are all integer/enum (keyword classification uses `contains(str, table, w)`), so this is
## `false` for the self-host build → the str dispatch is never emitted → fixpoint-neutral.
match_is_str := fn(head : ptr(mut Stmt), a : rt::Arena) -> bool {
  mut arm := head
  mut res := false
  while arm != 0 {
    am := deref(arm_p(arm))
    if am.wild == 4 { res = true }
    arm = am.next
  }
  res
}

## Count the arms in a match's arm list. Used to RESERVE the per-arm body labels CONTIGUOUSLY before
## the dispatch pass emits them — a str-literal dispatch calls `emit_str_eq_core`, which also draws
## fresh labels from `nl`, so without a reservation those interior labels would collide with the body
## labels. Reserving up front (`base = nl; nl += arm_count`) keeps body labels `base..base+n` disjoint
## from any dispatch-emitted label, and is byte-identical for the integer/enum path (the body labels
## land at the same values the old `lbody := nl; nl += 1` interleave produced).
arm_count := fn(head : ptr(mut Stmt), a : rt::Arena) -> usize {
  mut arm := head
  mut n := 0
  while arm != 0 {
    am := deref(arm_p(arm))
    n += 1
    arm = am.next
  }
  n
}

## Deliver `rv` as the function's RETURN VALUE via the convention for the fn's return kind (enum:
## disc/%rax + payload/%rdx; 2..7-word struct: %rax:%rdx:%rcx:%r8:%r9:%r10:%r11; str: ptr/%rax +
## len/%rdx; scalar: %rax), then `jmp` the epilogue. Shared by an early `return e` and a TAIL value
## expression (the last `ExprStmt` of a value-returning fn whose value flows through a braced
## `match` — the lean parser has no expression-`match`, so without this such a fn returns the `0`
## placeholder / garbage; e.g. every `struct_lit_info`/`enum_lit_info`/`str_lit_info`).
## Is the return/arm expression a bare `panic(msg)` call? `panic` is a DIVERGENT builtin name-recognized
## only on the scalar `emit_gas` Call path; in an aggregate-returning fn a `None => panic(msg)` arm value
## would route through `emit_struct_value`/`emit_enum_value`, which mangle `panic` to an undefined
## `<module>__panic` (link error). TAIL-match form (a `mut res`+assign-in-arm form is seed-mislowered —
## mirror `is_sub_call`).
ret_expr_is_panic := fn(e : ptr(Expr), src : ptr(u8)) -> bool {
  match deref(e) {
    Expr::Call(cs, cl, nargs, args_head) => { str_at((src + cs), cl) == "panic" }
    _ => { false }
  }
}

emit_return_value := fn(rv : ptr(Expr), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  ## A `panic(msg)` arm/return value in an AGGREGATE-returning fn (`unwrap`/`expect`'s `None`/`Err` arm):
  ## emit the builtin panic (write(2,msg)+exit(1)) via the scalar path, pop its dead `$0`, and jmp the
  ## epilogue — never route it through the aggregate emitters (which would mangle `panic`).
  if ret_expr_is_panic(rv, cx.src) {
    emit_gas(rv, sb, cx, a, nl)          ## builtin panic: write(2,msg)+exit(1); leaves a dead $0
    push_str(sb, "  popq %rax\n  jmp ")
    emit_label(sb, cx.epi)
    push_str(sb, "\n")
    return
  }
  ## A BARE-arm value-`match` in tail position (`match n { 0 => v ; _ => w }` with no braces — an
  ## `Expr::Match`, NOT a braced statement-match) over an INTEGER scrutinee: dispatch on the
  ## scrutinee, then DELIVER each arm's value through the return convention (recursive
  ## `emit_return_value` already appends the `jmp epilogue`), so no merge label is needed. This is
  ## the value-match the lean parser CAN form (the braced-arm form rides the `cx.tail` ExprStmt path
  ## instead). An ENUM scrutinee is left to the braced form (its arms bind payloads — not handled
  ## here); it falls through to the type emitter below.
  ## `return if cond { then } else { else }` returning an aggregate/str/enum: dispatch the cond, then
  ## DELIVER each branch's value via the return convention (recursive `emit_return_value` — which jumps
  ## the epilogue itself, so no merge label). Without this a bare `If` reached emit_struct_value/…
  ## (no `If` arm) → {0}/empty. A SCALAR if-return is left to `emit_gas` (the caller only routes here
  ## for struct/tuple/str/enum). Placed before the match handling; the two are disjoint (an expr is If
  ## or Match, not both).
  ## GUARD on an AGGREGATE/str return: a SCALAR if-expression (e.g. a match arm body `if c { 1 } else
  ## { 0 }` in a scalar fn like `comptime::apply`) is delivered fine by the `emit_gas` fall-through
  ## below (its Expr::If arm) — firing here for scalars would restructure that (correct, but a needless
  ## reseed). Only a struct/tuple/str if-return needs this (emit_struct_value/emit_str_pair lack an If
  ## arm); an enum if-return uses emit_enum_value's own If arm.
  ii := if_info(rv)
  if ii.is_if and (cx.ret_struct or cx.ret_tuple or cx.ret_str or fixed_array_byte_return_len_span(cx.src, cx.ret_ss, cx.ret_sl) >= 1) {
    lelse := nl
    nl += 1
    emit_gas(ii.cond, sb, cx, a, nl)
    push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  je ")
    emit_label(sb, lelse)
    push_str(sb, "\n")
    emit_return_value(ii.then_e, sb, cx, a, nl)   ## delivers the then value + jmp epilogue
    emit_label(sb, lelse)
    push_str(sb, ":\n")
    emit_return_value(ii.else_e, sb, cx, a, nl)   ## delivers the else value + jmp epilogue
    return
  }
  mi := match_info(rv)
  if mi.is_m {
    mut si := scrut_enum_info(mi.scrut, cx)
    ## a `match <mutable enum GLOBAL>` in tail/return position — materialize the global into the scratch
    ## temp and treat it as an enum scrutinee (else `si.is_e` is false and it wrongly takes the integer
    ## path). Emits the copy now; the enum dispatch below reads it at `si.base`.
    if si.is_e == false {
      geg := try_global_enum_scrut(mi.scrut, sb, cx)
      if geg.is_e { si = geg }
    }
    if (si.is_e == false) and (enum_ret_call(mi.scrut, cx) == false) {
      is_str := match_is_str(mi.head, a)
      if is_str == false {
        emit_gas(mi.scrut, sb, cx, a, nl)
        push_str(sb, "  popq %r12\n")
      }
      ## reserve body labels contiguously (base..) before dispatch (see the Expr::Match note);
      ## byte-identical for the integer path.
      base := nl
      nl += arm_count(mi.head, a)
      mut arm := mi.head
      mut hadwild := false
      mut ai := 0
      while arm != 0 {
        am := deref(arm_p(arm))
        lbody := base + ai
        ai += 1
        if is_str and am.wild == 4 {
          ## byte-compare the str scrutinee against the arm's pattern literal (StrLit at `am.lit`)
          pat := unchecked bitcast(ptr(Expr), usize(am.lit))
          emit_str_eq_core(mi.scrut, pat, sb, cx, a, nl)
          push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  jne ")
          emit_label(sb, lbody)
          push_str(sb, "\n")
        } else if am.wild == 5 or am.wild == 6 {
          ## a RANGE arm (Control Flow §5.4): bounds-check the scrutinee (%r12) against `[lo, hi)`
          ## (wild 5, half-open) / `[lo, hi]` (wild 6, inclusive); jump to the body iff in range,
          ## else fall through. Signed compares (correct for iN/char and any uN value < 2^63).
          lskip := nl
          nl += 1
          push_str(sb, "  movq $")
          push_int(sb, am.lit)
          push_str(sb, ", %rax\n  cmpq %rax, %r12\n  jl ")
          emit_label(sb, lskip)
          push_str(sb, "\n  movq $")
          push_int(sb, am.hi)
          push_str(sb, ", %rax\n  cmpq %rax, %r12\n  ")
          if am.wild == 6 { push_str(sb, "jle ") } else { push_str(sb, "jl ") }
          emit_label(sb, lbody)
          push_str(sb, "\n")
          emit_label(sb, lskip)
          push_str(sb, ":\n")
        } else if am.wild != 0 {
          push_str(sb, "  jmp ")
          emit_label(sb, lbody)
          push_str(sb, "\n")
          hadwild = true
        } else {
          push_str(sb, "  movq $")
          push_int(sb, am.lit)
          push_str(sb, ", %rax\n  cmpq %rax, %r12\n  je ")
          emit_label(sb, lbody)
          push_str(sb, "\n")
        }
        arm = am.next
      }
      ## no wildcard ⇒ no arm matched: deliver 0 and jump the epilogue (a non-exhaustive value-match
      ## is a logic error; this keeps it from falling through into an arm body).
      if hadwild == false {
        push_str(sb, "  movq $0, %rax\n  jmp ")
        emit_label(sb, cx.epi)
        push_str(sb, "\n")
      }
      mut arm2 := mi.head
      mut lbody2 := base
      while arm2 != 0 {
        am2 := deref(arm_p(arm2))
        emit_label(sb, lbody2)
        push_str(sb, ":\n")
        emit_return_value(am2.body, sb, cx, a, nl)   ## delivers the arm value + jmp epilogue
        lbody2 += 1
        arm2 = am2.next
      }
      return
    } else {
      ## ENUM-scrutinee tail value-`match` (`match self { Ok(v) => Option(T).Some(v) … }` as the
      ## fn's tail expression): dispatch on the discriminant + bind payloads (mirroring
      ## `emit_enum_match`), but DELIVER each arm's value via the return convention (recursive
      ## `emit_return_value`). Without this the tail match fell through to `emit_enum_value(Match)`
      ## below, which has no `Match` arm → returned `{0,0}` (a silent miscompile). Fires ONLY for an
      ## enum scrutinee; `src/` writes no such tail match (it would already be broken) → fixpoint-neutral.
      mut sbase := si.base
      mut ses := si.es
      mut sel := si.el
      mut tail_enum_owner_ctx := false
      mut tail_enum_owner_old_on := false
      mut tail_enum_owner_old_s := 0
      mut tail_enum_owner_old_l := 0
      mut tail_enum_owner_s := 0
      mut tail_enum_owner_l := 0
      if (si.is_e == false) and enum_ret_call(mi.scrut, cx) {
        ## scrutinee is a CALL returning an enum (`main := fn() -> u64 { match mkn(10) { … } }` — a tail
        ## value-match with NO intervening binding): stage its result into this match's scratch temp, then
        ## dispatch on the temp as a local. Store EVERY returned word (word k in `emit_retreg(k)` → slot
        ## `tbm - k`, the down-growing layout every other scrutinee path uses) — this used to store only
        ## disc/%rax + payload[0]/%rdx, so the SECOND and later payload words were LOST: `N.Two(10, 11)`
        ## matched to `(a, b)` yielded a = 10, b = 0 (a SILENT miscompile). For a 1-payload-word enum the
        ## loop emits exactly the former two `movq`s → byte-identical there.
        ## Carry the direct callee declaration's module while resolving the returned enum's generic
        ## payload and variant names. The arm bodies are restored to the caller module below.
        tail_owner_ci := call_ret_enum_target(mi.scrut, cx)
        if tail_owner_ci >= 0 {
          tail_enum_owner_old_on = lower_layout::type_ref_mod_on()
          tail_enum_owner_old_s = lower_layout::type_ref_mod_s()
          tail_enum_owner_old_l = lower_layout::type_ref_mod_l()
          tail_owner_d := deref(decl_at(Decl, rt::vec_get(deref(cx.decls), usize(tail_owner_ci))))
          tail_enum_owner_s = tail_owner_d.mod_start
          tail_enum_owner_l = tail_owner_d.mod_len
          lower_layout::set_type_ref_module(tail_owner_d.mod_start, tail_owner_d.mod_len, ROOT_MOD_S, ROOT_MOD_L)
          tail_enum_owner_ctx = true
        }
        direct_match_multiword_reject(mi.scrut, cx)
        ci := call_ret_enum_span(mi.scrut, cx)
        tbm := usize(cx.tslot) + cx.mdepth * cx.swidth + cx.swidth - 1
        etwt := 1 + enum_inst_words(cx.decls, cx.src, ci.s, ci.n, a)
        if etwt > tbm + 1 { panic("selfhost: tail value-match on a call returning an enum wider than the match scratch — bind the result to a local first (`t := f(…)` then `match t { … }`)") }
        if etwt >= 8 {
          ## a WIDE (SRET) enum callee delivers through a hidden result POINTER, not the return
          ## registers — hand it the scratch block's word-0 address (see the value-`Expr::Match` twin).
          ovtsc := cx.sret_call
          cx.sret_call = i64(tbm)
          emit_enum_value(mi.scrut, sb, cx, a, nl)
          cx.sret_call = ovtsc
        } else {
          emit_enum_value(mi.scrut, sb, cx, a, nl)
          for k in 0..etwt {
            push_str(sb, "  movq ")
            emit_retreg(sb, k)
            push_str(sb, ", -")
            push_int(sb, i64((tbm - k + 1) * 8))
            push_str(sb, "(%rbp)\n")
          }
        }
        sbase = tbm
        ses = ci.s
        sel = ci.n
      } else if si.is_ref {
        mref := materialize_ref_enum(si.base, si.es, si.el, sb, cx)
        sbase = mref.base
        ses = mref.es
        sel = mref.el
      }
      head := expand_variant_arms(mi.head, ses, sel, cx, a)
      base := nl
      nl += arm_count(head, a)
      ## disc load at the `@repr(T)` tag WIDTH (spec §8) if pinned, else word-sized (byte-identical).
      mrsp := enum_repr_ty(cx.decls, cx.src, ses, sel)
      emit_repr_tag_load(sb, sbase, repr_tag_code(cx.src, mrsp.s, mrsp.n))
      mut arm := head
      mut hadwild := false
      mut ai := 0
      while arm != 0 {
        am := deref(arm_p(arm))
        lbody := base + ai
        ai += 1
        if am.wild != 0 {
          push_str(sb, "  jmp ")
          emit_label(sb, lbody)
          push_str(sb, "\n")
          hadwild = true
        } else {
          disc := variant_index(cx.decls, cx.src, ses, sel, am.vs, am.vl, deref(cx.mar))
          push_str(sb, "  movq $")
          push_int(sb, disc)
          push_str(sb, ", %rax\n  cmpq %rax, %r12\n  je ")
          emit_label(sb, lbody)
          push_str(sb, "\n")
        }
        arm = am.next
      }
      if hadwild == false {
        push_str(sb, "  movq $0, %rax\n  jmp ")
        emit_label(sb, cx.epi)
        push_str(sb, "\n")
      }
      mut arm2e := head
      mut lbody2e := base
      while arm2e != 0 {
        am2 := deref(arm_p(arm2e))
        emit_label(sb, lbody2e)
        push_str(sb, ":\n")
        saved := svec_len(cx.slots)
        mut nbind := 0
        mut cb := am2.binds_head
        while unchecked bitcast(usize, cb) != 0 { nbind = nbind + 1; cb = bnd_next(cb) }
        pty := variant_payload_type(cx.decls, cx.src, ses, sel, am2.vs, am2.vl, deref(cx.mar))
        mut agg_ek : u8 = 0
        mut array_ess := 0
        mut array_esl := 0
        mut array_estride := 1
        mut array_nel := 0
        if nbind == 1 and pty.n != 0 {
          if struct_decl_of(cx.decls, cx.src, pty.s, pty.n) >= 0 { agg_ek = 2 }
          else if enum_decl_of(cx.decls, cx.src, pty.s, pty.n) >= 0 { agg_ek = 3 }
          else if str_at((cx.src + pty.s), pty.n) == "str" { agg_ek = 4 }   ## a str payload → 2-word {ptr, len} binding
          else {
            pae := array_elem_span(cx.src, pty.s, pty.n)
            if pae.n != 0 {
              pbn := base_type_name(cx.src, pae.s, pae.n)
              if struct_decl_of(cx.decls, cx.src, pbn.s, pbn.n) < 0 {
                panic("selfhost: a value-match binding rooted at an array payload currently requires a plain-struct element (`xs[i].a.arr[j]`); aggregate array leaves remain a fail-loud frontier")
              }
              agg_ek = 5
              array_ess = pae.s
              array_esl = pae.n
              array_estride = struct_words(cx.decls, cx.src, pbn.s, pbn.n, deref(cx.mar))
              array_nel = parse_arr_len(cx.src, pty.s, pty.n)
              if array_nel == 0 or array_estride == 0 { panic("selfhost: a value-match array payload has no resolvable fixed length/element stride") }
            }
          }
        }
        mut bnd := am2.binds_head
        mut bi := 0
        while unchecked bitcast(usize, bnd) != 0 {
          bmns := bnd_ns(bnd)
          bmnl := bnd_nl(bnd)
          if agg_ek == 5 {
            for fi in 0..(array_nel * array_estride) {
              svec_push(deref(cx.slots), SlotEntry(ns = 0, nl = 0, off = 0, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
            }
            svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = array_ess, snl = array_esl, ek = 5, estride = array_estride, eek = 2, is_ref = false))
          } else if agg_ek != 0 {
            svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = pty.s, snl = pty.n, ek = agg_ek, estride = 1, eek = 0, is_ref = false, tmod_s = tail_enum_owner_s, tmod_l = tail_enum_owner_l))
          } else {
            svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
          }
          bi += 1
          bnd = bnd_next(bnd)
        }
        cx.mdepth = cx.mdepth + 1                          ## a nested match in the body uses a deeper scratch level
        if tail_enum_owner_ctx {
          if tail_enum_owner_old_on { lower_layout::set_type_ref_module(tail_enum_owner_old_s, tail_enum_owner_old_l, ROOT_MOD_S, ROOT_MOD_L) } else { lower_layout::clear_type_ref_module() }
        }
        emit_return_value(am2.body, sb, cx, a, nl)         ## delivers the arm's value + jmp epilogue
        if tail_enum_owner_ctx { lower_layout::set_type_ref_module(tail_enum_owner_s, tail_enum_owner_l, ROOT_MOD_S, ROOT_MOD_L) }
        cx.mdepth = cx.mdepth - 1
        svec_truncate(deref(cx.slots), saved)
        lbody2e += 1
        arm2e = am2.next
      }
      if tail_enum_owner_ctx {
        if tail_enum_owner_old_on { lower_layout::set_type_ref_module(tail_enum_owner_old_s, tail_enum_owner_old_l, ROOT_MOD_S, ROOT_MOD_L) } else { lower_layout::clear_type_ref_module() }
      }
      return
    }
  }
  if fixed_array_byte_return_len_span(cx.src, cx.ret_ss, cx.ret_sl) >= 1 {
    emit_byte_array_return_value(rv, sb, cx, a, nl)
  } else if is_niche_folded(cx.src, cx.ret_ss, cx.ret_sl) {
    ## §8 `@niche`: a fn returning `Option(ptr(T))` returns ONE word (the folded value: `Some(p)`=p,
    ## `None`=0) in %rax like a pointer — NOT the 2-register enum convention. Checked FIRST because a
    ## folded return type is NOT recognized as an enum (`enum_decl_of` doesn't resolve the parenthesized
    ## `Option(ptr(T))` instance), so `cx.ret_enum` is FALSE for it. Gated by `is_niche_folded` — every
    ## non-folded return keeps its exact existing path below (byte-identical).
    emit_folded_option_value(rv, sb, cx, a, nl)
  } else if cx.ret_sret {
    ## a >7-word aggregate return via the hidden result-pointer — enum (disc + payload) or struct.
    ## Checked BEFORE ret_enum: a wide enum has BOTH ret_sret and ret_enum set, and the sret path wins.
    if cx.ret_enum { emit_enum_to_sret(rv, sb, cx, a, nl) }
    else { emit_struct_to_sret(rv, sb, cx, a, nl) }
  } else if cx.ret_enum {
    emit_enum_value(rv, sb, cx, a, nl)
  } else if cx.ret_struct {
    emit_struct_value(rv, sb, cx, a, nl)
  } else if cx.ret_tuple {
    ## a tuple arm value `(a, b)` (an ArrayLit) delivered via the register-return convention
    ## (emit_struct_value's ArrayLit arm) — the tuple dual of the ret_struct branch.
    emit_struct_value(rv, sb, cx, a, nl)
  } else if cx.ret_str {
    emit_str_pair(rv, sb, cx, a, nl)
    push_str(sb, "  popq %rdx\n  popq %rax\n")
  } else {
    emit_gas(rv, sb, cx, a, nl)
    push_str(sb, "  popq %rax\n")
  }
  push_str(sb, "  jmp ")
  emit_label(sb, cx.epi)
  push_str(sb, "\n")
}

## Is `e` a str-VALUED expression (a `str` literal / view / str-returning call)? Used to decide that a
## `match`/`if` whose arms are strs binds a str LOCAL (its {ptr,len} must be delivered, not a scalar).
expr_is_str_val := fn(e : ptr(Expr), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> bool {
  si := str_lit_info(e)
  if si.is_s { return true }
  if is_sub_call(e, src) or is_strat_call(e, src) or is_slice_expr(e) or is_bytes_call(e, src) { return true }
  str_ret_call(e, decls, src, a)
}
## The FIRST real value body of a `match`/`if` EXPRESSION — the first non-wildcard (or str-literal)
## arm body, or an `if`'s then-branch. Used to classify what an aggregate/str `match`/`if` yields so
## `name := match/if { … }` sizes + delivers the local correctly. Null when `v` is neither.
match_if_first_body := fn(v : ptr(Expr), a : rt::Arena) -> ptr(Expr) {
  z := unchecked bitcast(ptr(Expr), 0)
  mi := match_info(v)
  if mi.is_m {
    mut arm := mi.head
    while arm != 0 {
      am := deref(arm_p(arm))
      if am.wild == 0 or am.wild == 4 { return am.body }
      arm = am.next
    }
    if mi.head != 0 { return deref(arm_p(mi.head)).body }
    return z
  }
  ii := if_info(v)
  if ii.is_if { return ii.then_e }
  z
}

## The aggregate/str KIND an expression yields (for sizing a `match`/`if`-bound local): kind 2 struct
## (+ type span), 3 enum (+ type span), 5 tuple/array (+ element count `nel` and elem-list `ehead`),
## 4 str, 0 none (a scalar). Classifies a match arm / if branch body.
AggKind := struct { kind : u8, s : usize, n : usize, nel : usize, ehead : ptr(mut Arg) }
agg_kind_of := fn(e : ptr(Expr), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> AggKind {
  si := struct_lit_info(e)
  if si.is_s { return AggKind(kind = 2, s = si.ss, n = si.sl, nel = 0, ehead = 0) }
  ei := enum_lit_info(e)
  if ei.is_e { return AggKind(kind = 3, s = ei.es, n = ei.el, nel = 0, ehead = 0) }
  ai := array_lit_info(e)
  if ai.is_a { return AggKind(kind = 5, s = 0, n = 0, nel = ai.nel, ehead = ai.ehead) }
  ## a CALL returning a small (1..7-word) STRUCT as an `if`/`match` branch VALUE (`if c { f() } else
  ## { g() }` with `f/g -> P`): classify it as a struct so the `name := if/match { … }` binding sizes
  ## `name` as that struct AND delivers each branch's struct-return words into its slots. Without this
  ## the call fell through to kind 0 (scalar) — the binding reserved ONE slot and captured only the
  ## if-expr's scalar-converged %rax (a struct-return isn't materialized in %rax at a bare if value),
  ## a §Priority-1 SILENT word-0-drop → 0. (A str-returning call already rides kind 4 via `expr_is_str_val`.)
  if struct_ret_call(e, decls, src, a) {
    csp := call_ret_struct_span(e, decls, src, a)
    if csp.n != 0 { return AggKind(kind = 2, s = csp.s, n = csp.n, nel = 0, ehead = 0) }
  }
  if expr_is_str_val(e, decls, src, a) { return AggKind(kind = 4, s = 0, n = 0, nel = 0, ehead = 0) }
  AggKind(kind = 0, s = 0, n = 0, nel = 0, ehead = 0)
}

## The aggregate/str kind a `match`/`if` EXPRESSION yields (classified on its first value body), or
## kind 0 when it is scalar / not a match/if. Such a `name := match/if { … }` binds `name` by this
## kind and delivers each arm/branch's value into its slots (aggregates + strs do not materialize on
## the stack in bare expression position, so the generic scalar store would truncate them).
match_if_agg_kind := fn(v : ptr(Expr), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> AggKind {
  fb := match_if_first_body(v, a)
  if unchecked bitcast(usize, fb) == 0 { return AggKind(kind = 0, s = 0, n = 0, nel = 0, ehead = 0) }
  agg_kind_of(fb, decls, src, a)
}

## Store one match-arm / if-branch VALUE body into an aggregate/str LOCAL's slots at `base` — the
## per-branch primitive of `emit_val_match_to_local` / `emit_val_if_to_local`. Dispatches on the
## body's own kind: a struct/enum/array via the existing `emit_*_assign`; a str materializes its
## {ptr,len} pair (`emit_str_pair`) and pops it in (ptr@base, len@base+1).
emit_arm_val_store := fn(body : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  si := struct_lit_info(body)
  if si.is_s { emit_struct_assign(body, base, sb, cx, a, nl) }
  else {
    ei := enum_lit_info(body)
    if ei.is_e { emit_enum_assign(body, base, sb, cx, a, nl) }
    else {
      ai := array_lit_info(body)
      if ai.is_a { emit_array_assign(body, base, sb, cx, nl) }
      else if struct_ret_call(body, cx.decls, cx.src, a) {
        ## a small-STRUCT-returning CALL branch (`if c { f() } else { g() }`, `f/g -> P`): emit the
        ## call, then copy each returned struct word from its retreg (%rax:%rdx:%rcx:%r8:%r9:%r10:%r11)
        ## into the binding's slot (word k at `base - k`). Mirrors the direct `q := f()` struct-return
        ## delivery — the missing piece that left a struct if/match-value binding a silent 0.
        emit_struct_value(body, sb, cx, a, nl)
        csp := call_ret_struct_span(body, cx.decls, cx.src, deref(cx.mar))
        rw := struct_words(cx.decls, cx.src, csp.s, csp.n, deref(cx.mar))
        for k in 0..rw {
          push_str(sb, "  movq ")
          emit_retreg(sb, k)
          push_str(sb, ", -")
          push_int(sb, (base - i64(k) + 1) * 8)
          push_str(sb, "(%rbp)\n")
        }
      }
      else if expr_is_str_val(body, cx.decls, cx.src, a) {
        emit_str_pair(body, sb, cx, a, nl)         ## stack: [ptr(deep), len(top)]
        push_str(sb, "  popq %rax\n  movq %rax, -")
        push_int(sb, base * 8)               ## len -> slot base+1
        push_str(sb, "(%rbp)\n  popq %rax\n  movq %rax, -")
        push_int(sb, (base + 1) * 8)               ## ptr -> slot base
        push_str(sb, "(%rbp)\n")
      }
      else {
        ## An aggregate `if`/`match` branch VALUE of a shape this deliverer does not lower — a wide
        ## (>7-word SRET) struct-returning call, or an enum/tuple-returning call. FAIL LOUD (never a
        ## silent word-0 store): bind such a branch to a local first, then read that local.
        panic("selfhost: an aggregate `if`/`match` branch value of an unsupported shape — only a struct/enum/array literal, a str value, or a small-struct-returning call deliver into the binding's slots (a wide-struct / enum / tuple-returning call branch is not yet lowered; bind it to a local first)")
      }
    }
  }
}

## Deliver an aggregate/str-valued `match scrut { … => <agg> }` into a LOCAL's slots at `base`.
## Mirrors the int/str-scrutinee value-match dispatch (emit_gas' Match arm), but each arm stores its
## value into the local via `emit_arm_val_store` (struct/enum/array assign, or a str {ptr,len} pop) —
## the local-binding dual of `emit_return_value`'s aggregate/str routing (aggregates + strs do not
## materialize on the stack in bare expr position, so the generic scalar store cannot deliver them).
emit_val_match_to_local := fn(scrut : ptr(Expr), head : ptr(mut Stmt), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  ## An ENUM scrutinee (`p := match e { V(x) => <agg> }`): dispatch on the discriminant with variant
  ## indices + payload binding (the integer path below uses `am.lit`, which is 0 for enum patterns, so
  ## it never matched — the aggregate stayed unwritten). Materialize a global / struct-field / array-
  ## element / by-ref enum scrutinee into the scratch first (each helper emits only when it fires).
  si0 := scrut_enum_info(scrut, cx)
  geg := try_global_enum_scrut(scrut, sb, cx)
  feg := try_field_enum_scrut(scrut, sb, cx)
  ieg := try_index_enum_scrut(scrut, sb, cx, nl)
  aeg := try_arrelem_field_enum_scrut(scrut, sb, cx, nl)
  mut sise := si0.is_e
  mut sbase := si0.base
  mut ses := si0.es
  mut sel := si0.el
  if geg.is_e { sise = true; sbase = geg.base; ses = geg.es; sel = geg.el }
  else if feg.is_e { sise = true; sbase = feg.base; ses = feg.es; sel = feg.el }
  else if ieg.is_e { sise = true; sbase = ieg.base; ses = ieg.es; sel = ieg.el }
  else if aeg.is_e { sise = true; sbase = aeg.base; ses = aeg.es; sel = aeg.el }
  else if si0.is_e and si0.is_ref {
    mref := materialize_ref_enum(si0.base, si0.es, si0.el, sb, cx)
    sbase = mref.base; ses = mref.es; sel = mref.el
  }
  if sise {
    ehead := expand_variant_arms(head, ses, sel, cx, a)
    elend := nl
    nl += 1
    ## disc load at the `@repr(T)` tag WIDTH (spec §8) if pinned, else word-sized (byte-identical).
    ersp := enum_repr_ty(cx.decls, cx.src, ses, sel)
    emit_repr_tag_load(sb, sbase, repr_tag_code(cx.src, ersp.s, ersp.n))
    ebodybase := nl
    nl += arm_count(ehead, a)
    mut earm := ehead
    mut ehadwild := false
    mut eai := 0
    while earm != 0 {
      eam := deref(arm_p(earm))
      elbody := ebodybase + eai
      eai += 1
      if eam.wild != 0 {
        push_str(sb, "  jmp ")
        emit_label(sb, elbody)
        push_str(sb, "\n")
        ehadwild = true
      } else {
        edisc := variant_index(cx.decls, cx.src, ses, sel, eam.vs, eam.vl, deref(cx.mar))
        push_str(sb, "  movq $")
        push_int(sb, edisc)
        push_str(sb, ", %rax\n  cmpq %rax, %r12\n  je ")
        emit_label(sb, elbody)
        push_str(sb, "\n")
      }
      earm = eam.next
    }
    if ehadwild == false { push_str(sb, "  jmp "); emit_label(sb, elend); push_str(sb, "\n") }
    mut earm2 := ehead
    mut elbody2 := ebodybase
    while earm2 != 0 {
      eam2 := deref(arm_p(earm2))
      emit_label(sb, elbody2)
      push_str(sb, ":\n")
      ## alias each payload binding to its scrutinee payload slot (`sbase+1+i`), mirroring
      ## `emit_enum_match`, so a bound payload (`Some(x) => P(x, …)`) resolves in the arm body.
      esaved := svec_len(cx.slots)
      mut ebnd := eam2.binds_head
      mut ebi := 0
      while unchecked bitcast(usize, ebnd) != 0 {
        svec_push(deref(cx.slots), SlotEntry(ns = bnd_ns(ebnd), nl = bnd_nl(ebnd), off = sbase - 1 - ebi, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
        ebi += 1
        ebnd = bnd_next(ebnd)
      }
      emit_arm_val_store(eam2.body, base, sb, cx, a, nl)
      svec_truncate(deref(cx.slots), esaved)
      push_str(sb, "  jmp ")
      emit_label(sb, elend)
      push_str(sb, "\n")
      elbody2 += 1
      earm2 = eam2.next
    }
    emit_label(sb, elend)
    push_str(sb, ":\n")
    return
  }
  lend := nl
  nl += 1
  is_str := match_is_str(head, a)
  if is_str == false {
    emit_gas(scrut, sb, cx, a, nl)
    push_str(sb, "  popq %r12\n")
  }
  bodybase := nl
  nl += arm_count(head, a)
  mut arm := head
  mut hadwild := false
  mut ai := 0
  while arm != 0 {
    am := deref(arm_p(arm))
    lbody := bodybase + ai
    ai += 1
    if is_str and am.wild == 4 {
      pat := unchecked bitcast(ptr(Expr), usize(am.lit))
      emit_str_eq_core(scrut, pat, sb, cx, a, nl)
      push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  jne ")
      emit_label(sb, lbody)
      push_str(sb, "\n")
    } else if am.wild == 5 or am.wild == 6 {
      ## a RANGE arm (Control Flow §5.4): bounds-check the scrutinee (%r12) against `[lo, hi)`
      ## (wild 5) / `[lo, hi]` (wild 6); jump to the body iff in range, else fall through. Signed.
      lskip := nl
      nl += 1
      push_str(sb, "  movq $")
      push_int(sb, am.lit)
      push_str(sb, ", %rax\n  cmpq %rax, %r12\n  jl ")
      emit_label(sb, lskip)
      push_str(sb, "\n  movq $")
      push_int(sb, am.hi)
      push_str(sb, ", %rax\n  cmpq %rax, %r12\n  ")
      if am.wild == 6 { push_str(sb, "jle ") } else { push_str(sb, "jl ") }
      emit_label(sb, lbody)
      push_str(sb, "\n")
      emit_label(sb, lskip)
      push_str(sb, ":\n")
    } else if am.wild != 0 {
      push_str(sb, "  jmp ")
      emit_label(sb, lbody)
      push_str(sb, "\n")
      hadwild = true
    } else {
      push_str(sb, "  movq $")
      push_int(sb, am.lit)
      push_str(sb, ", %rax\n  cmpq %rax, %r12\n  je ")
      emit_label(sb, lbody)
      push_str(sb, "\n")
    }
    arm = am.next
  }
  if hadwild == false { push_str(sb, "  jmp "); emit_label(sb, lend); push_str(sb, "\n") }
  mut arm2 := head
  mut lbody2 := bodybase
  while arm2 != 0 {
    am2 := deref(arm_p(arm2))
    emit_label(sb, lbody2)
    push_str(sb, ":\n")
    emit_arm_val_store(am2.body, base, sb, cx, a, nl)
    push_str(sb, "  jmp ")
    emit_label(sb, lend)
    push_str(sb, "\n")
    lbody2 += 1
    arm2 = am2.next
  }
  emit_label(sb, lend)
  push_str(sb, ":\n")
}

## Deliver an aggregate/str-valued `if cond { <agg> } else { <agg> }` into a LOCAL's slots (the if
## dual of `emit_val_match_to_local`): dispatch the cond, each branch stores its value via
## `emit_arm_val_store`.
emit_val_if_to_local := fn(cond : ptr(Expr), t : ptr(Expr), f : ptr(Expr), base : i64, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  lelse := nl
  lend := nl + 1
  nl += 2
  emit_gas(cond, sb, cx, a, nl)
  push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  je ")
  emit_label(sb, lelse)
  push_str(sb, "\n")
  emit_arm_val_store(t, base, sb, cx, a, nl)
  push_str(sb, "  jmp ")
  emit_label(sb, lend)
  push_str(sb, "\n")
  emit_label(sb, lelse)
  push_str(sb, ":\n")
  emit_arm_val_store(f, base, sb, cx, a, nl)
  emit_label(sb, lend)
  push_str(sb, ":\n")
}

## Deliver a MULTI-WORD aggregate VALUE `v` into a LOCAL struct FIELD whose word-0 frame slot is
## `fslot` and whose declared TYPE is the span `[fts, fts+ftn)`. Returns TRUE when it emitted a full
## multi-word store — a `str` field (2-word {ptr,len}), an `enum` field (disc + payload), or a nested
## STRUCT field of >1 word — writing ALL the field's words so none stay stale; FALSE when the field is
## a single scalar word (the caller keeps its byte-identical one-word store). A multi-word STRUCT value
## must be a struct LITERAL (`emit_struct_assign`), an `if`/`match` value (`emit_val_*_to_local`), or a
## struct VAR (a word copy — a LOCAL source at frame word k, a by-ref source through its pointer at
## k*8); any other value kind is a fail-loud panic, NEVER a silent word-0-only store. Shared by the
## single-hop `FieldAssign` and the deep-chain `FieldPathAssign` LOCAL field-store paths (the store
## dual of the multi-word field READ). Gated by the callers to an inline-struct (frame-local) base, so
## `fslot` is a real down-growing frame slot the `emit_*_assign` primitives can write into.
emit_local_field_agg_store := fn(v : ptr(Expr), fslot : i64, fts : usize, ftn : usize, in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) -> bool {
  if ftn == 0 { return false }
  if str_at((cx.src + fts), ftn) == "str" { emit_str_assign(v, fslot, sb); return true }
  if enum_decl_of(cx.decls, cx.src, fts, ftn) >= 0 { emit_enum_assign(v, fslot, sb, cx, a, nl); return true }
  if struct_decl_of(cx.decls, cx.src, fts, ftn) >= 0 and struct_words(cx.decls, cx.src, fts, ftn, deref(cx.mar)) > 1 {
    fsli := struct_lit_info(v)
    if fsli.is_s { emit_struct_assign(v, fslot, sb, cx, a, nl); return true }
    fmak := match_if_agg_kind(v, cx.decls, cx.src, a)
    if fmak.kind != 0 {
      fmi := match_info(v)
      if fmi.is_m {
        emit_val_match_to_local(fmi.scrut, fmi.head, fslot, sb, cx, a, nl)
      } else {
        fii := if_info(v)
        emit_val_if_to_local(fii.cond, fii.then_e, fii.else_e, fslot, sb, cx, a, nl)
      }
      return true
    }
    ## A multi-word struct VAR source (`o.field = r`) — FAIL LOUD rather than emit a word-copy here.
    ## The naive `for k in 0..struct_words` copy loop, when it lives in THIS extracted helper, is
    ## mis-lowered by the self-host seed to a SINGLE iteration (a word-0-only store — the very silent
    ## miscompile this guard exists to prevent); the byte-identical loop works only inline in a
    ## pre-existing emit function (`emit_struct_assign`). Refusing loudly keeps Priority-1 discipline;
    ## the workaround is `o.field = SType(a = r.a, b = r.b)` (a struct literal) or an intermediate copy.
    ## A struct LITERAL and an if/match value (handled above) cover the common shapes.
    panic("selfhost: whole-value assignment of a multi-word struct VAR into a struct field is unsupported here (would risk a word-0-only store) — use a struct literal `S(a = r.a, …)` or bind through an if/match")
  }
  return false
}

## Lower a statement-position `match scrut { pat => { stmts } ; … }`. The scrutinee is an
## enum-typed `Var` local (dispatch on the discriminant word, with payload binding) OR an
## integer value (value compare). Mirrors `emit_enum_match` / the expression-match dispatch,
## but each arm body is a STATEMENT LIST (`emit_stmts(am.body_stmts)`) and NO value is pushed
## (no default `$0`). Two passes: first emits the dispatch (compare + `je` to each arm's fresh
## body label, a wildcard arm an unconditional `jmp`, no wildcard ⇒ `jmp end`); second emits
## each arm body under its reserved label (`lend+1, lend+2, …`, allocated in order) + `jmp end`.
## `a` (the AST arena) is read from `arena_of(cx)`, not a by-value `rt::Arena` param (it would
## be the 5th value arg with 2 more value args after, pushing this over the seed's safe call-arg
## budget). The scrutinee info is held in SCALAR locals (`sise`/`sbase`/`ses`/`sel`) rather than a
## `mut si : ScrutInfo = si0` struct copy — the seed lower copies a struct-VAR binding by ONE word
## only (it has no `name := <struct-var>` case), which left `es`/`el` garbage; reading the fields
## of `si0` into scalars (and re-assigning the scalars on the by-ref path) needs no struct copy.
emit_match_stmt := fn(scrut : ptr(Expr), head_in : usize, in out sb : strbuf::StrBuf, cx : ptr(LCtx), in out nl : usize) {
  a := arena_of(cx)
  mut enum_owner_ctx := false
  mut enum_owner_old_on := false
  mut enum_owner_old_s := 0
  mut enum_owner_old_l := 0
  mut enum_owner_s := 0
  mut enum_owner_l := 0
  mut si0 := scrut_enum_info(scrut, cx)
  ## A payload alias carries the returned enum's declaration module even when this nested match is
  ## lexically in the caller. Install that identity before template expansion and keep the caller's
  ## context saved for each arm body and for the function exit.
  if si0.tmod_l != 0 {
    enum_owner_old_on = lower_layout::type_ref_mod_on()
    enum_owner_old_s = lower_layout::type_ref_mod_s()
    enum_owner_old_l = lower_layout::type_ref_mod_l()
    enum_owner_s = si0.tmod_s
    enum_owner_l = si0.tmod_l
    lower_layout::set_type_ref_module(enum_owner_s, enum_owner_l, ROOT_MOD_S, ROOT_MOD_L)
    enum_owner_ctx = true
  }
  ## a `match <mutable enum GLOBAL>` — materialize the global into the scratch temp and treat it as an
  ## enum scrutinee (else its `es/el`/`base` are garbage — no frame slot — so arm expansion + dispatch
  ## resolve the wrong discriminant). Emits the copy now; the dispatch below reads it at `si0.base`.
  if si0.is_e == false {
    geg := try_global_enum_scrut(scrut, sb, cx)
    if geg.is_e { si0 = geg }
  }
  ## a `match s.c` over an ENUM FIELD of a struct — materialize the field's enum words into the
  ## scratch temp and dispatch on it as a local (else the field scrutinee read a garbage discriminant).
  if si0.is_e == false {
    feg := try_field_enum_scrut(scrut, sb, cx)
    if feg.is_e { si0 = feg }
  }
  ## a `match cs[i]` over an ENUM-element array — materialize element `i`'s enum words into the
  ## scratch and dispatch on it (the index dual of the field-enum case).
  if si0.is_e == false {
    ieg := try_index_enum_scrut(scrut, sb, cx, nl)
    if ieg.is_e { si0 = ieg }
  }
  ## a `match xs[i].c` over an ENUM FIELD of a struct-element array element.
  if si0.is_e == false {
    aeg := try_arrelem_field_enum_scrut(scrut, sb, cx, nl)
    if aeg.is_e { si0 = aeg }
  }
  ## Capture the comptime-for-VARIANT loop-var name from the `wild==2` template arm (before
  ## `expand_variant_arms` overwrites the generated arms' `vs/vl`) so a `var.name`/`var.payload`
  ## read in the arm body resolves (`display`'s enum arm). Restored at the end. 0/0 for an ordinary
  ## match → byte-identical.
  ov_vls := cx.cf_vloop_s; ov_vll := cx.cf_vloop_l
  mut tpl := head_in
  while tpl != 0 {
    tm := deref(arm_p(tpl))
    if tm.wild == 2 { cx.cf_vloop_s = tm.vs; cx.cf_vloop_l = tm.vl }
    tpl = tm.next
  }
  ## expand any `comptime for var in typeinfo(T).variants` template arm into one real arm per variant.
  head := expand_variant_arms(head_in, si0.es, si0.el, cx, a)
  ## A by-reference enum scrutinee (a by-ref enum parameter) is materialized into the scratch
  ## temp first, so the inline dispatch + payload binding below read from a frame slot.
  mut sise := si0.is_e
  mut sbase := si0.base
  mut ses := si0.es
  mut sel := si0.el
  if (sise == false) and enum_ret_call(scrut, cx) {
    ## scrutinee is a CALL returning an enum (`match g() { … }`): STAGE its result — disc/%rax +
    ## payload/%rdx (the enum return convention) → the scratch temp — then dispatch on the temp as a
    ## local (mirrors the expression-match call path). Without this a STATEMENT `match g()` fell to
    ## the integer path (`emit_gas(scrut)`) and dispatched on a garbage word → wrong arm.
    ## Preserve the RETURN DECLARATION's module while the statement-match path sizes, stages, and
    ## dispatches the returned generic enum. This is the same identity-carrying seam as the
    ## expression-match path above; the statement form is the codec reproducer's shape.
    owner_ci := call_ret_enum_target(scrut, cx)
    if owner_ci >= 0 {
      if enum_owner_ctx == false {
        enum_owner_old_on = lower_layout::type_ref_mod_on()
        enum_owner_old_s = lower_layout::type_ref_mod_s()
        enum_owner_old_l = lower_layout::type_ref_mod_l()
      }
      owner_d := deref(decl_at(Decl, rt::vec_get(deref(cx.decls), usize(owner_ci))))
      enum_owner_s = owner_d.mod_start
      enum_owner_l = owner_d.mod_len
      lower_layout::set_type_ref_module(owner_d.mod_start, owner_d.mod_len, ROOT_MOD_S, ROOT_MOD_L)
      enum_owner_ctx = true
    }
    direct_match_multiword_reject(scrut, cx)
    ci := call_ret_enum_span(scrut, cx)
    tbm := usize(cx.tslot) + cx.mdepth * cx.swidth + cx.swidth - 1   ## this match's scratch level
    ## store EVERY returned word (word k in `emit_retreg(k)`) into the scratch — word k → slot `tbm+1-k`
    ## (the down-growing layout) — so a nested multi-word enum payload stages whole, not just word 0.
    etwm := 1 + enum_inst_words(cx.decls, cx.src, ci.s, ci.n, a)
    ## The scratch check remains fail-loud for a value wider than the current match frame. Supported
    ## nested Option/Result values are staged word-for-word; an over-budget value must not underflow
    ## the down-growing slot arithmetic or silently discard its payload.
    if etwm > tbm + 1 { panic("selfhost: match on an enum-returning call exceeds the available match scratch") }
    if etwm >= 8 {
      ## a WIDE (disc + payload > 7-word, SRET) enum callee has NO return registers to stage from: it
      ## delivers through a hidden result POINTER. Hand it the scratch block's word-0 ADDRESS as that
      ## pointer (`cx.sret_call`, exactly as a `t := mk(…)` binding does) — it then writes the whole
      ## {disc, payload…} block straight into the scratch and nothing is copied back. Without this the
      ## register loop below wired no pointer and read %rax..%r11 for a value that never rode them: the
      ## callee wrote through whatever %rdi held → a RAW SIGSEGV. `src/`+`lib/` declare no
      ## wide-enum-returning fn → dormant → fixpoint-neutral.
      ovssc := cx.sret_call
      cx.sret_call = i64(tbm)
      emit_enum_value(scrut, sb, cx, a)
      cx.sret_call = ovssc
    } else {
    emit_enum_value(scrut, sb, cx, a)
    for k in 0..etwm {
      push_str(sb, "  movq ")
      emit_retreg(sb, k)
      push_str(sb, ", -")
      push_int(sb, i64((tbm - k + 1) * 8))
      push_str(sb, "(%rbp)\n")
    }
    }
    sise = true
    sbase = tbm
    ses = ci.s
    sel = ci.n
  } else if si0.is_e and si0.is_ref {
    mref := materialize_ref_enum(si0.base, si0.es, si0.el, sb, cx)
    sbase = mref.base
    ses = mref.es
    sel = mref.el
  }
  ## §8 `@niche`: a NICHE-FOLDED `Option(ptr(T))` scrutinee is ONE word (no discriminant) — `None` is
  ## the null (0) niche, `Some(p)` the nonzero pointer (Memory §4.2). So an arm dispatches on `word == 0`
  ## (the nullary `None` arm) vs `word != 0` (the `Some` arm), and the `Some` payload IS word 0 itself.
  folded := sise and is_niche_folded(cx.src, ses, sel)
  lend := nl
  nl += 1
  is_str := (sise == false) and match_is_str(head, a)
  if sise {
    ## load the discriminant (slot `base`) into %r12 (callee-saved), at the `@repr(T)` tag WIDTH if the
    ## enum pins one (spec §8), else word-sized (code 0 → byte-identical for the no-`@repr` corpus).
    ## A folded scrutinee loads its single word here identically (code 0) — the word IS the payload.
    rsp := enum_repr_ty(cx.decls, cx.src, ses, sel)
    emit_repr_tag_load(sb, sbase, repr_tag_code(cx.src, rsp.s, rsp.n))
  } else if is_str == false {
    emit_gas(scrut, sb, cx, a, nl)   ## integer scrutinee value on the stack
    push_str(sb, "  popq %r12\n")
  }
  ## reserve body labels contiguously (bodybase == lend+1) before dispatch — see the Expr::Match
  ## note; byte-identical for the integer/enum path.
  bodybase := nl
  nl += arm_count(head, a)
  ## dispatch pass
  mut arm := head
  mut hadwild := false
  mut ai := 0
  while arm != 0 {
    am := deref(arm_p(arm))
    lbody := bodybase + ai
    ai += 1
    if is_str and am.wild == 4 {
      ## a STR-LITERAL arm: byte-compare the str scrutinee against the pattern (StrLit at `am.lit`)
      pat := unchecked bitcast(ptr(Expr), usize(am.lit))
      emit_str_eq_core(scrut, pat, sb, cx, a, nl)
      push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  jne ")
      emit_label(sb, lbody)
      push_str(sb, "\n")
    } else if (sise == false) and (am.wild == 5 or am.wild == 6) {
      ## a RANGE arm (Control Flow §5.4) over a SCALAR scrutinee (%r12): bounds-check against
      ## `[lo, hi)` (wild 5) / `[lo, hi]` (wild 6); jump to the body iff in range, else fall
      ## through. Ranges are scalar-only, so this never fires for an enum (`sise`) scrutinee. Signed.
      lskip := nl
      nl += 1
      push_str(sb, "  movq $")
      push_int(sb, am.lit)
      push_str(sb, ", %rax\n  cmpq %rax, %r12\n  jl ")
      emit_label(sb, lskip)
      push_str(sb, "\n  movq $")
      push_int(sb, am.hi)
      push_str(sb, ", %rax\n  cmpq %rax, %r12\n  ")
      if am.wild == 6 { push_str(sb, "jle ") } else { push_str(sb, "jl ") }
      emit_label(sb, lbody)
      push_str(sb, "\n")
      emit_label(sb, lskip)
      push_str(sb, ":\n")
    } else if am.wild != 0 {
      push_str(sb, "  jmp ")
      emit_label(sb, lbody)
      push_str(sb, "\n")
      hadwild = true
    } else if folded {
      ## §8 `@niche` folded `Option(ptr)`: dispatch on the null niche — nullary `None` ⟺ `word == 0`,
      ## payload `Some` ⟺ `word != 0` (a non-null pointer). No discriminant compare. Nullary-vs-payload
      ## is read from the arm's BINDING COUNT (`Some(p)` binds one, `None` binds none) — robust without
      ## resolving the parenthesized `Option(ptr(T))` span through `enum_decl_of`.
      mut fnb := 0
      mut fcb := am.binds_head
      while unchecked bitcast(usize, fcb) != 0 { fnb = fnb + 1; fcb = bnd_next(fcb) }
      if fnb == 0 { push_str(sb, "  cmpq $0, %r12\n  je ") }
      else { push_str(sb, "  cmpq $0, %r12\n  jne ") }
      emit_label(sb, lbody)
      push_str(sb, "\n")
    } else {
      ## an enum scrutinee compares to the variant's discriminant index; an integer
      ## scrutinee compares to the arm's literal.
      mut cmpv := am.lit
      if sise { cmpv = variant_index(cx.decls, cx.src, ses, sel, am.vs, am.vl, deref(cx.mar)) }
      push_str(sb, "  movq $")
      push_int(sb, cmpv)
      push_str(sb, ", %rax\n  cmpq %rax, %r12\n  je ")
      emit_label(sb, lbody)
      push_str(sb, "\n")
    }
    arm = am.next
  }
  if hadwild == false {
    push_str(sb, "  jmp ")
    emit_label(sb, lend)
    push_str(sb, "\n")
  }
  ## body pass — bind enum payloads (if any), emit the arm's statement list, then jmp end.
  mut arm2 := head
  mut lbody2 := lend + 1
  while arm2 != 0 {
    am2 := deref(arm_p(arm2))
    emit_label(sb, lbody2)
    push_str(sb, ":\n")
    saved := svec_len(cx.slots)
    ## type-aware payload binding (mirrors the expression-match arm): a SINGLE payload whose
    ## (substituted) type is a struct/enum binds as an AGGREGATE (ek 2/3, passed by-ref), fixing the
    ## `check`/sema crash where `Ok(bt : Ty)` bound as a 1-word scalar was passed by-value to a
    ## by-ref `Ty` param. A multi-binding / scalar payload keeps one-word-per-binding scalars.
    mut nbind2 := 0
    mut cb2 := am2.binds_head
    while unchecked bitcast(usize, cb2) != 0 { nbind2 = nbind2 + 1; cb2 = bnd_next(cb2) }
    mut agg_ek2 : u8 = 0
    mut ptys2 := 0
    mut ptyn2 := 0
    mut ptup2 := 0                       ## component count when the payload is a TUPLE (0 = not)
    mut array_ess2 := 0
    mut array_esl2 := 0
    mut array_estride2 := 1
    mut array_nel2 := 0
    if nbind2 == 1 and sise {
      pt2 := variant_payload_span(cx.decls, cx.src, ses, sel, am2.vs, am2.vl, deref(cx.mar))
      ptys2 = pt2.s
      ptyn2 = pt2.n
      if ptyn2 != 0 {
        if str_at((cx.src + ptys2), 1) == "(" {
          ## MULTI-component payload `V(T0, …, TN)` bound to ONE name `p` — a TUPLE (ek 5, N words at
          ## sbase+1). `display(p)`/`hash(p)` then route via `cf_pay_ty` = the `(…)` span to the tuple
          ## instance, and `p` is passed by reference (like any aggregate arg). Count the components.
          agg_ek2 = 5
          mut cj := 0
          mut cg := true
          while cg { ca := typearg_at(cx.src, ptys2, 0, cj); if ca.n == 0 { cg = false } else { ptup2 = ptup2 + 1; cj = cj + 1 } }
        }
        else if struct_decl_of(cx.decls, cx.src, base_type_name(cx.src, ptys2, ptyn2).s, base_type_name(cx.src, ptys2, ptyn2).n) >= 0 { agg_ek2 = 2 }
        else if enum_decl_of(cx.decls, cx.src, base_type_name(cx.src, ptys2, ptyn2).s, base_type_name(cx.src, ptys2, ptyn2).n) >= 0 { agg_ek2 = 3 }   ## a nested generic-instance payload (`Option(u64)`) resolves via its BASE name; the FULL span stays in the slot for the inner match's dispatch
        else if str_at((cx.src + ptys2), ptyn2) == "str" { agg_ek2 = 4 }   ## a str payload → 2-word {ptr, len} binding
        else {
          ## A single fixed-array payload is an indexable aggregate binding. Keep `ptys2/ptyn2`
          ## as the full payload type for comptime consumers, but record the element type/stride
          ## separately for the array alias SlotEntry used by `xs[i].a.arr[j]`.
          pae2 := array_elem_span(cx.src, ptys2, ptyn2)
          if pae2.n != 0 {
            pbn2 := base_type_name(cx.src, pae2.s, pae2.n)
            if struct_decl_of(cx.decls, cx.src, pbn2.s, pbn2.n) < 0 {
              panic("selfhost: a match binding rooted at an array payload currently requires a plain-struct element (`xs[i].a.arr[j]`); aggregate array leaves remain a fail-loud frontier")
            }
            agg_ek2 = 5
            array_ess2 = pae2.s
            array_esl2 = pae2.n
            array_estride2 = struct_words(cx.decls, cx.src, pbn2.s, pbn2.n, a)
            array_nel2 = parse_arr_len(cx.src, ptys2, ptyn2)
            if array_nel2 == 0 or array_estride2 == 0 {
              panic("selfhost: a match binding array payload has no resolvable fixed length/element stride")
            }
          }
        }
      }
    }
    ## §4 UP-GROWING: only bind enum payloads for a RECOGNISED enum scrutinee (`sise`). When `sise` is
    ## false the scrutinee wasn't resolved to an enum, so `sbase` is the not-found literal 0 and
    ## `sbase - 1 - bi` would underflow (a huge usize → a downstream checked `off+1` traps). The old
    ## down-growing `sbase + 1 + bi` produced a garbage-but-non-trapping offset for that dead path.
    if sise {
      mut bnd := am2.binds_head
      mut bi := 0
      while unchecked bitcast(usize, bnd) != 0 {
        bmns := bnd_ns(bnd)
        bmnl := bnd_nl(bnd)
        if agg_ek2 == 5 and array_nel2 != 0 {
          ## The enum already owns the payload block. Add only the filler metadata needed by the
          ## existing checked aggregate-array bounds path; these entries do not allocate frame words.
          for fi2 in 0..(array_nel2 * array_estride2) {
            svec_push(deref(cx.slots), SlotEntry(ns = 0, nl = 0, off = 0, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
          }
          svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = array_ess2, snl = array_esl2, ek = 5, estride = array_estride2, eek = 2, is_ref = false, tmod_s = enum_owner_s, tmod_l = enum_owner_l))
        } else if agg_ek2 == 5 {
          svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = 0, snl = ptup2, ek = 5, estride = 1, eek = 0, is_ref = false))
        } else if agg_ek2 != 0 {
          svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = ptys2, snl = ptyn2, ek = agg_ek2, estride = 1, eek = 0, is_ref = false, tmod_s = enum_owner_s, tmod_l = enum_owner_l))
        } else if folded {
          ## §8 `@niche`: the folded `Some(p)` payload IS word 0 (`sbase`) — bind `p` there as a scalar
          ## (ek 0) pointer, not the `sbase-1` payload word an ordinary `[disc, payload]` enum uses.
          svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false, tmod_s = enum_owner_s, tmod_l = enum_owner_l))
        } else {
          svec_push(deref(cx.slots), SlotEntry(ns = bmns, nl = bmnl, off = sbase - 1 - bi, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false, tmod_s = enum_owner_s, tmod_l = enum_owner_l))
        }
        bi += 1
        bnd = bnd_next(bnd)
      }
    }
    ## COMPTIME enum-hash `hash(p)` support: for a single-payload arm, bind the payload name + its
    ## TYPE so a generic call `hash(p)` inside the body routes to `hash__<paytype>` (implicit type-arg).
    ov_ps := cx.cf_pay_s; ov_pl := cx.cf_pay_l; ov_pts := cx.cf_pay_ty_s; ov_ptl := cx.cf_pay_ty_l
    ov_cvs := cx.cf_curvar_s; ov_cvl := cx.cf_curvar_l
    if nbind2 == 1 and ptyn2 != 0 {
      cx.cf_pay_s = bnd_ns(am2.binds_head)
      cx.cf_pay_l = bnd_nl(am2.binds_head)
      cx.cf_pay_ty_s = ptys2
      cx.cf_pay_ty_l = ptyn2
    }
    ## current variant (for a nested `T.(v)` comptime-variant pattern in this arm's body)
    if am2.wild == 0 { cx.cf_curvar_s = am2.vs; cx.cf_curvar_l = am2.vl }
    cx.mdepth = cx.mdepth + 1                            ## a nested match uses a higher scratch level
      ## DEFER (§9.3): each arm body is a statement-list BLOCK — push a per-arm defer frame before
      ## emitting it and drain its fall-through defers after (gated on `cx.defer_active` for fixpoint-neutrality).
      ## The returned enum's module is needed for the payload metadata above, but the arm body is
      ## lexically in the caller's module. Restore the caller context around body emission so a bare
      ## type/global in the arm cannot accidentally resolve to the callee's same-named declaration.
      if enum_owner_ctx {
        if enum_owner_old_on { lower_layout::set_type_ref_module(enum_owner_old_s, enum_owner_old_l, ROOT_MOD_S, ROOT_MOD_L) } else { lower_layout::clear_type_ref_module() }
      }
      if cx.defer_active { defer_frame_push(cx) }
      emit_stmts(am2.body_stmts, sb, cx, nl)   ## arm body statement list (no value)
      if cx.defer_active {
        emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
        defer_frame_pop(cx)
      }
      if enum_owner_ctx { lower_layout::set_type_ref_module(enum_owner_s, enum_owner_l, ROOT_MOD_S, ROOT_MOD_L) }
      cx.mdepth = cx.mdepth - 1
    cx.cf_pay_s = ov_ps; cx.cf_pay_l = ov_pl; cx.cf_pay_ty_s = ov_pts; cx.cf_pay_ty_l = ov_ptl
    cx.cf_curvar_s = ov_cvs; cx.cf_curvar_l = ov_cvl
    svec_truncate(deref(cx.slots), saved)
    push_str(sb, "  jmp ")
    emit_label(sb, lend)
    push_str(sb, "\n")
    lbody2 += 1
    arm2 = am2.next
  }
  emit_label(sb, lend)
  push_str(sb, ":\n")
  cx.cf_vloop_s = ov_vls; cx.cf_vloop_l = ov_vll
  if enum_owner_ctx {
    if enum_owner_old_on { lower_layout::set_type_ref_module(enum_owner_old_s, enum_owner_old_l, ROOT_MOD_S, ROOT_MOD_L) } else { lower_layout::clear_type_ref_module() }
  }
}

## Emit one body statement list (arena-linked `Stmt` head, 0 = end) into `sb`. An `Assign`
## lowers its value expression (left on the stack) then pops it into the name's frame slot;
## a struct-construction value is special-cased (its fields are stored directly into the
## local's reserved slots via `emit_struct_assign`). A `While` is a counted-style loop — a
## guard label where the condition is lowered and a false (zero) result jumps past the body
## to a done-label, the body lowers, then a back-edge `jmp` returns to the guard. Fresh
## labels via the shared `nl` counter, so nested loops/branches never collide.
## `a` (the AST arena) is read from `deref(cx.mar)` rather than a separate parameter — keeping
## `emit_stmts` at 4 params (the two `in out`, the head, the ctx pointer) so both `in out`
## land in argument registers (the documented arg-register budget; the aggregate-element-copy
## Assign arm added enough pressure to spill `nl` when `a` was a 5th param).
## The variant/field name of an `Arch.<name>` reference (`Field(Var("Arch"), name)`) — used to fold
## a `comptime if target.arch == Arch.<name>` guard. 0/0 if `e` is not `Arch.<name>`.
## During a `comptime for` unroll, resolve a generic call's type-arg that is `<loopvar>.type`
## (the current member's type, e.g. `hash(f.type, v.(f))`) to the bound member type `cf_ty`. 0/0
## if not applicable (no active binding, or the arg is not `<cf_var>.type`).
## T's KIND (in a mono instance where `it` is the concrete type), matching the `TypeInfo` cases of
## appendix §4.1: 5 = Array (`[…]` span), 7 = Tuple (`(…)` span), 2 = Struct (a struct decl), 3 = Enum
## (an enum decl), 6 = Brand (a nominal brand), 8 = Pointer (`ptr(T)`/`ptr(mut T)`), 9 = Str (`str`),
## 10 = Function (`fn(…) -> …`), 0 = Scalar; -1 = unknown (not in an instance). (The `Union` case —
## §4.1 kind 11, mapped in `comptime_kind_of_name` — has no self-host surface yet: union types are not
## parsed, so no instance type ever spells one and this detector never returns 11.) The KIND integers
## are the lower's own; the spec contract is the arm NAMES, which `comptime_kind_of_name` mirrors. Drives
## the comptime `match typeinfo(T)` / `match typeinfo(T){…}` kind-dispatch.
comptime_type_kind := fn(it_s : usize, it_l : usize, decls : ptr(rt::Vec), src : ptr(u8)) -> i64 {
  if it_l == 0 { return 0 - 1 }
  if str_at((src + it_s), 1) == "[" { return 5 }
  ## a TUPLE type `(T0, T1, …)` — kind 7 (drives `typeinfo(T)`'s `Tuple` arm).
  if str_at((src + it_s), 1) == "(" { return 7 }
  bn := base_type_name(src, it_s, it_l)
  ## POINTER `ptr(T)` / `ptr(mut T)` → Pointer (kind 8); STR `str` → Str (kind 9); FUNCTION
  ## `fn(…) -> …` → Function (kind 10) — detected from the type SPELLING's base name (the lexeme
  ## before the first `(`; `str` has none, so its base name is the whole span). Checked before the
  ## brand/struct/enum/scalar fall-through so `typeinfo(ptr(T))`/`typeinfo(str)`/`typeinfo(fn(…))`
  ## select their own arm instead of collapsing to `Scalar` (kind 0). `ptr`/`fn`/`str` are reserved
  ## prelude spellings (never a user type name), so these matches cannot alias a user type.
  bnm := str_at((src + bn.s), bn.n)
  if bnm == "ptr" { return 8 }
  if bnm == "str" { return 9 }
  if bnm == "fn" { return 10 }
  ## A NOMINAL BRAND (`Id := brand(U)`) reifies as `Brand` (kind 6) — checked before
  ## struct/enum/scalar so `typeinfo(Id)`'s `Brand(under, _)` arm is selected. The PRELUDE scalar
  ## brands (`bool`/`char`/`f32`/`f64`, declared `:= brand(bitsN)` in lib) are the lower's BUILT-IN
  ## scalars, not user brands — they reify as `Scalar{kind}` (handled by the `Scalar` arm + the
  ## numeric-kind dispatch), so exclude them here (name is `bool`/`char` or a known conversion type).
  if brand_underlying(decls, src, bn.s, bn.n).n != 0 and not (bnm == "bool" or bnm == "char" or conv_kind(bnm) >= 0) { return 6 }
  ## RAW UNION (spec Types §6.3, appendix §4.1 `TypeInfo.Union`) — reifies as kind 11. Checked BEFORE the
  ## enum arm (a union is a kind-3 decl too), gated on `is_union_decl` → an enum still returns 3 (byte-
  ## identical). Populates the previously-inert `Union` arm now that union types parse.
  if is_union_decl(decls, src, bn.s, bn.n) { return 11 }
  if struct_decl_of(decls, src, bn.s, bn.n) >= 0 { return 2 }
  if enum_decl_of(decls, src, bn.s, bn.n) >= 0 { return 3 }
  return 0
}

## Map a `comptime match typeinfo(T)` arm's variant name to a KIND value (see `comptime_type_kind`);
## -1 for an unrecognized name.
comptime_kind_of_name := fn(src : ptr(u8), vs : usize, vl : usize) -> i64 {
  nm := str_at((src + vs), vl)
  if nm == "Struct" { return 2 }
  if nm == "Enum" { return 3 }
  if nm == "Array" { return 5 }
  if nm == "Scalar" { return 0 }
  if nm == "Brand" { return 6 }
  if nm == "Tuple" { return 7 }
  ## Pointer/Str/Function/Union (appendix §4.1) — same KIND integers `comptime_type_kind` returns.
  ## `Union` (raw union, Types §6.3) now parses and `comptime_type_kind` yields 11 for it, so a
  ## `match typeinfo(U) { Union(_) => … }` arm is live (was inert while union types were unparsed).
  if nm == "Pointer" { return 8 }
  if nm == "Str" { return 9 }
  if nm == "Function" { return 10 }
  if nm == "Union" { return 11 }
  return 0 - 1
}

## The NUMERIC sub-kind of a SCALAR type `T` (appendix §4.1): `Bool`=1, `Char`=2, signed `Int`=3,
## `Float`=4, everything else (unsigned `uN`/`usize`/`bitsN`) = 0. `comptime_type_kind` collapses
## every scalar to `0` (it only tells Struct/Enum/Array/Scalar apart), so the INNER `comptime match`
## on a `Scalar`'s kind binding (`display`'s `match k { Int => … Float => … }`) needs this finer
## reading. Keyed by the instance type's NAME lexeme (the prelude scalar brands `iN`/`fN`/`bool`/
## `char` reify as `Scalar{kind}`); a user brand / unknown name falls through to 0 (the `_` arm).
comptime_scalar_num_kind := fn(it_s : usize, it_l : usize, src : ptr(u8)) -> i64 {
  if it_l == 0 { return 0 }
  nm := str_at((src + it_s), it_l)
  if nm == "bool" { return 1 }
  if nm == "char" { return 2 }
  if nm == "i8" or nm == "i16" or nm == "i32" or nm == "i64" or nm == "isize" { return 3 }
  if nm == "f32" or nm == "f64" { return 4 }
  return 0
}

## Map a `comptime match <scalar-kind>` arm's variant name to a NUMERIC sub-kind (the dual of
## `comptime_scalar_num_kind`): `Bool`/`Char`/`Int`/`Float`. -1 for a non-numeric name (the outer
## `typeinfo(T)` arms `Struct`/`Enum`/`Scalar`/… return -1 here, so this dispatch is inert for them).
comptime_num_kind_of_name := fn(src : ptr(u8), vs : usize, vl : usize) -> i64 {
  nm := str_at((src + vs), vl)
  if nm == "Bool"  { return 1 }
  if nm == "Char"  { return 2 }
  if nm == "Int"   { return 3 }
  if nm == "Float" { return 4 }
  return 0 - 1
}

arch_rhs_name := fn(e : ptr(Expr), src : ptr(u8)) -> CSpan {
  match deref(e) {
    Expr::Field(b, fs, fl) => {
      vn := var_name_span(b)
      if vn.n != 0 and str_at((src + vn.s), vn.n) == "Arch" { return CSpan(s = fs, n = fl) }
      CSpan(s = 0, n = 0)
    }
    _ => { CSpan(s = 0, n = 0) }
  }
}

## Fold a DECLARATION `when`-guard predicate (Comptime §7.1/§9; CT-5): 1 = TRUE (keep the decl active),
## 0 = FALSE (the decl is neutered to an inert no-op — as-if-absent), -1 = cannot fold (KEEP the decl —
## a dependent/generic predicate is treated as active; per-instantiation folding is future work). A decl
## guard is a CLOSED comptime fact — TARGET gating `target.arch == Arch.<name>` (folded against the
## x86_64 build, matching `comptime_cond_eval`'s target arm) composed with `and`/`or`/`not`. Standalone
## (no `LCtx`) because it runs at the top of `emit_program` before any function context exists; it mirrors
## `comptime_cond_eval`'s target-arch + boolean-composition arms over the same `arch_rhs_name` helper. It
## recurses on itself (never a nested match) to stay within the self-host lower idiom limits.
decl_guard_fold := fn(cond : ptr(Expr), src : ptr(u8)) -> i64 {
  match deref(cond) {
    Expr::Bin(op, l, r) => {
      an := arch_rhs_name(r, src)
      if an.n != 0 {
        eq := str_at((src + an.s), an.n) == "x86_64"
        if i64(op) == 20 { if eq { return 1 } return 0 }   ## `==`
        if i64(op) == 28 { if eq { return 0 } return 1 }   ## `!=`
        return -1
      }
      if i64(op) == 42 {                                   ## `not <pred>` (Bin(42, x, x))
        lv := decl_guard_fold(l, src)
        if lv == 1 { return 0 }
        if lv == 0 { return 1 }
        return -1
      }
      if i64(op) == 40 {                                   ## `and`
        lv := decl_guard_fold(l, src)
        if lv == 0 { return 0 }
        rv := decl_guard_fold(r, src)
        if rv == 0 { return 0 }
        if lv == 1 and rv == 1 { return 1 }
        return -1
      }
      if i64(op) == 41 {                                   ## `or`
        lv := decl_guard_fold(l, src)
        if lv == 1 { return 1 }
        rv := decl_guard_fold(r, src)
        if rv == 1 { return 1 }
        if lv == 0 and rv == 0 { return 0 }
        return -1
      }
      return -1
    }
    _ => { return -1 }
  }
}

## The byte SIZE of a concrete type `(ts,tl)` for a `when size(T) …` guard fold — mirrors the `size(T)`
## builtin's WORD model (§8): a struct → words*8, an enum → (1 + max payload arity)*8, else the scalar
## width (`scalar_byte_size` returns 8 for word-sized / unknown names). Standalone (no `LCtx`) so the
## instantiation gate can call it before any function context exists. `src/`+`lib/` carry no generic
## `when` → never reached during the self-build → fixpoint-neutral.
guard_type_bytes := fn(decls : ptr(rt::Vec), src : ptr(u8), ts : usize, tl : usize, a : rt::Arena) -> usize {
  if is_bool_niche_pending(src, ts, tl) {
    panic("selfhost: when size(Option(bool)) requires the declared bool niche; this guard fold is deferred until CLAYOUT S6")
  }
  layout_type_size_bytes(decls, src, ts, tl, a)
}

## The generic's type-PARAMETER bindings for an instantiation guard fold: up to THREE type-parameters
## `(gp_s,gp_l)`/`(gp2_s,gp2_l)`/`(gp3_s,gp3_l)` each bound to a concrete instance type `(its,itl)`/
## `(its2,itl2)`/`(its3,itl3)`. A `.._l == 0` slot is absent (fewer than 3 type-params). Passed BY POINTER
## to the guard-fold helpers (a 12-word bundle — by-pointer sidesteps the by-value aggregate word budget)
## so `size(V)` / `typeinfo(V).…` on the 2nd/3rd type-param folds against its OWN instance type, mirroring
## how `comptime_cond_eval`/`Subst` thread `gps2`→`its2`. `src/`+`lib/` carry no generic `when` → never
## built → fixpoint-neutral.
GuardTP := struct {
  gp_s : usize, gp_l : usize, its : usize, itl : usize,
  gp2_s : usize, gp2_l : usize, its2 : usize, itl2 : usize,
  gp3_s : usize, gp3_l : usize, its3 : usize, itl3 : usize,
}

## Resolve a type-name span `(ts,tl)` through the instance bindings: if it names one of the generic's
## type-PARAMETERS, return that parameter's concrete instance type; otherwise it is a concrete type name
## used AS-IS. Lets `size(T)`/`size(V)`/`size(W)` and `typeinfo(T)`/… fold against whichever of the 1st/
## 2nd/3rd type-params (or a concrete type) the argument spells.
guard_resolve_tp := fn(tp : ptr(GuardTP), src : ptr(u8), ts : usize, tl : usize) -> CSpan {
  t := deref(tp)
  if t.gp_l != 0 and streq(src, ts, tl, t.gp_s, t.gp_l) { return CSpan(s = t.its, n = t.itl) }
  if t.gp2_l != 0 and streq(src, ts, tl, t.gp2_s, t.gp2_l) { return CSpan(s = t.its2, n = t.itl2) }
  if t.gp3_l != 0 and streq(src, ts, tl, t.gp3_s, t.gp3_l) { return CSpan(s = t.its3, n = t.itl3) }
  CSpan(s = ts, n = tl)
}

## If `e` is a `size(X)` comptime call whose argument names a type, return its byte size with `X` resolved
## through the instance bindings `tp` (any of the 1st/2nd/3rd type-params, or a concrete type used as-is);
## -1 when `e` is not such a call. Only used by `guard_fold_inst`.
guard_size_operand := fn(e : ptr(Expr), tp : ptr(GuardTP), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> i64 {
  match deref(e) {
    Expr::Call(cs, cl, nargs, ah) => {
      if str_at((src + cs), cl) == "size" and nargs >= 1 {
        a0 := arg_expr_at(ah, 0, a)
        tn := var_name_span(a0)
        rv := guard_resolve_tp(tp, src, tn.s, tn.n)
        return i64(guard_type_bytes(decls, src, rv.s, rv.n, a))
      }
      return 0 - 1
    }
    _ => { return 0 - 1 }
  }
}

## If `scrut` is a `typeinfo(X)` comptime call whose argument names a type, return that type's KIND
## (`comptime_type_kind`: 2 Struct / 3 Enum / 5 Array / 7 Tuple / 6 Brand / 8 Pointer / 9 Str / 10 Function /
## 0 Scalar) with `X` resolved through the instance bindings `tp`; -1 when `scrut` is not a `typeinfo(type)`
## call. Backs the `match typeinfo(T) { <Kind>(_) => true; _ => false }` when-guard fold (the SPEC surface for
## a structural is-KIND generic bound — appendix §4.1's `TypeInfo` tagged enum, matched, exactly as
## `comptime_cond_eval`'s own `match typeinfo(T)` arm folds it).
guard_typeinfo_kind := fn(scrut : ptr(Expr), tp : ptr(GuardTP), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> i64 {
  match deref(scrut) {
    Expr::Call(cs, cl, nargs, ah) => {
      if str_at((src + cs), cl) == "typeinfo" and nargs >= 1 {
        a0 := arg_expr_at(ah, 0, a)
        tn := var_name_span(a0)
        rv := guard_resolve_tp(tp, src, tn.s, tn.n)
        return comptime_type_kind(rv.s, rv.n, decls, src)
      }
      return 0 - 1
    }
    _ => { return 0 - 1 }
  }
}

## Is `e` an integer literal? / its value. Split into two single-`match` helpers so `guard_fold_inst`
## needs no nested match (staying within the self-host lower idiom limits).
guard_expr_is_num := fn(e : ptr(Expr)) -> bool {
  match deref(e) { Expr::Num(v, s, n) => { true } _ => { false } }
}
guard_expr_num := fn(e : ptr(Expr)) -> i64 {
  match deref(e) { Expr::Num(v, s, n) => { i64(v) } _ => { 0 } }
}

## Apply a comparison operator (24 `<`, 25 `>`, 26 `<=`, 27 `>=`, 20 `==`, 28 `!=`) to two integers;
## 1 = true, 0 = false, -1 = not a comparison op.
guard_cmp := fn(op : i64, l : i64, r : i64) -> i64 {
  if op == 24 { if l < r { return 1 } return 0 }
  if op == 25 { if l > r { return 1 } return 0 }
  if op == 26 { if l <= r { return 1 } return 0 }
  if op == 27 { if l >= r { return 1 } return 0 }
  if op == 20 { if l == r { return 1 } return 0 }
  if op == 28 { if l != r { return 1 } return 0 }
  return 0 - 1
}

## The SINGLE trailing bool expression of a candidate NAMED predicate `fn(T:type,…) -> bool { <expr> }`
## (CT-4 "a constraint is an ordinary comptime fn(type) bool"). A foldable predicate body is exactly ONE
## comptime-boolean expression — either the trailing return expr (`body_stmts == 0`, `value` = the expr)
## or a bare `return <expr>` as the SOLE statement. Anything with locals / control flow (a non-empty
## `body_stmts` that is not a lone `return`) is NOT a single foldable expr → `0` (the caller FAIL-SAFES to
## "cannot fold" = the guard is kept ACTIVE; a full comptime fn-body interpreter is a separate build).
guard_stmt_ret_expr := fn(bs : ptr(mut Stmt)) -> ptr(Expr) {
  match deref(stmt_p(Stmt, bs)) {
    Stmt::Return(e, next) => {
      if unchecked bitcast(usize, next) == 0 { return e }
      unchecked bitcast(ptr(Expr), 0)
    }
    _ => { unchecked bitcast(ptr(Expr), 0) }
  }
}
guard_pred_body_expr := fn(bs : ptr(mut Stmt), val : ptr(Expr)) -> ptr(Expr) {
  if unchecked bitcast(usize, bs) == 0 { return val }   ## trailing-expr body (no statements)
  guard_stmt_ret_expr(bs)                                 ## else must be a lone `return <expr>`
}

## The RESOLVED concrete type a `typeinfo(X)` comptime call names, threaded through the instance bindings
## `tp` (any of the 1st/2nd/3rd type-params, or a concrete type used as-is); `CSpan(0,0)` when `scrut` is
## not a `typeinfo(type)` call. Backs both the is-KIND fold and the field/variant-COUNT fold.
guard_typeinfo_arg_type := fn(scrut : ptr(Expr), tp : ptr(GuardTP), src : ptr(u8), a : rt::Arena) -> CSpan {
  match deref(scrut) {
    Expr::Call(cs, cl, nargs, ah) => {
      if str_at((src + cs), cl) == "typeinfo" and nargs >= 1 {
        a0 := arg_expr_at(ah, 0, a)
        tn := var_name_span(a0)
        return guard_resolve_tp(tp, src, tn.s, tn.n)
      }
      return CSpan(s = 0, n = 0)
    }
    _ => { return CSpan(s = 0, n = 0) }
  }
}

## The declared FIELD count (struct) / VARIANT count (enum) of a concrete type `(rs,rn)` — the fold value of
## `typeinfo(T).fields.len` / `typeinfo(T).variants.len` (the spec's `TypeInfo.Struct{fields:[Field]}` /
## `.Enum{variants:[Variant]}` surface, appendix §4.1); -1 when the type is neither (a scalar/pointer has no
## introspectable member list). Mirrors `comptime_member_count`'s own field/variant walk, here standalone.
guard_type_member_count := fn(rs : usize, rn : usize, decls : ptr(rt::Vec), src : ptr(u8)) -> i64 {
  if rn == 0 { return -1 }
  bnt := base_type_name(src, rs, rn)
  sd := struct_decl_of(decls, src, bnt.s, bnt.n)
  if sd >= 0 {
    sdd := deref(decl_at(Decl, rt::vec_get(deref(decls), usize(sd))))
    mut fc := 0
    mut f := sdd.fields_head
    while f != 0 { fc = fc + 1 ; f = deref(fld_p(f)).next }
    return i64(fc)
  }
  ed := enum_decl_of(decls, src, bnt.s, bnt.n)
  if ed >= 0 {
    edd := deref(decl_at(Decl, rt::vec_get(deref(decls), usize(ed))))
    mut vc := 0
    mut vf := edd.fields_head
    while vf != 0 { vc = vc + 1 ; vf = deref(fld_p(vf)).next }
    return i64(vc)
  }
  return -1
}

## The base expression / tail field-name of an `Expr::Field(base, fs, fl)` (else null / `CSpan(0,0)`) — the
## single-`match` accessors that let `guard_field_count` walk `typeinfo(T).fields.len` (a nested Field over
## a Field over the `typeinfo` call) without a nested match.
guard_field_base := fn(e : ptr(Expr)) -> ptr(Expr) {
  match deref(e) { Expr::Field(base, fs, fl) => { base } _ => { unchecked bitcast(ptr(Expr), 0) } }
}
guard_field_tail := fn(e : ptr(Expr)) -> CSpan {
  match deref(e) { Expr::Field(base, fs, fl) => { CSpan(s = fs, n = fl) } _ => { CSpan(s = 0, n = 0) } }
}

## If `e` is a `typeinfo(T).fields.len` / `typeinfo(T).variants.len` / `typeinfo(T).n` comptime member-count
## expression (over any of the 1st/2nd/3rd type-params, or a concrete type), return the resolved instance
## type's field/variant COUNT; -1 otherwise. The spec-faithful structural bound the `TypeInfo` surface
## supports directly — the fold value of a `when typeinfo(T).fields.len <op> N` guard. (A field-by-NAME
## `has_field("x")` is NOT a `TypeInfo` builtin — the spec models it as a `comptime for f in typeinfo(T).
## fields { … f.name == "x" … }` walk that yields a bool, which needs the comptime fn-body interpreter; only
## the COUNT is a single foldable comptime expression here.)
guard_field_count := fn(e : ptr(Expr), tp : ptr(GuardTP), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> i64 {
  tail := guard_field_tail(e)
  if tail.n == 0 { return -1 }
  tnm := str_at((src + tail.s), tail.n)
  base := guard_field_base(e)
  if tnm == "len" {                                   ## `typeinfo(T).fields.len` / `.variants.len`
    inner := guard_field_base(base)                   ## descend past `.fields`/`.variants` to `typeinfo(T)`
    if unchecked bitcast(usize, inner) == 0 { return -1 }
    rt := guard_typeinfo_arg_type(inner, tp, src, a)
    return guard_type_member_count(rt.s, rt.n, decls, src)
  }
  if tnm == "n" {                                     ## `typeinfo(T).n` (the lower's member-count shorthand)
    rt := guard_typeinfo_arg_type(base, tp, src, a)
    return guard_type_member_count(rt.s, rt.n, decls, src)
  }
  return -1
}

## Fold a NAMED comptime-PREDICATE call `P(A, …)` (CT-4) by INLINING its single foldable body expression
## `be`: bind the predicate's own type-PARAMETERS `ph` (positionally to the call's type ARGUMENTS `ah`, each
## resolved through the caller instance's `tp`) into a FRESH `GuardTP`, then recurse `guard_fold_inst` into
## the body. The `GuardTP` is built here as THIS function's OWN local so `ptr(itp)` gets a reliable frame
## home (a `GuardTP` local built and address-taken deep inside a match arm of `guard_fold_inst` does NOT — the
## lean lower's aggregate-local frame-home limit; mirror `emit_program`'s top-level-local `gtp`). Up to three
## type-params (extra ones ignored). `src/`+`lib/` carry no generic `when` → never built → fixpoint-neutral.
guard_pred_call_fold := fn(be : ptr(Expr), ph : ptr(mut Param), ah : ptr(mut Arg), tp : ptr(GuardTP), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> i64 {
  mut i1s := 0
  mut i1l := 0
  mut t1s := 0
  mut t1l := 0
  mut i2s := 0
  mut i2l := 0
  mut t2s := 0
  mut t2l := 0
  mut i3s := 0
  mut i3l := 0
  mut t3s := 0
  mut t3l := 0
  mut pp := ph
  mut pidx := 0
  mut slot := 0
  while pp != 0 {
    pm := deref(param_p(pp))
    if str_at((src + pm.ts), pm.tl) == "type" {
      argx := arg_expr_at(ah, pidx, a)
      tn := var_name_span(argx)
      rv := guard_resolve_tp(tp, src, tn.s, tn.n)
      if slot == 0 { i1s = pm.ns ; i1l = pm.nl ; t1s = rv.s ; t1l = rv.n }
      else if slot == 1 { i2s = pm.ns ; i2l = pm.nl ; t2s = rv.s ; t2l = rv.n }
      else if slot == 2 { i3s = pm.ns ; i3l = pm.nl ; t3s = rv.s ; t3l = rv.n }
      slot = slot + 1
    }
    pidx = pidx + 1
    pp = pm.next
  }
  itp := GuardTP(gp_s = i1s, gp_l = i1l, its = t1s, itl = t1l,
                 gp2_s = i2s, gp2_l = i2l, its2 = t2s, itl2 = t2l,
                 gp3_s = i3s, gp3_l = i3l, its3 = t3s, itl3 = t3l)
  guard_fold_inst(be, ptr(itp), decls, src, a)
}

## Fold a generic-fn `when`-predicate AT INSTANTIATION (Comptime §7.1/§9; CT-4/CT-5): given the instance's
## concrete type-parameter bindings `tp` (up to three type-params → their concrete types), fold an INLINE
## comptime-boolean. 1 = TRUE (admit the instance), 0 = FALSE (the instance is as-if-absent — not emitted),
## -1 = cannot fold (admit, per the conservative default). Two structural predicate forms — both spec
## surfaces folded against the concrete instance:
##   • `size(U) <op> N` — a comparison whose LHS is a `size(…)` comptime call (over any of the 1st/2nd/3rd
##     type-params, or a concrete type) and RHS an integer literal (§8 word model).
##   • `match typeinfo(U) { <Kind>(_) => true; _ => false }` — a structural is-KIND bound (appendix §4.1's
##     `TypeInfo` tagged enum, matched); folds by the resolved type's kind == the first arm's kind name
##     (the same read `comptime_cond_eval`'s `match typeinfo(T)` arm performs, here standalone per-instance).
## Both compose with `and`(40)/`or`(41)/`not`(42), recursing on itself (never a nested match) like
## `decl_guard_fold`. A `T == U` type-equality or `target.arch == …` guard falls to -1 (admit) here — those
## are folded on their own paths. `src/`+`lib/` carry no generic `when` → never called with a non-null guard
## → fixpoint-neutral.
guard_fold_inst := fn(cond : ptr(Expr), tp : ptr(GuardTP), decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> i64 {
  match deref(cond) {
    Expr::Bin(op, l, r) => {
      if i64(op) == 42 {                                   ## `not <pred>` (Bin(42, x, x))
        lv := guard_fold_inst(l, tp, decls, src, a)
        if lv == 1 { return 0 }
        if lv == 0 { return 1 }
        return -1
      }
      if i64(op) == 40 {                                   ## `and`
        lv := guard_fold_inst(l, tp, decls, src, a)
        if lv == 0 { return 0 }
        rv := guard_fold_inst(r, tp, decls, src, a)
        if rv == 0 { return 0 }
        if lv == 1 and rv == 1 { return 1 }
        return -1
      }
      if i64(op) == 41 {                                   ## `or`
        lv := guard_fold_inst(l, tp, decls, src, a)
        if lv == 1 { return 1 }
        rv := guard_fold_inst(r, tp, decls, src, a)
        if rv == 1 { return 1 }
        if lv == 0 and rv == 0 { return 0 }
        return -1
      }
      ## `size(U) <op> N` — a comparison whose LHS is a `size(…)` comptime call and RHS an integer literal.
      lsz := guard_size_operand(l, tp, decls, src, a)
      if lsz >= 0 and guard_expr_is_num(r) {
        return guard_cmp(i64(op), lsz, guard_expr_num(r))
      }
      ## `typeinfo(U).fields.len <op> N` — a structural FIELD/VARIANT-COUNT bound (appendix §4.1's
      ## `TypeInfo.Struct{fields:[Field]}` / `.Enum{variants:[Variant]}`), the count folded per-instance.
      lcnt := guard_field_count(l, tp, decls, src, a)
      if lcnt >= 0 and guard_expr_is_num(r) {
        return guard_cmp(i64(op), lcnt, guard_expr_num(r))
      }
      return -1
    }
    ## `when P(T)` — a NAMED comptime PREDICATE call (CT-4: "a constraint is an ordinary comptime fn(type)
    ## bool"). If the callee resolves to a generic `fn(<type-params>) -> bool` whose body is a SINGLE
    ## foldable comptime-boolean expression (`guard_pred_body_expr` — a trailing expr or lone `return`),
    ## INLINE it: bind the predicate's OWN type-params to this call's type ARGUMENTS (each first resolved
    ## through the outer instance's `tp`) and recurse `guard_fold_inst` into the predicate body. A callee
    ## that is not such a bool predicate, or whose body has locals / control flow, → -1 (KEPT — the guard
    ## stays active; a full comptime fn-body interpreter is a separate build). Composes with and/or/not
    ## since a named call is just another leaf of the boolean tree.
    Expr::Call(cs, cl, nargs, ah) => {
      idx := generic_decl_of(decls, src, cs, cl, 0, 0, nargs, ah, a)
      if idx < 0 { return -1 }
      pd := deref(decl_get(decls, usize(idx)))
      if pd.is_fn == false { return -1 }
      if pd.is_generic == false { return -1 }
      if str_at((src + pd.ret_ts), pd.ret_tl) == "bool" {
        be := guard_pred_body_expr(pd.body_stmts, pd.value)
        if unchecked bitcast(usize, be) == 0 { return -1 }   ## non-single-expr body → fail-safe KEPT
        return guard_pred_call_fold(be, pd.params_head, ah, tp, decls, src, a)
      }
      return -1
    }
    ## `match typeinfo(U) { <Kind>(_) => true; _ => false }` — a structural is-KIND bound. Fold by the
    ## resolved instance type's kind: the FIRST arm's variant name (`Struct`/`Enum`/`Scalar`/…) is the
    ## tested kind → 1 when it matches the instance's kind, else 0. A non-`typeinfo` scrutinee or an
    ## unrecognized first-arm name → -1 (admit).
    Expr::Match(scrut, arms_head) => {
      k := guard_typeinfo_kind(scrut, tp, decls, src, a)
      if k < 0 { return -1 }
      am := deref(arm_p(arms_head))
      if am.vl != 0 {
        want := comptime_kind_of_name(src, am.vs, am.vl)
        if want >= 0 {
          if k == want { return 1 }
          return 0
        }
      }
      return -1
    }
    _ => { return -1 }
  }
}

## Tooling §2.7 — the SELECTED profile's `build.<name>` comptime facts, as a `name=value\n` blob set by
## the manifest build path (`cli::run_cli` mode 6) via `set_build_flags`. Stored as a raw (ptr, len) pair
## because a mutable `str` global cannot be whole-assigned in the lean lower. Empty for a bare file-list /
## `run` compile and for the self-host's OWN build (its `package.al` declares no `profile_flags`) → the
## `build.*` folding path is DORMANT → the emitted GAS is byte-identical → fixpoint-neutral, no reseed.
## `comptime_cond_eval` folds `comptime if build.<flag>`; `emit_gas` folds a bare `build.<flag>` value.
## An undeclared `build.<name>` FAILS LOUD (a `panic`) — never a silent false / zero (Tooling §2.7, FND-7).
mut BUILD_FLAGS_P : usize = 0
mut BUILD_FLAGS_N : usize = 0
pub set_build_flags := fn(p : usize, n : usize) -> i64 { BUILD_FLAGS_P = p ; BUILD_FLAGS_N = n ; return 0 }

## The AMBIENT ALLOCATOR (MEM-5): the `alloc::with(A) { … }` scope in effect, as the `A` expression's
## pointer (a `ptr(Expr)` bit-cast to `usize`; 0 = none). Set/restored around the body in `emit_stmts`'s
## `AllocWith` arm; read at a call site with an ELIDED allocator parameter to inject `ptr(A)` (§5.5).
## `src/` never opens an `alloc::with` scope → stays 0 → dormant for the self-host build.
mut AMBIENT_ALLOC : usize = 0

## The body-stmt head of the fn whose calls the mono PRE-PASS is currently collecting (0 = none). Set
## per top-level fn in `collect_insts` so `infer_implicit_pre` can type an implicit generic call's LOCAL
## value arg (`v.push(i)`, `i` a local) via `fn_local_type` — but ONLY for a UFCS-style call whose callee
## takes a `ptr(...)` RECEIVER as its first runtime param (so `hash(key)`/`eq(a,b)`, whose args pass by
## value, are NOT affected — that path stays exactly as before → `src/` byte-identical, fixpoint-safe).
mut COLLECT_BODY : usize = 0

## The MODULE of the declaration whose body the mono pre-pass is collecting — the `COLLECT_BODY`
## twin, and for the same reason. `generic_decl_of` resolves a BARE generic call by the §3 ancestor
## ranking of the CALLING module; the collector used to pass `0, 0` (no module at all), so it fell to
## last-declared while the emit side, which does know its module, could pick the ancestor's copy.
## The two then disagreed and the instance the call names was never emitted (`ld: undefined reference
## to 'geo__gid__u64'` — loud, but only because the emit side had already been fixed). Publishing the
## collecting module here keeps the collected instance set and the emitted call labels in lockstep.
mut COLLECT_MOD_S : usize = 0
mut COLLECT_MOD_L : usize = 0

## The EMIT-side counterparts of `COLLECT_BODY`: the body-stmt head + params head of the fn currently
## being EMITTED (`emit_fn`). They let the emit side resolve a UFCS receiver's DECLARED type from the
## SOURCE annotation — the slot keeps only the aggregate's BASE name (`Result`), losing the type-args
## (`u64, u64`), so `recv_full_emit` re-reads them exactly as the pre-pass's `recv_full_pre` does, and
## the two passes agree on the implicit-UFCS instance label. 0 = not inside a fn body emit.
mut EMIT_BODY : usize = 0
mut EMIT_PARAMS : usize = 0


## The `typeinfo(X)` ARGUMENT type text of a `comptime for <v> in typeinfo(X).fields/.variants/…`
## header, recovered by a SOURCE-SCAN forward from the loop-var name span `[vs, vs+vl)`. The `CompFor`
## AST node keeps only the loop-var span, the fields/variants flag, the body and `next` (the seed's
## AST-node word budget), so the ITERATED TYPE is otherwise LOST — the same recovery discipline as
## `fnty_ret_span` and the enum discriminant pins. 0/0 when the header does not spell
## `in typeinfo(<type>)`.
pub compfor_iter_arg := fn(src : ptr(u8), vs : usize, vl : usize) -> CSpan {
  lim := vs + vl + 512
  mut p := fnty_skip_ws(src, vs + vl, lim)
  if str_at((src + p), 2) != "in" { return CSpan(s = 0, n = 0) }
  p = fnty_skip_ws(src, p + 2, lim)
  if str_at((src + p), 8) != "typeinfo" { return CSpan(s = 0, n = 0) }
  p = fnty_skip_ws(src, p + 8, lim)
  if str_at((src + p), 1) != "(" { return CSpan(s = 0, n = 0) }
  p = fnty_skip_ws(src, p + 1, lim)
  e := comptime_arg_end(src, p, lim)
  if e <= p { return CSpan(s = 0, n = 0) }
  CSpan(s = p, n = e - p)
}



## `cx.loop_dframe` records each loop's body-frame boundary (parallel to `cx.loop_brk`) so a `break`/`continue`
## drains the defer ledger up to the TARGET loop's boundary without a nested scan. The defer ledger it
## indexes into now lives in `LCtx` (`cx.defer_*`) — see `lower_ctx.al`.
## The loop-target stack + each loop's defer-frame boundary now live in `LCtx` (`cx.loop_*`) — see
## `lower_ctx.al`. Push/pop one frame; the pairs are balanced at every call site.
loop_push := fn(cx : ptr(LCtx), brk : i64, cont : i64, isexpr : usize) {
  if cx.loop_sp < 64 {
    cx.loop_brk[cx.loop_sp] = brk
    cx.loop_cont[cx.loop_sp] = cont
    cx.loop_isexpr[cx.loop_sp] = isexpr
    cx.loop_sp = cx.loop_sp + 1
  }
}
loop_pop := fn(cx : ptr(LCtx)) { if cx.loop_sp > 0 { cx.loop_sp = cx.loop_sp - 1 } }
## DEFER (§9.3): push/pop a per-block frame (a snapshot of `cx.defer_n`, the block's drain boundary)
## at a nested statement-block's entry/exit. Frame ops emit NO gas and are CALLED ONLY when `cx.defer_active`
## (a defer-free fn never touches the frame stack — the TOOL-1 fixpoint is byte-neutral for the tree).
defer_frame_push := fn(cx : ptr(LCtx)) {
  if cx.defer_sp >= 64 { panic("selfhost: defer — more than 64 nested defer-scope blocks in one function") }
  cx.defer_frame[cx.defer_sp] = cx.defer_n
  cx.defer_sp = cx.defer_sp + 1
}
defer_frame_pop := fn(cx : ptr(LCtx)) { if cx.defer_sp > 0 { cx.defer_sp = cx.defer_sp - 1 } }
## The `Stmt::Match` arm of `emit_stmts`, moved out verbatim (Step 4.1). Statement-position dispatch;
## the caller keeps `s = nx`. Touches no module global.
emit_st_match := fn(sc : ptr(Expr), ah : ptr(mut Arm), nx : ptr(mut Stmt), in out sb : strbuf::StrBuf, cx : ptr(LCtx), in out nl : usize) {
  ## TAIL: an arm body's last statement is the fn's return value only for a DIRECTLY-tail `match`
  ## (`cx.tail` already true AND nothing follows it) — the braced value-`match` path documented at
  ## `emit_fn`. A `match` with statements after it must not let an arm's trailing call `jmp` the
  ## epilogue.
  mov_tail := cx.tail
  cx.tail = mov_tail and nx == 0
  emit_match_stmt(sc, ah, sb, cx, nl)
  cx.tail = mov_tail
}

## The `Stmt::CompIf` arm of `emit_stmts`, moved out verbatim (Step 4.1). Re-enters `emit_stmts`
## on the selected branch; the caller keeps `s = nx`. Touches no module global.
emit_st_comp_if := fn(ccond : ptr(Expr), cthen : ptr(mut Stmt), celse : ptr(mut Stmt), nx : ptr(mut Stmt), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  ## The selected branch's inner last statement is the function TAIL only when the CompIf is
  ## ITSELF in tail position (cx.tail already true AND nothing follows it, nx == 0). Otherwise
  ## a bare-ExprStmt tail (e.g. num.al's `comptime if … { x86_64.addq(out, b) }` followed by a
  ## `return out`) would wrongly `jmp` the epilogue, skipping the real trailing statements.
  ov_tail := cx.tail
  cx.tail = ov_tail and nx == 0
  cv := comptime_cond_eval(ccond, cx, a)
  if cv < 0 { comptime_reject_cond(ccond, cx.src) }
  if cv == 1 { emit_stmts(cthen, sb, cx, nl) }
  else if cv == 0 { emit_stmts(celse, sb, cx, nl) }
  cx.tail = ov_tail
}

## The `Stmt::ExprStmt` arm of `emit_stmts`, moved out verbatim (Step 4.1). Takes `head` because the
## variadic-`print` expansion needs the block head; the caller keeps `s = nx`. Touches no module global.
emit_st_expr_stmt := fn(e : ptr(Expr), nx : ptr(mut Stmt), head : ptr(mut Stmt), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  ## `<call>.expect(msg)` / `<call>?` as a DISCARDED STATEMENT (not the base of a `.field`):
  ## the stdlib's fallible mutators are used this way (`push(T, out, v).expect("oom")` in
  ## `vec::filter`/`split`). Handle it like the Field-arm tryable unwrap MINUS the field read:
  ## `emit_enum_value(recv)` EVALUATES the receiver call (its side effect — the push happens)
  ## and leaves disc/%rax; on Ok (disc 0) discard, on Err `?` returns the whole enum from the
  ## enclosing fn / `expect` panics (msg + exit 1). WITHOUT this the UFCS desugar `expect(recv,
  ## msg)` hit the generic 2-type-param `expect` — whose arg 0 (the receiver) was ERASED as the
  ## type argument, so the receiver call was never emitted (the mutation was silently dropped).
  ## `{}`-template variadic `print(...)` in statement position — expand to the specified
  ## `io::print(seg)` / `print_one(arg)` call sequence (Functions §7.1) instead of a plain call
  ## to the (register-passed, un-expandable) variadic fn.
  mut vpr := false
  vcp := call_parts(e)
  if vcp.is_call and variadic_print_target(cx.decls, cx.src, vcp.cs, vcp.cl, vcp.na, cx.mod_s, cx.mod_l, a) >= 0 {
    emit_variadic_print(vcp.ah, head, sb, cx, a, nl)
    vpr = true
  }
  if not vpr {
    tbf := tryable_field_recv(e, cx.src, a)
    mut handled := false
    if tbf.kind != 0 {
      rty := call_ret_ty_span(tbf.recv, cx.decls, cx.src, deref(cx.mar))
      if rty.n != 0 {
        emit_enum_value(tbf.recv, sb, cx, a, nl)   ## disc → %rax (evaluates the receiver call)
        lok := nl
        nl += 1
        push_str(sb, "  cmpq $0, %rax\n  je ")
        emit_label(sb, lok)
        push_str(sb, "\n")
        if tbf.kind == 1 {
          push_str(sb, "  jmp ")
          emit_label(sb, cx.epi)
          push_str(sb, "\n")
        } else {
          emit_str_pair(tbf.msg, sb, cx, a, nl)
          push_str(sb, "  popq %rdx\n  popq %rsi\n  movq $2, %rdi\n  movq $1, %rax\n  syscall\n")
          push_str(sb, "  movq $1, %rdi\n  movq $60, %rax\n  syscall\n")
        }
        emit_label(sb, lok)
        push_str(sb, ":\n")   ## Ok: result discarded (a statement)
        handled = true
      }
    }
    if handled == false {
      if is_raw_instr_call(e, cx.src, a) {
        ## RAW-ASM instruction over register operands (`movq(rax, 60)`, `syscall()`; spec ch.80 §2):
        ## emit the single machine instruction directly — no stack value, and crucially NO discard-pop
        ## (a `popq %rax` would clobber the register just written, breaking a syscall register setup).
        emit_raw_instr(e, sb, cx, a)
      } else if cx.tail and nx == 0 {
        ## TAIL position (last stmt of a value-returning fn / of a directly-tail `match` arm):
        ## this bare expression IS the return value — deliver it via the return convention + `jmp`
        ## epilogue instead of discarding it (the value-`match`-arm path the lean parser can't form).
        emit_return_value(e, sb, cx, a, nl)
      } else {
        emit_gas(e, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n")
      }
    }
  }
}

## The `Stmt::CompForRange` arm of `emit_stmts`, moved out verbatim (Step 4.1). Both the pack unroll
## and the constant-range unroll re-enter `emit_stmts` per iteration; the caller keeps `s = nx`.
## Touches no module global.
emit_st_comp_for_range := fn(rvs : usize, rvl : usize, rlo : ptr(Expr), rhi : ptr(Expr), rbody : ptr(mut Stmt), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  if unchecked bitcast(usize, rhi) == 0 {
    ## PACK unroll (Functions §7.1) — a null hi marks `comptime for v in <pack>`: bind the loop var
    ## `v` to each TRAILING pack argument (`cx.pack_args`) in turn (evaluate the arg → `v`'s slot),
    ## then emit the body. Control flow erased; an empty pack (`pack_args == 0`) emits nothing.
    rslot := slot_of(cx.slots, cx.src, rvs, rvl)
    mut pa := cx.pack_args
    while pa != 0 {
      pam := deref(arg_p(pa))
      mut handled := false
      ## HETEROGENEOUS packs (Functions §7.1): a pack arg that is a bound VARIABLE keeps its OWN type.
      ## Alias the loop var to that variable's storage + type for this iteration by pushing a slot
      ## entry with the arg's off/ek/type under the loop var's NAME — `slot_of`/`entry_of` are
      ## last-match-wins, so it shadows the loop var's own (scalar) slot; it is popped after the body.
      ## This is what lets a struct / str / any-typed pack arg work (`p.x`, `p.len`, … resolve).
      ## `var_name_span` (not an inline `match`, which degenerates here) recovers a `Var` arg's name.
      vsp := var_name_span(pam.e)
      if vsp.n != 0 {
        aei := entry_of(cx.slots, cx.src, vsp.s, vsp.n)
        aent := deref(svec_at(SlotEntry, cx.slots, aei))
        if streq(cx.src, aent.ns, aent.nl, vsp.s, vsp.n) {
          asv := svec_len(cx.slots)
          svec_push(deref(cx.slots), SlotEntry(ns = rvs, nl = rvl, off = aent.off, sns = aent.sns, snl = aent.snl, ek = aent.ek, estride = aent.estride, eek = aent.eek, is_ref = aent.is_ref, tmod_s = aent.tmod_s, tmod_l = aent.tmod_l))
          emit_stmts(rbody, sb, cx, nl)
          svec_truncate(deref(cx.slots), asv)
          handled = true
        }
      }
      if handled == false {
        ## a non-variable pack arg must be a SINGLE-word scalar (integer/pointer): evaluate it and bind
        ## the value into the loop var's 1-word slot. A multi-word LITERAL (struct/array/str literal) is
        ## rejected — fail LOUDLY (§8, no silent miscompile) rather than misread it from a 1-word slot;
        ## pass such a value through a variable to use it as a pack arg.
        pw := emit_operand_words(pam.e, sb, cx, a, nl)
        if pw != 1 { panic("selfhost: comptime-variadic pack arg must be a single-word scalar or a bound variable (multi-word literal pack args not supported)") }
        push_str(sb, "  popq %rax\n  movq %rax, -")
        push_int(sb, (rslot + 1) * 8)
        push_str(sb, "(%rbp)\n")
        emit_stmts(rbody, sb, cx, nl)
      }
      pa = pam.next
    }
  } else {
    rlo_v := comptime_range_bound(rlo, cx)
    rhi_v := comptime_range_bound(rhi, cx)
    rslot := slot_of(cx.slots, cx.src, rvs, rvl)
    ## COMPTIME STEP BUDGET (§3.3): an over-budget range is a CLEAN fatal error, never a silent
    ## truncation — a `comptime for` unrolling > 100000 steps would either bloat the output or (with
    ## the old `rguard` cap) silently emit a WRONG program missing its tail iterations. Deterministic:
    ## the same over-budget input always aborts here. (src/ has no such loop, so this never fires on
    ## the self-build → fixpoint byte-identical.)
    if rhi_v - rlo_v > 100000 { panic("selfhost: comptime-for range exceeds the unroll budget (100000)") }
    mut rk := rlo_v
    while rk < rhi_v {
      push_str(sb, "  movq $")
      push_int(sb, rk)
      push_str(sb, ", %rax\n  movq %rax, -")
      push_int(sb, (rslot + 1) * 8)
      push_str(sb, "(%rbp)\n")
      emit_stmts(rbody, sb, cx, nl)
      rk += 1
    }
  }
}



## The `Stmt::CompFor` arm of `emit_stmts`, moved out verbatim (Step 4.1). Unrolls a
## `comptime for` over a type's members, re-entering `emit_stmts` per member; the caller keeps
## `s = nx`. Touches no module global.
emit_st_comp_for := fn(cvs : usize, cvl : usize, cisvar : u8, cbody : ptr(mut Stmt), in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize) {
  cft := compfor_target_type(cx, cvs, cvl)
  cfts := cft.s
  cftl := cft.n
  if cftl != 0 and cisvar == 0 and str_at((cx.src + cfts), 1) == "(" {
    ## `comptime for c in typeinfo(T).components` over a TUPLE `T` `(T0, T1, …)` — UNROLL over
    ## the components (each read off the `(…)` span via `typearg_at`), binding `cf_ty` to the
    ## component TYPE and `cf_fld_s` to the component INDEX with `cf_fld_l = 0` (the tuple-mode
    ## signal, no member name), so the body's `v.(c)` resolves to a component word read and
    ## `c.type` to the component type. Saved/restored (single-level).
    ov_vs := cx.cf_var_s; ov_vl := cx.cf_var_l
    ov_fs := cx.cf_fld_s; ov_fl := cx.cf_fld_l
    ov_ts := cx.cf_ty_s; ov_tl := cx.cf_ty_l
    mut jt := 0
    mut got := true
    while got {
      comp := typearg_at(cx.src, cfts, 0, jt)
      if comp.n == 0 { got = false } else {
        cx.cf_var_s = cvs
        cx.cf_var_l = cvl
        cx.cf_fld_s = jt
        cx.cf_fld_l = 0
        cx.cf_ty_s = comp.s
        cx.cf_ty_l = comp.n
        emit_stmts(cbody, sb, cx, nl)
        jt += 1
      }
    }
    cx.cf_var_s = ov_vs; cx.cf_var_l = ov_vl
    cx.cf_fld_s = ov_fs; cx.cf_fld_l = ov_fl
    cx.cf_ty_s = ov_ts; cx.cf_ty_l = ov_tl
  } else if cftl != 0 and cisvar == 0 and str_at((cx.src + cfts), 1) == "[" {
    ## `comptime for e in typeinfo(T).elements` over an ARRAY `[T; N]` — UNROLL N times, binding
    ## `cf_ty` to the ELEMENT type and `cf_fld_s` to the element INDEX (`cf_fld_l = 0`), so the
    ## body's `v.(e)` reads element i and `e.type` is the element type. Reuses the tuple
    ## component-read machinery (same down-growing element layout). Saved/restored.
    aes := array_elem_span(cx.src, cfts, cftl)
    an := parse_arr_len(cx.src, cfts, cftl)
    ov_vs := cx.cf_var_s; ov_vl := cx.cf_var_l
    ov_fs := cx.cf_fld_s; ov_fl := cx.cf_fld_l
    ov_ts := cx.cf_ty_s; ov_tl := cx.cf_ty_l
    mut ai := 0
    while ai < an {
      cx.cf_var_s = cvs
      cx.cf_var_l = cvl
      cx.cf_fld_s = ai
      cx.cf_fld_l = 0
      cx.cf_ty_s = aes.s
      cx.cf_ty_l = aes.n
      emit_stmts(cbody, sb, cx, nl)
      ai += 1
    }
    cx.cf_var_s = ov_vs; cx.cf_var_l = ov_vl
    cx.cf_fld_s = ov_fs; cx.cf_fld_l = ov_fl
    cx.cf_ty_s = ov_ts; cx.cf_ty_l = ov_tl
  } else if cftl != 0 and cisvar == 0 {
    bn := base_type_name(cx.src, cfts, cftl)
    sdi := struct_decl_of(cx.decls, cx.src, bn.s, bn.n)
    ## `.fields` over a type with NO field list (a scalar) unrolls ZERO times and that is not a
    ## silent deletion but the right answer: the mono worklist SPECULATIVELY instantiates any
    ## generic carrying a `comptime for … typeinfo(T).fields` once per FIELD TYPE of the real
    ## instance (`stmts_have_compfor` — how a self-recursive derive reaches its leaves), so
    ## `sumfields__u64` / `speq__u64` are emitted alongside `sumfields__Pt`, and a `u64` instance
    ## genuinely has no fields. Rejecting here fails those (dead) instances and breaks
    ## `fmt_comptime_for` / `agg_compare_fields`. What WAS wrong — iterating the wrong type — is
    ## fixed above by honouring the header's own `typeinfo(X)` argument.
    if sdi >= 0 {
      sd := deref(decl_at(Decl, rt::vec_get(deref(cx.decls), usize(sdi))))
      ov_vs := cx.cf_var_s; ov_vl := cx.cf_var_l
      ov_fs := cx.cf_fld_s; ov_fl := cx.cf_fld_l
      ov_ts := cx.cf_ty_s; ov_tl := cx.cf_ty_l
      mut fd := sd.fields_head
      while fd != 0 {
        fdd := deref(fld_p(fd))
        cx.cf_var_s = cvs
        cx.cf_var_l = cvl
        cx.cf_fld_s = fdd.ns
        cx.cf_fld_l = fdd.nl
        cx.cf_ty_s = fdd.ts
        cx.cf_ty_l = fdd.tl
        emit_stmts(cbody, sb, cx, nl)
        fd = fdd.next
      }
      cx.cf_var_s = ov_vs; cx.cf_var_l = ov_vl
      cx.cf_fld_s = ov_fs; cx.cf_fld_l = ov_fl
      cx.cf_ty_s = ov_ts; cx.cf_ty_l = ov_tl
    }
  } else if cftl != 0 and cisvar == 1 {
    ## `comptime for <v> in typeinfo(E).variants { body }` in STATEMENT position (Comptime §5.5)
    ## — UNROLL over the enum's declared variants (they live in the enum decl's `fields_head`,
    ## one FieldDecl per variant, exactly as `comptime_range_bound`'s variant count walks them),
    ## binding per iteration: `cf_fld` = the variant NAME, `cf_ty` = its payload type,
    ## `cf_curvar` = the current variant name and `cf_vloop` = the loop-var name, so a `<v>.name`
    ## read inside the body resolves to the current variant. This arm did not exist: a statement
    ## form fell through EVERY branch and unrolled ZERO times with no diagnostic.
    ## (The match-ARM template form — `match v { comptime for var in
    ## typeinfo(T).variants { T.(var)(p) => … } }` — is a different node, expanded by
    ## `expand_variant_arms`, and is untouched: it never reaches here.) A type with NO variant
    ## list unrolls zero times, for the same reason the `.fields` arm tolerates a scalar: the
    ## mono worklist emits SPECULATIVE per-member-type instances of the enclosing generic.
    bne := base_type_name(cx.src, cfts, cftl)
    edi := enum_decl_of(cx.decls, cx.src, bne.s, bne.n)
    if edi >= 0 {
      ed := deref(decl_at(Decl, rt::vec_get(deref(cx.decls), usize(edi))))
      ov_vs := cx.cf_var_s; ov_vl := cx.cf_var_l
      ov_fs := cx.cf_fld_s; ov_fl := cx.cf_fld_l
      ov_ts := cx.cf_ty_s; ov_tl := cx.cf_ty_l
      ov_cs := cx.cf_curvar_s; ov_cl := cx.cf_curvar_l
      ov_ls := cx.cf_vloop_s; ov_ll := cx.cf_vloop_l
      mut vf := ed.fields_head
      while vf != 0 {
        vfd := deref(fld_p(vf))
        cx.cf_var_s = cvs
        cx.cf_var_l = cvl
        cx.cf_fld_s = vfd.ns
        cx.cf_fld_l = vfd.nl
        cx.cf_ty_s = vfd.ts
        cx.cf_ty_l = vfd.tl
        cx.cf_curvar_s = vfd.ns
        cx.cf_curvar_l = vfd.nl
        cx.cf_vloop_s = cvs
        cx.cf_vloop_l = cvl
        emit_stmts(cbody, sb, cx, nl)
        vf = vfd.next
      }
      cx.cf_var_s = ov_vs; cx.cf_var_l = ov_vl
      cx.cf_fld_s = ov_fs; cx.cf_fld_l = ov_fl
      cx.cf_ty_s = ov_ts; cx.cf_ty_l = ov_tl
      cx.cf_curvar_s = ov_cs; cx.cf_curvar_l = ov_cl
      cx.cf_vloop_s = ov_ls; cx.cf_vloop_l = ov_ll
    }
  }
}





emit_stmts := fn(head : ptr(mut Stmt), in out sb : strbuf::StrBuf, cx : ptr(LCtx), in out nl : usize) {
  a := arena_of(cx)
  ## DEFER (§9.3): only if this block carries a `defer` marker do we track exit-ordering (gate: defer-free
  ## code — all of `src/`+`lib/` — pays nothing beyond this cheap prescan). `defer_exit_seen` becomes true
  ## once a statement that can early-exit is seen; a `defer` AFTER that point is fail-loud (a mis-registered
  ## cleanup would otherwise run on a path that never reached the defer).
  hasdef := list_has_defer(head, cx.src, a)
  mut defer_exit_seen := false
  mut s := head
  while s != 0 and (cx.ir_stop == 0 or unchecked bitcast(usize, s) != cx.ir_stop) {
    ## Intercept a `__defer(<expr>)` marker: register the inner cleanup under the CURRENT frame (LIFO),
    ## do NOT emit it inline, and advance. A marker reached here registers into whatever frame is active
    ## (the fn body's base boundary 0, or the nearest enclosing block frame) — the drain at that frame's
    ## block exit / the early-exit drains discharges it on the correct runtime path.
    dfi := defer_marker_inner_h(unchecked bitcast(usize, s), cx.src, a)
    if dfi != 0 {
      if defer_exit_seen { panic("selfhost: defer — a `defer` that follows an early-exit path (return/?/branch) is not yet modelled; place defers before any early exit (fail-loud rather than run a mis-registered cleanup)") }
      if cx.defer_n >= 128 { panic("selfhost: defer — more than 128 defers in one function is unsupported") }
      cx.defer_inner[cx.defer_n] = dfi
      cx.defer_n = cx.defer_n + 1
      s = unchecked bitcast(ptr(mut Stmt), lower_stmt_nx(unchecked bitcast(usize, s), a))
      continue
    }
    ## Intercept a `__deferblk()` marker (the head of a `defer { S1; S2 }` chain): register the WHOLE
    ## chain (from the marker to its `__deferblkend`) as ONE block-defer entry and jump OVER it — the
    ## block's statements run only at LIFO drain time (`emit_defer_chain` emits them via `emit_stmts`).
    dbi := defer_blk_start_h(unchecked bitcast(usize, s), cx.src, a)
    if dbi != 0 {
      if defer_exit_seen { panic("selfhost: defer — a `defer { }` that follows an early-exit path (return/?/branch) is not yet modelled; place defers before any early exit (fail-loud rather than run a mis-registered cleanup)") }
      if cx.defer_n >= 128 { panic("selfhost: defer — more than 128 defers in one function is unsupported") }
      cx.defer_inner[cx.defer_n] = dbi
      cx.defer_blk[cx.defer_n] = 1
      cx.defer_n = cx.defer_n + 1
      e := defer_blk_end_h(dbi, cx.src, a)
      s = unchecked bitcast(ptr(mut Stmt), lower_stmt_nx(e, a))
      continue
    }
    ## A `__deferblkend()` reached as a NORMAL statement: the block it terminates was already consumed
    ## as a single deferred unit (the `__deferblk()` branch above jumped the emitter past it, and the
    ## drain chain re-runs the block via `emit_stmts`) — skip it (advance). (Every marker is parser-paired;
    ## this skip is what lets the drain's `emit_stmts`-of-the-block terminate cleanly at its end marker.)
    if is_defer_blk_end_h(unchecked bitcast(usize, s), cx.src, a) {
      s = unchecked bitcast(ptr(mut Stmt), lower_stmt_nx(unchecked bitcast(usize, s), a))
      continue
    }
    if hasdef and stmt_may_early_exit(unchecked bitcast(usize, s), cx.src, a) { defer_exit_seen = true }
    st := deref(stmt_p(Stmt, s))
    match st {
      Stmt::Assign(ns, nl2, v, nx) => {
        emit_st_assign(ns, nl2, v, sb, cx, a, nl)
        s = nx
      }
      ## A struct field mutation `var.field = e`: lower the value (left on the stack), pop it
      ## into the field's reserved frame slot. The field lives at slot `base_off + index`,
      ## i.e. byte offset -(slot + 1) * 8(%rbp) — the store dual of the `Field` READ.
      Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => {
        emit_st_field_assign(bns, bnl, fns, fnl, fv, sb, cx, a, nl)
        s = nx
      }
      ## `o.i.v = <expr>` — a NESTED field store. Resolve the place's frame slot via `field_slot`
      ## (walks the nested `Field(Field(Var(o), i), v)` recursively → the down-growing inline slot),
      ## lower the value, store it. Scalar-word field; a LOCAL struct base (`field_slot` reads the
      ## base var's frame slot — a by-ref/ptr nested base is future work).
      Stmt::FieldPathAssign(pl, v, nx) => {
        emit_st_field_path_assign(pl, v, sb, cx, a, nl)
        s = nx
      }
      Stmt::While(cnd, b, nx) => {
        lguard := nl
        ldone := nl + 1
        nl += 2
        emit_label(sb, lguard)
        push_str(sb, ":\n")
        emit_gas(cnd, sb, cx, a, nl)   ## condition value pushed
        push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  je ")
        emit_label(sb, ldone)
        push_str(sb, "\n")
        ## set the `break` target to this loop's done-label + the `continue` target to its GUARD
        ## (re-evaluate the condition) for the body, restore both after
        ob := cx.brk
        oc := cx.cont
        cx.brk = i64(ldone)
        cx.cont = i64(lguard)
        ## DEFER (§9.3): push a per-iteration defer frame for the loop body and record its boundary
        ## (for a `break`/`continue` drain), gated on `cx.defer_active` so a defer-free fn stays byte-identical.
        if cx.defer_active {
          defer_frame_push(cx)
          cx.loop_dframe[cx.loop_sp] = cx.defer_frame[cx.defer_sp - 1]
        }
        loop_push(cx, i64(ldone), i64(lguard), 0)   ## depth-frame for labeled break/continue (byte-neutral)
        ## TAIL (see the `ExprStmt` arm): a LOOP body's last statement is NEVER the function's return
        ## value — the loop runs many times and then falls through. Clearing `cx.tail` for the body stops
        ## a trailing bare-call statement inside the loop from being emitted as the fn's return (`jmp`
        ## epilogue), which silently ABORTED the enclosing fn mid-loop.
        wov_tail := cx.tail
        cx.tail = false
        emit_stmts(b, sb, cx, nl) ## loop body
        cx.tail = wov_tail
        loop_pop(cx)
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        cx.brk = ob
        cx.cont = oc
        push_str(sb, "  jmp ")
        emit_label(sb, lguard)
        push_str(sb, "\n")
        emit_label(sb, ldone)
        push_str(sb, ":\n")
        s = nx
      }
      ## An infinite `loop { body }`: a label, the body (with `break` → done-label), an
      ## unconditional `jmp` back, then the done-label. No guard, so the body's `break` is the
      ## only exit (a loop with no `break` is an intentional spin — emitted faithfully).
      Stmt::Loop(b, nx) => {
        ltop := nl
        ldone := nl + 1
        nl += 2
        emit_label(sb, ltop)
        push_str(sb, ":\n")
        ob := cx.brk
        oc := cx.cont
        cx.brk = i64(ldone)
        cx.cont = i64(ltop)     ## `continue` re-enters the top (no guard)
        if cx.defer_active {
          defer_frame_push(cx)
          cx.loop_dframe[cx.loop_sp] = cx.defer_frame[cx.defer_sp - 1]
        }
        loop_push(cx, i64(ldone), i64(ltop), 0)     ## depth-frame for labeled break/continue (byte-neutral)
        ## TAIL: a `loop` body's last statement is never the fn's return value (see the `While` arm).
        lov_tail := cx.tail
        cx.tail = false
        emit_stmts(b, sb, cx, nl)
        cx.tail = lov_tail
        loop_pop(cx)
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        cx.brk = ob
        cx.cont = oc
        push_str(sb, "  jmp ")
        emit_label(sb, ltop)
        push_str(sb, "\n")
        emit_label(sb, ldone)
        push_str(sb, ":\n")
        s = nx
      }
      ## `unchecked { body }` (Grammar §130 statement form): lower the body with `verify.checked` FALSE
      ## (overflow/bounds guards comptime-absent), then restore the mode. The body is an ordinary
      ## statement list — no loop/label; just the scoped verification toggle.
      Stmt::Unchecked(b, nx) => {
        ov := cx.vchk
        cx.vchk = false
        ## TAIL: the block's last statement is the fn's tail only when the `unchecked` block ITSELF is
        ## in tail position (`cx.tail` already true AND nothing follows it) — the `CompIf` discipline.
        uov_tail := cx.tail
        cx.tail = uov_tail and nx == 0
        if cx.defer_active { defer_frame_push(cx) }
        emit_stmts(b, sb, cx, nl)
        cx.tail = uov_tail
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        cx.vchk = ov
        s = nx
      }
      ## `alloc::with(A) { body }` (MEM-5): establish `A` as the ambient allocator for the body, then
      ## restore. A call in the body omitting an allocator param reads `AMBIENT_ALLOC` and injects `ptr(A)`
      ## (see the elided-allocator path in the call emit). Nesting is lexical shadowing (save/restore).
      Stmt::AllocWith(ae, b, nx) => {
        oa := AMBIENT_ALLOC
        AMBIENT_ALLOC = unchecked bitcast(usize, ae)
        ## TAIL: only when the `alloc::with` block itself is in tail position (the `CompIf` discipline).
        aov_tail := cx.tail
        cx.tail = aov_tail and nx == 0
        if cx.defer_active { defer_frame_push(cx) }
        emit_stmts(b, sb, cx, nl)
        cx.tail = aov_tail
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        AMBIENT_ALLOC = oa
        s = nx
      }
      ## `break [name] [<expr>]` (Control Flow §7): jump to the target loop's done-label. `depth` 0 = the
      ## nearest enclosing loop; depth > 0 = a labeled `break name`, resolved to the loop frame `depth`
      ## levels out on the loop-target stack. The target is ALWAYS read from the loop-frame stack
      ## (`cx.loop_brk`), which every loop kind — `loop`/`while`/`for` and the value-bearing `Expr::Loop` —
      ## pushes with its real done-label. For `loop`/`while`/`Expr::Loop` this equals `cx.brk` (pushed at
      ## the same site), so the depth-0 emit stays byte-identical to the classic bare `break`; a `for`,
      ## however, never sets `cx.brk` (its emit tracks only the continue target), so reading `cx.brk`
      ## there yielded the `-1` no-loop sentinel → `jmp .L-1` (an undefined label — a bare break inside a
      ## `for` link-errored). Reading `cx.loop_brk[cx.loop_sp-1]` fixes `for`-break and also makes a break inside
      ## a `for` nested in an outer loop target the `for`'s exit (innermost), not the outer loop's.
      ## `value` (0 = none) is the loop-EXPRESSION value (§7.2): it is emitted (left on the stack) so the
      ## done-label converges with exactly one value — but only if the TARGET loop is value-bearing (an
      ## `Expr::Loop`); a `break <expr>` to a statement-position loop is ill-formed (fail-loud, not a
      ## silent stack imbalance).
      Stmt::Break(value, depth, nx) => {
        mut btgt := cx.brk
        mut tisexpr : usize = 1
        if depth != 0 {
          if depth >= cx.loop_sp { panic("selfhost: break to a label beyond the enclosing loop nesting") }
          btgt = cx.loop_brk[(cx.loop_sp - 1) - depth]
          tisexpr = cx.loop_isexpr[(cx.loop_sp - 1) - depth]
        } else if cx.loop_sp > 0 {
          btgt = cx.loop_brk[cx.loop_sp - 1]
          tisexpr = cx.loop_isexpr[cx.loop_sp - 1]
        }
        if unchecked bitcast(usize, value) != 0 {
          if tisexpr == 0 { panic("selfhost: `break <expr>` targets a non-value loop (loop-expression value only from a loop consumed for a value, Control Flow §7.2)") }
          emit_gas(value, sb, cx, a, nl)   ## leave the loop-expression value on the stack at the done-label
        }
        ## DEFER (§9.3): a `break` leaves the TARGET loop, so drain that loop's body-frame defers before
        ## jumping (its boundary from `cx.loop_dframe`, parallel to `btgt`/`tisexpr`). SAVE & RESTORE the
        ## ledger — this is an alternate runtime path; the emission continues on the fall-through path, and
        ## only ONE of the drains actually runs at runtime. The chain's pushes sit ABOVE the emitted break
        ## value (emitted first), so the done-label still converges with exactly one value. Gated on a
        ## nested defer frame (`cx.defer_sp > 0`) so a defer-free fn emits nothing here.
        if cx.defer_sp > 0 {
          mut bdb := 0
          if depth != 0 {
            bdb = cx.loop_dframe[(cx.loop_sp - 1) - depth]
          } else if cx.loop_sp > 0 {
            bdb = cx.loop_dframe[cx.loop_sp - 1]
          }
          sv := cx.defer_n
          emit_defer_chain(sb, cx, a, nl, bdb)
          cx.defer_n = sv
        }
        push_str(sb, "  jmp ")
        emit_label(sb, usize(btgt))
        push_str(sb, "\n")
        s = nx
      }
      ## `continue [name]` (Control Flow §7): jump to the target loop's CONTINUE label — a `while`'s guard,
      ## a `loop`'s top, or a `for`'s increment (so the loop index still advances). depth 0 = nearest loop
      ## (`cx.cont`, byte-identical); depth > 0 = a labeled `continue name` (a loop, §7.1).
      Stmt::Continue(depth, nx) => {
        mut ctgt := cx.cont
        if depth != 0 {
          if depth >= cx.loop_sp { panic("selfhost: continue to a label beyond the enclosing loop nesting") }
          ctgt = cx.loop_cont[(cx.loop_sp - 1) - depth]
        }
        ## DEFER (§9.3): a `continue` re-enters the target loop's next iteration, so drain THIS iteration's
        ## defers (the target loop body-frame boundary) before jumping — SAVE & RESTORE the ledger (an
        ## alternate runtime path). Gated on a nested defer frame so a defer-free fn emits nothing here.
        if cx.defer_sp > 0 {
          mut cdb := 0
          if depth != 0 {
            cdb = cx.loop_dframe[(cx.loop_sp - 1) - depth]
          } else if cx.loop_sp > 0 {
            cdb = cx.loop_dframe[cx.loop_sp - 1]
          }
          sv := cx.defer_n
          emit_defer_chain(sb, cx, a, nl, cdb)
          cx.defer_n = sv
        }
        push_str(sb, "  jmp ")
        emit_label(sb, usize(ctgt))
        push_str(sb, "\n")
        s = nx
      }
      ## A bare expression statement `f(args)` / `mod::f(args)` / `expr?`: emit the expression
      ## (a call pushes its result), then DISCARD the result (`popq %rax`). The pervasive
      ## side-effecting statement in the passes (`lexer::lex_all(lx, toks)`, `vec::push(out, d)`).
      ## emit_gas always leaves exactly one value on the stack for a call, so the single pop
      ## keeps the stack balanced regardless of the callee's return (void/scalar/aggregate).
      Stmt::ExprStmt(e, nx) => {
        emit_st_expr_stmt(e, nx, head, sb, cx, a, nl)
        s = nx
      }
      ## An early `return e`: lower the value (left on the stack), pop into %rax, and `jmp`
      ## the function epilogue (`cx.epi`), which restores the frame and `ret`s. So the value
      ## is delivered the same way as the trailing return, just at an arbitrary body point.
      Stmt::Return(rv, nx) => {
        rvm := match_info(rv)
        rvi := if_info(rv)
        ## Route through emit_return_value for: a `return match` of ANY aggregate/str/enum (emit_enum_value
        ## / emit_struct_value / emit_str_pair have no Match arm), OR a `return if` of struct/tuple/str
        ## (those lack an If arm) — but NOT an enum `return if`: emit_enum_value ALREADY has an If arm,
        ## and routing it would change src/'s (working, byte-identical) enum-if emission.
        if (rvm.is_m and (cx.ret_struct or cx.ret_tuple or cx.ret_str or cx.ret_enum or fixed_array_byte_return_len_span(cx.src, cx.ret_ss, cx.ret_sl) >= 1)) or (rvi.is_if and (cx.ret_struct or cx.ret_tuple or cx.ret_str or fixed_array_byte_return_len_span(cx.src, cx.ret_ss, cx.ret_sl) >= 1)) {
          ## `return match … { … => P(…) / (a,b) / "s" / E.V(…) }` OR `return if c { … } else { … }` — a value-`match`/`if` returning an
          ## AGGREGATE / `str` / ENUM. Route it through `emit_return_value` (dispatch the scrutinee +
          ## deliver EACH arm's value via the return convention + jump the epilogue). `emit_struct_value`
          ## / `emit_str_pair` / `emit_enum_value` have no `Match` arm, so this used to deliver {0} / an
          ## empty str (a silent miscompile). A SCALAR `return match` is left to `emit_gas` (which HAS an
          ## Expr::Match arm) — routing scalars regressed a bool-returning derive `return match`
          ## (`cx.ret_enum` is FALSE for a bool return, so that stays on emit_gas).
          emit_return_value(rv, sb, cx, a, nl)
          s = nx
        } else {
        if fixed_array_byte_return_len_span(cx.src, cx.ret_ss, cx.ret_sl) >= 1 {
          emit_byte_array_return_value(rv, sb, cx, a, nl)
        } else if is_niche_folded(cx.src, cx.ret_ss, cx.ret_sl) {
          ## §8 `@niche`: a fn returning `Option(ptr(T))` delivers ONE folded word in %rax (`Some(p)`=p,
          ## `None`=0) — NOT the 2-register enum convention. Checked FIRST because a folded return type is
          ## NOT recognized as an enum (`enum_decl_of` can't resolve the parenthesized `Option(ptr(T))`),
          ## so `cx.ret_enum` is FALSE for it. Gated by `is_niche_folded`; non-folded returns unchanged.
          emit_folded_option_value(rv, sb, cx, a, nl)
        } else if cx.ret_sret {
          ## a >7-word AGGREGATE return via the hidden result-pointer — enum (disc + payload) or struct.
          ## Checked BEFORE `ret_enum`: a WIDE enum has BOTH `ret_sret` and `ret_enum` set and the sret
          ## path must win (the two-register/`emit_retreg` enum convention tops out at %r11 = 7 words).
          ## `emit_return_value` (the trailing / tail-`match`-arm path) already ordered it this way; this
          ## is the explicit-`return` (Stmt::Return) DUAL, which used to fall to `emit_enum_value` — a
          ## SILENT 0 for the `return e` (enum Var) form and a fail-loud panic for the `return E.V(…)`
          ## (EnumLit) form. Neutral for the self-host build: no `src/`+`lib/` fn returns a >7-word
          ## aggregate, so `cx.ret_sret` is false everywhere there.
          if cx.ret_enum { emit_enum_to_sret(rv, sb, cx, a, nl) }
          else { emit_struct_to_sret(rv, sb, cx, a, nl) }
        } else if cx.ret_enum {
          ## an enum-returning fn: deliver the value via the two-register convention
          ## (disc/%rax, payload/%rdx) then jump the epilogue (no stack push/pop).
          emit_enum_value(rv, sb, cx, a, nl)
        } else if cx.ret_struct {
          ## a 2-word-struct-returning fn: deliver field 0/%rax, field 1/%rdx (same convention).
          emit_struct_value(rv, sb, cx, a, nl)
        } else if cx.ret_tuple {
          ## a TUPLE-returning fn: deliver component k → %rax/%rdx/… (emit_struct_value's ArrayLit arm).
          emit_struct_value(rv, sb, cx, a, nl)
        } else if cx.ret_str {
          ## a str-returning fn: materialize the {ptr, len} pair (ptr deep, len top), then deliver
          ## ptr/%rax, len/%rdx (the str dual of the 2-word-struct return).
          emit_str_pair(rv, sb, cx, a, nl)
          push_str(sb, "  popq %rdx\n  popq %rax\n")
        } else {
          ## (TYP-6) the `return <aggregate>` from a scalar-return fn soundness net moved UP into
          ## `sema::check_program` (build-path gate; covers int/float/char/bool + the reverse direction).
          emit_gas(rv, sb, cx, a, nl)
          push_str(sb, "  popq %rax\n")
          ## an f64/f32-returning fn delivers in %xmm0 — set it BEFORE the jump to the epilogue
          ## (the epilogue label sits past the trailing-return's own %xmm0 move).
          if cx.ret_float { push_str(sb, "  movq %rax, %xmm0\n") }
        }
        ## DEFER (§9.3): an early `return` runs the NESTED-frame defers (everything at/above the first
        ## nested frame's boundary `FRAME[0]` — the fn-body top-level entries `[0, FRAME[0])` stay for the
        ## epilogue, preserving LIFO across scopes) BEFORE jumping. SAVE & RESTORE the ledger (an alternate
        ## runtime path; the emission continues on the fall-through path, and only one drain runs).
        if cx.defer_sp > 0 {
          sv := cx.defer_n
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[0])
          cx.defer_n = sv
        }
        push_str(sb, "  jmp ")
        emit_label(sb, cx.epi)
        push_str(sb, "\n")
        s = nx
        }
      }
      ## A statement-position `if cond { then-stmts } [ else { else-stmts } ]`: lower the cond,
      ## pop, `cmpq $0` + `je else-label`; emit the then statement list; `jmp end-label`; the
      ## else-label, the else statement list; the end-label. No value is left on the stack
      ## (these are statements). Fresh else/end labels via the shared `nl`.
      Stmt::If(c, th, el, nx) => {
        lelse := nl
        lend := nl + 1
        nl += 2
        emit_gas(c, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  cmpq $0, %rax\n  je ")
        emit_label(sb, lelse)
        push_str(sb, "\n")
        ## TAIL: a branch's last statement is the fn's return value only when the `if` ITSELF is in tail
        ## position (`cx.tail` already true AND nothing follows it, `nx == 0`) — the same discipline the
        ## `CompIf` arm applies. Without it, a bare-call statement ending an `if` branch anywhere in a
        ## value-returning fn was emitted as that fn's RETURN (`jmp` epilogue): the call vanished when it
        ## had no return value and the fn silently aborted at that point.
        iov_tail := cx.tail
        cx.tail = iov_tail and nx == 0
        if cx.defer_active { defer_frame_push(cx) }
        emit_stmts(th, sb, cx, nl)   ## then statement list (no value)
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        push_str(sb, "  jmp ")
        emit_label(sb, lend)
        push_str(sb, "\n")
        emit_label(sb, lelse)
        push_str(sb, ":\n")
        if cx.defer_active { defer_frame_push(cx) }
        emit_stmts(el, sb, cx, nl)   ## else statement list (0 head = empty)
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        cx.tail = iov_tail
        emit_label(sb, lend)
        push_str(sb, ":\n")
        s = nx
      }
      ## A statement-position `match scrut { pat => { stmts } ; … }`: dispatch on the
      ## scrutinee (an enum `Var` local on its discriminant, else an integer value compare)
      ## and run the matching arm's STATEMENT LIST — no value pushed. Mirrors the expression
      ## match dispatch shape (`emit_gas`'s `Match` arm / `emit_enum_match`) but each arm body
      ## is `emit_stmts(am.body_stmts)`, and there is no default value to push.
      Stmt::Match(sc, ah, nx) => {
        emit_st_match(sc, ah, nx, sb, cx, nl)
        s = nx
      }
      ## A `deref(p) = v` store through a pointer: lower the value (left on the stack), lower
      ## the pointer (its value on top), pop the pointer into %rax and the value into %rbx, and
      ## store `movq %rbx, (%rax)`. The store dual of the `Deref` READ.
      Stmt::DerefAssign(ptr, val, nx) => {
        emit_st_deref_assign(ptr, val, sb, cx, a, nl)
        s = nx
      }
      ## An `arr[i] = v` array element write: lower the value (left on the stack), compute the
      ## element address (`emit_index_addr` → %rax; the value on the stack survives its index
      ## lowering), pop the value into %rbx, and store `movq %rbx, (%rax)`. The store dual of
      ## the `Index` READ.
      Stmt::IndexAssign(ib, ii, iv, nx) => {
        emit_st_index_assign(ib, ii, iv, sb, cx, a, nl)
        s = nx
      }
      ## An `a[i].f = v` element-field write: lower the value (left on the stack), compute the
      ## element-field address (`emit_idx_field_addr` → %rax; the value survives), pop the value
      ## into %rbx, and store `movq %rbx, (%rax)`. The store dual of the `Field(Index(...), f)`
      ## READ.
      Stmt::IndexFieldAssign(fia, fii, ifs, ifl, fiv, nx) => {
        emit_st_index_field_assign(fia, fii, ifs, ifl, fiv, sb, cx, a, nl)
        s = nx
      }
      ## A `for i in lo .. hi { body }`: desugar to a counted while. Store `lo` into `i`'s
      ## frame slot, then at a guard label compare `i < hi` (lower `i` and `hi`, `cmpq`/`setl`),
      ## `je` past the body to a done-label when false; emit the body; increment `i` by 1;
      ## back-edge `jmp` to the guard. Half-open: `i` runs `lo, lo+1, …, hi-1`. Fresh
      ## guard/done labels via `nl` so nested loops never collide.
      Stmt::For(fns, fnl, flo, fhi, fb, nx) => {
      if unchecked bitcast(usize, fhi) == 0 {
        ## ITERABLE `for x in s { … }`: `s` is a Slice VAR `{ptr @ B, len @ B+1}` OR a scalar/float
        ## ARRAY VAR (`ek == 5`, elements inline in the frame). The loop var (each element) lives at
        ## `vslot`, the hidden index at `vslot+1`. Desugar to a counted loop — for a slice
        ## `__i = 0; while __i < s.len { x = *(s.ptr + __i*8) ; body ; __i += 1 }`; for an array the
        ## length is the static element count (`snl`) and element `__i` is read inline at
        ## `&element0 − __i*stride*8` (the down-growing frame layout). SCALAR/word elements only;
        ## aggregate elements / non-var iterables are future work.
        fv := var_name_span(flo)
        is_nonvar := fv.n == 0
        ## a `for c in bytes(s)` iterable is a BYTE slice (u8 elements, stride 1) — read each element
        ## with `movzbq` at stride 1, not a word load at stride 8. (Detected on the `bytes(…)` call.)
        mut byte_elem := is_nonvar and is_bytes_call(flo, cx.src)
        vslot := slot_of(cx.slots, cx.src, fns, fnl)
        mut islot := vslot + 1   ## hidden loop index; moved to vslot+agg_stride for an aggregate loop var
        ## scalar-word (eek 0) and FLOAT (eek 9) element arrays: both keep the element COUNT in `snl`
        ## and read the element as an inline word (a float rides its slot as bits; the loop var is
        ## tagged `ek==9` by collect_slots so body float ops dispatch the xmm path). Aggregate/str
        ## arrays keep `snl` as a type span (no static count) → they stay on the slice path (future).
        ## A NON-VAR iterable (`for x in f()`) is materialized ONCE into the {ptr,len} temp at
        ## `vslot+2 .. +3` (reserved by collect_slots), then read like a by-VALUE slice with base there.
        ## The iterable's SlotEntry fields as SCALARS (a `mut bent : SlotEntry = …; bent = deref(…)`
        ## struct-local reassignment SILENTLY DROPS some fields — the documented landmine; read the
        ## fields into scalars from an IMMUTABLE `bent := deref(…)` instead).
        mut is_arr := false
        mut is_agg_arr := false   ## a struct/enum-ELEMENT array (eek 2/3): loop var is that aggregate
        mut is_agg_slice := false ## a struct/enum-ELEMENT slice VIEW (eek 2/3, is_ref): copy via the ptr
        mut is_str_slice := false ## a str-ELEMENT slice VIEW (eek 4, is_ref): loop var is a 2-word str
        mut is_glob_arr := false  ## a MUTABLE ARRAY GLOBAL iterable (`for v in TABLE`): `.data` base
        mut glob_nel := 0        ## the global array's element count (from its ArrayLit)
        mut glob_is_agg := false  ## a STRUCT-element global array: copy `glob_stride` words per element
        mut glob_stride := 1     ## the global array's element width in words
        mut agg_n := 0           ## element count (parsed from the `[T; N]` annotation)
        mut agg_stride := 0      ## element width in words
        mut b_snl := 0           ## the var array's static scalar/float count (bent.snl)
        mut b_estride := 1       ## the var array's element stride in words (bent.estride)
        mut b_is_ref := false
        mut bslot := 0
        ## a `for x in v` over an arena-backed `Vec(T)` (`@owning struct { idx, len, cap, arena }`, 4
        ## words): word 0 = the arena HANDLE index (NOT a pointer), so the slice path would deref a raw
        ## index and trap. Resolve the element base as `arena.base + idx` per iteration setup instead.
        mut is_vec := false
        mut vec_bslot := 0    ## the Vec struct local's base slot (word 0 = idx)
        ## a `for v in <mutable array GLOBAL>` — the iterable is a module global (no frame slot), so it
        ## is neither the non-var nor the slot path: read the count from its ArrayLit and each element
        ## from `LABEL + i*8`. Scalar-word elements. Detected before the slot read (which would garbage).
        gfor_mgv := if fv.n != 0 { mut_global_value(cx.decls, cx.src, fv.s, fv.n) } else { unchecked bitcast(ptr(Expr), 0) }
        lg := nl
        ld := nl + 1
        lcont := nl + 2      ## `continue` target: the increment (so the index still advances)
