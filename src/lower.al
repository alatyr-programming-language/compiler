          push_int(sb, i64(glob_nel))
          push_str(sb, ", %rbx\n")
        } else if is_agg_arr {
          ## aggregate-element array: the static count parsed from `[T; N]`
          push_str(sb, "  movq $")
          push_int(sb, i64(agg_n))
          push_str(sb, ", %rbx\n")
        } else if is_arr {
          ## array: the static element count is `snl` (recorded by bind_array_slot)
          push_str(sb, "  movq $")
          push_int(sb, i64(b_snl))
          push_str(sb, ", %rbx\n")
