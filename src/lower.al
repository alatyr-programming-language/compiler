        ## the caller, while its variant/layout lookups re-install `call_owner_*` from `si2`.
        if owner_ci >= 0 {
          if old_ton { lower_layout::set_type_ref_module(old_tos, old_tol, ROOT_MOD_S, ROOT_MOD_L) } else { lower_layout::clear_type_ref_module() }
        }
        si2 := ScrutInfo(is_e = true, base = tbc, es = ci.s, el = ci.n, is_ref = false, tmod_s = call_owner_s, tmod_l = call_owner_l)
