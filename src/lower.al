      ## aggregate sinks (local assignment, aggregate call argument, or aggregate return registers).
      ## Reaching this path would read only word 0, so fail loud instead of silently miscompiling it.
      reject_unsupported_require_enum(e, cx.decls, cx.src, a)
      if require_agg_is(e, cx.decls, cx.src, a) {
        panic("selfhost: aggregate require value has no scalar stack representation — bind it, pass it to an aggregate parameter, or return it")
      }
