  ## barrier's `emit_gas(p.f)` reads it (`movq slot(%rbp), %rax ; movq off(%rax), %rax`). Param `i` lives
  ## at text slot `i` (byte -(i+1)*8); its pointer arrived in argreg(i). A by-ref struct = one register, so
  ## the param index IS the slot index. Only runs for a barrier fn (wbase > 0).
  if wbase > 0 {
    mut xp := d.params_head
    mut xi := 0
    while xp != 0 {
      xpm := deref(param_p(xp))
      if not ir_native_scalar(p.src, xpm.ts, xpm.tl) {
        pnx := ir_phys_name(ir_argreg_id(xi))
        push_str(sb, "  movq ")
        push_str(sb, pnx)
        push_str(sb, ", -")
        push_int(sb, i64((xi + 1) * 8))
        push_str(sb, "(%rbp)\n")
      }
      xi = xi + 1
      xp = xpm.next
    }
  }
  ## save each used callee-saved reg into its frame slot (below all spill slots), so a value the allocator
  ## parked in it survives across the fn (the ABI requires the callee preserve rbx/r12..r15).
  mut si := 0
  mut sk := 0
  while si < 5 {
    r := ir_csreg_id(si)
    if regalloc::ra_out_uses_reg(r) {
      pn := ir_phys_name(r)
      push_str(sb, "  movq ")
      push_str(sb, pn)
      push_str(sb, ", ")
      push_int(sb, 0 - i64(wbase + nsp + sk + 1) * 8)
      push_str(sb, "(%rbp)\n")
      sk = sk + 1
    }
    si = si + 1
  }
  ir_render(sb, raprefix, lepi, cx, deref(p.mar), nl)
  emit_label(sb, lepi)
  push_str(sb, ":\n")
  ## restore the callee-saved regs (all return paths jump here) before tearing down the frame.
  mut ri := 0
  mut rk := 0
  while ri < 5 {
    r := ir_csreg_id(ri)
    if regalloc::ra_out_uses_reg(r) {
      pn := ir_phys_name(r)
      push_str(sb, "  movq ")
      push_int(sb, 0 - i64(wbase + nsp + rk + 1) * 8)
      push_str(sb, "(%rbp), ")
      push_str(sb, pn)
      push_str(sb, "\n")
      rk = rk + 1
    }
    ri = ri + 1
  }
  push_str(sb, "  movq %rbp, %rsp\n  popq %rbp\n  ret\n")
}

## ---- The SCALAR-LEAF shape predicate --------------------------------------------------------
## A fn qualifies iff: non-generic, non-sret, non-@test, non-lambda, non-naked, not in an overload set,
## not `_start`-with-args issues; a real scalar (native-width u64/usize/i64/isize/bool) return + all
## params native-scalar `in`; a body of ONLY Assign/If/While/For(RANGE `i in lo..hi`)/Return/Unchecked; exprs of ONLY
## Num/BoolLit/Var/Bin(arith,div,cmp); every Var a param/local (no module-global / call — hence LEAF);
## `+`/`-`/`*` allowed CHECKED or `unchecked` (the emit models the inline overflow guard); `/`/`%` still
## require `unchecked` (div-by-zero / INT_MIN guards deferred); and a conservative vreg/inst/label budget
## under the allocator's capacity. Anything else → text path.
mut IRB_S : [usize; 64] = [0; 64]   ## the predicate's bound-name set (params + all assign targets)
mut IRB_L : [usize; 64] = [0; 64]
mut IRB_N := 0
mut IRP_OK : bool = true            ## running verdict
mut IRP_NBIN := 0                   ## arithmetic/div/cmp Bin nodes (vreg/inst budget)
mut IRP_NCHK := 0                   ## CHECKED arith bins that emit an inline overflow guard (extra inst/label budget)
mut IRP_NCTRL := 0                  ## if/while count (label budget)
mut IRP_NSTMT := 0                  ## statements (inst budget)
mut IRP_NCALL := 0                  ## modeled scalar calls (inst/vreg/side-table budget)
mut IRP_NCALLARG := 0               ## total args across all modeled calls (arg-mov inst budget)
mut IRP_NSLFOR := 0                 ## iterable `for x in <slice param>` loops (inst/vreg/label budget)
mut IRP_NARRFOR := 0                ## iterable `for x in <array local>` loops (inst/vreg/label budget)
mut IRP_NARRINIT := 0               ## inline-array-literal INITs routed to the statement barrier (inst budget)
mut IRP_NVECFOR := 0                ## iterable `for x in <Vec local>` loops (inst/vreg/label budget)
mut IRP_NGBAR := 0                  ## general statement barriers (Vec-build; inst budget + side-table cap)
mut IRP_NSYNC := 0                  ## modeled-scalar → frame-slot syncs emitted before barriers (inst budget)
mut IRP_SAWMODEL : bool = false     ## a MODELED (register-allocated) statement has been seen — general barriers
                                    ## must all PRECEDE modeled statements (so a barrier never reads a vreg local)
mut IRP_MS := 0                     ## enclosing module span (for callee resolution in ir_check_call)
mut IRP_ML := 0
## BARRIER (COMMIT 6): the by-ref STRUCT params admitted this fn (name span + type-name span), and the
## count of barriered field reads. A struct param is admitted ONLY when every field is native-scalar (so
## any field read `p.f` yields a scalar the barrier's single-word `popq` delivers correctly). `IRP_MARP`
## carries `p.mar` (as usize) so the Field check can validate the field exists via `struct_field_index`.
mut IRSP_S : [usize; 8] = [0; 8]
mut IRSP_L : [usize; 8] = [0; 8]
mut IRSP_TS : [usize; 8] = [0; 8]
mut IRSP_TL : [usize; 8] = [0; 8]
mut IRSP_N := 0
mut IRP_NBARR := 0
mut IRP_MARP : usize = 0

## SLICE-PARAM (COMMIT 6c): a by-ref `Slice(<native-scalar-word>)` param admitted for ITERATION via
## `for x in s`. It arrives as a POINTER to the caller's {ptr,len} block; the barrier prologue spills that
## pointer to text slot `pidx` (byte -(pidx+1)*8), and the slice-iteration lowering reads base = *(P+0),
## len = *(P+8) ONCE into vregs, then loads each element `*(base + idx*8)` through a register-held address.
## `IRSL_PIDX` records the param POSITION (→ the prologue slot). NOT admitted as a bare Var (only the `for`
## iterable arm consumes it); byte/aggregate-element slices, indexing `s[i]`, and `.len()` stay text-path.
mut IRSL_S : [usize; 4] = [0; 4]
mut IRSL_L : [usize; 4] = [0; 4]
mut IRSL_PIDX : [usize; 4] = [0; 4]
mut IRSL_N := 0

## ARRAY-LOCAL (COMMIT 6d): an inline SCALAR array local (`ys : [<native-scalar>; N] = [<consts>]`) admitted
## for ITERATION via `for x in ys`. It is FRAME-RESIDENT: its array-literal init routes to the STATEMENT
## barrier, and the `for` reads each element from the frame through a LEA-SLOT base + indexed load. NOT
## admitted as a bare Var (only the `for` iterable arm consumes it); `ys[i]` indexing / `.len()` stay text.
mut IRARR_S : [usize; 4] = [0; 4]
mut IRARR_L : [usize; 4] = [0; 4]
mut IRARR_N := 0
## Vec-LOCAL: a `Vec(T)` LOCAL admitted for ITERATION via `for x in v`. It is FRAME-RESIDENT (built by the
## general text barriers); the vec-for lowering reads base = arena.base + idx and len from its frame words.
mut IRVEC_S : [usize; 4] = [0; 4]
mut IRVEC_L : [usize; 4] = [0; 4]
mut IRVEC_N := 0
## FRAME-LOCAL set: every general-barrier ASSIGN target (`r`/`ar`/`v` — the Vec-build chain). Such a local is
## frame-resident, so a MODELED expr must NOT read it as a vreg (it would read a stale frame slot). Vec locals
## live in IRVEC; both sets are checked by ir_check_expr's Var reject.
mut IRFR_S : [usize; 8] = [0; 8]
mut IRFR_L : [usize; 8] = [0; 8]
mut IRFR_N := 0

pub emit_fn := fn(d : Decl, di : usize, in out sb : strbuf::StrBuf, p : ptr(PCtx), in out nl : usize) {
  ## Module-global references inside this body resolve in the declaration's module, exactly like a
  ## bare function call. This must be established before slot/type collection because those passes
  ## also inspect global initializers to classify array and aggregate places.
  set_global_ref_module(d.mod_start, d.mod_len, unchecked bitcast(usize, p.decls))
  ## RECEIVING side (increment 3b): does THIS fn's own definition carry `@abi(c)` (an exported fn
  ## CALLED FROM C)? If so it needs a SysV-conforming PROLOGUE + classed RETURN (below) instead of the
  ## internal ABI. Reuse `callee_is_abi_c` on the decl's OWN name span (the source right after the name
  ## is `:= @abi(c) fn(…)`, possibly after a decl-position `@export("…")`, which precedes the name and
  ## so does not interfere). Guarded on a real name (a lifted lambda has the SENTINEL empty name) and a
  ## NON-generic decl (a generic `@abi(c)` fn is out of scope — deferred). `src/`+`lib/` declare no
  ## `@abi(c)` fn → `fn_abi_c` is always false there → every gate below stays byte-identical (fixpoint).
  fn_abi_c := d.name_len != 0 and d.is_generic == false and callee_is_abi_c(p.src, d.name_start, d.name_len)
  ## Publish this fn's body + params so `recv_full_emit` can resolve a UFCS receiver's DECLARED type
  ## (with type-args) from the source — the slot keeps only the base name. Reset per fn; no nested
  ## `emit_fn` (inline expands in place), so a plain set/leave is safe.
  EMIT_BODY = unchecked bitcast(usize, d.body_stmts)
  EMIT_PARAMS = d.params_head
  ## COMMIT 2 (--ra): a scalar-leaf / `unchecked` fn takes the register-allocated IR path. Default OFF →
  ## the `and` short-circuits before the predicate is evaluated, so the flag-OFF build reaches the text
  ## path below UNCHANGED and the whole self-host GAS is byte-identical (the TOOL-1 fixpoint holds).
  ## An `@abi(c)` fn is EXCLUDED (its SysV prologue/return lives on this text path, not the IR path);
  ## neutral because `fn_abi_c` is always false for the self-host source.
  ## DEFER (§9.3): a fn carrying a `defer` marker MUST take the text path — the pending-defer epilogue
  ## emission lives here, not on the register-allocated IR path. (`is_scalar_leaf_shape` almost always
  ## already rejects it — a defer's cleanup is a call, and a leaf has none — so the extra guard is a
  ## belt-and-braces net; `and` short-circuits so a defer-free fn never runs the scan.)
  if RA_ON == 1 and is_scalar_leaf_shape(d, p) and fn_abi_c == false and (stmts_have_defer(d.body_stmts, p.src, deref(p.mar)) == false) {
    emit_fn_ir(d, di, sb, p, nl)
    return
  }
  ## the name→slot map: params at slots 0..arity (in declaration order, from the arena-linked
  ## `Param` list), then the body's distinct locals (a struct local reserves its base + field
  ## slots, resolved against `decls`' struct layout).
  ## GENERICS tier: for an INSTANCE (`p.inst`) the leading type parameter (param 0) is
  ## COMPTIME — skip it (no slot), so the VALUE parameters take slots 0,1,… in order.
  mut slots := SVec(base = 0, len = 0, cap = 0, arena = p.mar)
  svec_new(slots, p.mar, 32)
  ## FN-6 first slice: a LIFTED LAMBDA (SENTINEL `name_len == 0`) returning a MULTI-WORD aggregate
  ## (struct/enum/str) is not yet supported — a lambda is called only INDIRECTLY (through its
  ## code-pointer value), and the indirect-call site has no signature for the fn value, so it captures
  ## only ONE result word and cannot resolve the result's fields (a SILENT MISCOMPILE at the call site).
  ## Reject fail-loud on the BUILD path here (sema rejects on the check path). Nested `if`s — a
  ## comparison AND-ed with a call mis-lowers under the seed. Scalar-returning lambdas are unaffected.
  if d.name_len == 0 {
    lrbn := base_type_name(p.src, d.ret_ts, d.ret_tl)
    if lrbn.n != 0 {
      if struct_decl_of(p.decls, p.src, lrbn.s, lrbn.n) >= 0 { panic("selfhost: FN-6 — a function value returning a struct/enum/str is unsupported (first slice: scalar returns only)") }
      if enum_decl_of(p.decls, p.src, lrbn.s, lrbn.n) >= 0 { panic("selfhost: FN-6 — a function value returning a struct/enum/str is unsupported (first slice: scalar returns only)") }
    }
    if str_at(p.src + d.ret_ts, d.ret_tl) == "str" { panic("selfhost: FN-6 — a function value returning a struct/enum/str is unsupported (first slice: scalar returns only)") }
  }
  ## §8 `@packed` RETURNED BY VALUE — DEFERRED, fail LOUD (spec Types §8). A struct return travels in the
  ## WORD-model return registers (field k in `emit_retreg(k)`, one whole word per field) and the caller
  ## materializes it by spilling those words at 8-byte strides; a `@packed`/`@offset`/`@align`/`@endian`
  ## value is BYTE-precise (fields at cumulative byte offsets, sized loads/stores, `@endian(big)` bytes
  ## reversed). The two representations disagree, and the return path applies NO packed semantics at all:
  ## `r := mk()` then `r.b` read byte 8 of a 7-byte block (0 — a SILENT WRONG VALUE), a PARTIAL packed
  ## literal returned only the words it constructed while the caller spilled one per FIELD (garbage over
  ## the `@offset` overlays), and `@endian(big)` never swapped. `mk().b` "worked" only because BOTH the
  ## return and the direct register read were word-model — two errors cancelling, and it broke the moment
  ## the by-ref packed PARAM read was made byte-precise. Correct-or-trap: reject at the DECL, the
  ## one choke point every call shape flows through, rather than leave any of them silently wrong.
  ## Gated on `is_packed(return type)` → `src/`+`lib/` declare no packed struct at all, so this is
  ## unreachable for the self-host source (fixpoint-neutral). Removing it is the entry point for a real
  ## byte-precise packed-return ABI (pack into `ceil(bytes/8)` registers on both sides).
  prbn := base_type_name(p.src, d.ret_ts, d.ret_tl)
  if prbn.n != 0 and is_packed(p.decls, p.src, prbn.s, prbn.n) { panic("selfhost: a @packed/@offset/@align/@endian struct returned BY VALUE from a function is not yet supported (spec Types §8) — the return registers are word-model while the value is byte-precise; return a ptr(T) or fill an `in out T` out-parameter instead") }
  ## GENERICS: the type-parameter name (param 0 of a generic fn) + the instance's concrete type
  ## (for an INSTANCE), so `bind_param` sizes a `x : T` param as the instance type and `size(T)`
  ## resolves. Computed before the param loop (bind_param needs it).
  ## the comptime TYPE parameter may sit at ANY position (`allocate`'s `T` is param 1); `tpidx`
  ## locates it. gps/gpl = its NAME (for `bind_param`'s `x : T` substitution + `size(T)`); the
  ## param loop skips exactly that param for an INSTANCE (it is erased, no slot). For the common
  ## leading `T : type` (tpidx 0) this is byte-identical to the old param-0 handling.
  ## Locate the comptime TYPE parameter's position by scanning THIS decl's OWN params (`d`), NOT via
  ## `tparam_idx(di)` — for a generic INSTANCE emit_fn is called with `di = 0` (a placeholder), so
  ## `tparam_idx` would re-fetch decl[0] (some OTHER decl) and mis-locate the type param. It only
  ## happened to work when the generic fn was itself decl[0]; a struct-typed param before `T` in any
  ## non-first generic fn (`allocate(self : Arena, T : type, …)`) mis-bound `self` as scalar.
  mut tpidx := 0
  if d.is_generic {
    mut tpp0 := d.params_head
    mut ti0 := 0
    mut tfound := false
    while tpp0 != 0 {
      tp0 := deref(param_p(tpp0))
      if tfound == false and str_at(p.src + tp0.ts, tp0.tl) == "type" { tpidx = ti0; tfound = true }
      ti0 += 1
      tpp0 = tp0.next
    }
  }
  ## SECOND type-param position (`tpidx2`) + name (`gps2`/`gpl2`), for a 2-type-param generic
  ## (`map(T, U : type, …)`). `ntpc` = the comptime-type-param COUNT (1 or 2). For a single-param
  ## generic `gps2`/`gpl2` stay 0 → the param loop / bind_param treat it as absent (byte-identical).
  mut ntpc := 0
  if d.is_generic {
    mut tpc := d.params_head
    while tpc != 0 {
      tpcm := deref(param_p(tpc))
      if str_at(p.src + tpcm.ts, tpcm.tl) == "type" { ntpc = ntpc + 1 }
      tpc = tpcm.next
    }
  }
  mut tpidx2 := 0
  if d.is_generic and ntpc >= 2 {
    mut tp2 := d.params_head
    mut ti2 := 0
    mut seen2 := 0
    while tp2 != 0 {
      tp2m := deref(param_p(tp2))
      if str_at(p.src + tp2m.ts, tp2m.tl) == "type" { seen2 = seen2 + 1; if seen2 == 2 { tpidx2 = ti2 } }
      ti2 += 1
      tp2 = tp2m.next
    }
  }
  ## THIRD type-param position (`tpidx3`), for a 3-type-param generic (`Result::map(T, E, U, …)`).
  mut tpidx3 := 0
  if d.is_generic and ntpc >= 3 {
    mut tp3 := d.params_head
    mut ti3 := 0
    mut seen3 := 0
    while tp3 != 0 {
      tp3m := deref(param_p(tp3))
      if str_at(p.src + tp3m.ts, tp3m.tl) == "type" { seen3 = seen3 + 1; if seen3 == 3 { tpidx3 = ti3 } }
      ti3 += 1
      tp3 = tp3m.next
    }
  }
  mut gps := 0
  mut gpl := 0
  mut gps2 := 0
  mut gpl2 := 0
  mut gps3 := 0
  mut gpl3 := 0
  if d.is_generic and d.params_head != 0 {
    mut tpp := d.params_head
    mut ti := 0
    while tpp != 0 {
      tpm := deref(param_p(tpp))
      if ti == tpidx { gps = tpm.ns; gpl = tpm.nl }
      if ntpc >= 2 and ti == tpidx2 { gps2 = tpm.ns; gpl2 = tpm.nl }
      if ntpc >= 3 and ti == tpidx3 { gps3 = tpm.ns; gpl3 = tpm.nl }
      ti += 1
      tpp = tpm.next
    }
  }
  mut its := 0
  mut itl := 0
  mut its2 := 0
  mut itl2 := 0
  mut its3 := 0
  mut itl3 := 0
  if p.inst { its = p.its; itl = p.itl; its2 = p.its2; itl2 = p.itl2; its3 = p.its3; itl3 = p.itl3 }
  mut pp := d.params_head
  mut pidx := 0
  while pp != 0 {
    pm := deref(param_p(pp))
    skip_tp := p.inst and (pidx == tpidx or (ntpc >= 2 and pidx == tpidx2) or (ntpc >= 3 and pidx == tpidx3))
    if not skip_tp { bind_param(slots, pm, p.src, p.decls, deref(p.mar), p.mar, gps, gpl, its, itl, gps2, gpl2, its2, itl2, gps3, gpl3, its3, itl3) }
    pidx += 1
    pp = pm.next
  }
  mut fn_sub := Subst(gps = gps, gpl = gpl, its = its, itl = itl, gps2 = gps2, gpl2 = gpl2, its2 = its2, itl2 = itl2, gps3 = gps3, gpl3 = gpl3, its3 = its3, itl3 = itl3)
  collect_slots(slots, d.body_stmts, p.src, p.decls, deref(p.mar), p.mar, ptr(fn_sub))
  ## MIXED-KIND tuple component layout (§4): record per-component type + cumulative offset for any
  ## mixed tuple LOCAL, so a `t.N.field` read uses element N's OWN type/offset (not the uniform first).
  ## Empty for fns with no mixed tuple → the read falls to the uniform path (byte-identical, neutral).
  mut tup_layout := SVec(base = 0, len = 0, cap = 0, arena = p.mar)
  svec_new(tup_layout, p.mar, 8)
  tuple_layout_collect(d.body_stmts, ptr(slots), tup_layout, p.src, p.decls, deref(p.mar), p.mar)
  ## MIXED-KIND tuple PARAM layout (§4/§8): the by-ref dual — record per-component layout for any
  ## non-uniform tuple parameter so `t.N.field` resolves element N's own type/offset (was fail-loud).
  param_tuple_layout_collect(d.params_head, ptr(slots), tup_layout, p.src, p.decls, deref(p.mar), p.mar)
  ## Reserve the enum SCRATCH region: an enum-returning `match <call>` stages the returned
  ## %rax/%rdx here, and a by-ref / `deref(ptr)` enum `match` materializes the pointee's words
  ## here (`materialize_ref_enum`). `tslot` is its base (the discriminant word; payload word `i`
  ## at `tslot+1+i`). Sized to **1 + the widest enum payload** in the program (≥ 2, so the
  ## %rax/%rdx call-staging path always fits) so even a multi-word payload enum
  ## (`Bin(op, ptr, ptr)`) materializes whole. Always this size, so the frame is uniform.
  ## Keep one anonymous separator between body locals and the enum-match scratch. The scratch
  ## addresses are derived from `lt + swidth - 1`; a final local that is discovered through an
  ## arm-body rewalk can otherwise occupy the low scratch word when a widened payload adds a
  ## third return word, overwriting a live accumulator before the arm reads it.
  mut lt := svec_len(ptr(slots))
  svec_push(slots, SlotEntry(ns = 0, nl = 0, off = lt, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
  lt = svec_len(ptr(slots))
  scr_w := imax(2, 1 + max_enum_arity_all(p.decls, p.src, deref(p.mar)))
  ## reserve `scr_w` words PER simultaneously-live match level (see LCtx.mdepth): a match nested `d`
  ## deep needs `d` scratch levels so an inner materialization never clobbers an outer scrutinee.
  ## depth ≤ 1 → one level (byte-identical to the pre-depth frame for un-nested-match fns).
  mdep := imax(1, match_depth_stmts(d.body_stmts, deref(p.mar)))
  nscratch := scr_w * mdep
  for w in 0..nscratch {
    svec_push(slots, SlotEntry(ns = 0, nl = 0, off = lt + w, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
  }
  ## STRING tier — reserve the str-MATERIALIZATION temp pool: `nstr` blocks of 2 words each (the
  ## max str-literal-argument count of any single call in the body + trailing return). A str
  ## literal passed as a call argument is materialized into one of these blocks and passed by
  ## reference (`emit_arg` / `str_arg_tmp_off`). `str_tmp` (the pool base slot) is -1 when no call
  ## takes a str-literal argument (the pool is empty — byte-identical frames for str-literal-free fns).
  nstr := imax(scan_str_arg_stmts(p.src, p.decls, d.body_stmts, deref(p.mar)), scan_str_arg_expr(p.src, p.decls, d.value, deref(p.mar)))
  mut str_tmp_base := -1
  if nstr > 0 {
    str_tmp_base = i64(svec_len(ptr(slots)))
    nstrw := nstr * 2
    for i in 0..nstrw {
      so := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = 0, nl = 0, off = so, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
    }
  }
  ## AGGREGATE-ARG tier — reserve the agg-temp materialization POOL for struct/enum/tuple CONSTRUCTORS
  ## and struct-returning calls passed as call arguments (`emit_arg`). `aggw` = the widest aggregate's
  ## word count (one block, incl. a mutable-global aggregate — see below). `aggpeak` = the max number of
  ## aggregate-VALUE args in any single call (a §4 ABI requirement: N such args in one call need N
  ## distinct blocks or they alias — §8). The pool is `imax(1, aggpeak)` blocks (so ≥ one block for the
  ## single-arg / global-aggregate case — byte-identical for the ≤1-agg-arg fns the self-host build uses).
  agg_tmp_base := i64(svec_len(ptr(slots)))
  ## AGGREGATE width is per-function: only materializations reachable from this body/value path can
  ## consume this function's pool. `aggpeak` remains the independent nested-call block-count scan.
  aggw := imax(1, imax(scan_agg_width_stmts(d.body_stmts, p.decls, p.src, deref(p.mar)), scan_agg_width_expr(d.value, p.decls, p.src, deref(p.mar))))
  aggpeak := imax(scan_agg_arg_stmts(p.src, p.decls, d.body_stmts, deref(p.mar)), scan_agg_arg_expr(p.src, p.decls, d.value, deref(p.mar)))
  mut aggblocks := imax(1, aggpeak)
  ## ONE EXTRA block for a fn that returns a WIDE (> 7-word) struct or a WIDE (disc + payload > 7-word)
  ## ENUM AND passes at least one aggregate-VALUE argument somewhere: `emit_struct_to_sret` /
  ## `emit_enum_to_sret`'s tail-forward (`return mk(S(…))` / `return mk(…)`) stages the inner sret call's
  ## result in a pool block, and that block must not collide with the blocks the SAME call's
  ## aggregate-value ARGUMENTS take. Gated on `aggpeak > 0` as well, so a wide-returning fn with NO
  ## aggregate-value arg anywhere (e.g. `tcomp_find` in `src/`) keeps its exact one-block reservation —
  ## the emitted frame stays byte-identical for the self-host build → fixpoint-neutral. `src/`+`lib/`
  ## declare no wide-ENUM-returning fn at all, so the enum half never fires there.
  if aggpeak > 0 and (fn_returns_sret(d, p.decls, p.src, deref(p.mar)) or fn_returns_enum_sret(d, p.decls, p.src, deref(p.mar))) { aggblocks = aggblocks + 1 }
  aggpoolw := aggblocks * aggw
  for i in 0..aggpoolw {
    so := svec_len(ptr(slots))
    svec_push(slots, SlotEntry(ns = 0, nl = 0, off = so, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
  }
  ## INLINE tier — reserve the `@inline` call-site expansion scratch, sized to the widest `@inline`
  ## callee this fn uses (its params, later + body-locals). Reserved ONLY when the fn actually makes an
  ## `@inline` call (`inl_need > 0`), so an inline-free fn's frame is byte-identical (fixpoint-neutral).
  inl_need := imax(inline_frame_need_stmts(d.body_stmts, p.decls, p.src, d.mod_start, d.mod_len, ptr(slots), deref(p.mar), p.mar), inline_frame_need_expr(d.value, p.decls, p.src, d.mod_start, d.mod_len, ptr(slots), deref(p.mar), p.mar))
  mut inl_tmp_base := -1
  if inl_need > 0 {
    inl_tmp_base = i64(svec_len(ptr(slots)))
    ## widest param count + a local slack for a statement-body callee's own `out`-style locals. Each
    ## `@inline` call uses `[base .. base + P + L)`; P ≤ inl_need, L ≤ slack (num.al operators: L = 1).
    inl_reserve := inl_need + 8
    for i in 0..inl_reserve {
      so := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = 0, nl = 0, off = so, sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false))
    }
    ## §4 UP-GROWING: point cx.inl_tmp at the TOP of the reservation so an inline frame's aggregate
    ## params/locals lay out word 0 at the top (word k at inl_tmp - k) and nested frames stack DOWNWARD.
    inl_tmp_base = inl_tmp_base + i64(inl_reserve) - 1
  }
  ## SRET tier — one slot holding the hidden result-pointer (%rdi on entry) when this fn returns a
  ## struct > 7 words. Reserved ONLY for an sret fn, so every non-sret frame is byte-identical.
  ## An `@abi(c)` fn returning a SysV MEMORY-class struct (> 16 bytes = > 2 words) ALSO uses sret, even
  ## in the 3..7-word range the internal register-return convention would otherwise handle — the SysV
  ## boundary requires the hidden %rdi result pointer (increment 3c). Gated on `fn_abi_c` → neutral.
  abi_c_ret_mem := fn_abi_c and d.ret_tl != 0 and struct_decl_of(p.decls, p.src, d.ret_ts, d.ret_tl) >= 0 and struct_words(p.decls, p.src, d.ret_ts, d.ret_tl, deref(p.mar)) > 2
  ## GENERIC WIDE RETURN — the sret decision must be taken on the MONOMORPHIZED return type. A fn whose
  ## declared `-> R` IS its type parameter (`mk(T : type) -> T`) has a return-type span (`T`) that
  ## `fn_returns_sret` can never resolve to a struct, so a WIDE instance (`mk(S10)`, >= 8 words) skipped
  ## sret entirely and read the value back from the return registers — a SILENT 0/garbage. Substitute the
  ## instance type FIRST (the same substitution `ers`/`erl` applies further below for `ret_struct`), then
  ## apply the >= 8-word rule. For every non-generic fn `srs`/`srl` ARE `d.ret_ts`/`d.ret_tl`, so this
  ## collapses into `fn_returns_sret` (byte-identical → fixpoint-neutral).
  mut srs := d.ret_ts
  mut srl := d.ret_tl
  if gpl != 0 and srl != 0 and streq(p.src, d.ret_ts, d.ret_tl, gps, gpl) { srs = its; srl = itl }
