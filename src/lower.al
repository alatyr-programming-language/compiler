        ## is exactly the explicit constructor form `T(v)` (narrowing is always explicit → one site);
        ## it is DROPPED under `unchecked` (cx.vchk false) and never reached through a raw `bitcast`
        ## (a distinct form that does not route through `T(v)`). The predicate value stays on the stack
        ## as the construction result (the balanced `call` preserves the word below the return address).
        ## `require_pred` returns `{0,0}` for every non-require type, so this is byte-identical for the
        ## self-host build (no `@require` in src/lib → the TOOL-1 fixpoint holds).
        if cx.vchk {
          rp := require_pred(cx.decls, cx.src, cs, cl)
          if rp.n != 0 {
            ## Named-fn predicate only in this slice: an INLINE `fn(v){…}` predicate (its span carries a
            ## `(`) is a distinct construct (anonymous fn hoist/inline) — fail LOUD rather than skip the
            ## check (a missed contract check would be a silent violation, the forbidden outcome).
            mut pi := 0
            mut inline := false
            while pi < rp.n { if str_at((cx.src + rp.s + pi), 1) == "(" { inline = true }; pi = pi + 1 }
            ## Inline predicates are lifted by the driver to `<module>__lam<fnpos>`. The predicate span
            ## starts at the `fn` token, so its source offset is also the synthetic declaration's id.
            ## This scalar slice uses the ordinary one-argument ABI, just like named predicates.
            ## The value is passed to the predicate using the same scalar ABI as an ordinary call:
            ## integer/pointer/brand-over-integer in `%rdi`, f32/f64 in `%xmm0`. The predicate returns
            ## `bool` in `%rax`; the value remains on the stack below the call's return-address frame.
            lok := nl
            nl += 1
            if ck == 1 { push_str(sb, "  movq (%rsp), %xmm0\n  call ") }
            else { push_str(sb, "  movq (%rsp), %rdi\n  call ") }
            if inline {
              if rp.n < 2 or str_at((cx.src + rp.s), 2) != "fn" {
                panic("selfhost: malformed inline @require predicate")
              }
              emit_mod_qual(sb, cx.src, cx.mod_s, cx.mod_l)
              push_str(sb, "lam")
              push_int(sb, i64(rp.s))
            } else {
              emit_mangled_call(sb, cx.src, rp.s, rp.n, 0, 0, cx.decls)
            }
            push_str(sb, "\n  testq %rax, %rax\n  jne ")
            emit_label(sb, lok)
            push_str(sb, "\n  ud2\n")
            emit_label(sb, lok)
            push_str(sb, ":\n")
          }
        }
        return
      }
