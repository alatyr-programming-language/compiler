  ## SAME scratch the text `emit_fn` reserves: enum-match staging (`tslot`), str-literal-arg blocks
  ## (`str_tmp`), the aggregate-arg pool (`agg_tmp`/`agg_next`/`agg_end`), and `@inline` expansion scratch.
  ## Reserved via the SAME scans/sizes as `emit_fn`, so a spliced print's segment {ptr,len} lands in real
  ## frame words — NOT on the saved %rbp / return address (the segfault when these stayed -1). A barrier-free
  ## scalar-leaf fn (IRP_NGBAR==0) keeps every pool at -1/0 → its frame is byte-identical (fixpoint-neutral).
  mut ir_tslot := 0 - 1
  mut ir_str_tmp := 0 - 1
  mut ir_agg_tmp := 0 - 1
  mut ir_inl_tmp := 0 - 1
  mut ir_agg_next := 0 - 1
  mut ir_agg_end := 0 - 1
  mut ir_agg_w := 0
  mut ir_swidth := 2
  if IRP_NGBAR > 0 {
    ir_swidth = imax(2, 1 + max_enum_arity_all(p.decls, p.src, deref(p.mar)))
    mdep := imax(1, match_depth_stmts(d.body_stmts, deref(p.mar)))
    ir_tslot = i64(svec_len(ptr(slots)))
    nscr := ir_swidth * mdep
    for w in 0..nscr { svec_push(slots, SlotEntry(ns = 0, nl = 0, off = svec_len(ptr(slots)), sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false)) }
    nstr := imax(scan_str_arg_stmts(p.src, p.decls, d.body_stmts, deref(p.mar)), scan_str_arg_expr(p.src, p.decls, d.value, deref(p.mar)))
    if nstr > 0 {
      ir_str_tmp = i64(svec_len(ptr(slots))) + 1
      nstrw := nstr * 2
      for i in 0..nstrw { svec_push(slots, SlotEntry(ns = 0, nl = 0, off = svec_len(ptr(slots)), sns = 0, snl = 0, ek = 0, estride = 1, eek = 0, is_ref = false)) }
    }
