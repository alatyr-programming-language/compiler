  }
  mut wbase := 0
  if anystruct or hasarr { wbase = svec_len(ptr(slots)) }
  regalloc::ra_scalarleaf_begin()
  if wbase > 0 { regalloc::ra_set_spill_base(0 - i64(wbase + 1) * 8) }
  ## bind each SCALAR param into its vreg from its SysV argument register. A by-ref struct param is NOT a
  ## vreg — its incoming POINTER is spilled to the text frame slot in the prologue (below), and its field
  ## reads route through the barrier. `pidx` still counts EVERY param (a by-ref struct = one arg register,
  ## so the param-index → arg-register mapping stays 1:1 across the mixed signature).
  mut pp := d.params_head
  mut pidx := 0
  while pp != 0 {
    pm := deref(param_p(pp))
    if ir_native_scalar(p.src, pm.ts, pm.tl) {
      vr := ir_var_vreg(cx, pm.ns, pm.nl)
