  ## (gps/gpl/its/itl — the generic type-param name + instance type — were computed above the
  ## TAIL-VALUE mode: a value-returning fn (`ret_tl != 0`) whose body has NO real trailing return
  ## expression (`d.value` is the `Num(-1)` sentinel) takes its value from the LAST body statement
  ## — a braced tail `match` whose arms each end in a value expression (the lean parser parses
  ## `match` only as a statement, so this is the sole way such a fn returns its value). The trailing
  ## delivery below stays as the fall-through default. Carried in `cx.tail` (a directly-tail match
  ## inherits it through the shared `cx`); see `emit_stmts`' `ExprStmt` arm.
  tailmode := d.ret_tl != 0 and expr_is_no_tail(d.value)
  ## §4 UP-GROWING: a temp-pool BLOCK's base is its word-0 = the TOP of the block (lowest address), so
  ## direct uses / str_arg_tmp_off address word k at `base - k` inside the reservation. str_tmp block 0
  ## top = base+1 (2-word blocks; str_arg_tmp_off's `+ j*2` then lands on block j's top). agg_tmp block 0
  ## top = base+aggw-1. (agg_next/agg_end stay at the pool BOTTOM: agg_alloc returns off+agg_w-1 itself.)
  mut str_tmp_top := str_tmp_base
  if str_tmp_base >= 0 { str_tmp_top = str_tmp_base + 1 }
  mut agg_tmp_top := agg_tmp_base
  if aggw > 0 { agg_tmp_top = agg_tmp_base + aggw - 1 }
  ## param loop, where bind_param needs them; reused here for the LCtx so `size(T)` resolves.)
  ## body statements, then the trailing return expression.
  ## DEFER (§9.3): the per-fn defer machinery, initialised in the ctx (it used to be three module
  ## globals reset here by hand). `defer_active` = does ANY statement (at any nesting depth) carry a
  ## `defer` marker — false for every self-host fn (no `defer` in `src/`+`lib/`), so the per-block frame
  ## push/drain ops are skipped and the emitted tree gas stays byte-identical (the TOOL-1 fixpoint is
  ## neutral). `defer_sp` starts at 0: the fn body has NO frame, only nested blocks push.
  d_has_defer := stmts_have_defer(d.body_stmts, p.src, deref(p.mar))
  cx := LCtx(src = p.src, slots = ptr(slots), decls = p.decls, mar = p.mar, epi = lepi, ret_enum = renum, ret_struct = rstruct, ret_tuple = rtuple, ret_str = rstr, ret_float = rfloat, ret_ss = ers, ret_sl = erl, tslot = i64(lt), str_tmp = str_tmp_top, agg_tmp = agg_tmp_top, inl_tmp = inl_tmp_base, mod_s = d.mod_start, mod_l = d.mod_len, brk = -1, cont = -1, gp_s = gps, gp_l = gpl, it_s = its, it_l = itl, gp2_s = gps2, gp2_l = gpl2, it2_s = its2, it2_l = itl2, gp3_s = gps3, gp3_l = gpl3, it3_s = its3, it3_l = itl3, cf_var_s = 0, cf_var_l = 0, cf_fld_s = 0, cf_fld_l = 0, cf_ty_s = 0, cf_ty_l = 0, cf_pay_s = 0, cf_pay_l = 0, cf_pay_ty_s = 0, cf_pay_ty_l = 0, cf_curvar_s = 0, cf_curvar_l = 0, cf_vloop_s = 0, cf_vloop_l = 0, pack_args = 0, agg_next = agg_tmp_base, agg_end = agg_tmp_base + aggpoolw, agg_w = aggw, tcomps = ptr(tup_layout), tail = tailmode, call_cidx = -1, mdepth = 0, swidth = scr_w, ret_sret = d_is_sret, sret_slot = sret_slot, sret_call = -1, vchk = true, defer_active = d_has_defer, defer_n = 0, defer_sp = 0, defer_inner = [0; 128], defer_blk = [0; 128], defer_frame = [0; 64], loop_sp = 0, loop_brk = [0; 64], loop_cont = [0; 64], loop_isexpr = [0; 64], loop_dframe = [0; 64], ir_stop = 0, ind_fn_fmask = 0)
  emit_stmts(d.body_stmts, sb, ptr(cx), nl)
  ## Trailing return: an enum- or 2-word-struct-returning fn materializes the value into
  ## %rax/%rdx (no stack push); a scalar fn lowers the value onto the stack and pops it into %rax.
  ## A bare-arm value-`match` as the WHOLE body (`fn -> T { match n { 0 => v ; _ => w } }`) lands in
  ## `d.value` as an `Expr::Match` (a tail EXPRESSION, not a braced statement-match); route it
  ## through `emit_return_value`, which dispatches an INTEGER scrutinee and delivers each arm via the
  ## return convention + `jmp` the epilogue (so the arms land on `lepi` below). (An enum-scrutinee
  ## bare-arm value-match is not delivered — use the braced form, which rides the `cx.tail` path.)
  mtr := match_info(d.value)
  dvi := if_info(d.value)
  if mtr.is_m {
    emit_return_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if dvi.is_if and (rstruct or rtuple or rstr or rbyte) {
    ## a TRAILING `if c { … } else { … }` returning a struct/tuple/str — deliver each branch via the
    ## return convention (emit_return_value's If arm; those emitters lack an If arm). NOT enum (renum):
    ## emit_enum_value HAS an If arm → src/'s enum tail-ifs stay byte-identical. A SCALAR trailing-if
    ## stays on `emit_gas` below (its Expr::If arm).
    emit_return_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if rbyte {
    emit_byte_array_return_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if is_niche_folded(p.src, ers, erl) {
    ## §8 `@niche`: a trailing `Option(ptr(T))` return is the folded pointer word, just
    ## like an early return. Keep this before `renum`: the parenthesized generic
    ## instance is intentionally not classified as an ordinary enum.
    emit_folded_option_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if d_is_sret {
    ## a >7-word aggregate TRAILING value written through the hidden result-pointer (ptr → %rax) —
    ## enum (disc + payload) or struct. Checked BEFORE renum: a wide enum has both set, sret wins.
    if renum { emit_enum_to_sret(d.value, sb, ptr(cx), deref(p.mar), nl) }
    else { emit_struct_to_sret(d.value, sb, ptr(cx), deref(p.mar), nl) }
  } else if renum {
    emit_enum_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if rstruct {
    emit_struct_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if rtuple {
    ## a TUPLE-returning fn's TRAILING value `(a, b)` — deliver each component via the register
    ## convention (emit_struct_value's ArrayLit arm).
    emit_struct_value(d.value, sb, ptr(cx), deref(p.mar), nl)
  } else if rstr {
    ## a str-returning fn's TRAILING value: materialize the {ptr, len} pair, deliver ptr/%rax,
    ## len/%rdx (the str dual — mirrors the `Stmt::Return` ret_str path).
    emit_str_pair(d.value, sb, ptr(cx), deref(p.mar), nl)
    push_str(sb, "  popq %rdx\n  popq %rax\n")
  } else {
    emit_gas(d.value, sb, ptr(cx), deref(p.mar), nl)
    push_str(sb, "  popq %rax\n")
    ## an f64/f32-returning fn delivers its value in %xmm0 (the SSE return register).
    if rfloat { push_str(sb, "  movq %rax, %xmm0\n") }
  }
  emit_label(sb, lepi)
  push_str(sb, ":\n")
  ## DEFER (§9.3): run the pending defers the fn still owes (boundary 0 = drain EVERYTHING, including the
  ## fn-body top-level entries) LIFO here — the point every normal exit (return / `?` / fall-through)
  ## converges — preserving the return registers across them. A no-op when the fn has none; the early-exit
  ## drains (`return`/`break`/`continue`/`?`) have already discharged the nested-frame entries.
  emit_defer_chain(sb, ptr(cx), deref(p.mar), nl, 0)
  ## RECEIVING side (increment 3b): normalize an `@abi(c)` ≤16-byte STRUCT return from the internal
  ## retreg convention (%rax:%rdx…) into the SysV classed result registers (%rax:%rdx INTEGER /
  ## %xmm0:%xmm1 SSE) — all return paths converge here with the words in the retregs. An all-integer
  ## struct emits only no-op self-moves → byte-identical; a scalar/float return is untouched. Gated on
  ## `fn_abi_c` → dormant for the self-host build (fixpoint-neutral; the split `:\n` string concatenates
  ## to the same bytes as the old `:\n  movq %rbp…`).
  if fn_abi_c and rstruct { emit_abi_c_ret_agg_def(p.decls, p.src, deref(p.mar), ers, erl, sb) }
  push_str(sb, "  movq %rbp, %rsp\n  popq %rbp\n  ret\n")
  sf := 0
}

## DATA-SECTION (`.rodata`) emission for string literals. Each `StrLit` carries a unique
## label index (assigned at parse time), so the AST is walked once before the `.text` section
## and every literal occurrence is emitted as `.Lstr<idx>: .ascii "<bytes>"` (the inner bytes
## read verbatim from the source via `str_at` — escapes deferred, the toy strings are plain
## ASCII). `.ascii` emits exactly the bytes with NO null terminator, matching the {ptr, len}
## representation (len = the byte count). The walk recurses over every expression child + the
## fn body statement lists, so a literal anywhere in the program gets its data entry.
##
## The deref-`match` on the expr pointer `e` stays a function-body match over a direct PARAM
## (the lowerable shape) — `emit_rodata_expr` is itself the recursion point.
##
## A StrLit's stored `sl` is the RUNTIME byte length. The `.ascii` directive needs the RAW source
## span (the escape sequence is emitted verbatim and `as` decodes it), so recover it by scanning
## `sl` logical bytes: a simple escape consumes two raw bytes while `\xHH` consumes four. Emitting
## `sl` raw bytes instead would truncate a literal by the extra source bytes in an x-escape.
rodata_raw_span := fn(src : ptr(u8), ss : usize, sl : usize) -> usize {
  mut bi := 0
  mut si := 0
  while bi < sl {
    if bytes(str_at((src + ss + si), 1))[0] == 92 {
      if bytes(str_at((src + ss + si + 1), 1))[0] == 120 { si = si + 4 }
      else { si = si + 2 }
    } else { si = si + 1 }
    bi += 1
  }
  si
}
rodata_hex_digit := fn(c : u8) -> usize {
  if c >= 48 and c <= 57 { return usize(c - 48) }
  if c >= 65 and c <= 70 { return usize(c - 65) + 10 }
  if c >= 97 and c <= 102 { return usize(c - 97) + 10 }
  0
}
rodata_has_x_escape := fn(src : ptr(u8), ss : usize, sl : usize) -> bool {
  mut bi := 0
  mut si := 0
  while bi < sl {
    if bytes(str_at((src + ss + si), 1))[0] == 92 {
      if bytes(str_at((src + ss + si + 1), 1))[0] == 120 { return true }
      si = si + 2
    } else { si = si + 1 }
    bi += 1
  }
  false
}
## Emit a literal containing `\xHH` as explicit bytes. GAS's `.ascii` escape parser is not
## portable for a following source byte (`"\x00A"` was assembled as 0x0A), so x-escape literals
## bypass it and are decoded by the compiler before assembly.
emit_rodata_decoded := fn(in out sb : strbuf::StrBuf, src : ptr(u8), ss : usize, sl : usize) {
  mut bi := 0
  mut si := 0
  mut any := false
  while bi < sl {
    mut b := 0
    if bytes(str_at((src + ss + si), 1))[0] == 92 {
      esc := bytes(str_at((src + ss + si + 1), 1))[0]
      if esc == 120 {
        b = rodata_hex_digit(bytes(str_at((src + ss + si + 2), 1))[0]) * 16
        b = b + rodata_hex_digit(bytes(str_at((src + ss + si + 3), 1))[0])
        si = si + 4
      } else {
        if esc == 110 { b = 10 }
        else if esc == 116 { b = 9 }
        else if esc == 114 { b = 13 }
        else if esc == 48 { b = 0 }
        else if esc == 92 or esc == 34 or esc == 39 { b = usize(esc) }
        else { b = usize(esc) }
        si = si + 2
      }
    } else {
      b = usize(bytes(str_at((src + ss + si), 1))[0])
      si = si + 1
    }
    if not any { push_str(sb, " .byte ") } else { push_str(sb, ", ") }
    push_int(sb, i64(b))
    any = true
    bi += 1
  }
  if not any { push_str(sb, " 0") }
  push_str(sb, "\n")
}
## The `.rodata` entry for a `StrLit`. A NORMAL literal: `.Lstr<lbl>: .ascii "<inner source bytes>"`.
## An EMBED literal: its baked file bytes as `.Lstr<lbl>: .byte b0, b1, …`, read from the ABSOLUTE
## address `ss` (baked into the compile arena by `parser::embed_strlit`, NOT a source offset), so ANY
## binary byte (NUL / high / newline) is exact with no `.ascii` escaping.
##
## EMBED DETECTION — `lbl % 1000000 >= 500000` (`parser::embed_label_base` = 500000): an embed's
## label carries the marker in its LOW residue. This is invariant under the closure-hoist label
## RENUMBER (`driver` adds `(fnpos+1)*1000000` to a cloned literal's label — a multiple of 1000000,
## so the residue is preserved), and the renumber leaves `ss` untouched, so a renumbered embed is
## still recognized and still reads its absolute address. Normal labels have residue < 500000 (the
## whole compiler uses ~6.5k strings; the renumber design already assumes < 1000000 per module), so
## they never collide. `src/`+`lib/` contain NO embeds → the `.byte` branch is never taken in a
## self-build → the emitted GAS is byte-identical → the TOOL-1 fixpoint is neutral.
emit_strlit_rodata := fn(in out sb : strbuf::StrBuf, src : ptr(u8), ss : usize, sl : usize, lbl : usize) {
  ## slice 1d SCAN pass: record the module's smallest label index and emit NOTHING (see `ROD_SCAN`).
  if ROD_SCAN != 0 {
    if ROD_HAS == 0 { ROD_MIN = lbl }
    if lbl < ROD_MIN { ROD_MIN = lbl }
    ROD_HAS = 1
    return
  }
  globl_lstr(sb, lbl)
  push_lstr(sb, lbl)
  if lbl % 1000000 >= 500000 {
    push_str(sb, ":")
    mut ei := 0
    while ei < sl {
      eb := bytes(str_at(unchecked bitcast(ptr(u8), ss + ei), 1))[0]
      if ei == 0 { push_str(sb, " .byte ") } else { push_str(sb, ", ") }
      push_int(sb, i64(usize(eb)))
      ei = ei + 1
    }
    push_str(sb, "\n")
  } else {
    if rodata_has_x_escape(src, ss, sl) {
      push_str(sb, ":")
      emit_rodata_decoded(sb, src, ss, sl)
    } else {
      push_str(sb, ": .ascii \"")
      rs := rodata_raw_span(src, ss, sl)
      push_str(sb, str_at((src + ss), rs))
      push_str(sb, "\"\n")
    }
  }
}
emit_rodata_expr := fn(e : ptr(Expr), in out sb : strbuf::StrBuf, src : ptr(u8), a : rt::Arena, seen : ptr(mut rt::Vec)) {
  match deref(e) {
    Expr::Num(v, s, n) => {}
    Expr::Var(s, n) => {}
    Expr::Bin(op, l, r) => {
      emit_rodata_expr(l, sb, src, a, seen)
      emit_rodata_expr(r, sb, src, a, seen)
    }
    Expr::If(c, t, f) => {
      emit_rodata_expr(c, sb, src, a, seen)
      emit_rodata_expr(t, sb, src, a, seen)
      emit_rodata_expr(f, sb, src, a, seen)
    }
    Expr::Match(scrut, head) => {
      emit_rodata_expr(scrut, sb, src, a, seen)
      mut arm := head
      while arm != 0 {
        am := deref(arm_p(arm))
        ## a STR-LITERAL pattern arm (`wild == 4`) carries its pattern StrLit's node handle in `lit`
        ## — emit that literal's `.ascii` rodata (the dispatch byte-compares against it).
        if am.wild == 4 { emit_rodata_expr(unchecked bitcast(ptr(Expr), usize(am.lit)), sb, src, a, seen) }
        emit_rodata_expr(am.body, sb, src, a, seen)
        emit_rodata_stmts(am.body_stmts, sb, src, a, seen)
        arm = am.next
      }
    }
    Expr::Call(cs, cl, nargs, args_head) => {
      mut g := args_head
      while g != 0 {
        ga := deref(arg_p(g))
        emit_rodata_expr(ga.e, sb, src, a, seen)
        g = ga.next
      }
    }
    Expr::StructLit(cs, cl, nf, fhead) => {
      mut g := fhead
      while g != 0 {
        ga := deref(arg_p(g))
        emit_rodata_expr(ga.e, sb, src, a, seen)
        g = ga.next
      }
    }
    Expr::Field(base, fs, fl) => { emit_rodata_expr(base, sb, src, a, seen) }
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      mut g := phead
      while g != 0 {
        ga := deref(arg_p(g))
        emit_rodata_expr(ga.e, sb, src, a, seen)
        g = ga.next
      }
    }
    Expr::AddrOf(p) => { emit_rodata_expr(p, sb, src, a, seen) }
    Expr::Deref(p) => { emit_rodata_expr(p, sb, src, a, seen) }
    Expr::ArrayLit(nel, ehead) => {
      mut g := ehead
      while g != 0 {
        ga := deref(arg_p(g))
        emit_rodata_expr(ga.e, sb, src, a, seen)
        g = ga.next
      }
    }
    Expr::Index(base, idx) => {
      emit_rodata_expr(base, sb, src, a, seen)
      emit_rodata_expr(idx, sb, src, a, seen)
    }
    Expr::Try(inner) => { emit_rodata_expr(inner, sb, src, a, seen) }
    Expr::Unchecked(inner) => { emit_rodata_expr(inner, sb, src, a, seen) }
    Expr::Bitcast(inner, _bcs, _bcl) => { emit_rodata_expr(inner, sb, src, a, seen) }
    ## the data entry for this literal (delegated to `emit_strlit_rodata`, which handles both the
    ## `.ascii` source-literal case and the embed `.byte` case; see its EMBED DETECTION note).
    Expr::StrLit(ss, sl, lbl) => { emit_strlit_rodata(sb, src, ss, sl, lbl) }
    ## the data entry for a FLOAT literal: `.Lflt<start>: .double <verbatim source text>` — the
    ## ASSEMBLER computes the IEEE-754 bits from the decimal text (e.g. "1.5"), so the compiler needs
    ## no float arithmetic of its own. The label is keyed on the literal's source-span start,
    ## matching the `movsd .Lflt<start>(%rip)` load in `emit_gas`.
    ##
    ## DEDUP by source-offset: unlike a `StrLit` (whose label index `lbl` is renumbered per HOF clone
    ## so every emission is unique), a `FloatLit` has NO separate label field — its label IS the source
    ## offset `fss`. When the driver's D-cap path DEEP-CLONES a HOF body carrying a float literal, the
    ## clone copies `fss` VERBATIM (it cannot be bumped — `fss` also indexes the literal's decimal text),
    ## so the original and the clone would both emit `.Lflt<fss>:` → an assembler "symbol already defined".
    ## Both loads (`movsd .Lflt<fss>`) name the SAME offset and read the SAME text, so ONE shared `.rodata`
    ## entry is correct: emit each distinct `fss` at most once, tracking emitted offsets in `seen`. In an
    ## un-cloned program every FloatLit has a unique `fss`, so nothing is skipped → the GAS is byte-
    ## identical → the TOOL-1 fixpoint is unaffected (`src/`+`lib/` float offsets are all unique).
    Expr::FloatLit(fss, fsl) => {
      ## slice 1d: the SCAN pass emits nothing AND must not touch `seen` (marking a float as emitted
      ## here would make the real pass skip its `.rodata` cell → an undefined `.Lflt` reference).
      if ROD_SCAN == 0 {
      mut fdup := false
      mut fk := 0
      while fk < rt::vec_len(deref(seen)) {
        if rt::vec_get(deref(seen), fk) == fss { fdup = true }
        fk += 1
      }
      if fdup == false {
        rt::vec_push(deref(seen), fss)
        globl_lflt(sb, fss)
        push_lflt(sb, fss)
        push_str(sb, ": .double ")
        push_str(sb, str_at((src + fss), fsl))
        push_str(sb, "\n")
      }
      }
    }
  }
}

## Walk a body statement list, emitting the `.rodata` entry for any string literal in any
## sub-expression (and recursing into nested branch/arm/loop statement lists).
emit_rodata_stmts := fn(head : ptr(mut Stmt), in out sb : strbuf::StrBuf, src : ptr(u8), a : rt::Arena, seen : ptr(mut rt::Vec)) {
  mut s := head
  while s != 0 {
    st := deref(stmt_p(Stmt, s))
    match st {
      Stmt::Assign(ns, nl, v, nx) => { emit_rodata_expr(v, sb, src, a, seen); s = nx }
      Stmt::While(c, b, nx) => {
        emit_rodata_expr(c, sb, src, a, seen)
        emit_rodata_stmts(b, sb, src, a, seen)
        s = nx
      }
      Stmt::Loop(b, nx) => {
        emit_rodata_stmts(b, sb, src, a, seen)
        s = nx
      }
      Stmt::Unchecked(b, nx) => {
        emit_rodata_stmts(b, sb, src, a, seen)
        s = nx
      }
      Stmt::AllocWith(ae, b, nx) => {
        emit_rodata_expr(ae, sb, src, a, seen)
        emit_rodata_stmts(b, sb, src, a, seen)
        s = nx
      }
      Stmt::Break(_bv, _bd, nx) => { s = nx }
      Stmt::Continue(_cd, nx) => { s = nx }
      Stmt::ExprStmt(e, nx) => { emit_rodata_expr(e, sb, src, a, seen); s = nx }
      Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { emit_rodata_expr(fv, sb, src, a, seen); s = nx }
      Stmt::FieldPathAssign(pl, fpv, nx) => { emit_rodata_expr(fpv, sb, src, a, seen); s = nx }
      Stmt::Return(rv, nx) => { emit_rodata_expr(rv, sb, src, a, seen); s = nx }
      Stmt::If(c, th, el, nx) => {
        emit_rodata_expr(c, sb, src, a, seen)
        emit_rodata_stmts(th, sb, src, a, seen)
        emit_rodata_stmts(el, sb, src, a, seen)
        s = nx
      }
      Stmt::Match(sc, ah, nx) => {
        emit_rodata_expr(sc, sb, src, a, seen)
        mut arm := ah
        while arm != 0 {
          am := deref(arm_p(arm))
          ## a STR-LITERAL pattern arm (`wild == 4`): emit the pattern StrLit's `.ascii` rodata.
          if am.wild == 4 { emit_rodata_expr(unchecked bitcast(ptr(Expr), usize(am.lit)), sb, src, a, seen) }
          emit_rodata_stmts(am.body_stmts, sb, src, a, seen)
          arm = am.next
        }
        s = nx
      }
      Stmt::For(fns, fnl, flo, fhi, fb, nx) => {
        emit_rodata_expr(flo, sb, src, a, seen)
        if unchecked bitcast(usize, fhi) != 0 { emit_rodata_expr(fhi, sb, src, a, seen) }   ## fhi==0 = for-over-iterable
        emit_rodata_stmts(fb, sb, src, a, seen)
        s = nx
      }
      Stmt::CompIf(ccond, cthen, celse, nx) => {
        emit_rodata_stmts(cthen, sb, src, a, seen)
        emit_rodata_stmts(celse, sb, src, a, seen)
        s = nx
      }
      Stmt::CompFor(cvs, cvl, civ, cb, nx) => {
        emit_rodata_stmts(cb, sb, src, a, seen)
        s = nx
      }
      Stmt::CompForRange(crvs, crvl, crlo, crhi, crb, nx) => {
        emit_rodata_stmts(crb, sb, src, a, seen)
        s = nx
      }
      Stmt::CompMatch(cmsc, cmah, nx) => {
        mut car := cmah
        while car != 0 { cam := deref(arm_p(car)); emit_rodata_stmts(cam.body_stmts, sb, src, a, seen); car = cam.next }
        s = nx
      }
      Stmt::DerefAssign(ptr, val, nx) => {
        emit_rodata_expr(ptr, sb, src, a, seen)
        emit_rodata_expr(val, sb, src, a, seen)
        s = nx
      }
      Stmt::IndexAssign(ib, ii, iv, nx) => {
        emit_rodata_expr(ib, sb, src, a, seen)
        emit_rodata_expr(ii, sb, src, a, seen)
        emit_rodata_expr(iv, sb, src, a, seen)
        s = nx
      }
      Stmt::IndexFieldAssign(fia, fii, ifs, ifl, fiv, nx) => {
        emit_rodata_expr(fia, sb, src, a, seen)
        emit_rodata_expr(fii, sb, src, a, seen)
        emit_rodata_expr(fiv, sb, src, a, seen)
        s = nx
      }
    }
  }
}

## One declaration's rodata contribution. The scan pass and the real per-module pass must walk the
## same AST shapes; keeping that policy here prevents `emit_program` from growing another copy when
## the module-local data lane gains a new declaration kind. `check_const` is enabled only for the real
## pass because the scan exists solely to derive label bases.
emit_rodata_decl := fn(d : Decl, decls : ptr(rt::Vec), src : ptr(u8), in out sb : strbuf::StrBuf, a : rt::Arena, seen : ptr(mut rt::Vec), check_const : bool) {
  if d.kind == 1 or d.kind == 5 {
    emit_rodata_stmts(d.body_stmts, sb, src, a, seen)
    emit_rodata_expr(d.value, sb, src, a, seen)
  } else if d.kind == 0 {
    ## CORRECT-OR-TRAP: a CONST module-level GLOBAL (`G := mk()`, no `mut`) whose initializer is
    ## a runtime CALL returning an AGGREGATE. A const global has NO storage — its value is folded at each
    ## use — and a call folds to nothing, so `G.a` silently read 0 while the initializer never ran.
    ## A `mut` global is deliberately excluded: it gets real zero-initialized storage.
    if check_const and d.is_fn == false and d.ret_tl == 0 and d.arity == 0 and local_is_mut(src, d.name_start) == false and global_init_agg_call(d.value, decls, src, a) {
      panic("selfhost: a CONST module-level global initialized by a runtime CALL returning an aggregate (struct / enum / tuple / str / slice) is not lowered — a const global's initializer must be a compile-time constant (a literal), and the call never runs (its fields would silently read 0); build the value inside a function instead")
    }
    emit_rodata_expr(d.value, sb, src, a, seen)
  }
}

## GENERICS tier — the MONOMORPHIZATION instantiation set. One entry = a distinct (generic
## fn, concrete type) pair seen at a call site: `gi` the generic fn's decl index, `ts`/`tl`
## the type-argument lexeme span. `emit_program` collects these from every call site (deduped
## by `gi` + typetag content) then emits one specialized fn-definition copy per entry.
## A monomorphization instance: the generic decl index `gi` + up to TWO comptime type-arg tags
## (`ts`/`tl` = the FIRST type-param's concrete-type lexeme span; `ts2`/`tl2` = the SECOND's, 0/0
## when the fn has a single type-param). Two tags cover `map(T, U, …)` / `HashMap(K, V, …)`; the
## mangled label is `<mod>__<fn>__<tag1>` (single) or `<mod>__<fn>__<tag1>__<tag2>` (two).
Inst := struct { gi : usize, ts : usize, tl : usize, ts2 : usize, tl2 : usize, ts3 : usize, tl3 : usize }

## `IVec` — an `Inst` vector backed by a bump arena (the lean replacement for
## `alloc::IVec` fixpoint), mirroring `SVec`. The mono pre-pass collects
## a bounded set of generic instances here; growth doubles `cap` with a word-granular copy.
IVec := struct { base : usize, len : usize, cap : usize, arena : ptr(mut rt::Arena) }
ivec_stride := fn() -> usize {
  sz := size(Inst)
  r := sz % 8
  if r == 0 { return sz }
  return sz + (8 - r)
}
## Initialize `v` as a fresh IVec backed by `cap` element slots from `a` (an IN-OUT constructor,
## the dual of `rt::arena_init`). IVec is a 4-WORD struct {base,len,cap,arena}; the self-host
## lower's struct-RETURN convention rides ≤3 registers (%rax:%rdx:%rcx), so a 4-word `return
## IVec(…)` would mis-deliver (it was treated as a SCALAR and returned a placeholder 0, leaving
## `insts.base = 0` — the bug-#7-adjacent fixpoint crash inside `ivec_at`). Filling `v` by
## reference dodges the wide return entirely — the same reason `rt::arena_init`/`strbuf` are in-out.
ivec_new := fn(in out v : IVec, a : ptr(mut rt::Arena), cap : usize) {
  off := node_alloc(deref(a), cap * ivec_stride())
  base_abs := unchecked bitcast(usize, deref(a).base) + off
  v.base = base_abs
  v.len = 0
  v.cap = cap
  v.arena = a
}
ivec_push := fn(in out v : IVec, x : Inst) {
  st := ivec_stride()
  if v.len >= v.cap {
    new_cap := v.cap * 2
    noff := node_alloc(deref(v.arena), new_cap * st)
    nbase := arena_base(v.arena) + noff
    nwords := (v.len * st) / 8
    mut k := 0
    while k < nwords {
      sp : ptr(mut usize) = unchecked bitcast(ptr(mut usize), v.base + k * 8)
      dp : ptr(mut usize) = unchecked bitcast(ptr(mut usize), nbase + k * 8)
      deref(dp) = deref(sp)
      k += 1
    }
    v.base = nbase
    v.cap = new_cap
  }
  p : ptr(mut Inst) = unchecked bitcast(ptr(mut Inst), v.base + v.len * st)
  deref(p) = x
  v.len = v.len + 1
}
ivec_at := fn(v : ptr(IVec), i : usize) -> Inst {
  p : ptr(Inst) = unchecked bitcast(ptr(Inst), deref(v).base + i * ivec_stride())
  return deref(p)
}
ivec_len := fn(v : ptr(IVec)) -> usize { return deref(v).len }

## Two type-arg spans denote the SAME instantiation? Compares the bare head lexeme AND every
## top-level type-argument (via the proven `typearg_at` re-scan), so two generic-instance type-args
## of one base (`Option(u64)` vs `Option(i64)`, both recorded as the bare head `Option`) are DISTINCT
## instantiations, not collapsed. For a bare type-arg (no trailing `(…)` → no type-args) this reduces
## to the head `streq` — byte-identical dedup to before (fixpoint-neutral for `src/`).
inst_targ_eq := fn(src : ptr(u8), a_s : usize, a_n : usize, b_s : usize, b_n : usize) -> bool {
  if streq(src, a_s, a_n, b_s, b_n) == false { return false }
  mut j := 0
  mut eq := true
  mut going := true
  while going {
    ta := typearg_at(src, a_s, a_n, j)
    tb := typearg_at(src, b_s, b_n, j)
    if ta.n == 0 and tb.n == 0 { going = false }
    else if ta.n == 0 or tb.n == 0 { eq = false ; going = false }
    else if streq(src, ta.s, ta.n, tb.s, tb.n) == false { eq = false ; going = false }
    else { j = j + 1 }
  }
  eq
}

## Record a (generic-fn, typetag) instantiation if not already present (dedup by `gi` + the
## typetag's content, so two `id(u64,…)` calls yield ONE instance, but `id(u64,…)` and
## `id(i64,…)` yield two).
add_inst := fn(in out insts : IVec, src : ptr(u8), gi : usize, ts : usize, tl : usize, ts2 : usize, tl2 : usize, ts3 : usize, tl3 : usize) {
  cnt := ivec_len(ptr(insts))
  mut found := false
  for i in 0..cnt {
    e := ivec_at(ptr(insts), i)
    if e.gi == gi and inst_targ_eq(src, e.ts, e.tl, ts, tl) and inst_targ_eq(src, e.ts2, e.tl2, ts2, tl2) and inst_targ_eq(src, e.ts3, e.tl3, ts3, tl3) { found = true }
  }
  if not found { ivec_push(insts, Inst(gi = gi, ts = ts, tl = tl, ts2 = ts2, tl2 = tl2, ts3 = ts3, tl3 = tl3)) }
}

## The declared (base) type name of the ENCLOSING-fn parameter named (ns,nl) — resolves a value
## argument's type in the mono PRE-PASS (which has no per-fn slot context). `penv` is the enclosing
## fn's `params_head`. 0/0 when the name is not a parameter (a local — uninferable in the pre-pass).
param_type_of := fn(ns : usize, nl : usize, penv : usize, src : ptr(u8), a : rt::Arena) -> CSpan {
  mut pc := penv
  while pc != 0 {
    pm := deref(param_p(pc))
    if streq(src, pm.ns, pm.nl, ns, nl) { return base_type_name(src, pm.ts, pm.tl) }
    pc = pm.next
  }
  CSpan(s = 0, n = 0)
}

## The static length of a concrete `[T; N]` parameter, captured by the parser in `Param.pps`.
## `pmode == 1` also covers tuple parameters, but those have no captured array length (`pps == 0`),
## so returning zero keeps tuple and generic/slice shapes outside fixed-array-only lowerings.
fixed_array_param_len := fn(ns : usize, nl : usize, params : ptr(mut Param), src : ptr(u8)) -> usize {
  mut p := params
  while p != 0 {
    pm := deref(param_p(p))
    if streq(src, pm.ns, pm.nl, ns, nl) and pm.pmode == 1 { return pm.pps }
    p = pm.next
  }
  0
}

## IMPLICIT type-argument inference for the mono PRE-PASS: a generic call `f(v)` with the leading
## `T : type` OMITTED. Find `f`'s value parameter whose type IS its type-param, and return the
## corresponding call argument's DECLARED type in the enclosing params (`penv`) — e.g. `hash(key)`
## inside `hashmap_insert(K, V, …, key : K, …)` yields `K`, which the transitive worklist then
## substitutes to the concrete instance type (K→u64). 0/0 when not inferable. `src/` spells its
## type-args (never implicit) → never fires → fixpoint-neutral.
infer_implicit_pre := fn(gi : i64, args_head : ptr(mut Arg), penv : usize, decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) -> CSpan {
  gd := deref(decl_at(Decl, rt::vec_get(deref(decls), usize(gi))))
  mut tpn_s := 0
  mut tpn_l := 0
  mut pc := gd.params_head
  while pc != 0 {
    pm := deref(param_p(pc))
    if str_at((src + pm.ts), pm.tl) == "type" { tpn_s = pm.ns; tpn_l = pm.nl }
    pc = pm.next
  }
  if tpn_l == 0 { return CSpan(s = 0, n = 0) }
  mut j := 0
  pc = gd.params_head
  while pc != 0 {
    pm := deref(param_p(pc))
    if str_at((src + pm.ts), pm.tl) == "type" {
      pc = pm.next
    } else {
      bn := base_type_name(src, pm.ts, pm.tl)
      if streq(src, bn.s, bn.n, tpn_s, tpn_l) {
        ## Try EVERY value param whose type is T (mirrors `infer_implicit_targ`): a value arg that is
        ## a LOCAL (not in `penv`) is uninferable in the pre-pass → fall through to the next T-typed
        ## arg (e.g. `eq(existing, key)` resolves via the param `key`, not the local `existing`).
        ae := arg_expr_at(args_head, j, a)
        vn := var_name_span(ae)
        if vn.n != 0 {
          r := param_type_of(vn.s, vn.n, penv, src, a)
          if r.n != 0 { return r }
        }
        ## a struct/enum LITERAL arg carries its own type name — recover it so the instance is tagged
        ## with the right `T` (else `type_arg_at` leaves the bogus first-arg span, e.g. `alloc(ar, P(…))`
        ## mis-tags `T = ar`). Mirrors the same recovery in `infer_implicit_targ`.
        sli := struct_lit_info(ae)
        if sli.is_s { return type_lit_tag(decls, src, sli.ss, sli.sl) }
        eli := enum_lit_info(ae)
        if eli.is_e { return type_lit_tag(decls, src, eli.es, eli.el) }
        ## Types §7 — the COLLECT-side MIRROR of the emit side's `view_arg_ty_span`: a VIEW value
        ## argument (`str` / `Slice(T)`) types from its binding's ANNOTATION in the enclosing body, so
        ## the collected instance's tag matches the label the call site emits (`…__str`). Restricted to
        ## a VIEW type — every other implicit call keeps the `recv_is_container`-gated resolution below,
        ## so nothing else moves (fixpoint-safe).
        if COLLECT_BODY != 0 and vn.n != 0 {
          vlt := block_decl_type(COLLECT_BODY, vn.s, vn.n, src, decls, a)
          if vlt.n != 0 {
            if str_at((src + vlt.s), vlt.n) == "str" { return CSpan(s = vlt.s, n = vlt.n) }
          }
        }
      }
      j += 1
      pc = pm.next
    }
  }
  ## UFCS-RECEIVER FALLBACK (last resort, only after every param-typed arg failed above): when the callee
  ## takes a `ptr(...)` RECEIVER as its FIRST runtime (non-type) param — i.e. a UFCS method like
  ## `v.push(i)` desugared to `push(v, i)` — resolve a T-typed LOCAL value arg's type from the enclosing
  ## fn body (`COLLECT_BODY`, via `fn_local_type`). The ptr-receiver gate excludes by-value implicit calls
  ## (`hash(key)`/`eq(a,b)`) whose resolution is unchanged, so `src/` stays byte-identical (fixpoint-safe).
  ## RECEIVER = the first runtime param; a UFCS container method (`push`'s `in out v : Vec(T)`) has a
  ## STRUCT (or `ptr(...)`) receiver, whereas a by-value implicit call (`hash(key)`'s `key : K`) has the
  ## bare type-param as its first param → gate false → its resolution is untouched (fixpoint-safe).
  mut recv_is_container := false
  mut pcr := gd.params_head
  mut seen_val := false
  while pcr != 0 and seen_val == false {
    pmr := deref(param_p(pcr))
    if str_at((src + pmr.ts), pmr.tl) == "type" { pcr = pmr.next } else {
      seen_val = true
      rb := base_type_name(src, pmr.ts, pmr.tl)
      if str_at((src + pmr.ts), pmr.tl) == "ptr" or struct_decl_of(decls, src, rb.s, rb.n) >= 0 { recv_is_container = true }
    }
  }
  if COLLECT_BODY != 0 and recv_is_container {
    mut j2 := 0
    mut pc2 := gd.params_head
    while pc2 != 0 {
      pm2 := deref(param_p(pc2))
      if str_at((src + pm2.ts), pm2.tl) == "type" {
        pc2 = pm2.next
      } else {
        bn2 := base_type_name(src, pm2.ts, pm2.tl)
        if streq(src, bn2.s, bn2.n, tpn_s, tpn_l) {
          vn2 := var_name_span(arg_expr_at(args_head, j2, a))
          if vn2.n != 0 {
            lt := block_decl_type(COLLECT_BODY, vn2.s, vn2.n, src, decls, a)
            if lt.n != 0 { blt := base_type_name(src, lt.s, lt.n); if blt.n != 0 { return CSpan(s = blt.s, n = blt.n) } }
          }
        }
        j2 += 1
        pc2 = pm2.next
      }
    }
  }
  ## MULTI-WORD PAYLOAD RE-TAG (Hunk C) — the COLLECT-side MIRROR of `infer_implicit_targ`'s emit-side
  ## recovery, so the collected instance's label matches the emitted UFCS call. A UFCS `o.unwrap()` /
  ## `o.expect(m)` on a generic `Option(T)` (the receiver a VALUE arg, `T` omitted) whose payload `T`
  ## resolves to a `>= 2`-word aggregate is tagged by the CONCRETE payload type (`Rec`) — NOT the
  ## receiver name — so it shares the `unwrap__Rec` instance the prefix `unwrap(Rec, o)` produces.
  ## Resolve the receiver's full type with `recv_full_pre` (a concrete-return CALL local `o := getit()`
  ## resolves to `Option(Rec)` via `block_decl_type`), extract the payload type-arg at `T`'s position,
  ## and — gated to `>= 2` words, matching the emit gate byte-for-byte — return it. A scalar / 1-word
  ## payload returns 0/0 here (→ the caller keeps the receiver-name tag, byte-identical to before) →
  ## fixpoint-neutral.
  mut jm := 0
  mut pcm := gd.params_head
  while pcm != 0 {
    pmm := deref(param_p(pcm))
    if str_at((src + pmm.ts), pmm.tl) == "type" {
      pcm = pmm.next
    } else {
      if param_type_has_tparam(src, pmm.ts, pmm.tl, tpn_s, tpn_l) {
        rty := recv_full_pre(arg_expr_at(args_head, jm, a), decls, src, penv, a)
        if rty.n != 0 {
          pbn := base_type_name(src, pmm.ts, pmm.tl)
          mut kk := 0
          mut tpos := 0 - 1
          mut gk := true
          while gk {
            pta := typearg_at(src, pbn.s, pbn.n, usize(kk))
            if pta.n == 0 { gk = false }
            else { if streq(src, pta.s, pta.n, tpn_s, tpn_l) { tpos = i64(kk); gk = false } ; kk += 1 }
          }
          if tpos >= 0 {
            rbn := base_type_name(src, rty.s, rty.n)
            payl := typearg_at(src, rbn.s, rbn.n, usize(tpos))
            if payl.n != 0 and agg_words(decls, src, payl.s, payl.n, a) >= 2 {
              return CSpan(s = payl.s, n = payl.n)
            }
          }
        }
        ## CALL-RECEIVER UFCS (`find(1).unwrap()`) — the COLLECT-side MIRROR of `infer_implicit_targ`'s
        ## call-receiver branch (SAME tight gate: base match + a CONCRETE SCALAR payload), so the collected
        ## instance's label matches the emitted call and every other call-receiver shape is DEFERRED
        ## (collects nothing new → byte-identical). `recv_call_full_span` is 0/0 for a non-call receiver.
        rc := recv_call_full_span(arg_expr_at(args_head, jm, a), decls, src, a)
        if rc.n != 0 {
          pbb := base_type_name(src, pmm.ts, pmm.tl)
          rbb := base_type_name(src, rc.s, rc.n)
          if streq(src, pbb.s, pbb.n, rbb.s, rbb.n) {
            cpayl := recv_payload_targ(src, pmm.ts, pmm.tl, tpn_s, tpn_l, rc.s, rc.n)
            if cpayl.n != 0 and is_concrete_scalar_tag(decls, src, cpayl.s, cpayl.n, a) { return cpayl }
          }
        }
      }
      jm += 1
      pcm = pmm.next
    }
  }
  CSpan(s = 0, n = 0)
}

## The first-resolvable call argument's type in the mono PRE-PASS (a Var resolved against the enclosing
## params `penv`). Used to decide whether a call matches a CONCRETE overload (→ not the generic).
arg_type_name_pre := fn(args_head : ptr(mut Arg), penv : usize, src : ptr(u8), a : rt::Arena) -> CSpan {
  mut g := args_head
  while g != 0 {
    ga := deref(arg_p(g))
    vn := var_name_span(ga.e)
    if vn.n != 0 {
      t := param_type_of(vn.s, vn.n, penv, src, a)
      if t.n != 0 { return t }
    }
    g = ga.next
  }
  CSpan(s = 0, n = 0)
}

## Walk an expression, recording every generic-fn call's (generic-fn, typetag) instantiation.
## The deref-`match` is over the direct PARAM `e` (the lowerable shape) and is the recursion
## point. Mirrors `emit_rodata_expr`'s structure.
## The `next` handle of any statement (mirrors sema::stmt_next_at) — to walk a block for a local's
## declaring `Assign` in the pre-pass, where there are no frame slots to read a var's type from.
lower_stmt_nx := fn(h : usize, a : rt::Arena) -> usize {
  st := deref(stmt_p(Stmt, h))
  match st {
    Stmt::Assign(ns, nl, v, nx) => { nx }
    Stmt::While(c, b, nx) => { nx }
    Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { nx }
    Stmt::FieldPathAssign(pl, fpv, nx) => { nx }
    Stmt::Return(rv, nx) => { nx }
    Stmt::If(c, th, el, nx) => { nx }
    Stmt::Match(sc, ah, nx) => { nx }
    Stmt::For(ns, nl, lo, hi, b, nx) => { nx }
    Stmt::DerefAssign(p, v, nx) => { nx }
    Stmt::IndexAssign(b, i, v, nx) => { nx }
    Stmt::IndexFieldAssign(b, i, fs, fl, v, nx) => { nx }
    Stmt::Loop(b, nx) => { nx }
    Stmt::Unchecked(b, nx) => { nx }
    Stmt::AllocWith(ae, b, nx) => { nx }
    Stmt::Break(_bv, _bd, nx) => { nx }
    Stmt::Continue(_cd, nx) => { nx }
    Stmt::ExprStmt(e, nx) => { nx }
    Stmt::CompIf(c, th, el, nx) => { nx }
    Stmt::CompFor(vs, vl, iv, b, nx) => { nx }
    Stmt::CompForRange(vs, vl, lo, hi, b, nx) => { nx }
    Stmt::CompMatch(sc, ah, nx) => { nx }
  }
}

## ---- DEFER (Control Flow §9.3 / Memory §5.8) -----------------------------------------------------
## If statement handle `h` is a `defer <expr>` marker — an `ExprStmt` whose expr is a `Call` to the
## parser-synthesized head `__defer` with one argument — return the inner action expr handle (a
## `ptr(Expr)` as usize); else 0. The parser desugars `defer <expr>` to `__defer(<expr>)` (kept in the
## body so every other pass sees it as an ordinary call); the x86 lower is the sole consumer of the marker.
defer_marker_inner_h := fn(h : usize, src : ptr(u8), a : rt::Arena) -> usize {
  mut res := 0
  st := deref(stmt_p(Stmt, h))
  match st {
    Stmt::ExprStmt(e, nx) => {
      cp := call_parts(e)
      if cp.is_call and cp.cl == 7 and cp.na == 1 and str_at((src + cp.cs), 7) == "__defer" {
        res = unchecked bitcast(usize, arg_expr_at(cp.ah, 0, a))
      }
    }
    _ => {}
  }
  res
}

## If statement handle `h` is a `__deferblk()` marker — the HEAD of a `defer { … }` chain, an `ExprStmt`
## whose expr is a `Call` to the parser-synthesized head `__deferblk` with ZERO args — return the FIRST
## block statement's handle (the marker's `nx`, the chain body's head); else 0.
defer_blk_start_h := fn(h : usize, src : ptr(u8), a : rt::Arena) -> usize {
  mut res := 0
  st := deref(stmt_p(Stmt, h))
  match st {
    Stmt::ExprStmt(e, nx) => {
      cp := call_parts(e)
      if cp.is_call and cp.cl == 10 and cp.na == 0 and str_at((src + cp.cs), 10) == "__deferblk" {
        res = lower_stmt_nx(h, a)
      }
    }
    _ => {}
  }
  res
}

## Walk the chain forward from the first block statement `start` (a `defer_blk_start_h` result) until the
## terminating `__deferblkend()` marker (an `ExprStmt` whose expr is a `Call` to the parser-synthesized
## head `__deferblkend`, ZERO args); return that end-marker statement's handle. Panics if the chain runs
## out (a parser pairing invariant — fail loud, never emit a half-chain).
defer_blk_end_h := fn(start : usize, src : ptr(u8), a : rt::Arena) -> usize {
  mut s := start
  mut res := 0
  mut go := true
  while go {
    if s == 0 { panic("selfhost: defer — `__deferblkend` marker not found after a `__deferblk` (compiler invariant)") }
    st := deref(stmt_p(Stmt, s))
    mut end := false
    match st {
      Stmt::ExprStmt(e, nx) => {
        cp := call_parts(e)
        if cp.is_call and cp.cl == 13 and cp.na == 0 and str_at((src + cp.cs), 13) == "__deferblkend" { end = true }
      }
      _ => {}
    }
    if end { res = s ; go = false } else { s = lower_stmt_nx(s, a) }
  }
  res
}

## Is statement handle `h` a `__deferblkend()` end marker (an `ExprStmt` call to head `__deferblkend`, ZERO
## args)? Used by `emit_stmts` to skip a block-end reached after its block was consumed as ONE deferred unit.
is_defer_blk_end_h := fn(h : usize, src : ptr(u8), a : rt::Arena) -> bool {
  mut res := false
  st := deref(stmt_p(Stmt, h))
  match st {
    Stmt::ExprStmt(e, nx) => {
      cp := call_parts(e)
      if cp.is_call and cp.cl == 13 and cp.na == 0 and str_at((src + cp.cs), 13) == "__deferblkend" { res = true }
    }
    _ => {}
  }
  res
}

## Does the statement LIST `head` contain a top-level `defer` marker (either form)? A cheap linear prescan
## (no recursion — markers only occur at the block's own top level) used by `emit_stmts` to GATE the
## defer-ordering bookkeeping so a defer-free function (all of `src/`+`lib/`) pays no scan cost beyond this.
list_has_defer := fn(head : ptr(mut Stmt), src : ptr(u8), a : rt::Arena) -> bool {
  mut s := head
  mut res := false
  while s != 0 {
    if defer_marker_inner_h(unchecked bitcast(usize, s), src, a) != 0 { res = true }
    if defer_blk_start_h(unchecked bitcast(usize, s), src, a) != 0 { res = true }
    s = unchecked bitcast(ptr(mut Stmt), lower_stmt_nx(unchecked bitcast(usize, s), a))
  }
  res
}

## Does EXPR `e` contain a `defer` marker (either form) at ANY depth? A recursive walk mirroring
## `expr_has_try`, specialized so it descends into `Expr::Loop` (a loop in VALUE position CAN carry a
## `defer` in its statement body) — the only expression form that holds a statement list. A LAMBDA's
## body is NOT recursed: a defer inside a lambda belongs to that lambda's cleanup, not the enclosing
## fn. EXHAUSTIVE over `Expr` so the walk always terminates.
expr_have_defer := fn(e : ptr(Expr), src : ptr(u8), a : rt::Arena) -> bool {
  mut res := false
  match deref(e) {
    Expr::Loop(b) => { res = stmts_have_defer(b, src, a) }
    Expr::Bin(op, l, r) => { if expr_have_defer(l, src, a) or expr_have_defer(r, src, a) { res = true } }
    Expr::If(c, t, el) => { if expr_have_defer(c, src, a) or expr_have_defer(t, src, a) or expr_have_defer(el, src, a) { res = true } }
    Expr::Match(sc, ah) => { mut arm := ah ; while arm != 0 { am := deref(arm_p(arm)) ; if expr_have_defer(am.body, src, a) { res = true } ; arm = am.next } }
    Expr::Field(b, fs, fl) => { res = expr_have_defer(b, src, a) }
    Expr::Index(b, i) => { if expr_have_defer(b, src, a) or expr_have_defer(i, src, a) { res = true } }
    Expr::Deref(p) => { res = expr_have_defer(p, src, a) }
    Expr::AddrOf(p) => { res = expr_have_defer(p, src, a) }
    Expr::Unchecked(inner) => { res = expr_have_defer(inner, src, a) }
    Expr::Bitcast(inner, ts, tl) => { res = expr_have_defer(inner, src, a) }
    Expr::Slice(b, lo, hi) => { if expr_have_defer(b, src, a) or expr_have_defer(lo, src, a) or expr_have_defer(hi, src, a) { res = true } }
    Expr::Call(cs, cl, na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_have_defer(unchecked bitcast(ptr(Expr), ga.e), src, a) { res = true } ; g = ga.next } }
    Expr::StructLit(cs, cl, na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_have_defer(unchecked bitcast(ptr(Expr), ga.e), src, a) { res = true } ; g = ga.next } }
    Expr::EnumLit(es, el, vs, vl, na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_have_defer(unchecked bitcast(ptr(Expr), ga.e), src, a) { res = true } ; g = ga.next } }
    Expr::ArrayLit(na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_have_defer(unchecked bitcast(ptr(Expr), ga.e), src, a) { res = true } ; g = ga.next } }
    Expr::CompField(b, i) => { if expr_have_defer(b, src, a) or expr_have_defer(i, src, a) { res = true } }
    _ => {}
  }
  res
}

## Does ANY statement in `head` (at ANY nesting depth), OR any expression inside one (an `Expr::Loop` in
## value position can carry a `defer`), contain a `defer` marker (either form)? A recursive walker
## mirroring `stmts_have_compfor`'s shape, recursing into every nested statement block (while/loop/for/
## if/match-arm/unchecked/alloc-with and the comptime forms) AND scanning each statement's own
## expressions. Used by (a) `emit_fn` to set `cx.defer_active` and (b) the RA gate, so a fn whose defers
## live in NESTED blocks / an expression loop still takes the text (frame/drain) path.
## EXHAUSTIVE over `Stmt` so the walk always terminates.
stmts_have_defer := fn(head : ptr(mut Stmt), src : ptr(u8), a : rt::Arena) -> bool {
  mut s := head
  mut found := false
  while s != 0 {
    if defer_marker_inner_h(unchecked bitcast(usize, s), src, a) != 0 { found = true }
    if defer_blk_start_h(unchecked bitcast(usize, s), src, a) != 0 { found = true }
    if found == false {
      st := deref(stmt_p(Stmt, s))
      match st {
        Stmt::While(c, b, nx) => { if expr_have_defer(c, src, a) { found = true } ; if stmts_have_defer(b, src, a) { found = true } ; s = nx }
        Stmt::If(c, th, el, nx) => { if expr_have_defer(c, src, a) { found = true } ; if stmts_have_defer(th, src, a) { found = true } ; if stmts_have_defer(el, src, a) { found = true } ; s = nx }
        Stmt::Match(sc, ah, nx) => { if expr_have_defer(sc, src, a) { found = true } ; mut arm := ah ; while arm != 0 { am := deref(arm_p(arm)) ; if stmts_have_defer(am.body_stmts, src, a) { found = true } ; arm = am.next } ; s = nx }
        Stmt::For(fns, fnl, flo, fhi, fb, nx) => { if flo != 0 and expr_have_defer(flo, src, a) { found = true } ; if fhi != 0 and expr_have_defer(fhi, src, a) { found = true } ; if stmts_have_defer(fb, src, a) { found = true } ; s = nx }
        Stmt::Loop(b, nx) => { if stmts_have_defer(b, src, a) { found = true } ; s = nx }
        Stmt::Unchecked(b, nx) => { if stmts_have_defer(b, src, a) { found = true } ; s = nx }
        Stmt::AllocWith(ae, b, nx) => { if expr_have_defer(ae, src, a) { found = true } ; if stmts_have_defer(b, src, a) { found = true } ; s = nx }
        Stmt::CompIf(c, th, el, nx) => { if expr_have_defer(c, src, a) { found = true } ; if stmts_have_defer(th, src, a) { found = true } ; if stmts_have_defer(el, src, a) { found = true } ; s = nx }
        Stmt::CompFor(vs, vl, iv, b, nx) => { if stmts_have_defer(b, src, a) { found = true } ; s = nx }
        Stmt::CompForRange(vs, vl, lo, hi, b, nx) => { if lo != 0 and expr_have_defer(lo, src, a) { found = true } ; if hi != 0 and expr_have_defer(hi, src, a) { found = true } ; if stmts_have_defer(b, src, a) { found = true } ; s = nx }
        Stmt::CompMatch(sc, ah, nx) => { if expr_have_defer(sc, src, a) { found = true } ; mut car := ah ; while car != 0 { cam := deref(arm_p(car)) ; if stmts_have_defer(cam.body_stmts, src, a) { found = true } ; car = cam.next } ; s = nx }
        Stmt::Assign(ans, anl, v, nx) => { if expr_have_defer(v, src, a) { found = true } ; s = nx }
        Stmt::Return(rv, nx) => { if rv != 0 and expr_have_defer(rv, src, a) { found = true } ; s = nx }
        Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { if expr_have_defer(fv, src, a) { found = true } ; s = nx }
        Stmt::FieldPathAssign(pl, v, nx) => { if expr_have_defer(pl, src, a) or expr_have_defer(v, src, a) { found = true } ; s = nx }
        Stmt::DerefAssign(p, v, nx) => { if expr_have_defer(p, src, a) or expr_have_defer(v, src, a) { found = true } ; s = nx }
        Stmt::IndexAssign(b, i, v, nx) => { if expr_have_defer(b, src, a) or expr_have_defer(i, src, a) or expr_have_defer(v, src, a) { found = true } ; s = nx }
        Stmt::IndexFieldAssign(b, i, fs, fl, v, nx) => { if expr_have_defer(b, src, a) or expr_have_defer(i, src, a) or expr_have_defer(v, src, a) { found = true } ; s = nx }
        Stmt::Break(bv, bd, nx) => { if bv != 0 and expr_have_defer(bv, src, a) { found = true } ; s = nx }
        Stmt::Continue(cd, nx) => { s = nx }
        Stmt::ExprStmt(e, nx) => { if expr_have_defer(e, src, a) { found = true } ; s = nx }
      }
    } else {
      ## Once a defer marker is found at this level, stop recursing into nested children (early exit)
      ## but STILL advance the top-level scan — otherwise `s` pins on the marker node and loops forever.
      s = unchecked bitcast(ptr(mut Stmt), lower_stmt_nx(unchecked bitcast(usize, s), a))
    }
  }
  found
}

## Does expr `e` contain a `?` (try) operator anywhere in its tree? Used ONLY to classify a statement as
## early-exit-capable for the defer-ordering guard (dormant unless a function has a defer marker), so a
## thorough recursive walk is fine (no hot-path cost). A `?` performs an early return running defers.
expr_has_try := fn(e : ptr(Expr)) -> bool {
  mut res := false
  match deref(e) {
    Expr::Try(inner) => { res = true }
    Expr::Bin(op, l, r) => { if expr_has_try(l) or expr_has_try(r) { res = true } }
    Expr::If(c, t, el) => { if expr_has_try(c) or expr_has_try(t) or expr_has_try(el) { res = true } }
    Expr::Field(b, fs, fl) => { res = expr_has_try(b) }
    Expr::Index(b, i) => { if expr_has_try(b) or expr_has_try(i) { res = true } }
    Expr::Deref(p) => { res = expr_has_try(p) }
    Expr::AddrOf(p) => { res = expr_has_try(p) }
    Expr::Unchecked(inner) => { res = expr_has_try(inner) }
    Expr::Bitcast(inner, ts, tl) => { res = expr_has_try(inner) }
    Expr::Slice(b, lo, hi) => { if expr_has_try(b) or expr_has_try(lo) or expr_has_try(hi) { res = true } }
    Expr::Call(cs, cl, na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_has_try(unchecked bitcast(ptr(Expr), ga.e)) { res = true } ; g = ga.next } }
    Expr::StructLit(cs, cl, na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_has_try(unchecked bitcast(ptr(Expr), ga.e)) { res = true } ; g = ga.next } }
    Expr::EnumLit(es, el, vs, vl, na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_has_try(unchecked bitcast(ptr(Expr), ga.e)) { res = true } ; g = ga.next } }
    Expr::ArrayLit(na, ah) => { mut g := ah ; while g != 0 { ga := deref(arg_p(g)) ; if expr_has_try(unchecked bitcast(ptr(Expr), ga.e)) { res = true } ; g = ga.next } }
    _ => {}
  }
  res
}

## Can statement `h` cause an early exit of the enclosing scope (a `return`/`break`/`continue`/`?`, or a
## nested branch/loop that might)? Used ONLY (gated on a function having a defer marker) to reject a
## `defer` that follows such a statement — the unconditional epilogue emission would otherwise run a
## cleanup on a path where the `defer` was never actually reached. Conservative: unknown/other kinds → true
## (fail-loud rather than risk a mis-registered cleanup); only the clearly-straight-line statement kinds
## WITHOUT a `?` are safe (false).
stmt_may_early_exit := fn(h : usize, src : ptr(u8), a : rt::Arena) -> bool {
  mut res := true
  st := deref(stmt_p(Stmt, h))
  match st {
    Stmt::Assign(ns, nl, v, nx) => { res = expr_has_try(v) }
    Stmt::ExprStmt(e, nx) => { res = expr_has_try(e) }
    Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { res = expr_has_try(fv) }
    Stmt::FieldPathAssign(pl, v, nx) => { res = expr_has_try(pl) or expr_has_try(v) }
    Stmt::DerefAssign(p, v, nx) => { res = expr_has_try(p) or expr_has_try(v) }
    Stmt::IndexAssign(b, i, v, nx) => { res = expr_has_try(b) or expr_has_try(i) or expr_has_try(v) }
    Stmt::IndexFieldAssign(b, i, fs, fl, v, nx) => { res = expr_has_try(b) or expr_has_try(i) or expr_has_try(v) }
    _ => {}
  }
  res
}

## Emit the pending `defer` actions (Control Flow §9.3) whose index is at/above `boundary` — the frames
## draining at a block's fall-through exit (boundary = that frame's push-time `cx.defer_n`), the 
## early-exit drains of `return`/`break`/`continue`/`?`, and the epilogue (boundary 0, EVERYTHING the fn
## still owes). LIFO: the highest-index (most recently registered) runs first. THE CHAIN CONSUMES the
## ledger — it decrements `cx.defer_n` as it emits and ends with `cx.defer_n == boundary` — so a
## block-defer's own statements (emitted via `emit_stmts`) see a consistent ledger. A call to the chain
## emits NOTHING when the block owed nothing (`cx.defer_n <= boundary`). The cleanup actions are calls
## that clobber the return registers, so the delivered result (%rax, and %rdx for a 2-register aggregate/
## str return; the float return's bits also live in %rax here) is saved across them (2 pushes keep 16-byte
## stack alignment).
emit_defer_chain := fn(in out sb : strbuf::StrBuf, cx : ptr(LCtx), a : rt::Arena, in out nl : usize, boundary : usize) {
  if cx.defer_n <= boundary { return }
  push_str(sb, "  pushq %rax\n  pushq %rdx\n")
  while cx.defer_n > boundary {
    cx.defer_n = cx.defer_n - 1
    j := cx.defer_n
    if cx.defer_blk[j] == 1 {
      hd := unchecked bitcast(ptr(mut Stmt), cx.defer_inner[j])
      ## Run the block's statements AS A UNIT, stopping at its `__deferblkend` marker (`cx.ir_stop`):
      ## the block's statement `next` chain continues past the end marker into the ENCLOSING statement
      ## list, so an un-rebounded `emit_stmts` would spill into the rest of the function (re-emitting a
      ## trailing `return`/its jump). Rebound to the end marker; the deferred unit is exactly the block.
      ostop := cx.ir_stop
      cx.ir_stop = defer_blk_end_h(unchecked bitcast(usize, hd), cx.src, a)
      emit_stmts(hd, sb, cx, nl)          ## run the block's statements (an ordinary stmt list)
      cx.ir_stop = ostop
    } else {
      inner := unchecked bitcast(ptr(Expr), cx.defer_inner[j])
      emit_gas(inner, sb, cx, a, nl)      ## the cleanup action leaves one value on the stack
      push_str(sb, "  popq %rax\n")       ## discard it (a defer's result is ignored, Memory §5.8)
    }
  }
  push_str(sb, "  popq %rdx\n  popq %rax\n")
  if cx.ret_float { push_str(sb, "  movq %rax, %xmm0\n") }
}

## --- DEAD-CODE ELIMINATION (reachability) ------------------------------------------------------
## An ambiently-injected stdlib module ships its WHOLE surface, but a program calls only a subset;
## a non-generic pub fn using a construct the lean lower can't yet compile (`alloc::vec::split`'s
## `Slice`/`Vec` type-fn constructors, a fn-value param call, a bogus derived typetag) would emit an
## undefined-symbol reference and break the link even though the program never calls it. So the
## `.text` pass emits only REACHABLE non-generic fns: a marker word per decl, closed over the call
## graph from `main` + every generic fn (a generic emits only per collected instance, but scanning
## its body as a root only ever OVER-keeps a non-generic fn it names — safe). A "call edge" is any
## callee NAME appearing at a `Call` (tail name), an `EnumLit` (UFCS `x.f(a)` parses as an EnumLit),
## or a `Field` (a zero-arg `x.f`); `mark_name` marks EVERY runtime fn or kind-4 `@abi(syscall)` decl
## of that name (module-agnostic over-approximation — keeping a same-named fn is safe, dropping a live one is not).
## `?`/`for`/
## operators are INLINED by the lean lower (no synthesized named call), so textual/AST call names
## are the complete edge set. `src/` has no dead non-generic fn and takes no fn address, so the
## reachable set is all of `src/` → the `.text` output is byte-identical → the fixpoint is unchanged.

## Read / write the reachability marker word for decl `i` in the bump-backed array at `rb`.
rb_get := fn(rb : usize, i : usize) -> usize {
  p : ptr(usize) = unchecked bitcast(ptr(usize), rb + i * 8)
  return deref(p)
}
rb_set := fn(rb : usize, i : usize, v : usize) {
  p : ptr(mut usize) = unchecked bitcast(ptr(mut usize), rb + i * 8)
  deref(p) = v
}

## Mark every runtime fn or bodyless kind-4 `@abi(syscall)` declaration named `[ns, ns+nl)` reachable
## in the `rb` marker array (word per decl).
## PERF: `mark_name` scans all decls marking EVERY runtime fn/kind-4 decl of a name reachable — idempotent, and
## called once per reachable call-site (so a popular callee's name is re-scanned from many sites). A
## 512-bucket "name already scanned" cache skips the redundant re-scans: the first scan marks the name's
## decls, later calls skip (the decls stay marked). The cache includes the current caller module because
## a bare call should prefer a same-module declaration when one exists; otherwise it falls back to the
## historical basename over-approximation for imports whose defining module is not recoverable here.
mut _mn_s : [usize; 512] = [0; 512]
mut _mn_n : [usize; 512] = [0; 512]
mut _mn_src : [usize; 512] = [0; 512]
mut _mn_ms : [usize; 512] = [0; 512]
mut _mn_ml : [usize; 512] = [0; 512]
mut _mark_ms : usize = 0
mut _mark_ml : usize = 0
mark_name := fn(rb : usize, decls : ptr(rt::Vec), src : ptr(u8), ns : usize, nl : usize) {
  h := _lnhash(src, ns, nl)
  if _mn_n[h] == nl and _mn_src[h] == src and _mn_ms[h] == _mark_ms and _mn_ml[h] == _mark_ml and streq(src, _mn_s[h], _mn_n[h], ns, nl) { return }
  cnt := rt::vec_len(deref(decls))
  th := name_hash(src, ns, nl)
  ## When the caller module contains a same-named declaration, that is the resolved bare call. Check
  ## this before marking anything so a local hit prevents a same-tail declaration in another module
  ## from being retained merely because the old basename approximation saw the same text.
  ## The best rank Modules §3 gives this name from the marking module: the caller's own module (or a
  ## last-segment lib path) outranks its ANCESTORS, nearest first, and -1 means nothing on the chain
  ## declares it. This replaces a plain "is there a same-named decl in my own module" test so DCE keeps
  ## exactly the declaration the resolver emits a call to — otherwise a descendant's call to its
  ## ancestor's fn also retained every unrelated module's same-named private duplicate. `src/`'s modules
  ## are all top-level, so a rank of `ml + 1` (own module) or -1 (nothing) are the only outcomes there
  ## and this is byte-identical for the self-build; the fixpoint is the check.
  mut bestr := 0 - 1
  if _mark_ml != 0 {
    mut q := dni_lo(cnt, th)
    qe := dni_hi(cnt, th)
    while q < qe {
      j := dni_at(cnt, q)
      q += 1
      if dnh_skip(cnt, j, th) == false {
        d := deref(decl_at(Decl, rt::vec_get(deref(decls), j)))
        if (d.kind == 1 or d.kind == 4) and streq(src, d.name_start, d.name_len, ns, nl) {
          r := callee_mod_rank(src, d.mod_start, d.mod_len, _mark_ms, _mark_ml)
          if r > bestr { bestr = r }
        }
      }
    }
  }
  mut k := dni_lo(cnt, th)
  ke := dni_hi(cnt, th)
  while k < ke {
    j := dni_at(cnt, k)
    if dnh_skip(cnt, j, th) == false {
      d := deref(decl_at(Decl, rt::vec_get(deref(decls), j)))
      if (d.kind == 1 or d.kind == 4) and streq(src, d.name_start, d.name_len, ns, nl) and (bestr < 0 or callee_mod_rank(src, d.mod_start, d.mod_len, _mark_ms, _mark_ml) == bestr) {
        rb_set(rb, j, 1)
      }
    }
    k += 1
  }
  if nl != 0 { _mn_s[h] = ns; _mn_n[h] = nl; _mn_src[h] = src; _mn_ms[h] = _mark_ms; _mn_ml[h] = _mark_ml }
}
## Mark a qualified callee against its defining module and tail name. The ordinary `mark_name` path
## intentionally over-approximates bare calls, but applying it to `std::os::sys_mmap` also marks a
## test-only `main::sys_mmap` because both declarations share the tail. Qualified calls already carry
## their module head in the source span, so use the same segment-aware matcher as lowering and only
## fall back to the basename scan when the head cannot be resolved (aliases/unknown imports).
mark_qualified_name := fn(rb : usize, decls : ptr(rt::Vec), src : ptr(u8), cs : usize, cl : usize) -> bool {
  cp := colon_pos(src, cs, cl)
  if cp < 0 { return false }
  hl := usize(cp)
  ts := cs + hl + 2
  tl := cl - hl - 2
  if tl == 0 { return false }
  idx := callee_decl_idx_qual(decls, src, ts, tl, cs, hl, _mark_ms, _mark_ml)
  if idx < 0 { return false }
  rb_set(rb, usize(idx), 1)
  true
}
## Mark every kind-1 fn whose name is the literal `nm` reachable — for the `{}`-template `print`
## desugar, whose emitted callees (`io::print`, `print_one_int`) are not present in the AST for the
## normal call-graph marking to find.
mark_lit := fn(rb : usize, decls : ptr(rt::Vec), src : ptr(u8), nm : str) {
  cnt := rt::vec_len(deref(decls))
  th := str_name_hash(nm)
  mut k := dni_lo(cnt, th)
  ke := dni_hi(cnt, th)
  while k < ke {
    j := dni_at(cnt, k)
    if dnh_skip(cnt, j, th) == false {
      d := deref(decl_at(Decl, rt::vec_get(deref(decls), j)))
      if d.kind == 1 and str_at((src + d.name_start), d.name_len) == nm { rb_set(rb, j, 1) }
    }
    k += 1
  }
}
## DCE — descend into a routed USER-TYPE operator's body. `a <op> b` over a user struct/enum routes to
## a glyph-`op` fn whose body is EXPANDED at the site (`@inline` or, via the `operator_decl_idx`
## fallback, a plain non-inline operator), so the reachability walk (which sees only the `Bin` node,
## not the expanded body) never marks the calls INSIDE it — e.g. u128's `/`/`%` delegate to the plain
## `udiv128`/`umod128`, which would then be pruned (undefined symbol at link). Walk the body of every
## 2-arity glyph-`op` fn whose FIRST-PARAM type is a user struct/enum, so a plain helper it calls
## survives. GATED to user struct/enum operands: num.al/cmp.al operators are over BUILT-IN types
## (u64/i64/f64/…) → excluded → the self-build's reachable set is byte-identical (fixpoint-neutral);
## only user-type operators (u128 in an ambient single-file compile) are walked.
mut _op_walk_active : bool = false
mark_op_body_helpers := fn(op : i64, rb : usize, decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) {
  sym := op_symbol(op)
  if sym == "" { return }
  ## RE-ENTRANCY GUARD: an operator body routes to further operators on its own fields (u128 `<`'s body
  ## is `a.hi < b.hi or …`), so a naive descent would re-enter the SAME operator body forever. Walk one
  ## level of operator bodies only — the nested operators' plain helpers (if any) are reached when the
  ## fixpoint walks the plain fn that names them, not through a second operator-body hop.
  if _op_walk_active { return }
  _op_walk_active = true
  cnt := rt::vec_len(deref(decls))
  th := str_name_hash(sym)
  mut jw := dni_lo(cnt, th)
  jwe := dni_hi(cnt, th)
  while jw < jwe {
    i := dni_at(cnt, jw)
    jw += 1
    if dnh_skip(cnt, i, th) == false {
    d := deref(decl_get(decls, i))
    ## TYP-10 slice B: a GENERIC operator (a comptime-VALUE-param glyph fn, e.g. `uint(N)`'s `+`)
    ## is expanded at the site exactly like a concrete one, so its body is walked here too — the
    ## former `is_generic == false` gate is relaxed for it. Its first-param discriminator is the
    ## first VALUE param (`uint` in `uint(N)`), not the comptime `N : u64`. The span rides SCALARS
    ## (`fps`/`fpn`) — a struct local reassigned in a loop is a lean-lower miscompile landmine.
    mut fps := 0
    mut fpn := 0
    if d.is_fn and d.is_generic == false and d.arity == 2 and str_at((src + d.name_start), d.name_len) == sym {
      fp0 := first_param_type_span(d, a, src)
      fps = fp0.s
      fpn = fp0.n
    }
    if d.is_fn and d.is_generic and str_at((src + d.name_start), d.name_len) == sym {
      fvg := first_value_param_type_span(d, src, a)
      if fvg.n != 0 and struct_decl_of(decls, src, fvg.s, fvg.n) >= 0 { fps = fvg.s; fpn = fvg.n }
    }
    if fpn != 0 {
      fpb := base_type_name(src, fps, fpn)
      if struct_decl_of(decls, src, fpb.s, fpb.n) >= 0 or enum_decl_of(decls, src, fpb.s, fpb.n) >= 0 {
        ## walk BOTH the statement list and the tail-expression value (an operator body like
        ## `{ udiv128(a, b) }` is a single tail expr stored in `d.value`) — mirroring the reachability
        ## fixpoint driver, which walks both `body_stmts` and `value` of a reachable fn.
        mark_calls_stmts(d.body_stmts, rb, decls, src, a)
        mark_calls_expr(d.value, rb, decls, src, a)
      }
    }
    }
  }
  _op_walk_active = false
}

mark_calls_expr := fn(e : ptr(Expr), rb : usize, decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) {
  match deref(e) {
    Expr::Num(v, s, n) => {}
    ## a bare identifier in value position may be a fn-VALUE (a function used as a value, e.g.
    ## `apply(add1, …)` / `sort_by(xs, cmp)`) — mark any fn of that name reachable so DCE keeps it.
    ## (A non-fn local name matches no fn decl → harmless.)
    Expr::Var(s, n) => { mark_name(rb, decls, src, s, n) }
    ## FN-6 — a code pointer to a LIFTED lambda: mark its synthetic decl (SENTINEL name_len == 0, whose
    ## name_start is the lambda's `fn` offset == fnpos) reachable, so DCE keeps it (the lambda is called
    ## INDIRECTLY, so no callee-name marks it). The reachability fixpoint then walks its body.
    Expr::FnRef(fnpos, fms, fml) => {
      mut j := 0
      cntl := rt::vec_len(deref(decls))
      while j < cntl {
        dj := deref(decl_get(decls, j))
        if dj.name_len == 0 and dj.name_start == fnpos { rb_set(rb, j, 1) }
        j = j + 1
      }
    }
    Expr::Bin(op, l, r) => {
      mark_calls_expr(l, rb, decls, src, a)
      mark_calls_expr(r, rb, decls, src, a)
      ## a routed USER-TYPE operator's body is inlined (invisible to this call-graph walk) — descend
      ## into it so a plain helper it delegates to (u128's `udiv128`/`umod128`) survives DCE.
      mark_op_body_helpers(op, rb, decls, src, a)
    }
    Expr::If(c, t, f) => {
      mark_calls_expr(c, rb, decls, src, a)
      mark_calls_expr(t, rb, decls, src, a)
      mark_calls_expr(f, rb, decls, src, a)
    }
    Expr::Match(scrut, head) => {
      mark_calls_expr(scrut, rb, decls, src, a)
      mut arm := head
      while arm != 0 {
        am := deref(arm_p(arm))
        mark_calls_expr(am.body, rb, decls, src, a)
        mark_calls_stmts(am.body_stmts, rb, decls, src, a)
        arm = am.next
      }
    }
    Expr::Call(cs, cl, nargs, args_head) => {
      if colon_pos(src, cs, cl) >= 0 {
        ## Modules §3 — a QUALIFIED call names its module outright, so the callee must be `pub` unless
        ## the calling module is that module or one nested within it. `_mark_ms`/`_mark_ml` is the
        ## module of the declaration whose body this walk is in, which is the exact naming module.
        ## (Inert inside `mark_op_body_helpers`, which re-walks another declaration's body without
        ## re-publishing its module — it would blame the wrong one.)
        if _op_walk_active == false { vis_check_qual(decls, src, cs, cl, _mark_ms, _mark_ml, 1, 4, "function") }
        if mark_qualified_name(rb, decls, src, cs, cl) == false {
          nm := callee_name_span(src, cs, cl)
          mark_name(rb, decls, src, nm.s, nm.n)
        }
      } else {
        nm := callee_name_span(src, cs, cl)
        mark_name(rb, decls, src, nm.s, nm.n)
      }
      ## USER CONVERSION-CONSTRUCTOR `T(v)` (Types §4.6 / TYP-6): the callee `T` names no fn, so
      ## `mark_name` marked nothing — but an in-scope `@convert fn(…) -> T` is the real callee. Mark it
      ## reachable so DCE keeps it (the reachability fixpoint then walks its body). Neutral: every
      ## `src/lib` call yields -1 here (`convert_callee_idx` filters builtin/brand) → reachable set unchanged.
      cvm := convert_callee_idx(decls, src, cs, cl)
      if cvm >= 0 { rb_set(rb, usize(cvm), 1) }
      ## A `@convert` whose TARGET is a BUILTIN-conv name (`u64(structval)` → `@convert fn(U) -> u64`):
      ## `convert_callee_idx` bailed above (builtin name), so mark it via the incl-builtin lookup — else
      ## the aggregate-operand conversion routes to an un-emitted symbol (undefined ref at link). Neutral:
      ## no `src/lib` @convert returns a builtin name, so this marks nothing extra on the self-host tree.
      if cvm < 0 and conv_kind(str_at((src + cs), cl)) >= 0 {
        acvm := convert_callee_idx_incl_builtin(decls, src, cs, cl)
        if acvm >= 0 { rb_set(rb, usize(acvm), 1) }
      }
      ## §8.1 `@require(pred) T`: a construction `T(v)` of a require-typed alias emits a synthetic
      ## `call <pred>` in the checked trap (not present in the AST as a call), so the call-graph walk
      ## above did not mark the predicate fn — mark it here so DCE keeps it (else an undefined ref at
      ## link). Neutral: `require_pred` returns `{0,0}` for every non-require callee → nothing extra
      ## marked on the self-host tree (no `@require` in src/lib → the reachable set is byte-identical).
      rqp := require_pred(decls, src, cs, cl)
      if rqp.n != 0 { mark_name(rb, decls, src, rqp.s, rqp.n) }
      mut g := args_head
      while g != 0 {
        ga := deref(arg_p(g))
        mark_calls_expr(ga.e, rb, decls, src, a)
        g = ga.next
      }
    }
    Expr::StructLit(cs, cl, nf, fhead) => {
      ## Modules §3 for a qualified CONSTRUCTION `geo::Pt(x = …)` — the type is a declaration like any
      ## other, so naming a non-`pub` one from outside its subtree is the same violation as a call.
      if _op_walk_active == false { vis_check_type_span(decls, src, cs, cl, _mark_ms, _mark_ml) }
      mut g := fhead
      while g != 0 {
        ga := deref(arg_p(g))
        mark_calls_expr(ga.e, rb, decls, src, a)
        g = ga.next
      }
    }
    Expr::Field(base, fs, fl) => {
      mark_name(rb, decls, src, fs, fl)
      mark_calls_expr(base, rb, decls, src, a)
    }
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      ## Modules §3 for a qualified enum literal `geo::Color.red` — same rule, same reject.
      if _op_walk_active == false { vis_check_type_span(decls, src, es, el, _mark_ms, _mark_ml) }
      mark_name(rb, decls, src, vs, vl)
      mut g := phead
      while g != 0 {
        ga := deref(arg_p(g))
        mark_calls_expr(ga.e, rb, decls, src, a)
        g = ga.next
      }
    }
    Expr::AddrOf(p) => { mark_calls_expr(p, rb, decls, src, a) }
    Expr::Deref(p) => { mark_calls_expr(p, rb, decls, src, a) }
    Expr::ArrayLit(nel, ehead) => {
      mut g := ehead
      while g != 0 {
        ga := deref(arg_p(g))
        mark_calls_expr(ga.e, rb, decls, src, a)
        g = ga.next
      }
    }
    Expr::Index(base, idx) => {
      mark_calls_expr(base, rb, decls, src, a)
      mark_calls_expr(idx, rb, decls, src, a)
    }
    Expr::Try(inner) => { mark_calls_expr(inner, rb, decls, src, a) }
    Expr::Loop(body) => { mark_calls_stmts(body, rb, decls, src, a) }
    Expr::Unchecked(inner) => { mark_calls_expr(inner, rb, decls, src, a) }
    Expr::Bitcast(inner, _bcs, _bcl) => { mark_calls_expr(inner, rb, decls, src, a) }
    Expr::Slice(base, lo, hi) => {
      mark_calls_expr(base, rb, decls, src, a)
      mark_calls_expr(lo, rb, decls, src, a)
      mark_calls_expr(hi, rb, decls, src, a)
    }
    Expr::StrLit(ss, sl, lbl) => {}
  }
}

mark_calls_stmts := fn(head : ptr(mut Stmt), rb : usize, decls : ptr(rt::Vec), src : ptr(u8), a : rt::Arena) {
  mut s := head
  while s != 0 {
    st := deref(stmt_p(Stmt, s))
    match st {
      Stmt::Assign(ns, nl, v, nx) => { mark_calls_expr(v, rb, decls, src, a); s = nx }
      Stmt::While(c, b, nx) => {
        mark_calls_expr(c, rb, decls, src, a)
        mark_calls_stmts(b, rb, decls, src, a)
        s = nx
      }
      Stmt::Loop(b, nx) => {
        mark_calls_stmts(b, rb, decls, src, a)
        s = nx
      }
      Stmt::Unchecked(b, nx) => {
        mark_calls_stmts(b, rb, decls, src, a)
        s = nx
      }
      Stmt::AllocWith(ae, b, nx) => {
        mark_calls_expr(ae, rb, decls, src, a)
        mark_calls_stmts(b, rb, decls, src, a)
        s = nx
      }
      Stmt::Break(_bv, _bd, nx) => { s = nx }
      Stmt::Continue(_cd, nx) => { s = nx }
      Stmt::ExprStmt(e, nx) => {
        ## a `{}`-template variadic `print` emits `io::print` / `print_one_int` by mangled label (not
        ## in the AST) — mark them reachable so they are emitted (print_one is a generic root already).
        ecp := call_parts(e)
        if ecp.is_call and variadic_print_target(decls, src, ecp.cs, ecp.cl, ecp.na, 0, 0, a) >= 0 {
          mark_lit(rb, decls, src, "print")
          mark_lit(rb, decls, src, "print_one_int")
          mark_lit(rb, decls, src, "print_one_float")
        }
        mark_calls_expr(e, rb, decls, src, a)
        s = nx
      }
      Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { mark_calls_expr(fv, rb, decls, src, a); s = nx }
      Stmt::FieldPathAssign(pl, fpv, nx) => { mark_calls_expr(fpv, rb, decls, src, a); s = nx }
      Stmt::Return(rv, nx) => { mark_calls_expr(rv, rb, decls, src, a); s = nx }
      Stmt::If(c, th, el, nx) => {
        mark_calls_expr(c, rb, decls, src, a)
        mark_calls_stmts(th, rb, decls, src, a)
        mark_calls_stmts(el, rb, decls, src, a)
        s = nx
      }
      Stmt::Match(sc, ah, nx) => {
        mark_calls_expr(sc, rb, decls, src, a)
        mut arm := ah
        while arm != 0 {
          am := deref(arm_p(arm))
          mark_calls_stmts(am.body_stmts, rb, decls, src, a)
          arm = am.next
        }
        s = nx
      }
      Stmt::For(fns, fnl, flo, fhi, fb, nx) => {
        mark_calls_expr(flo, rb, decls, src, a)
        if unchecked bitcast(usize, fhi) != 0 { mark_calls_expr(fhi, rb, decls, src, a) }   ## fhi==0 = for-over-iterable
        mark_calls_stmts(fb, rb, decls, src, a)
        s = nx
      }
      Stmt::CompIf(ccond, cthen, celse, nx) => {
        mark_calls_stmts(cthen, rb, decls, src, a)
        mark_calls_stmts(celse, rb, decls, src, a)
        s = nx
      }
      Stmt::CompFor(cvs, cvl, civ, cb, nx) => {
        mark_calls_stmts(cb, rb, decls, src, a)
        s = nx
      }
      Stmt::CompForRange(crvs, crvl, crlo, crhi, crb, nx) => {
        mark_calls_stmts(crb, rb, decls, src, a)
        s = nx
      }
      Stmt::CompMatch(cmsc, cmah, nx) => {
        mut car := cmah
        while car != 0 { cam := deref(arm_p(car)); mark_calls_stmts(cam.body_stmts, rb, decls, src, a); car = cam.next }
        s = nx
      }
      Stmt::DerefAssign(ptr, val, nx) => {
        mark_calls_expr(ptr, rb, decls, src, a)
        mark_calls_expr(val, rb, decls, src, a)
        s = nx
      }
      Stmt::IndexAssign(ib, ii, iv, nx) => {
        mark_calls_expr(ib, rb, decls, src, a)
        mark_calls_expr(ii, rb, decls, src, a)
        mark_calls_expr(iv, rb, decls, src, a)
        s = nx
      }
      Stmt::IndexFieldAssign(fia, fii, ifs, ifl, fiv, nx) => {
        mark_calls_expr(fia, rb, decls, src, a)
        mark_calls_expr(fii, rb, decls, src, a)
        mark_calls_expr(fiv, rb, decls, src, a)
        s = nx
      }
    }
  }
}

## Emit a whole program: a `.rodata` section with every string literal's bytes (walked from
## the decls), then a `.text` section with a function definition for each kind-1 (fn) decl;
## value/struct/enum decls carry no code here and are skipped. Each fn's labels share the `nl`
## counter so two functions never collide. `mar` is a mutable arena (per-fn slot maps); `a` is
## the AST arena. The per-fn inputs are bundled into one `PCtx` passed by pointer (keeps
## `emit_fn`'s `in out nl` in an argument register).
##
## GENERICS tier — MONOMORPHIZATION: a generic fn (its first param `T : type`) emits NO direct
## definition; instead a pre-pass collects every distinct (generic-fn, concrete-type) pair seen
## at a call site (`collect_insts_*`), and one specialized copy is emitted per pair (the label
## `<module>__<fn>__<typetag>`, the leading type parameter erased). An uninstantiated generic
## emits nothing. With word-sized type arguments every instance's body is identical — the
## MECHANISM (a distinct mangled symbol per concrete type, the call routed to it, the type
## argument erased from the registers) is the milestone.
## Emit a SYSCALL-ABI fn (kind 4, `@abi(syscall)`) as a trampoline from the System V calling
## convention to the Linux syscall convention. The caller invokes it like any fn (SysV: param 0
## in %rdi, param 1 in %rsi, …, param 6 on the stack at 8(%rsp)). The trampoline moves each
## param into its SYSCALL register — param 0 (the syscall number) → %rax, then args →
## %rdi/%rsi/%rdx/%r10/%r8/%r9 — issues `syscall` (result already in %rax), and `ret`s. The moves
## are ordered so each source register is read before it is overwritten as a destination (the
## SysV and syscall arg registers overlap): num←rdi, rdi←rsi, rsi←rdx, rdx←rcx, r10←r8, r8←r9,
## r9←8(%rsp). `arity` is the param count (incl. the number); emit only the moves the fn needs.
emit_syscall_fn := fn(d : Decl, src : ptr(u8), in out sb : strbuf::StrBuf) {
  ## Private syscall trampolines are local in a combined artifact. Keep explicit exports global here:
  ## this older bodyless path has no separate exact-name alias yet, so retaining its prior linkage is
  ## safer than silently hiding an `@export` declaration while that unsupported corner is completed.
  exn := export_name(src, d.name_start, d.name_len)
  if mangled_symbol_is_global(src, d) or exn.n != 0 {
    push_str(sb, ".globl ")
    emit_mangled_def(sb, src, d.mod_start, d.mod_len, d.name_start, d.name_len)
    push_str(sb, "\n")
  }
  emit_mangled_def(sb, src, d.mod_start, d.mod_len, d.name_start, d.name_len)
  push_str(sb, ":\n")
  n := d.arity
  if n >= 1 { push_str(sb, "  movq %rdi, %rax\n") }       ## syscall number
  if n >= 2 { push_str(sb, "  movq %rsi, %rdi\n") }       ## arg 0
  if n >= 3 { push_str(sb, "  movq %rdx, %rsi\n") }       ## arg 1
  if n >= 4 { push_str(sb, "  movq %rcx, %rdx\n") }       ## arg 2
  if n >= 5 { push_str(sb, "  movq %r8, %r10\n") }        ## arg 3 (syscall uses %r10, not %rcx)
  if n >= 6 { push_str(sb, "  movq %r9, %r8\n") }         ## arg 4
  if n >= 7 { push_str(sb, "  movq 8(%rsp), %r9\n") }     ## arg 5 (the 7th SysV arg, on the stack)
  push_str(sb, "  syscall\n  ret\n")
}

## §5.1 PARAMETER-DEFAULT filling (FN-5). A call that omits a callee's trailing DEFAULTED params is
## completed HERE, before any emission, by appending the default expressions as extra arguments — so
## every downstream pass (the `.rodata` str scan, the temp-pool reservations, arg counting, emit) sees
## one complete, uniform arg list and needs no per-site awareness of defaults. The parser stored each
## default's `Expr` pointer in the param's `pps` (a non-pointer value param leaves `pps` free; it is
## read as a pointee span ONLY for a `ptr` param), recovered here by bitcast. Generic callees are safe
## to fill here too: explicit type arguments are already ordinary leading args in the AST, so a trailing
## omitted value-param default appends in source-param order before generic dispatch sees the completed
## arity. For a comptime-variadic callee this still only fills the fixed params before the `...` rest:
## once the call supplies all fixed args (`nargs >= arity-1`), the remaining args are the pack and are
## never default-expanded. `src/` declares no defaults, so every call resolves to `arity == nargs` and
## NOTHING is appended → the emitted GAS is byte-identical → TOOL-1 fixpoint unaffected (no reseed).
fill_call := fn(e : ptr(Expr), decls : ptr(rt::Vec), src : ptr(u8), ms : usize, ml : usize, mar : ptr(mut rt::Arena)) {
  match deref(e) {
    Expr::Call(cs, cl, nargs, ahead) => {
      idx := callee_decl_idx(decls, src, cs, cl, ms, ml)
      if idx >= 0 {
        cd := deref(decl_get(decls, usize(idx)))
        vf := decl_is_variadic(cd, src, deref(mar))
        fill_stop := if vf { cd.arity - 1 } else { cd.arity }
        if cd.is_fn and fill_stop > nargs {
          ## the tail of the existing arg list (0 when the call had no args) — new defaults link after it.
          mut newhead := ahead
          mut tail := ahead
          while tail != 0 and deref(arg_p(tail)).next != 0 { tail = deref(arg_p(tail)).next }
          mut pp := cd.params_head
          mut k := 0
          mut added := 0
          while pp != 0 and k < fill_stop {
            pm := deref(param_p(pp))
            ## an omitted (index >= nargs) NON-pointer value param with a stored default (`pps != 0`).
            if k >= nargs and str_at((src + pm.ts), pm.tl) != "ptr" and pm.pps != 0 {
              defp := unchecked bitcast(ptr(Expr), pm.pps)
              h := mk_arg(deref(mar), Arg(e = defp, next = 0))
              if newhead == 0 { newhead = h } else {
                told := deref(arg_p(tail))
                set_arg(deref(mar), tail, Arg(e = told.e, next = h))
              }
              tail = h
              added += 1
            }
            k += 1
            pp = pm.next
          }
          if added != 0 { set_expr(e, Expr.Call(cs, cl, nargs + added, newhead)) }
        }
      }
    }
    _ => {}
  }
}
## Walk expression `e`, filling defaults on every `Call` within (itself + all sub-expressions +
## arguments). Structural twin of `scan_str_arg_expr`.
fill_expr := fn(e : ptr(Expr), decls : ptr(rt::Vec), src : ptr(u8), ms : usize, ml : usize, mar : ptr(mut rt::Arena)) {
  match deref(e) {
    Expr::Bin(op, l, r) => { fill_expr(l, decls, src, ms, ml, mar); fill_expr(r, decls, src, ms, ml, mar) }
    Expr::If(c, t, f) => { fill_expr(c, decls, src, ms, ml, mar); fill_expr(t, decls, src, ms, ml, mar); fill_expr(f, decls, src, ms, ml, mar) }
    Expr::Match(scrut, head) => {
      fill_expr(scrut, decls, src, ms, ml, mar)
      mut arm := head
      while arm != 0 {
        am := deref(arm_p(arm))
        if unchecked bitcast(usize, am.body) != 0 { fill_expr(am.body, decls, src, ms, ml, mar) }
        fill_stmts(am.body_stmts, decls, src, ms, ml, mar)
        arm = am.next
      }
    }
    Expr::Call(cs, cl, nargs, args_head) => {
      mut g := args_head
      while g != 0 {
        ga := deref(arg_p(g))
        fill_expr(ga.e, decls, src, ms, ml, mar)
        g = ga.next
      }
      fill_call(e, decls, src, ms, ml, mar)
    }
    Expr::StructLit(cs, cl, nf, fhead) => {
      mut g := fhead
      while g != 0 { ga := deref(arg_p(g)); fill_expr(ga.e, decls, src, ms, ml, mar); g = ga.next }
    }
    Expr::Field(base, fs, fl) => { fill_expr(base, decls, src, ms, ml, mar) }
    Expr::EnumLit(es, el, vs, vl, np, phead) => {
      mut g := phead
      while g != 0 { ga := deref(arg_p(g)); fill_expr(ga.e, decls, src, ms, ml, mar); g = ga.next }
    }
    Expr::AddrOf(p) => { fill_expr(p, decls, src, ms, ml, mar) }
    Expr::Deref(p) => { fill_expr(p, decls, src, ms, ml, mar) }
    Expr::ArrayLit(nel, ehead) => {
      mut g := ehead
      while g != 0 { ga := deref(arg_p(g)); fill_expr(ga.e, decls, src, ms, ml, mar); g = ga.next }
    }
    Expr::Index(base, ix) => { fill_expr(base, decls, src, ms, ml, mar); fill_expr(ix, decls, src, ms, ml, mar) }
    Expr::Slice(base, lo, hi) => { fill_expr(base, decls, src, ms, ml, mar); fill_expr(lo, decls, src, ms, ml, mar); fill_expr(hi, decls, src, ms, ml, mar) }
    Expr::Try(inner) => { fill_expr(inner, decls, src, ms, ml, mar) }
    Expr::Unchecked(inner) => { fill_expr(inner, decls, src, ms, ml, mar) }
    Expr::Bitcast(inner, _bcs, _bcl) => { fill_expr(inner, decls, src, ms, ml, mar) }
    Expr::CompField(base, ix) => { fill_expr(base, decls, src, ms, ml, mar); fill_expr(ix, decls, src, ms, ml, mar) }
    _ => {}
  }
}
## Walk statement list `head`, filling defaults on every `Call` within. Twin of `scan_str_arg_stmts`.
fill_stmts := fn(head : ptr(mut Stmt), decls : ptr(rt::Vec), src : ptr(u8), ms : usize, ml : usize, mar : ptr(mut rt::Arena)) {
  mut s := head
  while s != 0 {
    st := deref(stmt_p(Stmt, s))
    match st {
      Stmt::Assign(ns, nl, v, nx) => { fill_expr(v, decls, src, ms, ml, mar); s = nx }
      Stmt::While(c, b, nx) => { fill_expr(c, decls, src, ms, ml, mar); fill_stmts(b, decls, src, ms, ml, mar); s = nx }
      Stmt::Loop(b, nx) => { fill_stmts(b, decls, src, ms, ml, mar); s = nx }
      Stmt::Unchecked(b, nx) => { fill_stmts(b, decls, src, ms, ml, mar); s = nx }
      Stmt::AllocWith(ae, b, nx) => { fill_stmts(b, decls, src, ms, ml, mar); s = nx }
      Stmt::Break(_bv, _bd, nx) => { s = nx }
      Stmt::Continue(_cd, nx) => { s = nx }
      Stmt::ExprStmt(e, nx) => { fill_expr(e, decls, src, ms, ml, mar); s = nx }
      Stmt::FieldAssign(bns, bnl, fns, fnl, fv, nx) => { fill_expr(fv, decls, src, ms, ml, mar); s = nx }
      Stmt::FieldPathAssign(pl, fpv, nx) => { fill_expr(pl, decls, src, ms, ml, mar); fill_expr(fpv, decls, src, ms, ml, mar); s = nx }
      Stmt::Return(rv, nx) => { fill_expr(rv, decls, src, ms, ml, mar); s = nx }
      Stmt::DerefAssign(dp, val, nx) => { fill_expr(dp, decls, src, ms, ml, mar); fill_expr(val, decls, src, ms, ml, mar); s = nx }
      Stmt::IndexAssign(ib, ii, iv, nx) => { fill_expr(ib, decls, src, ms, ml, mar); fill_expr(ii, decls, src, ms, ml, mar); fill_expr(iv, decls, src, ms, ml, mar); s = nx }
      Stmt::IndexFieldAssign(fia, fii, ifs, ifl, fiv, nx) => { fill_expr(fia, decls, src, ms, ml, mar); fill_expr(fii, decls, src, ms, ml, mar); fill_expr(fiv, decls, src, ms, ml, mar); s = nx }
      Stmt::If(c, th, el, nx) => { fill_expr(c, decls, src, ms, ml, mar); fill_stmts(th, decls, src, ms, ml, mar); fill_stmts(el, decls, src, ms, ml, mar); s = nx }
      Stmt::Match(sc, ah, nx) => {
        fill_expr(sc, decls, src, ms, ml, mar)
        mut arm := ah
        while arm != 0 { am := deref(arm_p(arm)); fill_stmts(am.body_stmts, decls, src, ms, ml, mar); arm = am.next }
        s = nx
      }
      Stmt::For(fns, fnl, flo, fhi, fb, nx) => { fill_expr(flo, decls, src, ms, ml, mar); if unchecked bitcast(usize, fhi) != 0 { fill_expr(fhi, decls, src, ms, ml, mar) }; fill_stmts(fb, decls, src, ms, ml, mar); s = nx }
      Stmt::CompIf(ccond, cthen, celse, nx) => { fill_stmts(cthen, decls, src, ms, ml, mar); fill_stmts(celse, decls, src, ms, ml, mar); s = nx }
      Stmt::CompFor(cvs, cvl, civ, cb, nx) => { fill_stmts(cb, decls, src, ms, ml, mar); s = nx }
      Stmt::CompForRange(rvs, rvl, rlo, rhi, rb, nx) => { fill_stmts(rb, decls, src, ms, ml, mar); s = nx }
      Stmt::CompMatch(cmsc, cmah, nx) => { mut car : usize = cmah; while car != 0 { cam := deref(arm_p(car)); fill_stmts(cam.body_stmts, decls, src, ms, ml, mar); car = cam.next }; s = nx }
    }
  }
}
## Fill §5.1 parameter-defaults across the whole program: every fn/const body + value initializer.
## `pub` so the non-x86_64 backend drivers (which have their own emit, not `emit_program`) can run the
## same filler after parse — parameter defaults are then uniform across all four backends.
pub fill_program := fn(decls : ptr(rt::Vec), src : ptr(u8), mar : ptr(mut rt::Arena)) {
  cnt := rt::vec_len(deref(decls))
  for i in 0..cnt {
    d := deref(decl_get(decls, i))
    if d.kind == 1 or d.kind == 5 {
      fill_stmts(d.body_stmts, decls, src, d.mod_start, d.mod_len, mar)
      if unchecked bitcast(usize, d.value) != 0 { fill_expr(d.value, decls, src, d.mod_start, d.mod_len, mar) }
    } else if d.kind == 0 {
      if unchecked bitcast(usize, d.value) != 0 { fill_expr(d.value, decls, src, d.mod_start, d.mod_len, mar) }
    }
  }
}

## PERF (generated-code quality): a peephole over the final GAS collapsing the stack-machine's pervasive
## ADJACENT `pushq A` / `popq B` pairs (its eval-then-consume idiom): A==B → deleted (a pure register
## round-trip — ~26K in the self-build), else `movq A, B`. Every such pair in the emitted code has a
## register/immediate SOURCE and a register DEST (no mem→mem — verified over the whole self-build), so
## the movq is always a legal single instruction. Only TEXTUALLY-ADJACENT lines collapse (a label or any
## instruction between blocks the pattern), so it never reorders across control flow. ~32% of all emitted
## instructions are this churn → a large runtime win for every Alatyr program, incl. the compiler itself
## (compounds). NON-neutral (changes the output) → reseed-gated; correctness gated on e2e + the sweeps.
## Peephole the byte range `[start, endp)` of the source buffer at `base` into `out` (the pushq/popq →
## movq collapse; see `peephole_gas`). Factored out so `peephole_and_respan` (1c-γ) can peephole each
## per-module span independently: the pattern collapses only two TEXTUALLY-ADJACENT lines and a
## `.section`/`.text` directive line begins every span, so no pair straddles a boundary → peepholing the
## spans back-to-back yields the SAME bytes as peepholing the whole buffer.
peephole_range := fn(in out out : strbuf::StrBuf, base : usize, start : usize, endp : usize) {
  mut i := start
  while i < endp {
    mut j := i
    while j < endp and str_at((base + j), 1) != "\n" { j = j + 1 } ## j → end of the current line ('\n' or endp)
    mut matched := false
    if j < endp and j - i > 8 and str_at((base + i), 8) == "  pushq " {
      mut k := j + 1
      mut m := k
      while m < endp and str_at((base + m), 1) != "\n" { m = m + 1 } ## m → end of the next line
      if m - k > 7 and str_at((base + k), 7) == "  popq " {
        astr := str_at((base + i + 8), j - i - 8)       ## pushq operand A
        bstr := str_at((base + k + 7), m - k - 7)       ## popq operand B
        if astr == bstr {
          ## A == B: a pure round-trip — emit nothing
        } else {
          strbuf::push_str(out, "  movq ")
          strbuf::push_str(out, astr)
          strbuf::push_str(out, ", ")
          strbuf::push_str(out, bstr)
          strbuf::push_str(out, "\n")
        }
        i = m + 1
        matched = true
      }
    }
    if matched == false {
      mut e := j
      if j < endp { e = j + 1 }                                  ## include the trailing '\n'
      strbuf::push_str(out, str_at((base + i), e - i))
      i = e
    }
  }
}

pub peephole_gas := fn(inb : ptr(strbuf::StrBuf), a : rt::Arena) -> strbuf::StrBuf {
  ln := strbuf::buf_len(deref(inb))
  base := unchecked bitcast(usize, strbuf::strbuf_base(deref(inb)))
  mut out := strbuf::strbuf(a, ln + 64)
  peephole_range(out, base, 0, ln)
  out
}

## TOOL-6 slice 1c-γ: peephole the buffer PER RECORDED SPAN, rewriting the span table (from 1c-β) in
## place to the post-peephole (output-relative) offsets, and return the peepholed whole buffer. The
## build path uses this instead of `peephole_gas` so `link_exe` can slice the FINAL (peepholed) `.s`
## into per-module `.o` at the corrected boundaries. Byte-identical to `peephole_gas` over the whole
## buffer (spans tile the buffer in order and no pushq/popq pair straddles a `.section`/`.text` boundary).
pub peephole_and_respan := fn(inb : ptr(strbuf::StrBuf), spanbase : usize, a : rt::Arena) -> strbuf::StrBuf {
  ln := strbuf::buf_len(deref(inb))
  base := unchecked bitcast(usize, strbuf::strbuf_base(deref(inb)))
  mut out := strbuf::strbuf(a, ln + 64)
  n := rt::rec_get(unchecked bitcast(ptr(mut u8), spanbase), 0)
  for si in 0..n {
    old_start := rt::rec_get(unchecked bitcast(ptr(mut u8), spanbase), 1 + si * 2)
    old_len := rt::rec_get(unchecked bitcast(ptr(mut u8), spanbase), 2 + si * 2)
    new_start := strbuf::buf_len(out)
    peephole_range(out, base, old_start, old_start + old_len)
    rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 1 + si * 2, new_start)
    rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 2 + si * 2, strbuf::buf_len(out) - new_start)
  }
  out
}

## §8 `@repr(T)` representability CHECK (spec Types §8): every enum carrying `@repr(T)` must have T an
## INTEGER type (`uN`/`iN`/`usize`/`bitsN`) able to represent every discriminant value (0..count-1);
## otherwise "a compile diagnostic" — fail-loud here at build time (the spec-mandated rejection). No
## `@repr` in the self-host corpus, so this never fires for the fixpoint build (neutral). Call before
## `emit_program`. A non-integer T, or a narrow T too small for the variant count, aborts the build.
pub validate_repr := fn(decls : ptr(rt::Vec), src : ptr(u8)) {
  cnt := rt::vec_len(deref(decls))
  for i in 0..cnt {
    d := deref(decl_at(Decl, rt::vec_get(deref(decls), i)))
    if d.kind == 3 {
      ## spec Types §6.2 — "Two variants resolving to the same value are ill-formed." A duplicate
      ## effective discriminant (a `= N` pin colliding with another pin or an auto-incremented value) is
      ## a compile diagnostic: fail LOUD here at build time rather than emit an ambiguous tag. An
      ## un-pinned enum resolves to `0,1,2,…` (all distinct) → no rejection → fixpoint-neutral.
      if enum_dup_disc(src, d.fields_head) >= 0 {
        panic("selfhost: two enum variants resolve to the same discriminant value (spec Types §6.2 — ill-formed)")
      }
      rsp := enum_repr_ty(decls, src, d.name_start, d.name_len)
      if rsp.n != 0 {
        if repr_ty_is_integer(src, rsp.s, rsp.n) == false {
          panic("selfhost: @repr(T) tag type must be an integer type (uN / iN / usize / bitsN)")
        }
        mut f := d.fields_head
        mut vc := 0
        while f != 0 { fd := deref(fld_p(f)); vc = vc + 1; f = fd.next }
        cap := repr_ty_capacity(src, rsp.s, rsp.n)
        if cap != 0 and vc > cap {
          panic("selfhost: @repr(T) tag type is too narrow to represent the enum's discriminant count")
        }
      }
    }
  }
}

## Emit the FIELD-NAME `.rodata` labels for one module range. The caller owns the aggregate-renderer
## gate (`needs_fld`) and must have opened the module's `.rodata` section; this delegate owns only the
## range walk and preserves declaration/field order exactly. Struct field names and enum variant names
## share this representation because both are read through `<x>.name` by `alloc::fmt::display`.
emit_field_name_rodata := fn(decls : ptr(rt::Vec), src : ptr(u8), in out sb : strbuf::StrBuf, start : usize, count : usize) {
  for fk in 0..count {
    fi := start + fk
    d := deref(decl_get(decls, fi))
    if d.kind == 2 or d.kind == 3 {
      mut fh := d.fields_head
      while fh != 0 {
        fdd := deref(fld_p(fh))
        globl_lfld(sb, fdd.ns)
        push_lfld(sb, fdd.ns)
        push_str(sb, ": .ascii \"")
        push_str(sb, str_at((src + fdd.ns), fdd.nl))
        push_str(sb, "\"\n")
        fh = fdd.next
      }
    }
  }
}

## TOOL-6 (per-module compilation) slice 1a — grouping INFRASTRUCTURE ONLY. The flat decls Vec is a
## concatenation of the source modules parsed in order, so every decl carries its owning module's name
## span (`mod_start`/`mod_len`) and same-module decls form a contiguous run. `module_decl_ranges`
## partitions `[0, cnt)` into maximal runs of decls sharing the SAME (mod_start, mod_len) key — one range
## per run, in ascending index order — writing 4 words per range into the caller-owned buffer `base`:
## entry `m` at `base + m*32` is [mod_start, mod_len, start, count], covering decls `[start, start+count)`.
## Returns the range COUNT as a PLAIN usize. Deliberately NO wide-struct return and NO in-out struct: the
## FROZEN bootstrap seed's struct-return ABI is narrower than the current compiler's (a multi-word
## `return Struct(…)` mis-delivers there — the IVec 4-word precedent), so a struct handle would come back
## as 0 and the walk would emit nothing. Because the runs TILE `[0, cnt)` in ascending order, iterating
## them (outer over ranges, inner over each range) visits every decl index in the SAME order as a flat
## `for i in 0..cnt` — so a decl-walk phase refactored onto this helper is byte-identical REGARDLESS of
## whether a module is contiguous (a non-contiguous module would merely surface as two ranges with equal
## keys; the visit order is unchanged). The caller reserves `base` for up to `cnt` ranges.
module_decl_ranges := fn(decls : ptr(rt::Vec), src : ptr(u8), base : usize) -> usize {
  cnt := rt::vec_len(deref(decls))
  mut nmod := 0
  mut i := 0
  while i < cnt {
    d := deref(decl_get(decls, i))
    ms := d.mod_start
    ml := d.mod_len
    ## extend the run over every following decl sharing this exact module span. CRITICAL seed idiom: an
    ## `if C { X } else { Y }` whose BOTH branches are single assignment-EXPRESSIONS (`j += 1` / `go =
    ## false`), when it is the TAIL statement of a `while` body, is mis-parsed by the FROZEN seed as an
    ## if-EXPRESSION: it loads the branch values, discards them, and jumps to the FUNCTION return —
    ## exiting after one iteration (so the range list comes back empty). Avoid it entirely — decide with
    ## `cont`, then close the body with two `if`s that have NO `else` (a bodiless-else `if` has no value,
    ## so it can never be taken as a tail expression). This is the seed-safe shape.
    mut j := i + 1
    mut go := true
    while go {
      mut cont := false
      if j < cnt {
        dj := deref(decl_get(decls, j))
        if dj.mod_start == ms and dj.mod_len == ml { cont = true }
      }
      if cont == false { go = false }
      if cont { j += 1 }
    }
    eb := unchecked bitcast(ptr(mut u8), base + nmod * 32)
    rt::rec_set(eb, 0, ms)
    rt::rec_set(eb, 1, ml)
    rt::rec_set(eb, 2, i)
    rt::rec_set(eb, 3, j - i)
    nmod += 1
    i = j
  }
  return nmod
}

## TOOL-6 slice 1c-β: `spanbase` (0 = disabled, the DUMP paths) is a caller-owned buffer into which the
## per-module GAS byte SPANS are recorded as side-metadata: word 0 = span count `N`, then `N` × (start,len)
## word pairs (span `i` at word 1+i*2 / 2+i*2). Each span is one module's contiguous block (the merged
## per-module loop) plus one trailing span for the monomorphized-instances block, in emission order. The
## recording only WRITES `spanbase` (never `sb`), so the emitted GAS is byte-identical whether `spanbase`
## is 0 or a buffer → the fixpoint GAS dump (which passes 0) is unaffected. The build path (link_exe, 1c-γ)
## consumes the table to split the single `.s` into per-module `.o`; `start` is a byte offset from `sb.data`
## (the buffer only ever grows by append, so an offset captured mid-emit is its final file offset).
pub emit_program := fn(decls : ptr(rt::Vec), in out sb : strbuf::StrBuf, src : ptr(u8), mar : ptr(mut rt::Arena), a : rt::Arena, in out nl : usize, spanbase : usize, library_mode : bool) {
  ## COMMIT 3 (--ra default-on): probe the `ALATYR_RA=0` OFF escape hatch ONCE (intra-module write of
  ## RA_ON). Default → `emit_fn` register-allocates the scalar-leaf shape; `ALATYR_RA=0` forces the old
  ## text path (for debugging). This build is self-promoted (its own scalar-leaf fns are allocated).
  ra_env_init(a)
  SPLIT_ON = 0
  if spanbase != 0 { SPLIT_ON = 1 }
  LIBRARY_MODE = 0
  if library_mode { LIBRARY_MODE = 1 }
  ## PERF: build the per-decl name-hash pre-filter ONCE (decls are final here — lambda lifting ran in the
  ## driver before emit) so the O(cnt) decl-by-name scans in the `.text` emit skip non-matches cheaply.
  build_decl_name_hash(decls, src, deref(mar))
  cnt := rt::vec_len(deref(decls))
  ## COMPTIME `when`-GUARD gating (Comptime §7.1/§9; CT-5) — BEFORE any name-resolution / reachability /
  ## emission. A decl carrying a `when <predicate>` whose CLOSED predicate folds FALSE for the build
  ## target is NEUTERED IN PLACE to an inert kind-0 no-op with an EMPTY name (`name_len = 0`): it then
  ## matches no name lookup, no overload set, no reachability root, and emits nothing — exactly the
  ## spec's "as if the declaration were absent" (Phase B exclusion). A TRUE or unfoldable predicate
  ## leaves the decl untouched (active). `src/`+`lib/` carry no `when` (every `when_cond` is 0), so this
  ## loop neuters nothing there → the emitted GAS is byte-identical → the TOOL-1 fixpoint holds.
  for i in 0..cnt {
    dg := deref(decl_get(decls, i))
    if unchecked bitcast(usize, dg.when_cond) != 0 {
      if decl_guard_fold(dg.when_cond, src) == 0 {
        gh := rt::vec_get(deref(decls), i)
        gdp : ptr(mut Decl) = unchecked bitcast(ptr(mut Decl), gh)
        ## keep `value` (a valid `Expr` ptr the `.rodata` walker handles harmlessly) but drop the NAME,
        ## body, params, and kind → an inert kind-0 no-op that matches no lookup and emits no code.
        deref(gdp) = Decl(name_start = dg.name_start, name_len = 0, value = dg.value,
          is_fn = false, kind = 0, arity = 0, is_generic = false, params_head = 0,
          body_stmts = 0, fields_head = 0, ret_ts = 0, ret_tl = 0,
          mod_start = dg.mod_start, mod_len = dg.mod_len, when_cond = 0, alias_ts = 0, alias_tl = 0)
      }
    }
  }
  ## §5.1 fill omitted trailing parameter-defaults BEFORE any emission (the `.rodata`/pool scans below
  ## must see the completed arg lists). No-op for `src/` (no defaults) → fixpoint-neutral.
  fill_program(decls, src, mar)
  validate_standard_byte_tuple_boundaries(decls, src)
  ## .rodata: emit every string literal's data, walking each fn body + each value binding.
  ## `seen` collects already-emitted FLOAT-literal source offsets so a HOF-clone body that duplicates
  ## a float literal (see `emit_rodata_expr`'s FloatLit case) emits the shared `.Lflt<offset>:` entry
  ## once. Cap = `decls.cap` (reserved to the SOURCE BYTE COUNT by the driver): the number of distinct
  ## float offsets ≤ the token count ≤ that cap, so `rt::vec_push` never overflows. For `src/`+`lib/`
  ## every float offset is unique → nothing is deduped → the GAS is byte-identical (fixpoint-neutral).
  scap := deref(decls).cap + 16
  mut seen := rt::Vec(data = rt::bump(deref(mar), scap * 8), len = 0, cap = scap)
  ## TOOL-6 slice 1b-ii (per-module BLOCK reorg): the `.rodata` STRING-literal emission is MOVED down into
  ## the merged per-module loop (each module's `.rodata` strings now sit immediately before that same
  ## module's `.text` fn defs, forming ONE contiguous rodata+text block per module — the exact physical
  ## shape the per-module `.o` split needs). `seen` (the float-dedup Vec, from `mar` above) must stay LIVE
  ## across that whole loop, so it must not be aliased by `a`-scratch or `rb`/`rb`: `rb`/`pb` are now
  ## bumped from `mar` (past `seen`), not the by-value `a`. Field-name `.rodata` (below) + `.data` (below)
  ## stay LEADING whole-program sections for now; folding them into the per-module block is the next slice.
  ## FIELD-NAME rodata — for `display`'s aggregate rendering `{ <name> = value, … }`: a comptime-for
  ## field-name read `f.name` (`emit_str_pair`'s `is_cf_name_ref` case) points at `.Lfld<name-offset>`,
  ## so emit each STRUCT field's NAME as a `.ascii` string keyed on the field decl's name offset
  ## (unique per field). GATED on the renderer (`alloc::fmt::display`) being compiled in, so a program
  ## that never renders (the compiler's OWN self-build — `alloc::fmt` is not ambiently injected) emits
  ## nothing → the `.rodata` (hence whole GAS) is byte-identical → the TOOL-1 fixpoint is unaffected.
  mut needs_fld := false
  for i in 0..cnt {
    d := deref(decl_get(decls, i))
    if d.kind == 1 and str_at((src + d.name_start), d.name_len) == "display" and str_at((src + d.mod_start), d.mod_len) == "alloc__fmt" { needs_fld = true }
  }
  ## TOOL-6 slice 1b-iii: the leading whole-program FIELD-NAME `.rodata` block and the leading
  ## whole-program `.data` GLOBALS block have BOTH been folded into the per-module BLOCK loop below,
  ## so each module's field-names now sit in ITS OWN `.rodata` (right after its string literals) and
  ## its globals in ITS OWN `.data`, immediately before that module's `.text` — one contiguous
  ## rodata+data+text block per module (the physical shape the per-module `.o` split needs). Only the
  ## gate computations remain here: `needs_fld` (above, the aggregate renderer) and `has_gl` (below).
  mut has_gl := false
  for i in 0..cnt {
    d := deref(decl_get(decls, i))
    if global_needs_storage(src, d) { has_gl = true }
  }
  ## GENERICS pre-pass: collect the monomorphization instantiation set from every fn body.
  mut insts := IVec(base = 0, len = 0, cap = 0, arena = mar)
  ivec_new(insts, mar, 16)
  ## SEED from NON-GENERIC fns only. A generic fn's body calls other generics with its OWN
  ## type-PARAM (`allocate`'s `buf_ptr(T, …)`), which — collected literally here — would seed a
  ## BOGUS `buf_ptr__T` instance (an unsubstituted type-param tag); its body then calls `get(T)`
  ## → an undefined `<mod>__get` (no concrete tag). The CONCRETE nested instances are collected by
  ## the transitive worklist below (which substitutes the enclosing instance's type-arg). `src/`'s
  ## generic fns make no nested generic call, so skipping their bodies here is byte-identical.
  for i in 0..cnt {
    d := deref(decl_get(decls, i))
    if (d.kind == 1 and d.is_generic == false) or d.kind == 5 {
      COLLECT_BODY = unchecked bitcast(usize, d.body_stmts)
      COLLECT_MOD_S = d.mod_start
      COLLECT_MOD_L = d.mod_len
      collect_insts_stmts(d.body_stmts, insts, decls, src, a, d.params_head)
      collect_insts_expr(d.value, insts, decls, src, a, d.params_head)
      COLLECT_BODY = 0
      COLLECT_MOD_S = 0
      COLLECT_MOD_L = 0
    }
  }
  ## NESTED / TRANSITIVE monomorphization. The seed pass above collects a generic call's type-arg
  ## LITERALLY, so a generic fn `G` that calls another generic `H` with G's OWN type-parameter
  ## (`allocate`/`grow` → `buf_ptr(T, …)` → `get(T, …)`, all in base/alloc) yields a bogus
  ## `H__T` — the CONCRETE `H__<u8>` the instance `G__<u8>` actually calls is never collected.
  ## Fix: worklist over the instance set — for each generic instance `(G, C)`, collect G's OWN
  ## generic calls into a scratch set and re-add each with the enclosing type-parameter substituted
  ## to `C` (`H(T,…)` → `(H, C)`; a concrete `H(u64,…)` stays `(H, u64)`). Newly added instances are
  ## processed in turn (the loop re-reads the length); `add_inst` dedups so it converges. Reuses
  ## `collect_insts_*` unchanged — the substitution is applied to their results, not threaded in.
  ## For `src/` the generic fns (`node_ptr`/`decl_at`/`svec_at`) make NO nested generic call, so this
  ## adds nothing and the instance set + order is unchanged → the TOOL-1 fixpoint is unaffected.
  mut done := 0
  mut guard := 0
  while done < ivec_len(ptr(insts)) and guard < 100000 {
    ie := ivec_at(ptr(insts), done)
    done += 1
    guard += 1
    gd := deref(decl_at(Decl, rt::vec_get(deref(decls), ie.gi)))
    if gd.is_generic and gd.params_head != 0 {
      tp := deref(param_p(gd.params_head))
      ## the enclosing fn's SECOND type-param name (`map`'s `U`), 0/0 for a single-param generic —
      ## computed ONCE before the loop (a read-only param scan; no struct-local reassignment).
      mut tp2ns := 0
      mut tp2nl := 0
      if tparam_count(decls, i64(ie.gi), src, a) >= 2 {
        i2 := tparam_idx2(decls, i64(ie.gi), src, a)
        mut pq := gd.params_head
        mut pj := 0
        while pq != 0 {
          pqm := deref(param_p(pq))
          if pj == i2 { tp2ns = pqm.ns; tp2nl = pqm.nl }
          pj += 1
          pq = pqm.next
        }
      }
      ## the enclosing fn's THIRD type-param name (`Result::map`'s `U`), 0/0 for a <3-param generic.
      mut tp3ns := 0
      mut tp3nl := 0
      if tparam_count(decls, i64(ie.gi), src, a) >= 3 {
        i3 := tparam_idx3(decls, i64(ie.gi), src, a)
        mut pq3 := gd.params_head
        mut pj3 := 0
        while pq3 != 0 {
          pqm3 := deref(param_p(pq3))
          if pj3 == i3 { tp3ns = pqm3.ns; tp3nl = pqm3.nl }
          pj3 += 1
          pq3 = pqm3.next
        }
      }
      mut tmp := IVec(base = 0, len = 0, cap = 0, arena = mar)
      ivec_new(tmp, mar, 8)
      COLLECT_BODY = unchecked bitcast(usize, gd.body_stmts)
      COLLECT_MOD_S = gd.mod_start
      COLLECT_MOD_L = gd.mod_len
      collect_insts_stmts(gd.body_stmts, tmp, decls, src, a, gd.params_head)
      collect_insts_expr(gd.value, tmp, decls, src, a, gd.params_head)
      COLLECT_BODY = 0
      COLLECT_MOD_S = 0
      COLLECT_MOD_L = 0
      tn := ivec_len(ptr(tmp))
      for k in 0..tn {
        te := ivec_at(ptr(tmp), k)
        ## substitute each nested type-arg lexeme against the enclosing params (T → ie.ts, U → ie.ts2,
        ## W → ie.ts3). The `tp3` branches fire only for a 3-type-param generic (tp3nl != 0) → a
        ## 1-/2-param generic is byte-identical (the original two-way substitution).
        mut nts := te.ts
        mut ntl := te.tl
        if streq(src, te.ts, te.tl, tp.ns, tp.nl) { nts = ie.ts; ntl = ie.tl }
        else if tp2nl != 0 and streq(src, te.ts, te.tl, tp2ns, tp2nl) { nts = ie.ts2; ntl = ie.tl2 }
        else if tp3nl != 0 and streq(src, te.ts, te.tl, tp3ns, tp3nl) { nts = ie.ts3; ntl = ie.tl3 }
        mut nts2 := te.ts2
        mut ntl2 := te.tl2
        if tp2nl != 0 and streq(src, te.ts2, te.tl2, tp2ns, tp2nl) { nts2 = ie.ts2; ntl2 = ie.tl2 }
        else if streq(src, te.ts2, te.tl2, tp.ns, tp.nl) { nts2 = ie.ts; ntl2 = ie.tl }
        else if tp3nl != 0 and streq(src, te.ts2, te.tl2, tp3ns, tp3nl) { nts2 = ie.ts3; ntl2 = ie.tl3 }
        mut nts3 := te.ts3
        mut ntl3 := te.tl3
        if tp3nl != 0 and streq(src, te.ts3, te.tl3, tp3ns, tp3nl) { nts3 = ie.ts3; ntl3 = ie.tl3 }
        else if tp2nl != 0 and streq(src, te.ts3, te.tl3, tp2ns, tp2nl) { nts3 = ie.ts2; ntl3 = ie.tl2 }
        else if streq(src, te.ts3, te.tl3, tp.ns, tp.nl) { nts3 = ie.ts; ntl3 = ie.tl }
        add_inst(insts, src, te.gi, nts, ntl, nts2, ntl2, nts3, ntl3)
      }
      ## COMPTIME-FOR (self-recursive derive): a generic fn whose body has `comptime for f in
      ## typeinfo(T).fields { … <gi>(f.type, …) }` (hash/eq/cmp) unrolls, inside instance `(gi, ie.ts)`,
      ## to a recursive `<gi>(<fieldtype>, …)` per field. So instantiate `gi` for each field type of a
      ## STRUCT ie.ts — the emit-side unroll then finds those instances defined. (Covers the
      ## self-recursive derive pattern; a comptime-for calling a DIFFERENT generic on fields is not
      ## auto-collected — none in the stdlib.)
      if stmts_have_compfor(gd.body_stmts, a) {
        bnf := base_type_name(src, ie.ts, ie.tl)
        sdf := struct_decl_of(decls, src, bnf.s, bnf.n)
        if sdf >= 0 {
          sdd := deref(decl_at(Decl, rt::vec_get(deref(decls), usize(sdf))))
          mut fdc := sdd.fields_head
          while fdc != 0 {
            fdcm := deref(fld_p(fdc))
            add_inst(insts, src, ie.gi, fdcm.ts, fdcm.tl, 0, 0, 0, 0)
            fdc = fdcm.next
          }
        }
        ## TUPLE `ie.ts` — the `comptime for c in typeinfo(T).components` unroll recurses `<gi>(c.type,
        ## …)` per component, so instantiate `gi` for each component type (read off the `(…)` span).
        if str_at((src + ie.ts), 1) == "(" {
          mut jc := 0
          mut goc := true
          while goc {
            cc := typearg_at(src, ie.ts, 0, jc)
            if cc.n == 0 { goc = false } else {
              add_inst(insts, src, ie.gi, cc.s, cc.n, 0, 0, 0, 0)
              jc += 1
            }
          }
        }
        ## ARRAY `ie.ts` `[T; N]` — the element unroll recurses `<gi>(<element type>, …)`, so
        ## instantiate `gi` once for the element type (all elements share it).
        if str_at((src + ie.ts), 1) == "[" {
          aes := array_elem_span(src, ie.ts, ie.tl)
          if aes.n != 0 { add_inst(insts, src, ie.gi, aes.s, aes.n, 0, 0, 0, 0) }
        }
      }
      ## enum-VARIANT self-recursive derive: `match { comptime for var in variants { … <gi>(p) } }`
      ## unrolls, per variant, to a recursive `<gi>(payload)` whose IMPLICIT type-arg is that variant's
      ## PAYLOAD type. So instantiate `gi` for each variant's payload type of an ENUM `ie.ts`.
      if stmts_have_variant_template(gd.body_stmts, a) {
        bne := base_type_name(src, ie.ts, ie.tl)
        edc := enum_decl_of(decls, src, bne.s, bne.n)
        if edc >= 0 {
          edd := deref(decl_at(Decl, rt::vec_get(deref(decls), usize(edc))))
          mut fvc := edd.fields_head
          while fvc != 0 {
            fvcm := deref(fld_p(fvc))
            ## the SINGLE-binding payload view (`variant_payload_span`): a multi-component variant
            ## yields its `(…)` TUPLE span, so `display(p)`'s tuple instance (`display__Tuple_…`) is
            ## collected — matching the arm's `cf_pay_ty` routing.
            pty := variant_payload_span(decls, src, bne.s, bne.n, fvcm.ns, fvcm.nl, a)
            if pty.n != 0 { add_inst(insts, src, ie.gi, pty.s, pty.n, 0, 0, 0, 0) }
            fvc = fvcm.next
          }
        }
      }
    }
  }
  ## REACHABILITY (dead-code elimination): a marker word per decl (bump-backed, zeroed). Seed the
  ## roots — every @test body, `main` only for a production artifact (the executable entry), and every
  ## GENERIC fn (scanning its
  ## body as a root only over-keeps a non-generic fn it names; the generic itself emits per-instance,
  ## not here) — then close over the call graph to a fixpoint (repeat full marking passes until the
  ## reachable count is stable). A non-generic fn is emitted below only if reachable; unreachable
  ## stdlib surface (`alloc::vec::split`, etc.) is dropped so its un-lowerable constructs never reach
  ## the assembler. @test is a root only when the test artifact includes kind-5 declarations; ordinary
  ## build/run inputs do not, so their main-rooted DCE remains unchanged.
  ## REACHABILITY (dead-code elimination): a marker word per decl (bump-backed, zeroed). Seed the
    ## roots — in the test artifact, every @test body, plus every GENERIC fn; in a production artifact
    ## also every fn named `main` (the executable entry), and every
    ## GENERIC fn (scanning its body as a root only over-keeps a non-generic fn it names; the generic
    ## itself emits per-instance, not here) — then close over the call graph to a fixpoint (repeat full
    ## marking passes until the reachable count is stable). A non-generic fn is emitted below only if
    ## reachable; unreachable stdlib surface (`alloc::vec::split`, etc.) is dropped so its un-lowerable
    ## constructs never reach the assembler. Ordinary build/run inputs keep only the non-test roots.
  ## slice 1b-ii: `rb` (and `pb` below) are bumped from `mar`, NOT the by-value `a`. They must stay live
  ## through the MERGED per-module loop (which re-emits `.rodata` alongside `.text`), during which the
  ## float-dedup `seen` Vec is also live in `mar`. The by-value `a`-scratch re-treads from a LOW entry
  ## offset that overlaps `seen`'s `mar` region if bumped far enough (2*cnt*8) — so backing `rb`/`pb` with
  ## `a` would alias `seen` once emission interleaves. `mar` hands out fresh memory past both.
  ## Modules §3 over the DECLARED surface (signatures, aggregate members, import/alias/projection
  ## bindings) — before any emission, so a violation is a diagnostic rather than a mangled label to a
  ## declaration the naming module may not see. Expression-position references are checked by the
  ## reachability walk below, whose `_mark_ms`/`_mark_ml` is the same exact attribution.
  vis_check_program(decls, src)
  rb := rt::bump(deref(mar), cnt * 8)
  for i in 0..cnt { rb_set(rb, i, 0) }
  ## `compile_files_mode` prepends this exact marker only for the TOOL-5 runner. Keep @test roots
  ## scoped to that artifact: normal build/run emission also parses kind-5 declarations, but their
  ## bodies must not turn private helpers into ordinary program roots.
  mut test_artifact := false
  if sb.len >= 30 and str_at(sb.data, 30) == ".section .rodata\n.Ltestprefix:" { test_artifact = true }
  for i in 0..cnt {
    d := deref(decl_get(decls, i))
    ## A lifted inline @require predicate has no runtime AST caller: the contract call is emitted from
    ## the source-scanned `T(v)` site. Treat the matching synthetic lambda (`name_len == 0`, name_start
    ## == the predicate's `fn` offset) as a reachability root, otherwise DCE drops its definition while
    ## the contract emitter still references `<module>__lam<fnpos>`.
    mut require_lam := false
    if d.kind == 1 and d.name_len == 0 {
      mut ri := 0
      while ri < cnt {
        rd := deref(decl_get(decls, ri))
        if rd.kind == 0 and rd.arity == 1 {
          ## A WHOLE-PROGRAM pass asking about a declaration it already HAS: the naming module for the
          ## query is that declaration's own module (TYPE-ANCESTOR), never whichever module was
          ## published last — otherwise a `@require` alias declared in two modules resolves to the
          ## wrong one here and the root scan keeps the wrong predicate alive.
          lower_layout::set_type_ref_module(rd.mod_start, rd.mod_len, ROOT_MOD_S, ROOT_MOD_L)
          rps := require_pred(decls, src, rd.name_start, rd.name_len)
          if rps.n != 0 and rps.s == d.name_start { require_lam = true }
        }
        ri += 1
      }
    }
    ## `@export` fns are roots too (Modules §6.3): the symbol must be emitted REGARDLESS of the call
    ## graph — an entry point / C-callable routine reached only from outside the package would otherwise
    ## be dropped by DCE (and an `@extern` importer, which resolves to the symbol not the decl, leaves
    ## the exported target with no internal caller).
    ## A fn named `_start` is a root too: it is the program's ELF ENTRY (Modules §6.1; emitted as the
    ## unprefixed `_start` label), reached only by the loader — no internal caller — so DCE would
    ## otherwise drop it, leaving an entry pointing at nothing. `src/` compiles no `_start` (its
    ## `package.al` manifest is excluded) → no new root → the reachable set is byte-identical.
    if library_mode {
      ## A library has no executable root. Only public/runtime exports from PACKAGE modules form the
      ## API roots; private helpers and ambient stdlib functions arrive through the ordinary call graph.
      if library_api_root(src, d) { rb_set(rb, i, 1) }
    } else if (test_artifact and d.kind == 5) or (d.kind == 1 and (require_lam or d.is_generic or (test_artifact == false and str_at((src + d.name_start), d.name_len) == "main") or str_at((src + d.name_start), d.name_len) == "_start" or export_name(src, d.name_start, d.name_len).n != 0)) {
      rb_set(rb, i, 1)
    }
  }
  ## PERF: close the reachability fixpoint by walking each fn's body EXACTLY ONCE, not once per outer
  ## iteration. The old loop re-walked ALL reachable bodies every pass until the count stabilised
  ## (~call-graph-depth passes) — and each `mark_calls` does the O(n_decls) `mark_name` scan per call
  ## site, so that depth factor multiplied the profile's #1 cost. A `processed` bitmap (pb) guards each
  ## body: a fn is walked when it FIRST becomes reachable-and-unprocessed; a pass that marks new fns
  ## sets `changed` so the next pass picks them up. Same final `rb` → identical DCE → byte-identical output.
  pb := rt::bump(deref(mar), cnt * 8)                        ## slice 1b-ii: from `mar` (see `rb` above), not `a`
  for i in 0..cnt { rb_set(pb, i, 0) }
  mut changed := true
  mut rguard := 0
  while changed and rguard < 1000 {
    changed = false
    for i in 0..cnt {
      if rb_get(rb, i) == 1 and rb_get(pb, i) == 0 {
        d := deref(decl_get(decls, i))
        if d.kind == 1 or (test_artifact and d.kind == 5) {
          _mark_ms = d.mod_start
          _mark_ml = d.mod_len
          ## TYPE-ANCESTOR: the DCE walk resolves TYPE names too (a `@require` predicate, a brand's
          ## underlying, a struct/enum construction), so it must ask those questions from the SAME
          ## module the emit will ask them from — otherwise DCE keeps one module's declaration and the
          ## emitter calls another's. Measured: a child constructing an ancestor's `Nz := @require(ok1)
          ## u64` emitted `call geo__ok1` while DCE had marked the decoy's `aother__bad1` → an
          ## undefined reference at link. This is the type-side twin of `mark_name`'s §3 rank.
          lower_layout::set_type_ref_module(d.mod_start, d.mod_len, ROOT_MOD_S, ROOT_MOD_L)
          mark_calls_stmts(d.body_stmts, rb, decls, src, a)
          mark_calls_expr(d.value, rb, decls, src, a)
        }
        rb_set(pb, i, 1)
        changed = true
      }
    }
    rguard += 1
  }
  ## Aggregate scratch width is measured per emitted function; no declaration-wide maximum is carried
  ## through PCtx, so an unrelated function does not inherit a frame tax from a wide type elsewhere.
  pcx := PCtx(src = src, decls = decls, mar = mar, inst = false, its = 0, itl = 0, its2 = 0, itl2 = 0, its3 = 0, itl3 = 0)
  ## TOOL-6 slice 1b-ii — the MERGED per-module BLOCK loop. For each module (a contiguous decl range) emit
  ## that module's `.rodata` string literals immediately followed by that module's reachable `.text` fn
  ## defs, so the module's rodata+text form ONE physically contiguous block delimited by its own `.section`
  ## directives. The assembler + linker MERGE same-named sections across the object, so the linked binary
  ## is behaviour-identical; only the `.s` is now per-module — the exact structure the per-module `.o`
  ## split will lift into separate files. Ranges tile [0, cnt) ascending, so WITHIN each section kind the
  ## decl-visit order (hence the bytes per section) is unchanged vs. the old all-rodata-then-all-text
  ## walk; only the INTERLEAVING of the two section kinds changes → a RESEED (seed != Stage1 expected),
  ## with Stage1 == Stage2 deterministic (this is a pure emission-order reorganization).
  ##
  ## ARENA disciple (see the landmine notes at `rb`/`seen`): every buffer that must live across the WHOLE
  ## loop — `seen` (float dedup), `insts`, `rb`/`pb` (reachability), and this range buffer — is bumped from
  ## `mar` and sits BELOW `emit_hw`. The per-module `.rodata` emit uses the by-value `a`-scratch, which
  ## re-treads from a LOW entry offset each call (emit never advances the local `a`), so it never climbs
  ## into those `mar` buffers. `emit_fn` bumps `mar` ABOVE `emit_hw` and we reset `mar.off = emit_hw` after
  ## each fn, reclaiming its dead per-fn scratch (bounds compile memory to AST + ONE function's scratch)
  ## without ever clobbering a live buffer.
  tbase := rt::bump(deref(mar), cnt * 32 + 32)
  tnr := module_decl_ranges(decls, src, tbase)
  ## TOOL-6 slice 1d — fill `MODTAB`, the per-module LABEL-NAMESPACE base table (see its header for the
  ## scheme + the injectivity argument). Two bases per module, both forced MONOTONE NON-DECREASING with
  ## module 0 pinned at 0, so `k -> (m(k), k - base[m(k)])` is a total injective renaming of every old
  ## label key:
  ##   word m*2     SOURCE-offset base — the module's earliest decl-name offset. `.Lflt`/`.Lfld` are
  ##                keyed on source offsets, and every offset a module emits lies at or after it.
  ##   word m*2+1   LABEL-INDEX base — the module's smallest `.Lstr` index. `pc.nstr` is handed out in
  ##                parse order and modules parse in order, so a module's literals occupy a CONTIGUOUS
  ##                index run; subtracting its base makes the run start at 0 and stay put when an
  ##                EARLIER module gains or loses a literal. Recovered by replaying the real `.rodata`
  ##                walk in silent SCAN mode (`ROD_SCAN`) — reusing the walk guarantees the base covers
  ##                exactly the labels that walk will define, with no arm missed. One extra traversal of
  ##                the rodata-reachable AST, no emission.
  ## This table must be bumped from `mar` BEFORE `emit_hw` so the per-fn scratch reset never reclaims it.
  MODTAB = rt::bump(deref(mar), tnr * 16 + 32)
  MODTAB_N = tnr
  mut msb := 0
  mut mlb := 0
  ROD_SCAN = 1
  for tm in 0..tnr {
    tmeb0 := unchecked bitcast(ptr(mut u8), tbase + tm * 32)
    tms0 := rt::rec_get(tmeb0, 2)
    tmc0 := rt::rec_get(tmeb0, 3)
    mut smin := 0
    mut shas := 0
    for k in 0..tmc0 {
      d := deref(decl_get(decls, tms0 + k))
      if shas == 0 { smin = d.name_start }
      if d.name_start < smin { smin = d.name_start }
      shas = 1
    }
    ROD_HAS = 0
    ROD_MIN = 0
    for k in 0..tmc0 {
      rd := deref(decl_get(decls, tms0 + k))
      emit_rodata_decl(rd, decls, src, sb, a, ptr(seen), false)
    }
    mut sbase := msb
    if shas != 0 and smin > msb { sbase = smin }
    mut lbase := mlb
    if ROD_HAS != 0 and ROD_MIN > mlb { lbase = ROD_MIN }
    if tm == 0 { sbase = 0 }
    if tm == 0 { lbase = 0 }
    meb := unchecked bitcast(ptr(mut u8), MODTAB + tm * 16)
    rt::rec_set(meb, 0, sbase)
    rt::rec_set(meb, 1, lbase)
    msb = sbase
    mlb = lbase
  }
  ROD_SCAN = 0
  emit_hw := mar.off
  ## slice 1c-β span-table cursors: `sp_n` = spans recorded so far, `sp_prev` = the byte offset at which
  ## the CURRENT (not-yet-closed) span began. Each boundary closes the previous span (writes its len) and
  ## opens a new one; the tail is finalized after the instances block. Inert when `spanbase == 0`.
  mut sp_n := 0
  mut sp_prev := 0
  for tm in 0..tnr {
    ## open this module's span (and close the previous one) at the current GAS offset. Span 0 starts at
    ## byte 0 (not `sb.len`) so it ABSORBS the emit_program preamble emitted before this loop — the
    ## `.global _start` / `_start:` ELF-entry wrapper (~86 bytes) — into the first module's `.o`; dropping
    ## it would leave the linked binary with no entry symbol.
    if spanbase != 0 {
      cur := sb.len
      mut this_start := cur
      if sp_n == 0 { this_start = 0 }
      if sp_n != 0 { rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 2 + (sp_n - 1) * 2, cur - sp_prev) }
      rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 1 + sp_n * 2, this_start)
      sp_prev = this_start
      sp_n = sp_n + 1
    }
    tmeb := unchecked bitcast(ptr(mut u8), tbase + tm * 32)
    tms := rt::rec_get(tmeb, 2)
    tmc := rt::rec_get(tmeb, 3)
    ## Static initializers may refer to another comptime/static declaration by bare name. Resolve
    ## those references in this module while its data image is emitted; `emit_fn` refreshes the same
    ## context for every following function body.
    if tmc != 0 {
      tmd := deref(decl_get(decls, tms))
      set_global_ref_module(tmd.mod_start, tmd.mod_len, unchecked bitcast(usize, decls))
    }
    ## this module's `.rodata` string literals (decl-range order — identical to the old upfront `.rodata`
    ## string walk, just grouped per module and placed beside this module's `.text`).
    push_str(sb, ".section .rodata\n")
    for rk in 0..tmc {
      ri := tms + rk
      rd := deref(decl_get(decls, ri))
      emit_rodata_decl(rd, decls, src, sb, a, ptr(seen), true)
    }
    ## TOOL-6 slice 1b-iii: this module's FIELD-NAME `.rodata` labels (folded from the former leading
    ## whole-program field-name block) — struct field / enum variant names for THIS module, emitted into
    ## the `.rodata` section opened just above (before this module's `.text`). Gated on `needs_fld` (the
    ## aggregate renderer `alloc::fmt::display`); the self-build never injects it, so this emits nothing
    ## there. Same decl-range order as the former upfront walk.
    if needs_fld {
      emit_field_name_rodata(decls, src, sb, tms, tmc)
    }
    ## TOOL-6 slice 1b-iii: this module's `.data` module-level GLOBALS (folded from the former leading
    ## whole-program `.data` block) — each global emits its OWN `.data`/`@section` header per-global, so
    ## no section header is needed here. The cell-emit helpers bump only the by-value `a` scratch (which
    ## re-treads from its entry offset each call), never `mar`, so this never climbs into the live `mar`
    ## buffers (`seen`/`insts`/`rb`/`pb`/`tbase`). For the self-build the `lower` module's `mut RA_ON`
    ## global now emits INSIDE lower's block rather than up front → a pure repositioning of that cell
    ## (RESEED; Stage1 == Stage2 deterministic). Fresh loop var `gk`/`gj` (distinct from `rk`/`tk`/`fk`).
    if has_gl {
      for gk in 0..tmc {
      gj := tms + gk
      d := deref(decl_get(decls, gj))
      if global_needs_storage(src, d) {
        ## the placement section: `@section("name")` overrides the derived `.data` (Memory §2.3).
        ## Emitted PER global (so an `@section` one is isolated and the next unattributed one is back
        ## in `.data`); a repeated `.data` directive is harmless.
        secn := global_section_name(src, d.name_start)
        if secn.n != 0 {
          ## a mutable global is allocatable + writable data — the custom section needs the ELF flags
          ## (`"aw",@progbits`) the built-in `.data` carries implicitly, else it is not loaded → a read
          ## of the label faults.
          push_str(sb, ".section ")
          push_str(sb, str_at((src + secn.s), secn.n))
          push_str(sb, ",\"aw\",@progbits\n")
        } else if local_is_mut(src, d.name_start) or LIBRARY_MODE == 0 {
          push_str(sb, ".data\n")
        } else {
          ## Memory §2.3: an initialized immutable static binding is read-only storage. Const arrays
          ## need an address for runtime indexing, but needing storage does not make that storage mutable.
          ## This first conformance slice is library-only; executable split visibility stays unchanged.
          push_str(sb, ".section .rodata\n")
        }
        ## Non-library emission retains global linkage for cross-object references. In a library
        ## object/archive, only `pub` data and explicit exports enter the external symbol table.
        gex := export_name(src, d.name_start, d.name_len)
        mut gglobal := mangled_symbol_is_global(src, d)
        if gex.n != 0 { gglobal = true }
        if gglobal {
          push_str(sb, ".globl ")
          emit_mangled_def(sb, src, d.mod_start, d.mod_len, d.name_start, d.name_len)
          push_str(sb, "\n")
        }
        emit_mangled_def(sb, src, d.mod_start, d.mod_len, d.name_start, d.name_len)
        push_str(sb, ":\n")
        sli := struct_lit_info(d.value)
        ali := array_lit_info(d.value)
        efi := enum_lit_full(d.value)
        gbyte := global_array_byte_eek(decls, src, d.name_start, d.name_len)
        gsti := str_lit_info(d.value)
        if efi.is_e {
          if is_union_decl(decls, src, efi.es, efi.el) {
            ## RAW UNION global initializer: payload starts at LABEL+0 and there is no discriminant.
            ## Multi-payload members remain fail-loud because §6.3 does not define their layout.
            if efi.np != 1 { panic("selfhost: multi-payload union global initializer is unsupported until the spec defines payload layout") }
            epay := arg_expr_at(efi.phead, 0, a)
            emit_global_data_cells(epay, sb, decls, src, a)
            epty := variant_payload_type(decls, src, efi.es, efi.el, efi.vs, efi.vl, a)
            mut epw : usize = 1
            if epty.n != 0 { epw = field_words(decls, src, epty.s, epty.n, 1, a) }
            euw := union_words(decls, src, efi.es, efi.el, a)
            mut epad := epw
            while epad < euw {
              push_str(sb, "  .quad 0\n")
              epad += 1
            }
          } else {
          ## an ENUM global (`mut S := Color.Green(n)`) — `[disc, payload…, pad]` ASCENDING: disc at
          ## LABEL+0, payload k at LABEL+(1+k)*8, padded to `1 + max_arity` words (the enum instance
          ## width), matching a local enum's slot layout so a copy reads valid words.
          push_str(sb, "  .quad ")
          push_int(sb, variant_index(decls, src, efi.es, efi.el, efi.vs, efi.vl, a))
          push_str(sb, "\n")
          mut eek := 0
          while eek < efi.np {
            push_str(sb, "  .quad ")
            push_int(sb, global_init_value(arg_expr_at(efi.phead, eek, a), decls, src))
            push_str(sb, "\n")
            eek += 1
          }
          emxw := enum_inst_words(decls, src, efi.es, efi.el, a)
          mut epk := efi.np
          while epk < emxw {
            push_str(sb, "  .quad 0\n")
            epk += 1
          }
          }
        } else if sli.is_s {
          ## a STRUCT global — its fields ASCENDING (the layout `LABEL + k*8` field reads/writes assume),
          ## emitted RECURSIVELY so a NESTED struct/float field lays out correctly (a nested struct is
          ## one arg but several words — iterating by word count overran the arg list and crashed).
          emit_global_data_cells(d.value, sb, decls, src, a)
        } else if gsti.is_s and gbyte != 0 {
          ## `mut B : [u8; N] = embed("...")` — the parser represents the baked bytes as a StrLit,
          ## but the declared array type owns the runtime storage contract. Do not emit the usual
          ## `{ptr,len}` str pair: that would make B eight-byte cells and break direct `B[i]`/`ptr(B[i])`.
          mut bk := 0
          glen := global_array_len(decls, src, d.name_start, d.name_len, d.value)
          while bk < glen {
            eb := bytes(str_at(unchecked bitcast(ptr(u8), gsti.ss + bk), 1))[0]
            push_str(sb, "  .byte ")
            push_int(sb, i64(usize(eb)))
            push_str(sb, "\n")
            bk += 1
          }
        } else if ali.is_a {
          ## An explicitly typed byte ARRAY global has byte-exact `.data` storage. Keep this
          ## deliberately at the top-level global emission site: recursive aggregate-field emission
          ## still uses the word/aggregate layout, and a byte array FIELD remains a separate layout
          ## surface. The initializer values are already compile-time checked by sema; `.byte` stores
          ## the low byte for u8/i8/bits8 without changing any call ABI.
          if gbyte != 0 {
            mut bk := 0
            while bk < ali.nel {
              push_str(sb, "  .byte ")
              push_int(sb, global_byte_init_value(arg_expr_at(ali.ehead, bk, a), decls, src))
              push_str(sb, "\n")
              bk += 1
            }
          } else {
          ## an ARRAY global — element `i` at `LABEL + i*stride*8`. A SCALAR element is one `.quad`;
          ## a STRUCT element (`[Pt(…), …]`) is its `struct_words` field cells, ascending in declaration
          ## order (matching the `for e in ARR` / indexed reads that copy `stride` words per element).
          ## An ENUM element (`[E.A(5), E.B(7)]`) is `[disc, payload…, pad]` at the UNIFORM element
          ## stride `1 + enum_inst_words` fixed by element 0 (`global_arr_enum` — the same helper the
          ## strided read / `match` / write use, so all four agree by construction).
          gaen := global_arr_enum(decls, src, d.value, a)
          mut k := 0
          while k < ali.nel {
            ekx := arg_expr_at(ali.ehead, k, a)
            eksli := struct_lit_info(ekx)
            if gaen.is_e {
              ## ENUM element `k`: its variant INDEX as the discriminant word, then its payload words,
              ## then zero padding out to the array's element stride — so a NULLARY variant and a
              ## narrower-payload variant both occupy exactly `stride` words and element `i` really is
              ## at `LABEL + i*stride*8`. Was ONE `.quad global_init_value(…)` per element (an enum
              ## literal has no scalar init value → every cell `0`, discriminants and payloads lost,
              ## the stride wrong) — a SILENT MISCOMPILE across the whole construct.
              gee := enum_lit_full(ekx)
              if gee.is_e == false {
                panic("selfhost: a module-level ARRAY global MIXES enum elements with non-enum ones — every element must be a variant of the same enum (they share one `.data` stride). [fail-loud guard: never a mis-strided image]")
              }
              push_str(sb, "  .quad ")
              push_int(sb, variant_index(decls, src, gee.es, gee.el, gee.vs, gee.vl, a))
              push_str(sb, "\n")
              mut gpk := 0
              while gpk < gee.np {
                gpe := arg_expr_at(gee.phead, gpk, a)
                ## a MULTI-WORD payload (struct / nested enum / str / float literal) has no single-`.quad`
                ## init value: it would image as `0` AND break the disc+payload word accounting.
                if struct_lit_info(gpe).is_s or enum_lit_info(gpe).is_e or str_lit_info(gpe).is_s or float_lit_span(gpe).n != 0 {
                  panic("selfhost: an ENUM-element ARRAY global whose variant payload is a struct / nested-enum / str / float literal is not imaged (only SCALAR payload words are) — build that array in a local instead. [fail-loud guard: never a silent zero payload]")
                }
                push_str(sb, "  .quad ")
                push_int(sb, global_init_value(gpe, decls, src))
                push_str(sb, "\n")
                gpk += 1
              }
              if gee.np + 1 > gaen.stride {
                panic("selfhost: an ENUM-element ARRAY global element is WIDER than the array's element stride (its variant carries more payload words than `enum_inst_words` reports) — the `.data` image would overrun the next element. [fail-loud guard: never a mis-strided image]")
              }
              mut gpp := gee.np + 1
              while gpp < gaen.stride {
                push_str(sb, "  .quad 0\n")
                gpp += 1
              }
            } else if eksli.is_s {
              ## a struct ELEMENT — emit its fields recursively (nested/float-field safe), same as a
              ## struct global; the read side copies `stride` = struct_words words per element.
              emit_global_data_cells(ekx, sb, decls, src, a)
            } else {
              push_str(sb, "  .quad ")
              push_int(sb, global_init_value(ekx, decls, src))
              push_str(sb, "\n")
            }
            k += 1
          }
          }
        } else if str_lit_info(d.value).is_s {
          ## a `str` global (`mut S := "hi"`) — a 2-word {ptr, len} cell: word 0 = the `.rodata` label
          ## address of the string bytes, word 1 = the byte length. `emit_global_data_cells`'s str case
          ## emits exactly that pair (mirroring a str LOCAL's {ptr, len} slot layout), so the `.data`
          ## holds both words; the read side (`emit_str_pair`'s str-global branch) loads them from
          ## `LABEL`/`LABEL+8`. Was MISSING → a str global fell to the scalar `else` and emitted one
          ## `.quad 0` (null ptr, no len word) → `.len` read 0 and `bytes(S)[i]` null-derefed (segfault).
          emit_global_data_cells(d.value, sb, decls, src, a)
        } else if float_lit_span(d.value).n != 0 {
          ## a FLOAT global — an 8-byte `.double` holding the IEEE-754 bits (the assembler computes them
          ## from the verbatim source text, as for a `.Lflt` float-literal cell). Read/written as bits.
          fls := float_lit_span(d.value)
          push_str(sb, "  .double ")
          push_str(sb, str_at((src + fls.s), fls.n))
          push_str(sb, "\n")
        } else {
          ## a scalar global — a single 8-byte cell.
          push_str(sb, "  .quad ")
          push_int(sb, global_init_value(d.value, decls, src))
          push_str(sb, "\n")
          }
        }
      }
    }
    ## this module's reachable `.text` fn defs (non-generic; generic fns emit as instances below).
    push_str(sb, ".text\n")
    for tk in 0..tmc {
    ti := tms + tk
    d := deref(decl_get(decls, ti))
    ## a comptime-VARIADIC fn (§7.1) is expand-only — skip it here (it has no standalone runtime body).
    ## An `@extern` fn (Modules §7) is a bodyless import — its definition lives in another object, so
    ## emit no body here; calls to it were routed to the external symbol by `emit_mangled_call`.
    if d.kind == 1 and not d.is_generic and not decl_is_variadic(d, src, deref(mar)) and extern_symbol(src, d.name_start, d.name_len).n == 0 {
      if rb_get(rb, ti) == 1 { emit_fn(d, ti, sb, ptr(pcx), nl) }
    }
    ## `@test` bodies belong only to the dedicated TOOL-5 artifact. Production executables and
    ## object/archive library artifacts must not carry test code or accidentally retain its helpers.
    else if d.kind == 5 and test_artifact { emit_fn(d, ti, sb, ptr(pcx), nl) }
    ## `@abi(syscall)` declarations are bodyless call-graph nodes, not unconditional roots.
    ## `mark_calls_*` already marks a kind-4 callee from each retained function; honor that
    ## reachability bit here so a declaration referenced only by an omitted @test body does not
    ## leak into a production object/archive. The dedicated test artifact seeds its @test roots,
    ## so its test-only syscall remains emitted.
    else if d.kind == 4 and rb_get(rb, ti) == 1 { emit_syscall_fn(d, src, sb) }
    mar.off = emit_hw                          ## reclaim this function's dead per-fn scratch
    }
  }
  ## the monomorphized generic instances — the whole-program block that the settled model places into its
  ## OWN segment / `.o` (attributing instances to using-modules is a later slice). Give it an explicit
  ## `.text` header so it is a clean, separately-liftable trailing block.
  ## slice 1c-β: open the instances span (closing the last module's span) BEFORE its `.text` header.
  if spanbase != 0 {
    cur := sb.len
    mut this_start := cur
    if sp_n == 0 { this_start = 0 }
    if sp_n != 0 { rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 2 + (sp_n - 1) * 2, cur - sp_prev) }
    rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 1 + sp_n * 2, this_start)
    sp_prev = this_start
    sp_n = sp_n + 1
  }
  push_str(sb, ".text\n")
  ni := ivec_len(ptr(insts))
  for i in 0..ni {
    e := ivec_at(ptr(insts), i)
    gd := deref(decl_at(Decl, rt::vec_get(deref(decls), e.gi)))
    ## CT-4/CT-5 INSTANTIATION guard: a generic fn carrying a `when P(T)` predicate is emitted ONLY for
    ## instances whose concrete `T` satisfies `P` (an inline comptime-bool over `size(T)`, folded by
    ## `guard_fold_inst` with `T` = this instance's type). A FALSE fold makes the instance AS-IF-ABSENT
    ## (skip emission — a call to it then references an undefined symbol → the build fails loud, exactly
    ## the spec's "the declaration does not exist for this `T`"); a TRUE or UNFOLDABLE guard emits. `src/`+
    ## `lib/` carry no generic `when` (every `gd.when_cond == 0`) → every instance emits → the GAS for the
    ## tree is byte-identical → the TOOL-1 fixpoint holds.
    mut g_ok := true
    if unchecked bitcast(usize, gd.when_cond) != 0 {
      ## collect up to the FIRST THREE type-PARAMETERS (params whose type spelling is `type`), each bound
      ## to the instance's concrete type slot (`e.ts/tl`, `e.ts2/tl2`, `e.ts3/tl3`) — so a guard over the
      ## 2nd/3rd type-param (`when size(V) <= 8`) folds against the correct instance type.
      mut gtn_s := 0
      mut gtn_l := 0
      mut gtn2_s := 0
      mut gtn2_l := 0
      mut gtn3_s := 0
      mut gtn3_l := 0
      mut gpp := gd.params_head
      while gpp != 0 {
        gpm := deref(param_p(gpp))
        if str_at((src + gpm.ts), gpm.tl) == "type" {
          if gtn_l == 0 { gtn_s = gpm.ns; gtn_l = gpm.nl }
          else if gtn2_l == 0 { gtn2_s = gpm.ns; gtn2_l = gpm.nl }
          else if gtn3_l == 0 { gtn3_s = gpm.ns; gtn3_l = gpm.nl }
        }
        gpp = gpm.next
      }
      gtp := GuardTP(gp_s = gtn_s, gp_l = gtn_l, its = e.ts, itl = e.tl,
                     gp2_s = gtn2_s, gp2_l = gtn2_l, its2 = e.ts2, itl2 = e.tl2,
                     gp3_s = gtn3_s, gp3_l = gtn3_l, its3 = e.ts3, itl3 = e.tl3)
      if guard_fold_inst(gd.when_cond, ptr(gtp), decls, src, a) == 0 { g_ok = false }
    }
    ## The instance collector intentionally runs before DCE so it can discover nested generic calls.
    ## In a library, however, it also sees bodies that are not roots (notably an excluded `main`), so
    ## discard instances whose generic declaration did not survive the actual root/call-graph walk.
    ## Executable/test artifacts retain the historical collector/emitter pairing.
    if g_ok and (library_mode == false or rb_get(rb, e.gi) == 1) {
      ipcx := PCtx(src = src, decls = decls, mar = mar, inst = true, its = e.ts, itl = e.tl, its2 = e.ts2, itl2 = e.tl2, its3 = e.ts3, itl3 = e.tl3)
      emit_fn(gd, 0, sb, ptr(ipcx), nl)
      mar.off = emit_hw                          ## reclaim this instance's dead per-fn scratch
    }
  }
  ifree := 0
  ## slice 1c-β: close the final (instances) span at the end of the GAS and publish the span count.
  if spanbase != 0 {
    if sp_n != 0 { rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 2 + (sp_n - 1) * 2, sb.len - sp_prev) }
    rt::rec_set(unchecked bitcast(ptr(mut u8), spanbase), 0, sp_n)
  }
}
