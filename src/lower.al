        ## leaves the OLD value in %v. Subtract is add of the negation (x86 has no `lock xsub`).
        emit_gas(arg_expr_at(args_head, 0, a), sb, cx, a, nl)   ## p
        emit_gas(arg_expr_at(args_head, 1, a), sb, cx, a, nl)   ## v
        push_str(sb, "  popq %rax\n  popq %rcx\n")
