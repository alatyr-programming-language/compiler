        push_str(sb, "  movq -")
        push_int(sb, i64((islot + 1) * 8))
        push_str(sb, "(%rbp), %rax\n  cmpq %rbx, %rax\n  setl %al\n  movzbq %al, %rax\n  cmpq $0, %rax\n  je ")
