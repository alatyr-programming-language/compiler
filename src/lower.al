        if b_is_ref {
          push_str(sb, "  movq -")
          push_int(sb, i64((bslot + 1) * 8))
          push_str(sb, "(%rbp), %rax\n  movq (%rax), %rax\n")
        } else {
          push_str(sb, "  movq -")
          push_int(sb, i64((bslot + 1) * 8))
          push_str(sb, "(%rbp), %rax\n")
        }
        push_str(sb, "  movq -")
        push_int(sb, i64((islot + 1) * 8))
        if byte_elem {
