        ## scratch temp first, then dispatched inline; an enum local dispatches directly.
        if si.is_ref {
          sir := materialize_ref_enum(si.base, si.es, si.el, sb, cx)
          emit_enum_match(head, sir, sb, cx, a, nl)
        } else {
          emit_enum_match(head, si, sb, cx, a, nl)
        }
