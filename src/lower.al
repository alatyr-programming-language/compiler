        ## struct PARAM (`is_ref`) holds a POINTER `P` @ slot `B` to the caller's Slice, whose fields ride
        ## the down-growing convention: ptr (field 0) at `(P)`, len (field 1) at `-8(P)`.
        push_str(sb, "  movq $0, -")
        push_int(sb, i64((islot + 1) * 8))
        push_str(sb, "(%rbp)\n")
        emit_label(sb, lg)
        push_str(sb, ":\n")
