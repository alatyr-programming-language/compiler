          push_int(sb, i64(vec_bslot * 8))
          push_str(sb, "(%rbp), %rbx\n")
        } else if b_is_ref {
          push_str(sb, "  movq -")
          push_int(sb, i64((bslot + 1) * 8))
          push_str(sb, "(%rbp), %rax\n  movq 8(%rax), %rbx\n")
