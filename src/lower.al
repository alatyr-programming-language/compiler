        emit_gas(arg_expr_at(args_head, 0, a), sb, cx, a, nl)   ## p
        emit_gas(arg_expr_at(args_head, 1, a), sb, cx, a, nl)   ## v (stack top)
        push_str(sb, "  popq %rax\n  popq %rcx\n  xchgq %rax, (%rcx)\n  pushq $0\n")
        return
      }
