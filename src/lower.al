          push_str(sb, "(%rbp), %rcx\n  leaq (%rax,%rcx,1), %rax\n  movzbq (%rax), %rax\n  movq %rax, -")
        } else {
          ## x = *(dataptr + __i * 8)  — scalar/word element, stride 8
          push_str(sb, "(%rbp), %rcx\n  leaq (%rax,%rcx,8), %rax\n  movq (%rax), %rax\n  movq %rax, -")
        }
        push_int(sb, i64((vslot + 1) * 8))
        push_str(sb, "(%rbp)\n")
        }
        oc := cx.cont
        cx.cont = i64(lcont)
        if cx.defer_active {
          defer_frame_push(cx)
          cx.loop_dframe[cx.loop_sp] = cx.defer_frame[cx.defer_sp - 1]
        }
        loop_push(cx, i64(ld), i64(lcont), 0)   ## depth-frame (a `for` is never value-bearing); byte-neutral
        ## TAIL: a `for` body's last statement is never the fn's return value (see the `While` arm).
        f1ov_tail := cx.tail
        cx.tail = false
        emit_stmts(fb, sb, cx, nl)
        cx.tail = f1ov_tail
        loop_pop(cx)
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        cx.cont = oc
        emit_label(sb, lcont)     ## `continue` lands here, then falls into the increment
        push_str(sb, ":\n")
        push_str(sb, "  movq -")
        push_int(sb, i64((islot + 1) * 8))
        push_str(sb, "(%rbp), %rax\n  addq $1, %rax\n  movq %rax, -")
        push_int(sb, i64((islot + 1) * 8))
        push_str(sb, "(%rbp)\n  jmp ")
        emit_label(sb, lg)
        push_str(sb, "\n")
        emit_label(sb, ld)
        push_str(sb, ":\n")
      } else {
        ioff := slot_of(cx.slots, cx.src, fns, fnl)
        ## i := lo
        emit_gas(flo, sb, cx, a, nl)
        push_str(sb, "  popq %rax\n  movq %rax, -")
        push_int(sb, (ioff + 1) * 8)
        push_str(sb, "(%rbp)\n")
        lguard := nl
        ldone := nl + 1
        lcont := nl + 2      ## `continue` target: the increment (so `i` still advances)
        nl += 3
        emit_label(sb, lguard)
        push_str(sb, ":\n")
        ## guard: i < hi  → %rax = i, %rbx = hi ; cmpq %rbx,%rax ; set{b,l} ; je done if false.
        ## A range index takes the upper bound's proven signedness: `0..s.len` is unsigned, while
        ## an unresolved bound retains the conservative signed fallback used by the comparison scan.
        push_str(sb, "  movq -")
        push_int(sb, (ioff + 1) * 8)
        push_str(sb, "(%rbp), %rax\n  pushq %rax\n")
        emit_gas(fhi, sb, cx, a, nl)
        push_str(sb, "  popq %rbx\n  popq %rax\n  cmpq %rbx, %rax\n")
        if range_bound_is_unsigned(fhi, cx) {
          push_str(sb, "  setb %al\n")
        } else {
          push_str(sb, "  setl %al\n")
        }
        push_str(sb, "  movzbq %al, %rax\n  cmpq $0, %rax\n  je ")
        emit_label(sb, ldone)
        push_str(sb, "\n")
        oc := cx.cont
        cx.cont = i64(lcont)
        if cx.defer_active {
          defer_frame_push(cx)
          cx.loop_dframe[cx.loop_sp] = cx.defer_frame[cx.defer_sp - 1]
        }
        loop_push(cx, i64(ldone), i64(lcont), 0)   ## depth-frame (a `for` is never value-bearing); byte-neutral
        ## TAIL: a `for` body's last statement is never the fn's return value (see the `While` arm).
        f2ov_tail := cx.tail
        cx.tail = false
        emit_stmts(fb, sb, cx, nl)   ## loop body
        cx.tail = f2ov_tail
        loop_pop(cx)
        if cx.defer_active {
          emit_defer_chain(sb, cx, a, nl, cx.defer_frame[cx.defer_sp - 1])
          defer_frame_pop(cx)
        }
        cx.cont = oc
        emit_label(sb, lcont)        ## `continue` lands here, then falls into the increment
        push_str(sb, ":\n")
        ## i = i + 1
        push_str(sb, "  movq -")
        push_int(sb, (ioff + 1) * 8)
        push_str(sb, "(%rbp), %rax\n  addq $1, %rax\n  movq %rax, -")
        push_int(sb, (ioff + 1) * 8)
        push_str(sb, "(%rbp)\n  jmp ")
        emit_label(sb, lguard)
        push_str(sb, "\n")
        emit_label(sb, ldone)
        push_str(sb, ":\n")
      }
        s = nx
      }
      ## `comptime if <cond> { then } else { else }` — fold the condition and emit ONLY the taken
      ## branch's statements (Comptime §9.2: emission applies to the SELECTED branch). A condition the
      ## lower cannot fold is a LOCATED REJECT (`comptime_reject_cond`) — it used to emit NEITHER
      ## branch with no diagnostic, silently deleting both arms' effects.
      Stmt::CompIf(ccond, cthen, celse, nx) => {
        emit_st_comp_if(ccond, cthen, celse, nx, sb, cx, a, nl)
        s = nx
      }
      ## `comptime for <var> in typeinfo(X).fields/.components/.elements/.variants { body }` — UNROLL
      ## over `X`'s members: for each, bind the comptime var (`cf_*`) to that member (name + type) and
      ## emit the body. Inside, a `CompField` `v.(var)` resolves to `Field(v, <member>)` and a
      ## `<var>.type` type-arg to the member's type. The binding is saved/restored (single-level).
      ##
      ## The ITERATED TYPE is the header's OWN `typeinfo(X)` argument, recovered by SOURCE-SCAN and
      ## resolved through this instance's type-param bindings (`compfor_target_type`) — the `CompFor`
      ## AST node drops the argument at parse time, and keying off `cx.it` alone unrolled over the
      ## WRONG type: a concrete `typeinfo(S)` at top level (no instance) unrolled ZERO times, and
      ## `typeinfo(B)` inside an `A` instance unrolled over A. Both were silent. Every header
      ## `src/`+`lib/` spells is `typeinfo(T)` with T the 1st type-param, which resolves to exactly the
      ## `cx.it` used before → byte-identical.
      Stmt::CompFor(cvs, cvl, cisvar, cbody, nx) => {
        emit_st_comp_for(cvs, cvl, cisvar, cbody, sb, cx, a, nl)
        s = nx
      }
      ## `comptime for i in lo .. hi { body }` — UNROLL at compile time: for each constant `k` in
      ## `[lo, hi)`, bind the loop var `i` (a scalar local) to `k` (`movq $k → its slot`) then emit the
      ## body. The control flow is erased (no runtime loop); each `Var(i)` in the body reads the
      ## constant from the slot. Bounds are compile-time integer constants (`global_init_value`:
      ## literal / module const / const arithmetic).
      Stmt::CompForRange(rvs, rvl, rlo, rhi, rbody, nx) => {
        emit_st_comp_for_range(rvs, rvl, rlo, rhi, rbody, sb, cx, a, nl)
        s = nx
      }
      ## `comptime match typeinfo(T) { Struct(_) => … _ => … }` — evaluate T's KIND and emit ONLY the
      ## matching arm's body (or the `_` fallback). The comptime sibling of `Stmt::Match`.
      Stmt::CompMatch(cmsc, cmah, nx) => {
        ## `comptime match var.payload { Some(_) => …, None => … }` (`display`'s enum arm): fold on the
        ## CURRENT variant's arity — `Variant.payload` is `Some(type)` for a payloaded variant, `None`
        ## for a unit variant (appendix §4.1). Choose the `Some` arm iff the variant carries a payload
        ## (`variant_payload_type` non-empty over the instance's enum `cx.it`), else the `None`/`_` arm.
        if is_cf_payload_ref(cmsc, cx) {
          pty := variant_payload_type(cx.decls, cx.src, cx.it_s, cx.it_l, cx.cf_curvar_s, cx.cf_curvar_l, deref(cx.mar))
          has_pay := pty.n != 0
          mut pchosen := 0
          mut pwild := 0
          mut pcarm := cmah
          while pcarm != 0 {
            pcam := deref(arm_p(pcarm))
            if pcam.wild != 0 { pwild = pcarm }
            else {
              pnm := str_at((cx.src + pcam.vs), pcam.vl)
              if has_pay and pnm == "Some" { pchosen = pcarm }
              if (has_pay == false) and pnm == "None" { pchosen = pcarm }
            }
            pcarm = pcam.next
          }
          if pchosen == 0 { pchosen = pwild }
          if pchosen != 0 { emit_stmts(deref(arm_p(pchosen)).body_stmts, sb, cx, nl) }
          s = nx
        } else {
        ## `comptime match typeinfo(p)` (p = the payload binding) folds on the PAYLOAD's type
        ## (`cf_pay_ty`), not the instance type — rebind `cx.it` for the fold + the chosen arm body
        ## (like the Brand-arm underlying rebind below), then restore. Lets `display`'s enum arm pick
        ## the `Tuple(_)` arm for a multi-component payload (rendered `(a, b)` without a second wrap).
        pti := is_cf_payload_typeinfo(cmsc, cx, a)
        sav_pit_s := cx.it_s
        sav_pit_l := cx.it_l
        if pti { cx.it_s = cx.cf_pay_ty_s; cx.it_l = cx.cf_pay_ty_l }
        kind := comptime_type_kind(cx.it_s, cx.it_l, cx.decls, cx.src)
        ## The scalar NUMERIC sub-kind (Bool/Char/Int/Float/other) for an INNER `match k` over a
        ## `Scalar`'s kind binding. Its arm names (`Int`/`Float`/…) are disjoint from the outer
        ## `typeinfo(T)` arm names (`Struct`/`Scalar`/…), so this second dispatch is inert for the
        ## type-kind matches `src/` uses (`comptime_num_kind_of_name` → -1 there) → fixpoint-neutral.
        nkind := comptime_scalar_num_kind(cx.it_s, cx.it_l, cx.src)
        mut chosen := 0
        mut cwild := 0
        mut carm := cmah
        while carm != 0 {
          cam := deref(arm_p(carm))
          if cam.wild != 0 { cwild = carm }
          else if comptime_kind_of_name(cx.src, cam.vs, cam.vl) == kind { chosen = carm }
          else if comptime_num_kind_of_name(cx.src, cam.vs, cam.vl) == nkind { chosen = carm }
          carm = cam.next
        }
        if chosen == 0 { chosen = cwild }
        if chosen != 0 {
          ## For the `Brand(under, _)` arm (kind 6): the arm body dispatches on the UNDERLYING type
          ## (`comptime match typeinfo(under)` + `i64(v)`/`u64(v)`/`f64(v)` peels), but the folder
          ## keys every nested `comptime match` off `cx.it` (the scrutinee expr is not read). Rebind
          ## `cx.it` to the brand's underlying `U` for the arm body so the nested Scalar/kind dispatch
          ## folds on `U`, then restore it. (A brand over an unsigned/bits/signed underlying renders
          ## correctly; a FLOAT-underlying brand still needs the value's slot marked float — deferred.)
          if kind == 6 {
            bu := brand_underlying(cx.decls, cx.src, cx.it_s, cx.it_l)
            sav_s := cx.it_s
            sav_l := cx.it_l
            cx.it_s = bu.s
            cx.it_l = bu.n
            emit_stmts(deref(arm_p(chosen)).body_stmts, sb, cx, nl)
            cx.it_s = sav_s
            cx.it_l = sav_l
          } else {
            emit_stmts(deref(arm_p(chosen)).body_stmts, sb, cx, nl)
          }
        }
        cx.it_s = sav_pit_s
        cx.it_l = sav_pit_l
        s = nx
        }
      }
    }
  }
}

## Emit a real function definition for a kind-1 `Decl`. Builds the name→slot map (params
## first — param `i` at slot `i`, in declaration order — then the body's distinct locals),
## emits the callee label + frame prologue (`pushq %rbp; movq %rsp, %rbp; subq $N, %rsp`
## with N = slots * 8, 16-byte rounded), spills the argument registers (param `i` from
## `argreg(i)` → slot `i`) for up to 6 params, lowers the body statement list then the
## trailing return expression (popped into
## `%rax`), and emits the epilogue (`movq %rbp, %rsp; popq %rbp; ret`). `mar` is a mutable
## arena (the slot `Vec` is allocated from it); `a` is the AST arena (resolves Stmt/Arm
## handles); `nl` is the shared fresh-label counter.
## Program-emit inputs bundled and passed **by pointer** to `emit_fn`: the source base
## (name/literal spans), the program's decl vector (struct layout lookup), the mutable arena
## (the per-fn slot `Vec` is allocated from it), and the AST arena (resolves Stmt/Arm/Field
## handles). Bundling them keeps `emit_fn` within the argument-register budget — the two
## `in out` params (the output buffer + the fresh-label counter) must land in registers, so
## adding `decls` directly would spill `nl` past them (the documented arg-register limit).
## GENERICS tier: when emitting a generic fn INSTANCE, `inst` is true and `its`/`itl` is the
## concrete type-argument lexeme span — the label becomes `<module>__<fn>__<typetag>` and the
## leading type parameter (param 0) is SKIPPED (no slot, no register spill); value param `i`
## (i≥1) is then spilled from argument register `i-1`. For an ordinary fn `inst` is false.
## NOTE: the AST arena is carried as the POINTER `mar` only — NOT a `a : rt::Arena` VALUE field.
## A struct-valued (multi-word) field mid-struct is not yet supported by the lean layout machinery
## (parser `wsize`/`struct_words`/`field_word_offset`/`emit_struct_assign` assume 1-word fields, and
## a `deref(p.mar)` Field-of-struct can't be passed by-ref); the lean path B is handle/pointer-based anyway,
## so the arena flows as `mar` and a read site uses `deref(p.mar)` (the proven `deref(<ptr>)` arg
## shape the parser uses everywhere via `node_alloc(deref(pc.arena), …)`).
pub PCtx := struct {
  src : ptr(u8),
  decls : ptr(rt::Vec),
  mar : ptr(mut rt::Arena),
  inst : bool, its : usize, itl : usize,
  its2 : usize, itl2 : usize,
  its3 : usize, itl3 : usize,
}

## AGGREGATE-PARAM tier — bind a function parameter's slot. A struct/array parameter is passed
## BY REFERENCE (its slot holds a POINTER to the caller's aggregate word 0), so it occupies ONE
## word (like a scalar) but is marked `is_ref = true` with the aggregate's layout (`ek`/`sns`/
## `snl`/`estride`/`eek`) so field/element access dereferences the pointer. A struct param `p : P`
## (its type span resolves to a kind-2 `Decl`) binds `ek = 2`, type span `P`. An array param
## `a : [T; N]` (`pm.pmode == 1`) binds `ek = 5` with the element layout resolved from the element
## type span `T` (a word-sized element → stride 1, eek 0; a struct/enum element → its stride).
## A scalar/pointer/enum param binds an ordinary one-word scalar slot (`bind_slot`). The pointer
## itself is one word spilled from the argument register like any scalar (no new ABI work).
## The BASE type-name span of a type annotation — strips a generic type-argument application
## `Name(args)` → `Name` (returns the head ident up to the first `(`). A generic-struct/enum param
## `q : Box(T)` (or its instance-substituted `Box(u64)`) must resolve its DECL + fields by the bare
## `Box` (`struct_decl_of`/`field_word_offset` streq the WHOLE span, so `Box(T)` matched no decl →
## the field offset came back -1 → a malformed `--8(%rax)`). A paren-free name (`Quad`, `str`, `ptr`)
## is returned unchanged, so non-generic params are byte-identical.
base_type_name := fn(src : ptr(u8), ts : usize, tl : usize) -> CSpan {
  mut i := 0
  while i < tl {
    if str_at((src + ts + i), 1) == "(" { return CSpan(s = ts, n = i) }
    i += 1
  }
  CSpan(s = ts, n = tl)
}

bind_param := fn(in out slots : SVec, pm : Param, src : ptr(u8), decls : ptr(rt::Vec), a : rt::Arena, synth : ptr(mut rt::Arena), gps : usize, gpl : usize, its : usize, itl : usize, gps2 : usize, gpl2 : usize, its2 : usize, itl2 : usize, gps3 : usize, gpl3 : usize, its3 : usize, itl3 : usize) {
  ## GENERICS: substitute the enclosing generic fn's type-parameter (`gps`/`gpl`) with the
  ## monomorphization INSTANCE's concrete type (`its`/`itl`) in the param's type span, so a
  ## param `x : T` of a generic fn is sized as the instance type (e.g. a 3-word `Tok`) rather
  ## than a scalar. Non-generic / non-T params keep their own type span. A SECOND type-param
  ## (`gps2`/`gpl2` → `its2`/`itl2`, for `map(T, U, …)`) substitutes the same way.
  mut pts := pm.ts
  mut ptl := pm.tl
  if gpl != 0 and itl != 0 and streq(src, pm.ts, pm.tl, gps, gpl) { pts = its; ptl = itl }
  else if gpl2 != 0 and itl2 != 0 and streq(src, pm.ts, pm.tl, gps2, gpl2) { pts = its2; ptl = itl2 }
  else if gpl3 != 0 and itl3 != 0 and streq(src, pm.ts, pm.tl, gps3, gpl3) { pts = its3; ptl = itl3 }
  ## GENERIC POINTER-to-type-param param `p : ptr(V)` / `ptr(mut V)`: substitute the pointee `V`
  ## (`pm.pps`/`pm.ppl`) through the instance Subst so the ek 6/ek 7 (pointer-to-enum / -struct)
  ## checks below see the CONCRETE pointee, binding `p` as a pointer-to-struct/enum instead of a bare
  ## scalar. Without it a `deref(p)` / `deref(p) = v` through a generic `ptr(V)` param copied ONE word.
  ## Non-generic / concrete pointee → no subst fires → `ppn` == `pm.pps`/`pm.ppl` (byte-identical).
  mut ppn_s := pm.pps
  mut ppn_l := pm.ppl
  if gpl != 0 and streq(src, pm.pps, pm.ppl, gps, gpl) { ppn_s = its; ppn_l = itl }
  else if gpl2 != 0 and streq(src, pm.pps, pm.ppl, gps2, gpl2) { ppn_s = its2; ppn_l = itl2 }
  else if gpl3 != 0 and streq(src, pm.pps, pm.ppl, gps3, gpl3) { ppn_s = its3; ppn_l = itl3 }
  ## §7.2 SLICE-VARIADIC param `name : ...T` (`pmode == 3`; `ts`/`tl` = the element type `T`). The call
  ## site gathers the trailing args into a contiguous block + passes a `{ptr, len}` block ADDRESS, so
  ## the callee binds the param EXACTLY like a scalar-element `Slice(T)` PARAM: a by-reference slice
  ## (`ek 5`, `is_ref`, `sns == 1` = a POINTER to the {ptr,len} block, `snl == 1` = a runtime len).
  ## `for x in name` / `name[i]` / `name.len()` then read it through the shared by-ref slice-param path.
  ## A native scalar element (`u64`/`usize`/`i64`/`isize`) binds `eek == 0`; a FLOAT element (`f64`,
  ## or a float-underlying brand) binds `eek == 9` so `for x in name` yields a float loop var and
  ## `name[i]` reads as an `f64` (the xmm path) — the gathered args already ride the slice as raw
  ## IEEE-754 word bits (the call-site `emit_gas` on each float arg stores one word), so ONLY the read
  ## classification differs. A struct/enum element is a follow-up (fail-loud, so no silent miscompile).
  if pm.pmode == 3 {
    ## A STRUCT/ENUM element `...Pt` / `...E` binds like a struct/enum-element `Slice(T)` param: a
    ## by-ref slice (ek 5, is_ref) carrying the element TYPE span in `sns`/`snl` (so `x.field` / the
    ## loop var resolve the element type) and the element word stride. The by-ref for-loop + Index read
    ## paths already handle eek 2/3, and `slice_param_elem_span` now recovers `T` from the `...T` source.
    vebn := base_type_name(src, pm.ts, pm.tl)
    ve_sdi := struct_decl_of(decls, src, vebn.s, vebn.n)
    ve_edi := enum_decl_of(decls, src, vebn.s, vebn.n)
    if ve_sdi >= 0 or ve_edi >= 0 {
      mut vestride := 1
      mut veek2 : u8 = 2
      if ve_sdi >= 0 { vestride = struct_words(decls, src, vebn.s, vebn.n, a) }
      else { vestride = 1 + enum_inst_words(decls, src, vebn.s, vebn.n, a); veek2 = 3 }
      voff2 := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = voff2, sns = vebn.s, snl = vebn.n, ek = 5, estride = vestride, eek = veek2, is_ref = true))
      return
    }
    vesl := str_at((src + pm.ts), pm.tl)
    vfloat := type_is_float(decls, src, pm.ts, pm.tl)
    if not (vesl == "u64" or vesl == "usize" or vesl == "i64" or vesl == "isize" or vfloat) {
      panic("selfhost: §7.2 slice variadic `...T` supports a native scalar, float, struct, or enum element in this increment")
    }
    mut veek : u8 = 0
    if vfloat { veek = 9 }
    voff := svec_len(ptr(slots))
    svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = voff, sns = 1, snl = 1, ek = 5, estride = 1, eek = veek, is_ref = true))
    return
  }
  raw_slice := slice_param_elem_span(src, pm.ns, pm.nl)
  ## SUBSTITUTE a type-PARAM element (`Slice(T)` → `Slice(u64)` for this instance) via the same Subst
  ## as the whole-param path above. Without it a GENERIC `Slice(T)` param's element stayed `T` — matching
  ## no scalar/struct/enum — so the param fell through and mis-bound as a LOCAL array (`is_ref = false`):
  ## `s[i]` then used `leaq` (the slot ADDRESS) instead of `movq`+deref (the by-ref block pointer), so a
  ## generic slice element WRITE `s[i]=x` overwrote the param slot (lost) and a READ returned the block
  ## pointer. (`count_if(u64,…)` etc. worked only where the instance already carried a substituted span.)
  mut ess0 := raw_slice.s
  mut esn0 := raw_slice.n
  if esn0 != 0 {
    if gpl != 0 and itl != 0 and streq(src, ess0, esn0, gps, gpl) { ess0 = its; esn0 = itl }
    else if gpl2 != 0 and itl2 != 0 and streq(src, ess0, esn0, gps2, gpl2) { ess0 = its2; esn0 = itl2 }
    else if gpl3 != 0 and itl3 != 0 and streq(src, ess0, esn0, gps3, gpl3) { ess0 = its3; esn0 = itl3 }
  }
  early_slice := CSpan(s = ess0, n = esn0)
  if early_slice.n != 0 {
    mut sstride0 := 1
    mut seek0 : u8 = 0
    mut ssns0 := 0
    mut ssnl0 := 0
    mut esdi0 : i64 = -1
    mut eedi0 : i64 = -1
    if early_slice.n < 64 { esdi0 = struct_decl_of(decls, src, early_slice.s, early_slice.n); eedi0 = enum_decl_of(decls, src, early_slice.s, early_slice.n) }
    if esdi0 >= 0 {
      if is_packed(decls, src, early_slice.s, early_slice.n) {
        panic("selfhost: a Slice whose element is a @packed struct is not supported by the word-granular slice tier; byte-precise element stride and packed field offsets are a deferred slice; rejected rather than silently miscompiled")
      }
      sstride0 = struct_words(decls, src, early_slice.s, early_slice.n, a); seek0 = 2; ssns0 = early_slice.s; ssnl0 = early_slice.n
    }
    else if eedi0 >= 0 { sstride0 = 1 + enum_inst_words(decls, src, early_slice.s, early_slice.n, a); seek0 = 3; ssns0 = early_slice.s; ssnl0 = early_slice.n }
    esl0 := str_at((src + early_slice.s), early_slice.n)
    ## A `Slice(str)` element is a 2-word {ptr,len} value (eek 4, stride 2) — like a str-element ARRAY
    ## (`AElem` eek 4). Without this it fell through to the generic path and its element was read as one
    ## word (the ptr), zeroing the len (a silent word-1 drop). Marked `snl == 1` (a runtime-len slice)
    ## like a scalar-element slice — str carries no nominal type span. src/ has no `Slice(str)` (only in
    ## comments) → dormant for the self-host build → fixpoint-neutral.
    is_str_slice := esl0 == "str"
    known_scalar_slice := esl0 == "u64" or esl0 == "usize" or esl0 == "i64" or esl0 == "isize" or esl0 == "f64"
    if is_str_slice { sstride0 = 2; seek0 = 4 }
    if seek0 == 2 or seek0 == 3 or known_scalar_slice or is_str_slice {
      if known_scalar_slice or is_str_slice { ssns0 = 1; ssnl0 = 1 }
      off0 := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off0, sns = ssns0, snl = ssnl0, ek = 5, estride = sstride0, eek = seek0, is_ref = true))
      return
    }
  }
  ## Types §9.4: a generic-STRUCT param whose type-args name the callee's OWN type-parameters
  ## (`b : Box(T)` in `unbox := fn(T : type, b : Box(T)) -> T`) resolves to the INSTANTIATION
  ## (`Box(P)`). The base-name binding below records `Box` — whose `(T)` re-read from source sizes a
  ## type-param field as ONE word — so a by-ref `Box(P)` param read `b.v` as a single word and the
  ## rest of the aggregate was lost (a silent truncation). 0/0 → `pts`/`ptl` unchanged for every
  ## non-generic / scalar-type-arg param (byte-identical).
  gpp := subst_inst_struct_span(pts, ptl, decls, src, synth, gps, gpl, its, itl, gps2, gpl2, its2, itl2, gps3, gpl3, its3, itl3)
  if gpp.n != 0 { pts = gpp.s ; ptl = gpp.n }
  ## For a generic-STRUCT/ENUM param `q : Box(T)` (the whole span isn't the bare type-param, so the
  ## substitution above doesn't fire) resolve the decl + fields by the BASE name `Box` (all word-sized
  ## instances share one layout, D-generic-struct). Paren-free names are unchanged → byte-identical.
  bn := base_type_name(src, pts, ptl)
  bs := bn.s
  bl := bn.n
  if pm.pmode == 1 {
    ## ARRAY param `a : [T; N]` — element layout from the element type span `T`.
    mut estride := 1
    mut eek : u8 = 0
    mut ess := 0
    mut esl := 0
    sdi := struct_decl_of(decls, src, bs, bl)
    edi := enum_decl_of(decls, src, bs, bl)
    if sdi >= 0 {
      estride = struct_words(decls, src, bs, bl, a); eek = 2; ess = bs; esl = bl
    } else if edi >= 0 {
      estride = 1 + enum_inst_words(decls, src, bs, bl, a); eek = 3; ess = bs; esl = bl
    } else if type_is_float(decls, src, bs, bl) {
      ## FLOAT-element array / uniform float-tuple param (`a : [f64; N]`, `t : (f64, f64)` — a tuple
      ## param reaches this branch as a `pmode == 1` array of its first component). One word per
      ## element (the IEEE-754 bits), tagged `eek = 9` so `a[i]` / `t.N` read + arithmetic take the
      ## xmm (float) path (`is_float_expr`'s Index arm keys on `eek == 9`). Without this the element
      ## was `eek = 0` (integer): `t.0 + t.1` mis-lowered as an integer `addq` over the raw bits.
      ## Gated on a real `f64`/`f32` element (or a float-underlying brand); src/ has no float
      ## array/tuple PARAM, so this never fires for the self-host build → the TOOL-1 fixpoint holds.
      eek = 9
    } else {
      ## Concrete byte-element fixed arrays use the same packed byte ABI as typed local arrays:
      ## one byte stride, static N in `sns`, and the caller's data pointer in the by-ref slot.
      eek = byte_type_eek(src, bs, bl)
    }
    ## SCALAR-element array param `a : [T; N]`: record the STATIC length N (captured by the parser into
    ## the param's `pps` slot) in `sns` (unused for a scalar element — a struct/enum element keeps its
    ## type span there instead) so `a[i]` can be bounds-checked in the callee (I11): the length is
    ## statically known from the param's `[T; N]` type — no passed length needed. `snl` stays 0,
    ## distinguishing it from a runtime-len slice (`snl == 1`). A float element (`eek == 9`) is scalar-
    ## width, so it ALSO records N here for the same bounds check.
    if eek == 0 or is_byte_array_eek(eek) or eek == 9 { ess = pm.pps }
    off := svec_len(ptr(slots))
    svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = ess, snl = esl, ek = 5, estride = estride, eek = eek, is_ref = true))
  } else if str_at((src + pts), 1) == "[" {
    ## a GENERIC array param `a : T` whose instance type-arg substituted `T → [E; N]` (`pm.pmode == 0`,
    ## since the syntax was the bare `T`, not `[…]` — so the pmode-1 array branch above did not fire).
    ## Bind it as an ARRAY (ek 5, by-ref) with the element layout from `[E; N]`'s element span, so
    ## `a[i]` indexes with the right stride (else it fell to the scalar fallthrough → mis-read).
    aes := array_elem_span(src, pts, ptl)
    mut gestride := 1
    mut geek : u8 = 0
    mut gess := 0
    mut gesl := 0
    gsdi := struct_decl_of(decls, src, aes.s, aes.n)
    gedi := enum_decl_of(decls, src, aes.s, aes.n)
    if gsdi >= 0 {
      gestride = struct_words(decls, src, aes.s, aes.n, a); geek = 2; gess = aes.s; gesl = aes.n
    } else if gedi >= 0 {
      gestride = 1 + enum_inst_words(decls, src, aes.s, aes.n, a); geek = 3; gess = aes.s; gesl = aes.n
    } else if type_is_float(decls, src, aes.s, aes.n) {
      ## FLOAT-element generic array param (`a : T`, `T → [f64; N]`) — the float dual of the struct/enum
      ## cases: one word per element, `eek = 9` for the xmm read/arithmetic path. Neutral (no float
      ## generic-array param in src/).
      geek = 9
    } else if byte_type_eek(src, aes.s, aes.n) == 8 {
      ## BYTES generic array instance (`T → [u8; N]`) — preserve the same packed byte parameter ABI
      ## as a concrete `[u8; N]` parameter. The caller-side return-carrier seam above relies on this
      ## substituted parameter retaining its static N and byte element kind; other byte kinds remain
      ## outside this bounded consumer increment rather than inheriting an unsigned ABI accidentally.
      geek = 8
      gess = parse_arr_len(src, pts, ptl)
    }
    off := svec_len(ptr(slots))
    svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = gess, snl = gesl, ek = 5, estride = gestride, eek = geek, is_ref = true))
  } else {
    sdi := struct_decl_of(decls, src, bs, bl)
    edi := enum_decl_of(decls, src, bs, bl)
    if sdi >= 0 {
      ## STRUCT param `p : P` — by-reference, type span `P` (base name) for field resolution.
      ##
      ## CLAYOUT S3(a) FENCE. Every consumer of an `ek = 2` by-ref struct param resolves its fields
      ## with `field_word_offset` — one machine word per field — so a STANDARD-BYTE-LAYOUT parameter is
      ## read at the wrong offsets end to end. Measured: `readx := fn(o : Outer) -> u64 { o.inner.x }`
      ## over `struct { data : [u8;4], inner : Inner }` emitted `movq 32(%rax), %rax` — word 4, because
      ## the 4-BYTE array counts as four WORDS — and returned 0 instead of 20 (a64/rv64/wasm trap on
      ## the same program). The word-layout control `struct { pad : u64, inner : Inner }` returns 20
      ## correctly, so this is the byte tier's gap, not a general one. Rejecting at the BINDING catches
      ## every downstream use at once (field reads, the caller's argument block, the return ABI); the
      ## byte-precise param/return ABI is audit stage S3(e).
      ## Gated on the struct carrying an AGGREGATE field, which is the exact line between what the
      ## by-ref param path already gets right and what it gets wrong: `test/standard_byte_array_field.al`
      ## passes `struct { data : [u8;4], tail : u16 }` by value and reads `s.data[i]`/`s.tail`
      ## correctly (measured 42 on x86_64, before and after this commit), because those two field
      ## kinds have byte-aware param arms. A nested AGGREGATE field does not.
      if layout_kind_is_byte(layout_kind(decls, src, bs, bl, a)) and std_struct_has_aggregate_field(decls, src, bs, bl, a) {
        lower_show_src_line(src, pm.ns)
        panic("selfhost: a standard-byte-layout struct with an AGGREGATE field cannot be a by-value PARAMETER yet (the source line above) — the by-reference struct-param ABI addresses fields by WORD index while this type is laid out in BYTES, so every field read in the callee would use the wrong offset. Pass the individual fields, or a `ptr(mut T)` and write through it.")
      }
      off := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = bs, snl = bl, ek = 2, estride = 1, eek = 0, is_ref = true))
    } else if edi >= 0 {
      ## ENUM param `e : E` — by-reference (like a struct), type span `E` for variant
      ## resolution. The slot holds a POINTER to the caller's enum word 0; a `match e`
      ## materializes the pointee's discriminant + payload words into the scratch temp,
      ## then dispatches inline (`scrut_enum_info` reports `is_ref`).
      ## GENERIC enum-value param `self : Option(V)` (`unwrap`/`expect`/`ok`): override the recorded
      ## type span with the SUBSTITUTED instance (`Option(Rec)`) when a type-arg resolves to a multi-word
      ## struct, so `materialize_ref_enum`/`enum_inst_words` size the payload correctly and the `match`
      ## binds it as a struct (else the raw `Option(V)` span sized the payload ONE word → truncation).
      ## 0/0 for scalar / 1-word / non-generic → keep the base span (byte-identical).
      mut esns := bs
      mut esnl := bl
      psub := subst_param_enum_span(pts, ptl, decls, src, a, synth, gps, gpl, its, itl, gps2, gpl2, its2, itl2, gps3, gpl3, its3, itl3)
      if psub.n != 0 { esns = psub.s; esnl = psub.n }
      off := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = esns, snl = esnl, ek = 3, estride = 1, eek = 0, is_ref = true, tmod_s = 0, tmod_l = 0))
    } else if str_at((src + pts), ptl) == "str" {
      ## STR param `s : str` — a str is a 2-word {ptr, len} value, so it is passed BY REFERENCE
      ## (like a struct/array param): the slot holds a POINTER to the caller's str word-0 (the
      ## ptr word), and `emit_str_pair` derefs it (ptr = `(%rax)`, len = `-8(%rax)`, the
      ## down-growing layout). ONE pointer slot so the 1-param-1-register spill mapping holds.
      off := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = 0, snl = 0, ek = 4, estride = 1, eek = 0, is_ref = true))
    } else if str_at((src + pts), ptl) == "ptr" and enum_decl_of(decls, src, ppn_s, ppn_l) >= 0 {
      ## POINTER-TO-ENUM param `p : ptr(E)` — the arena-AST shape (`match deref(p)`). The slot
      ## holds the POINTER value (a plain scalar, passed by value); `ek = 6` records "pointer to
      ## enum `E`" with the pointee enum's type span (`ppn`, the Subst-resolved pointee) so
      ## `scrut_enum_info` resolves a `match deref(p)` — the pointer is materialized like a by-ref enum.
      off := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = ppn_s, snl = ppn_l, ek = 6, estride = 1, eek = 0, is_ref = true, tmod_s = 0, tmod_l = 0))
    } else if str_at((src + pts), ptl) == "ptr" and struct_decl_of(decls, src, ppn_s, ppn_l) >= 0 {
      ## POINTER-TO-STRUCT param `p : ptr(S)` (e.g. the parser's `a : ptr(mut rt::Arena)`). The slot
      ## holds the POINTER value; `ek = 7` records "pointer to struct `S`" with the pointee struct
      ## span (`ppn`, the Subst-resolved pointee — a generic `ptr(V)` binds as the instance struct). KEY:
      ## this lets `deref(p)` passed as a call ARG to a by-ref aggregate param pass the POINTER itself
      ## (emit_arg's `Deref` case) — instead of a scalar word-load of `*p` — AND a `deref(p) = v` /
      ## `x := deref(p)` whole-struct store/load copy every word (the generic-aggregate frontier).
      off := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = ppn_s, snl = ppn_l, ek = 7, estride = 1, eek = 0, is_ref = true))
    } else if pm.pmode == 2 {
      ## OUT-SCALAR param `out r : T` / `in out r : T` (T a scalar — none of the aggregate/ptr
      ## branches above matched): passed BY REFERENCE so a callee write is visible to the caller.
      ## The slot holds a POINTER to the caller's scalar (`ek = 8`, `is_ref`); a `Var` READ loads
      ## the pointer then derefs it, an ASSIGN stores through it, and the caller passes the arg's
      ## ADDRESS (`emit_out_scalar_arg`). One pointer-sized slot, spilled from its arg register
      ## like any scalar param.
      off := svec_len(ptr(slots))
      svec_push(slots, SlotEntry(ns = pm.ns, nl = pm.nl, off = off, sns = 0, snl = 0, ek = 8, estride = 1, eek = 0, is_ref = true))
    } else if type_is_float(decls, src, pts, ptl) {
      ## FLOAT param `x : f64` (or a float-underlying brand `x : F`, `F := brand(f64)`) — one word
      ## (the IEEE-754 bits), tagged `ek = 9` so a `Var` read /
      ## arithmetic dispatches the xmm path. Keyed on the SUBSTITUTED type span `pts`/`ptl` (not
      ## `pm`'s raw type) so a GENERIC param `v : T` monomorphized with `T = f64` is ALSO tagged
      ## float — without this, `display__f64`'s `v : T` bound as a plain scalar (ek 0), so
      ## `is_float_expr(v)` was false and `f64(v)` mis-lowered as `cvtsi2sd` (int→float CONVERSION of
      ## the raw bits) instead of the float no-op → the IEEE bits printed as a huge integer. The value
      ## still flows in via a GP reg (caller + prologue both use the unsubstituted classifier, so they
      ## AGREE on GP), lands in this ek-9 slot as bits, and `f64(v)` is now a reinterpret. pmode is 0
      ## here (array=1 handled at the top, out=2 just above), so no `pmode` guard is needed.
      bind_float_slot(slots, src, pm.ns, pm.nl)
    } else {
      ## scalar VALUE param — record its (substituted) type name so per-signature overload
      ## resolution can recover an argument's type at the call site.
      bind_slot_typed(slots, src, pm.ns, pm.nl, bs, bl)
    }
  }
}

## ============================================================================================
## COMMIT 2 — EMIT-FROM-IR for the SCALAR-LEAF / `unchecked` shape (register allocator).
## Behind the `--ra` flag (default OFF): when OFF the whole path is dormant (short-circuited before it
## is even reached in `emit_fn`), so the self-host build's GAS is byte-identical and the TOOL-1 fixpoint
## is untouched. When ON, a function matching `is_scalar_leaf_shape` is lowered to the `regalloc`
## instruction-IR, register-allocated (linear-scan, spills to reserved frame slots), and rendered to GAS
## — keeping loop-carried scalars register-resident instead of the text stack-machine's per-iteration
## reload. Everything failing the shape predicate falls through to the unchanged text `emit_fn` body.
## ---------------------------------------------------------------------------------------------
## The `--ra` toggle: `emit_program` reads `ALATYR_RA=0` from the environment ONCE (intra-module — a
## cross-module write of this global corrupts the pipeline in the lean lower) into `RA_ON`; `emit_fn`
## reads it. COMMIT 3: default 1 (ON) → every build register-allocates the scalar-leaf shape without any
## env var; `ALATYR_RA=0` forces the old text-stack-machine path (an escape hatch for debugging). This
## reseed self-promotes the default-on compiler (its own scalar-leaf fns are now register-allocated).
mut RA_ON : usize = 1
## 1 while emitting a per-module SPLIT build (spanbase != 0), else 0. Its only effect is to `.globl` the
## `.Lstr`/`.Lfld`/`.Lflt` rodata labels so a cross-`.o` reference resolves; spanbase == 0 => GAS
## byte-identical.
mut SPLIT_ON : usize = 0
## 1 only for object/static-library lowering. Executable/test/source emission keeps its established
## linkage until the per-module split can carry explicit hidden visibility across object boundaries.
mut LIBRARY_MODE : usize = 0

## The compiler injects the shipped prelude and stdlib as modules named from their three tiers:
## `base__…`, `alloc__…`, and `std__…` (driver::push_module_name). They are implementation inputs to
## a package, not members of that package's public API. In particular, `pub` on every ambient helper
## must NOT turn the whole injected closure into a static-library root when the package merely calls
## one of them from its excluded entry module. Keep this fact at the module-name boundary: Decl has no
## source-path provenance, and changing target selection / shared-library semantics is outside P2.
library_ambient_module := fn(src : ptr(u8), ms : usize, ml : usize) -> bool {
  if ml >= 5 and str_at((src + ms), 5) == "std__" { return true }
  if ml >= 7 and str_at((src + ms), 7) == "alloc__" { return true }
  if ml >= 6 and str_at((src + ms), 6) == "base__" { return true }
  false
}

## Library API root = a public / explicitly exported runtime fn from the PACKAGE source tree. Ambient
## declarations remain reachable only when a package root calls them; their own `pub` is not a root here.
library_api_root := fn(src : ptr(u8), d : Decl) -> bool {
  if d.kind != 1 or library_ambient_module(src, d.mod_start, d.mod_len) { return false }
  decl_is_pub(src, d.name_start) or export_name(src, d.name_start, d.name_len).n != 0
}

## Whether a path-derived declaration symbol must be visible outside the current object. A split
## executable still needs every cross-module target global until the split linker grows explicit
## hidden-symbol plumbing; a library object/archive exports only the source-level public surface.
## `@export("exact")` is handled by emit_fn's separate exact-name alias, so it deliberately does not
## make the private mangled implementation name global as well (Modules §6.3).
mangled_symbol_is_global := fn(src : ptr(u8), d : Decl) -> bool {
  LIBRARY_MODE == 0 or decl_is_pub(src, d.name_start)
}

## ============================ TOOL-6 slice 1d: MODULE-LOCAL LABEL NAMESPACES =====================
## THE PROBLEM. Every `.rodata` label the x86 emit produced was keyed on a WHOLE-PROGRAM number:
##   `.Lstr<N>`   N = `pc.nstr`, ONE literal counter threaded across all modules in parse order
##   `.Lflt<off>` / `.Lfld<off>`   off = an ABSOLUTE byte offset into the concatenated source buffer
## So adding a single string literal to an early module RENUMBERED every `.Lstr` in every module after
## it — measured 13 of 19 per-module GAS blocks invalidated by one added literal (`scripts/incr_probe.sh
## blast`), and almost every emit change in this compiler adds a `push_str(sb, "…")`. That is fatal for
## a per-module emission cache: the cache would miss on nearly every edit.
##
## THE FIX. Give every module its own label namespace: `.Lstr<m>_<n>` / `.Lflt<m>_<n>` / `.Lfld<m>_<n>`,
## where `m` is the module index and `n` is the key MINUS that module's base. An edit inside module k
## then leaves modules != k byte-identical, because their `n`s are relative to their OWN bases.
##
## THE MECHANISM is deliberately a PURE RENAMING of the old key — not a re-keying. `MODTAB` holds, per
## module, two MONOTONE NON-DECREASING bases (word `m*2` = the source-offset base, word `m*2+1` = the
## label-index base), with base[0] pinned to 0. For a key `k`, `m(k)` = the LARGEST m with base[m] <= k
## and the emitted pair is `(m(k), k - base[m(k)])`.
##
## UNIQUENESS (the link-time requirement) is therefore FREE and unconditional: for any non-decreasing
## base array with base[0] == 0, the map `k -> (m(k), k - base[m(k)])` is INJECTIVE — recover k as
## `base[m] + n`. So two distinct old labels stay distinct, and two equal old labels stay equal. Every
## duplicate-symbol / shared-entry property of the old scheme (the HOF-clone renumber, the `.Lflt`
## dedup, embeds, cross-module references from inlined bodies and monomorphized instances) is preserved
## EXACTLY, no matter how the bases are computed. A wrong base can only cost cache precision, never
## correctness.
mut MODTAB : usize = 0
mut MODTAB_N : usize = 0
## The scan pass that fills the LABEL bases: while `ROD_SCAN != 0` the `.rodata` walk emits NOTHING and
## instead records the smallest `.Lstr` label index it sees (`ROD_HAS` = "saw one"). Reusing the real
## walk (rather than a parallel traversal) means the bases cover exactly the labels the real walk
## defines — no arm can be missed.
mut ROD_SCAN : usize = 0
mut ROD_MIN : usize = 0
mut ROD_HAS : usize = 0
## base lookup: word `w` (0 = source offsets, 1 = label indices) of module `m`.
modtab_base := fn(m : usize, w : usize) -> usize {
  if MODTAB_N == 0 { return 0 }
  return rt::rec_get(unchecked bitcast(ptr(mut u8), MODTAB), m * 2 + w)
}
## the owning module of key `k` in namespace `w` — the largest m with base[m] <= k (base[0] == 0, so
## this is always defined and `k - base[m]` never underflows), then walked BACK over any run of EQUAL
## bases to the FIRST module of that run. The back-walk matters: a module that defines no label of this
## kind (e.g. `main`, which holds no string literal) inherits its predecessor's base, and without the
## walk it would CAPTURE the predecessor's labels — so the day it gained a literal of its own, the
## predecessor's whole block would be renamed. Picking the first module of the run pins each key to the
## module that actually owns it. Injectivity is untouched: `m` still determines `base[m]`, so
## `k == base[m] + n` is recoverable. 19 modules → the linear scan is free.
modtab_of := fn(k : usize, w : usize) -> usize {
  mut m := 0
  mut i := 1
  while i < MODTAB_N {
    if modtab_base(i, w) <= k { m = i }
    i = i + 1
  }
  mut go := true
  while go {
    mut back := false
    if m > 0 {
      if modtab_base(m - 1, w) == modtab_base(m, w) { back = true }
    }
    if back == false { go = false }
    if back { m = m - 1 }
  }
  return m
}
## `.Lstr<m>_<n>` — the string-literal label for whole-program label index `lbl`.
push_lstr := fn(in out sb : strbuf::StrBuf, lbl : usize) {
  m := modtab_of(lbl, 1)
  push_str(sb, ".Lstr")
  push_int(sb, i64(m))
  push_str(sb, "_")
  push_int(sb, i64(lbl - modtab_base(m, 1)))
}
## `.Lflt<m>_<n>` — the float-literal cell for source offset `off`.
push_lflt := fn(in out sb : strbuf::StrBuf, off : usize) {
  m := modtab_of(off, 0)
  push_str(sb, ".Lflt")
  push_int(sb, i64(m))
  push_str(sb, "_")
  push_int(sb, i64(off - modtab_base(m, 0)))
}
## `.Lfld<m>_<n>` — the field/variant NAME cell for the name's source offset `off`.
push_lfld := fn(in out sb : strbuf::StrBuf, off : usize) {
  m := modtab_of(off, 0)
  push_str(sb, ".Lfld")
  push_int(sb, i64(m))
  push_str(sb, "_")
  push_int(sb, i64(off - modtab_base(m, 0)))
}
## Under a SPLIT build the rodata labels are object-local, so a cross-`.o` reference (an inlined body,
## a monomorphized instance, a shared `.Lflt` cell) needs them `.globl`. No-op in a normal build.
globl_lstr := fn(in out sb : strbuf::StrBuf, lbl : usize) {
  if SPLIT_ON == 0 { return }
  push_str(sb, ".globl ")
  push_lstr(sb, lbl)
  push_str(sb, "\n")
}
globl_lflt := fn(in out sb : strbuf::StrBuf, off : usize) {
  if SPLIT_ON == 0 { return }
  push_str(sb, ".globl ")
  push_lflt(sb, off)
  push_str(sb, "\n")
}
globl_lfld := fn(in out sb : strbuf::StrBuf, off : usize) {
  if SPLIT_ON == 0 { return }
  push_str(sb, ".globl ")
  push_lfld(sb, off)
  push_str(sb, "\n")
}
## One-time env probe for the `ALATYR_RA=0` entry in NUL-separated /proc/self/environ (the OFF escape
## hatch). Uses the same `bytes(str)[i]` scan `cli` uses (a raw-address deref chain mis-scans in the
## lean lower). Absent → RA_ON stays 1 (default on).
ra_env_init := fn(a : rt::Arena) {
  RA_ON = 1
  mut pb := rt::strbuf(a, 32)
  hp := rt::push_str(pb, "/proc/self/environ")
  hz := rt::push_byte(pb, 0)
  pc := unchecked bitcast(usize, rt::strbuf_base(pb))
  fd := rt::sys_open(2, pc, 0, 0)
  if fd < 0 { return }
  mut eb := rt::strbuf(a, 8192)
  ebase := unchecked bitcast(usize, rt::strbuf_base(eb))
  nread := rt::sys_read(0, unchecked bitcast(usize, fd), ebase, 8191)
  cc := rt::sys_close(3, unchecked bitcast(usize, fd))
  if nread <= 0 { return }
  env := str_at(unchecked bitcast(ptr(u8), ebase), usize(nread))
  ## Scan for the `ALATYR_RA=0` entry (the OFF escape hatch). NO early `return` from inside the nested
  ## loops (that mis-lowers in the lean lower — a layout-dependent stack corruption); use a `found` flag
  ## + clear RA_ON after. The final byte is 48 (`0`); an unset env or any other value keeps default-on.
  mut found := false
  mut i := 0
  while i < env.len and (not found) {
    if i + 11 <= env.len and bytes(env)[i] == 65 and bytes(env)[i + 1] == 76 and bytes(env)[i + 2] == 65 and bytes(env)[i + 3] == 84 and bytes(env)[i + 4] == 89 and bytes(env)[i + 5] == 82 and bytes(env)[i + 6] == 95 and bytes(env)[i + 7] == 82 and bytes(env)[i + 8] == 65 and bytes(env)[i + 9] == 61 and bytes(env)[i + 10] == 48 {
      found = true
    }
    if not found {
      while i < env.len and bytes(env)[i] != 0 { i = i + 1 }
      i = i + 1
    }
  }
  if found { RA_ON = 0 }
