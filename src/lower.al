          push_str(sb, "  leaq ")
          emit_global_label(sb, cx.decls, cx.src, fv.s, fv.n)
          push_str(sb, "(%rip), %rax\n  movq -")
          push_int(sb, i64((islot + 1) * 8))
          push_str(sb, "(%rbp), %rcx\n  imulq $")
          push_int(sb, i64(glob_stride * 8))
          push_str(sb, ", %rcx\n  addq %rcx, %rax\n")
