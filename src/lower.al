  ot := ir_lower_expr(d.value, cx, false)
  regalloc::ra_ir_emit(0, 2, 0, ot.k, ot.v)
  regalloc::ra_ir_emit(7, 0, 0, 0, 0)
  if regalloc::ra_ir_ovf() { panic("selfhost: regalloc emit — IR capacity overflow (predicate too permissive)") }
  regalloc::ra_ir_run()
