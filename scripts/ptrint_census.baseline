# The #529 ptrint census baseline — scripts/ptrint_census.sh gate mode.
#
# MEASURED, not chosen: `places` is the distinct seam places the census reported over src/, lib/ and
# every tracked fixture on main at 7aae8b3 (1 BIND i2p + 2 RESULT-TAIL p2i, all in test/, all OUTSIDE
# an `unchecked` grant); `blind-lib` is the tracked lib/ modules the census could NOT check standalone,
# so their places are unknown rather than zero.
#
# Neither number may grow.
#
# `op-cmp` IS now claimed clean, and held: the planted fixture plants a pointer meeting an integer
# literal outside any `unchecked` grant, `planted` reports the hook PROVEN (`proven=13/13` — every class,
# OP-CMP included), and the census reports `op-cmp=0` over src/, lib/ and every tracked fixture. The
# ratchet holds that 0 and REFUSES to hold it while the hook is unproven — an unproven zero is silence,
# not cleanliness, so the ceiling returns rc=2 rather than passing. An earlier revision of this file said
# OP-CMP could not be claimed because its hook sat undispatched under the bootstrap seed ("scar #2");
# that was false — both the tree compiler and `seed/alatyr 0.2.16` fire it on `p == 0`.
places=3
blind-lib=12
op-cmp=0
