# scripts/idiom.baseline — the reviewed ALLOW list for scripts/idiom_gate.sh.
#
# One line per accepted finding, TAB-separated, each carrying a LOCATION so a reader can
# tell an accepted duplicate from a forgotten one. Regenerating this file is an
# INTENTIONAL act that belongs in its own reviewed commit — blessing a new duplicate
# unreviewed erases the oracle, exactly as with scripts/corpus.manifest.
#
# Columns:
#   TABLE|SCAN  fileA  nameA  fileB  nameB  n-shared-literals  signature  lineA:lineB
#   STRIDE      file   count                                              -
#   DROPPED     file   callee  count                                      -
#   CACHE       file   family  columns                                    -
#
# The LAST field of every row is a LOCATION and is EXCLUDED from the comparison: a line
# number churns on any edit above it. Everything before it is the key.
#
# Written by: bash scripts/idiom_gate.sh --write
# Thresholds: LK=4 LMAXF=20 SK=4 SMAXF=40
#
# The TABLE/SCAN pairs below, collapsed into CLUSTERS. A pair is the gate's unit (so a new
# copy adds lines and FAILS, while a removed copy only goes stale), but a cluster is what a
# reader can judge: 21 pairs among 7 functions is ONE duplicated decision, not 21.
# cluster of 7:  src/lower_attrs.al:fn_is_inline src/driver.al:d_export_name src/lower.al:export_name src/iface.al:iface_ident src/lower/fnval.al:ecallee_ident_char src/wat.al:wat_export_name src/sema.al:export_name
# cluster of 6:  src/fmt.al:fmt_op src/lower.al:op_symbol src/sema.al:sema_op_symbol src/wat.al:wat_cmp_glyph src/ast.al:compound_assign_op_at src/lower.al:local_is_plain_assign
# cluster of 5:  src/riscv64.al:rv_asm_digit src/wat.al:wat_float_global_init src/lower_ctx.al:asm_digit src/aarch64.al:a64_asm_digit src/lower_layout.al:dec_digit_val
# cluster of 5:  src/riscv64.al:rv_ann_span src/wat.al:wat_ann_span src/aarch64.al:a64_ann_span src/ast.al:local_is_uninit src/ast.al:local_type_span
# cluster of 3:  src/wat.al:wat_comp_range_bound src/riscv64.al:rv_comp_range_bound src/aarch64.al:a64_comp_range_bound
# cluster of 3:  src/wat.al:emit_wat_expr src/aarch64.al:emit_a64_expr src/riscv64.al:emit_rv_expr
# cluster of 3:  src/riscv64.al:emit_rv_fn src/aarch64.al:emit_a64_fn src/wat.al:emit_wat_fn
# cluster of 2:  src/lower/fnval.al:fnty_name_end src/sema.al:sema_fnty_name_end
# cluster of 2:  src/cli.al:link_exe_split src/cli.al:link_exe
# cluster of 2:  src/aarch64.al:a64_fcond src/aarch64.al:a64_cond
# Deliberate target-specific copies: S3(d)'s byte-tier array-element loads and stores must spell the
# selected ISA/WASM memory operations in each emitter; the layout decision and byte offsets remain
# shared in lower_layout.al. These are an extension of the already reviewed emit_* backend cluster.
CACHE	src/lower.al	_mcv	ctx,ml,ms,n,r,s,src	-
CACHE	src/lower.al	_mgv	ctx,ml,ms,n,r,s,src	-
CACHE	src/lower.al	_mn	ml,ms,n,s,src	-
CACHE	src/lower_layout.al	_ctb	nl,ns,val	-
CACHE	src/lower_layout.al	_edc	ctx,i,ml,ms,n,s,src	-
CACHE	src/lower_layout.al	_sdc	ctx,i,ml,ms,n,s,src	-
DROPPED	src/cli.al	rt::sys_write	6	-
DROPPED	src/driver.al	rt::sb_flush	4	-
DROPPED	src/lower.al	rt::sys_write	2	-
DROPPED	src/lower/ctfold.al	rt::sys_write	1	-
DROPPED	src/lower_layout.al	rt::sys_write	3	-
DROPPED	src/rt.al	sys_write	1	-
